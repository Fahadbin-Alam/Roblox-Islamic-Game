        Disclosure = "Rewards must be developer products. Players do not receive Robux from ads.",
    },
    SkinDefinitions = {
        default = {
            DisplayName = "Pilgrim Standard",
            UnlockType = "Default",
            PrimaryColor = Color3.fromRGB(229, 223, 209),
            SecondaryColor = Color3.fromRGB(72, 72, 72),
            AccentColor = Color3.fromRGB(188, 165, 116),
            CapeColor = Color3.fromRGB(240, 237, 230),
        },
        -- Earned by learning, never bought: reaching these levels unlocks them for free.
        student_robe = {
            DisplayName = "Student's Robe",
            UnlockType = "Level",
            UnlockLevel = 3,
            PrimaryColor = Color3.fromRGB(92, 119, 82),
            SecondaryColor = Color3.fromRGB(236, 230, 214),
            AccentColor = Color3.fromRGB(193, 162, 86),
            CapeColor = Color3.fromRGB(70, 96, 64),
        },
        seeker_of_knowledge = {
            DisplayName = "Seeker Of Knowledge",
            UnlockType = "Level",
            UnlockLevel = 6,
            PrimaryColor = Color3.fromRGB(58, 84, 120),
            SecondaryColor = Color3.fromRGB(240, 236, 224),
            AccentColor = Color3.fromRGB(214, 180, 98),
            CapeColor = Color3.fromRGB(40, 60, 92),
        },
        scholars_companion = {
            DisplayName = "Scholar's Companion",
            UnlockType = "Level",
            UnlockLevel = 10,
            PrimaryColor = Color3.fromRGB(245, 241, 230),
            SecondaryColor = Color3.fromRGB(121, 94, 63),
            AccentColor = Color3.fromRGB(226, 190, 104),
            CapeColor = Color3.fromRGB(176, 140, 62),
        },
        desert_commander = {
            DisplayName = "Desert Commander",
            UnlockType = "GamePass",
            UnlockKey = "desert_commander_skin",
            PrimaryColor = Color3.fromRGB(194, 153, 88),
            SecondaryColor = Color3.fromRGB(87, 61, 38),
