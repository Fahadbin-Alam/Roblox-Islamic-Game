    <Item class="Script" referent="20">
      <Properties>
        <string name="Name">MannersService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MannersLessons = require(Shared.Data.MannersLessons)
local TravelRoute = require(Shared.Data.TravelRoute)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local mannersFolder = remotesFolder:WaitForChild("Manners")
local requestLesson = mannersFolder:WaitForChild("RequestLesson") :: RemoteEvent
local showMannersLesson = mannersFolder:WaitForChild("ShowMannersLesson") :: RemoteEvent

local lessonById = {}
local promptConnections = {}

for _, lesson in ipairs(MannersLessons) do
    lessonById[lesson.Id] = lesson
end

local function showLesson(player: Player, lessonId: string)
    local lesson = lessonById[lessonId]

    if not lesson then
        return
    end

    showMannersLesson:FireClient(player, {
        Id = lesson.Id,
        DisplayName = lesson.DisplayName,
        Subtitle = lesson.Subtitle,
        Lines = lesson.Lines,
        AccentColor = lesson.AccentColor,
        LinkedStoryId = lesson.LinkedStoryId,
    })
end

local function connectPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    if prompt:GetAttribute("PromptAction") ~= "OpenManners" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local lessonId = prompt:GetAttribute("LessonId")

        if typeof(lessonId) == "string" then
            showLesson(player, lessonId)
        end
    end)
end

requestLesson.OnServerEvent:Connect(function(player: Player, lessonId: string)
    if typeof(lessonId) == "string" then
        showLesson(player, lessonId)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    for prompt, connection in pairs(promptConnections) do
        if not prompt.Parent then
            connection:Disconnect()
            promptConnections[prompt] = nil
        end
    end
end)

task.spawn(function()
    local worldFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if not worldFolder then
        return
    end

    for _, descendant in ipairs(worldFolder:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end

    worldFolder.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end)
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="21">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">BattleLoadout</string>
          <string name="Source"><![CDATA[--!strict

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShopCatalog = require(Shared.Data.ShopCatalog)
local battleFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Battle")
local requestBlock = battleFolder:WaitForChild("RequestBlock") :: RemoteEvent

local BattleLoadout = {}

local SWORD_SWING_SOUND = "rbxasset://sounds/swordslash.wav"
local SWORD_HIT_SOUND = "rbxasset://sounds/swordlunge.wav"
local SWORD_DRAW_SOUND = "rbxasset://sounds/unsheath.wav"
local BOW_RELEASE_SOUND = "rbxasset://sounds/action_jump.mp3"
local BOW_HIT_SOUND = "rbxasset://sounds/impact_water.mp3"
local BLOCK_SOUND = "rbxasset://sounds/collide.wav"

local BLOCK_WINDOW_SECONDS = 1.1
local BLOCK_COOLDOWN_SECONDS = 1.8
local BLOCK_DAMAGE_MULTIPLIER = 0.28
local blockCooldowns: { [Player]: number } = {}

local function getCharacterHumanoid(model: Instance): Humanoid?
    if not model:IsA("Model") then
        return nil
    end

    return model:FindFirstChildOfClass("Humanoid")
end

local function findFirstBodyPart(character: Model, names: { string }): BasePart?
    for _, name in ipairs(names) do
        local part = character:FindFirstChild(name)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    return nil
end

local function findEnemyHumanoid(originCharacter: Model, maxDistance: number): Humanoid?
    local root = originCharacter:FindFirstChild("HumanoidRootPart")

    if not root or not root:IsA("BasePart") then
        return nil
    end

    local originTeam = originCharacter:GetAttribute("BattleTeam")
    local bestHumanoid = nil
    local bestDistance = maxDistance

    for _, candidate in ipairs(Workspace:GetDescendants()) do
        if candidate:IsA("Humanoid") and candidate.Health > 0 then
            local candidateModel = candidate.Parent

            if candidateModel and candidateModel:IsA("Model") and candidateModel ~= originCharacter then
                local candidateRoot = candidateModel:FindFirstChild("HumanoidRootPart")

                if candidateRoot and candidateRoot:IsA("BasePart") then
                    local candidateTeam = candidateModel:GetAttribute("BattleTeam")

                    if candidateTeam and candidateTeam ~= originTeam then
                        local distance = (candidateRoot.Position - root.Position).Magnitude

                        if distance < bestDistance then
                            bestDistance = distance
                            bestHumanoid = candidate
                        end
                    end
                end
            end
        end
    end

    return bestHumanoid
end

local function playOneShotSound(parent: Instance, soundId: string, volume: number, playbackSpeed: number?)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = volume

    if playbackSpeed then
        sound.PlaybackSpeed = playbackSpeed
    end

    sound.Parent = parent
    sound:Play()
    Debris:AddItem(sound, 3)
end

local function isBlocking(character: Model): boolean
    local blockingUntil = character:GetAttribute("BlockingUntil")

    return type(blockingUntil) == "number" and blockingUntil > os.clock()
end

local function applyDamage(attackerCharacter: Model, targetHumanoid: Humanoid?, damage: number, hitSoundId: string?)
    if not targetHumanoid or targetHumanoid.Health <= 0 then
        return false
    end

    local targetModel = targetHumanoid.Parent

    if not targetModel or not targetModel:IsA("Model") then
        return false
    end

    if targetModel:GetAttribute("BattleTeam") == attackerCharacter:GetAttribute("BattleTeam") then
        return false
    end

    local finalDamage = damage
    local blocked = isBlocking(targetModel)

    if blocked then
        finalDamage = math.max(3, math.floor(damage * BLOCK_DAMAGE_MULTIPLIER))
    end

    targetHumanoid:TakeDamage(finalDamage)

    if blocked then
        local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")

        if targetRoot and targetRoot:IsA("BasePart") then
            playOneShotSound(targetRoot, BLOCK_SOUND, 0.65, 1.08)

            local flash = Instance.new("Part")
            flash.Name = "BlockFlash"
            flash.Shape = Enum.PartType.Ball
            flash.Size = Vector3.new(3, 3, 3)
            flash.Material = Enum.Material.Neon
            flash.Color = Color3.fromRGB(222, 198, 126)
            flash.Transparency = 0.35
            flash.Anchored = true
            flash.CanCollide = false
            flash.CanTouch = false
            flash.CanQuery = false
            flash.CFrame = targetRoot.CFrame
            flash.Parent = Workspace
            Debris:AddItem(flash, 0.22)
        end
    elseif hitSoundId then
        local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")

        if targetRoot and targetRoot:IsA("BasePart") then
            playOneShotSound(targetRoot, hitSoundId, 0.55, 1)
        end
    end

    return true
end

local function setBlocking(player: Player)
    if player:GetAttribute("InBattle") ~= true then
        return
    end

    local now = os.clock()
    local lastBlock = blockCooldowns[player]

    if lastBlock and now - lastBlock < BLOCK_COOLDOWN_SECONDS then
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return
    end

    blockCooldowns[player] = now
    character:SetAttribute("BlockingUntil", now + BLOCK_WINDOW_SECONDS)
    playOneShotSound(root, BLOCK_SOUND, 0.5, 1.2)
end

local function createCosmeticPart(name: string, size: Vector3, color: Color3, material: Enum.Material, transparency: number?): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = material
    part.Transparency = transparency or 0
    part.Anchored = false
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth

    return part
end

local function attachPart(parent: Instance, part: Part, basePart: BasePart, offset: CFrame)
    part.CFrame = basePart.CFrame * offset
    part.Parent = parent

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = basePart
    weld.Part1 = part
    weld.Parent = part
end

local function clearSkinCosmetics(character: Model)
    local existing = character:FindFirstChild("BattleCosmetics")

    if existing then
        existing:Destroy()
    end
end

local function applySkinCosmetics(player: Player)
    local character = player.Character

    if not character then
        return
    end

    clearSkinCosmetics(character)

    local root = findFirstBodyPart(character, { "HumanoidRootPart" })
    local head = findFirstBodyPart(character, { "Head" })
    local torso = findFirstBodyPart(character, { "UpperTorso", "Torso", "LowerTorso" })
    local leftArm = findFirstBodyPart(character, { "LeftUpperArm", "Left Arm" })
    local rightArm = findFirstBodyPart(character, { "RightUpperArm", "Right Arm" })
    local leftLeg = findFirstBodyPart(character, { "LeftUpperLeg", "Left Leg" })
    local rightLeg = findFirstBodyPart(character, { "RightUpperLeg", "Right Leg" })

    if not root or not head or not torso then
        return
    end

    local skinId = player:GetAttribute("EquippedBattleSkin")

    if typeof(skinId) ~= "string" then
        skinId = "default"
    end

    local skin = ShopCatalog.SkinDefinitions[skinId] or ShopCatalog.SkinDefinitions.default
    local cosmetics = Instance.new("Folder")
    cosmetics.Name = "BattleCosmetics"
    cosmetics.Parent = character

    local cuirass = createCosmeticPart("Cuirass", Vector3.new(2.5, 2.6, 1.4), skin.PrimaryColor, Enum.Material.Metal, nil)
    attachPart(cosmetics, cuirass, torso, CFrame.new(0, 0.05, 0))

    local waistGuard = createCosmeticPart("WaistGuard", Vector3.new(2.7, 0.45, 1.45), skin.AccentColor, Enum.Material.Metal, nil)
    attachPart(cosmetics, waistGuard, torso, CFrame.new(0, 0.82, 0))

    local backCape = createCosmeticPart("BackCape", Vector3.new(2.8, 3.3, 0.2), skin.CapeColor, Enum.Material.Fabric, 0.05)
    attachPart(cosmetics, backCape, torso, CFrame.new(0, -0.18, 0.76))

    local helmetBand = createCosmeticPart("HelmetBand", Vector3.new(2.12, 0.34, 1.1), skin.SecondaryColor, Enum.Material.Metal, nil)
    attachPart(cosmetics, helmetBand, head, CFrame.new(0, 0.18, 0))

    local crest = createCosmeticPart("HelmetCrest", Vector3.new(0.32, 0.9, 1.2), skin.AccentColor, Enum.Material.Fabric, nil)
    attachPart(cosmetics, crest, head, CFrame.new(0, -0.48, 0))

    if leftArm then
        local leftShoulder = createCosmeticPart("LeftShoulder", Vector3.new(0.95, 0.62, 1.15), skin.PrimaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, leftShoulder, leftArm, CFrame.new(0, -0.52, 0))

        local leftBracer = createCosmeticPart("LeftBracer", Vector3.new(0.82, 1.05, 0.82), skin.SecondaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, leftBracer, leftArm, CFrame.new(0, 0.52, 0))
    end

    if rightArm then
        local rightShoulder = createCosmeticPart("RightShoulder", Vector3.new(0.95, 0.62, 1.15), skin.PrimaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, rightShoulder, rightArm, CFrame.new(0, -0.52, 0))

        local rightBracer = createCosmeticPart("RightBracer", Vector3.new(0.82, 1.05, 0.82), skin.SecondaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, rightBracer, rightArm, CFrame.new(0, 0.52, 0))
    end

    if leftLeg then
        local leftGreave = createCosmeticPart("LeftGreave", Vector3.new(0.82, 1.18, 0.82), skin.SecondaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, leftGreave, leftLeg, CFrame.new(0, 0.3, 0))
    end

    if rightLeg then
        local rightGreave = createCosmeticPart("RightGreave", Vector3.new(0.82, 1.18, 0.82), skin.SecondaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, rightGreave, rightLeg, CFrame.new(0, 0.3, 0))
    end

    if player:GetAttribute("HasFounderSupport") then
        local founderBand = createCosmeticPart("FounderBand", Vector3.new(0.24, 2.7, 1.18), Color3.fromRGB(208, 174, 92), Enum.Material.Metal, nil)
        attachPart(cosmetics, founderBand, torso, CFrame.new(1.05, 0, 0))
    end

    local aura = createCosmeticPart("AuraPlate", Vector3.new(2.8, 0.14, 2.8), skin.AccentColor, Enum.Material.Neon, 0.42)
    attachPart(cosmetics, aura, root, CFrame.new(0, -2.68, 0))
end

local function createWeaponVisualPart(name: string, size: Vector3, color: Color3, material: Enum.Material): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = material
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth

    return part
end

local function weldToHandle(handle: BasePart, part: BasePart, offset: CFrame)
    part.CFrame = handle.CFrame * offset
    part.Parent = handle.Parent

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = handle
    weld.Part1 = part
    weld.Parent = part
end

local function createSwordTool(): Tool
    local tool = Instance.new("Tool")
    tool.Name = "Training Sword"
    tool.RequiresHandle = true
    tool.Grip = CFrame.new(0, -0.65, 0)

    local handle = createWeaponVisualPart("Handle", Vector3.new(0.42, 3.3, 0.42), Color3.fromRGB(98, 66, 38), Enum.Material.Wood)
    handle.Parent = tool

    local grip = createWeaponVisualPart("Grip", Vector3.new(0.54, 2.4, 0.54), Color3.fromRGB(81, 52, 33), Enum.Material.Wood)
    local pommel = createWeaponVisualPart("Pommel", Vector3.new(0.7, 0.45, 0.7), Color3.fromRGB(177, 146, 78), Enum.Material.Metal)
    local guard = createWeaponVisualPart("Crossguard", Vector3.new(3.2, 0.3, 0.5), Color3.fromRGB(179, 149, 87), Enum.Material.Metal)
    local blade = createWeaponVisualPart("Blade", Vector3.new(0.34, 4.8, 0.54), Color3.fromRGB(216, 216, 216), Enum.Material.Metal)
    local tip = createWeaponVisualPart("BladeTip", Vector3.new(0.18, 0.8, 0.24), Color3.fromRGB(228, 228, 226), Enum.Material.Metal)

    weldToHandle(handle, grip, CFrame.new(0, 0, 0))
    weldToHandle(handle, pommel, CFrame.new(0, -1.85, 0))
    weldToHandle(handle, guard, CFrame.new(0, 1.54, 0))
    weldToHandle(handle, blade, CFrame.new(0, 4.2, 0))
    weldToHandle(handle, tip, CFrame.new(0, 7.0, 0))

    tool.Equipped:Connect(function()
        playOneShotSound(handle, SWORD_DRAW_SOUND, 0.45, 1)
    end)

    local cooldown = false

    tool.Activated:Connect(function()
        if cooldown then
            return
        end

        local character = tool.Parent

        if not character or not character:IsA("Model") then
            return
        end

        local humanoid = getCharacterHumanoid(character)
        local root = character:FindFirstChild("HumanoidRootPart")

        if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
            return
        end

        cooldown = true
        playOneShotSound(handle, SWORD_SWING_SOUND, 0.5, 1.05)

        local direction = root.CFrame.LookVector * 11
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = { character, tool }

        local result = Workspace:Raycast(root.Position, direction, raycastParams)
        local targetHumanoid = nil

        if result then
            local target = result.Instance:FindFirstAncestorOfClass("Model")

            if target then
                targetHumanoid = getCharacterHumanoid(target)
            end
        end

        if not targetHumanoid then
            targetHumanoid = findEnemyHumanoid(character, 11)
        end

        applyDamage(character, targetHumanoid, 28, SWORD_HIT_SOUND)

        task.delay(0.58, function()
            cooldown = false
        end)
    end)

    return tool
end

local function createBowTool(): Tool
    local tool = Instance.new("Tool")
    tool.Name = "Bow"
    tool.RequiresHandle = true

    local handle = createWeaponVisualPart("Handle", Vector3.new(0.36, 3.2, 0.36), Color3.fromRGB(108, 74, 42), Enum.Material.Wood)
    handle.Parent = tool

    local upperLimb = createWeaponVisualPart("UpperLimb", Vector3.new(0.26, 3.4, 0.26), Color3.fromRGB(116, 82, 48), Enum.Material.Wood)
    local lowerLimb = createWeaponVisualPart("LowerLimb", Vector3.new(0.26, 3.4, 0.26), Color3.fromRGB(116, 82, 48), Enum.Material.Wood)
    local upperString = createWeaponVisualPart("UpperString", Vector3.new(0.08, 1.8, 0.08), Color3.fromRGB(228, 223, 207), Enum.Material.SmoothPlastic)
    local lowerString = createWeaponVisualPart("LowerString", Vector3.new(0.08, 1.8, 0.08), Color3.fromRGB(228, 223, 207), Enum.Material.SmoothPlastic)
    local displayArrow = createWeaponVisualPart("DisplayArrow", Vector3.new(0.18, 0.18, 2.8), Color3.fromRGB(124, 88, 48), Enum.Material.Wood)

    weldToHandle(handle, upperLimb, CFrame.new(0.56, -1.38, 0) * CFrame.Angles(0, 0, math.rad(26)))
    weldToHandle(handle, lowerLimb, CFrame.new(0.56, 1.38, 0) * CFrame.Angles(0, 0, math.rad(-26)))
    weldToHandle(handle, upperString, CFrame.new(1.0, -2.18, 0))
    weldToHandle(handle, lowerString, CFrame.new(1.0, 2.18, 0))
    weldToHandle(handle, displayArrow, CFrame.new(-0.32, 0, -0.7) * CFrame.Angles(math.rad(90), 0, 0))

    local cooldown = false

    tool.Activated:Connect(function()
        if cooldown then
            return
        end

        local character = tool.Parent

        if not character or not character:IsA("Model") then
            return
        end

        local humanoid = getCharacterHumanoid(character)
        local root = character:FindFirstChild("HumanoidRootPart")

        if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
            return
        end

        cooldown = true
        playOneShotSound(handle, BOW_RELEASE_SOUND, 0.35, 1.2)

        local arrow = Instance.new("Part")
        arrow.Name = "BattleArrow"
        arrow.Size = Vector3.new(0.22, 0.22, 4.2)
        arrow.Color = Color3.fromRGB(113, 77, 44)
        arrow.Material = Enum.Material.Wood
        arrow.CanCollide = false
        arrow.CFrame = root.CFrame * CFrame.new(0, 1.5, -3.8)
        arrow.Parent = Workspace
        arrow.AssemblyLinearVelocity = root.CFrame.LookVector * 162

        local arrowTip = createWeaponVisualPart("ArrowTip", Vector3.new(0.28, 0.28, 0.52), Color3.fromRGB(191, 191, 191), Enum.Material.Metal)
        weldToHandle(arrow, arrowTip, CFrame.new(0, 0, -2.15))

        local featherA = createWeaponVisualPart("FeatherA", Vector3.new(0.12, 0.36, 0.44), Color3.fromRGB(224, 228, 233), Enum.Material.Fabric)
        local featherB = createWeaponVisualPart("FeatherB", Vector3.new(0.12, 0.36, 0.44), Color3.fromRGB(224, 228, 233), Enum.Material.Fabric)
        weldToHandle(arrow, featherA, CFrame.new(0.12, 0, 1.6))
        weldToHandle(arrow, featherB, CFrame.new(-0.12, 0, 1.6))

        local damaged = false

        arrow.Touched:Connect(function(hitPart)
            if damaged then
                return
            end

            local target = hitPart:FindFirstAncestorOfClass("Model")

            if not target or target == character then
                return
            end

            local targetHumanoid = getCharacterHumanoid(target)

            if not targetHumanoid then
                return
            end

            damaged = true
            applyDamage(character, targetHumanoid, 20, BOW_HIT_SOUND)
            arrow:Destroy()
        end)

        Debris:AddItem(arrow, 4)

        task.delay(1.05, function()
            cooldown = false
        end)
    end)

    return tool
end

function BattleLoadout.ClearForPlayer(player: Player)
    local backpack = player:FindFirstChildOfClass("Backpack")

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Training Sword" or item.Name == "Bow") then
                item:Destroy()
            end
        end
    end

    local character = player.Character

    if character then
        clearSkinCosmetics(character)
        character:SetAttribute("BlockingUntil", nil)

        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Training Sword" or item.Name == "Bow") then
                item:Destroy()
            end
        end
    end
end

function BattleLoadout.ApplyCurrentSkin(player: Player)
    applySkinCosmetics(player)
end

function BattleLoadout.GiveToPlayer(player: Player)
    BattleLoadout.ClearForPlayer(player)

    local backpack = player:FindFirstChildOfClass("Backpack")

    if not backpack then
        return
    end

    createSwordTool().Parent = backpack
    createBowTool().Parent = backpack
    applySkinCosmetics(player)
end

requestBlock.OnServerEvent:Connect(function(player: Player)
    setBlocking(player)
end)

game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
    blockCooldowns[player] = nil
end)

return BattleLoadout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">BuildUtils</string>
          <string name="Source"><![CDATA[--!strict

local BuildUtils = {}

function BuildUtils.CreateFolder(parent: Instance, name: string): Folder
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent

    return folder
end

function BuildUtils.CreatePart(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?,
    transparency: number?
): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Anchored = true
    part.CanCollide = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Size = size
    part.CFrame = cframe
    part.Color = color
    part.Material = material

    if shape then
        part.Shape = shape
    end

    if transparency then
        part.Transparency = transparency
    end

    part.Parent = parent

    return part
end

function BuildUtils.CreateTeleportAnchor(parent: Instance, name: string, position: Vector3): Part
    local anchor = BuildUtils.CreatePart(
        parent,
        name,
        Vector3.new(12, 1, 12),
        CFrame.new(position + Vector3.new(0, 2, 0)),
        Color3.fromRGB(255, 255, 255),
        Enum.Material.SmoothPlastic,
        nil,
        1
    )
    anchor.CanCollide = false

    return anchor
end

function BuildUtils.AddPointLight(parent: BasePart, color: Color3, brightness: number, range: number)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = brightness
    light.Range = range
    light.Parent = parent
end

function BuildUtils.AttachPrompt(
    parent: BasePart,
    actionText: string,
    objectText: string,
    attributes: { [string]: any }?
): ProximityPrompt
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = actionText
    prompt.ObjectText = objectText
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 12
    prompt.RequiresLineOfSight = false
    prompt.Parent = parent

    if attributes then
        for key, value in pairs(attributes) do
            prompt:SetAttribute(key, value)
        end
    end

    return prompt
end

local function createSignLabel(board: BasePart, title: string, subtitle: string, titleColor: Color3)
    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Face = Enum.NormalId.Front
    surfaceGui.CanvasSize = Vector2.new(760, 280)
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surfaceGui.PixelsPerStud = 60
    surfaceGui.Parent = board

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.fromOffset(26, 18)
    titleLabel.Size = UDim2.new(1, -52, 0, 110)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = title
    titleLabel.TextColor3 = titleColor
    titleLabel.TextScaled = true
    titleLabel.TextWrapped = true
    titleLabel.Parent = surfaceGui

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.fromOffset(26, 122)
    subtitleLabel.Size = UDim2.new(1, -52, 0, 110)
    subtitleLabel.Font = Enum.Font.Gotham
    subtitleLabel.Text = subtitle
    subtitleLabel.TextColor3 = Color3.fromRGB(228, 226, 221)
    subtitleLabel.TextScaled = true
    subtitleLabel.TextWrapped = true
    subtitleLabel.Parent = surfaceGui
end

function BuildUtils.CreateBoardSign(
    parent: Instance,
    name: string,
    position: Vector3,
    title: string,
    subtitle: string,
    accentColor: Color3,
    promptAttributes: { [string]: any }?
): BasePart
    local post = BuildUtils.CreatePart(
        parent,
        string.format("%s_Post", name),
        Vector3.new(2, 11, 2),
        CFrame.new(position + Vector3.new(0, 5.5, 0)),
        Color3.fromRGB(112, 79, 48),
        Enum.Material.WoodPlanks,
        nil,
        nil
    )

    local board = BuildUtils.CreatePart(
        parent,
        string.format("%s_Board", name),
        Vector3.new(18, 9, 1.2),
        CFrame.new(position + Vector3.new(0, 10.8, 0)),
        accentColor,
        Enum.Material.WoodPlanks,
        nil,
        nil
    )
    board.Orientation = Vector3.new(0, 180, 0)

    createSignLabel(board, title, subtitle, Color3.fromRGB(252, 249, 242))

    if promptAttributes then
        BuildUtils.AttachPrompt(board, promptAttributes.ActionText, promptAttributes.ObjectText, promptAttributes.Attributes)
    end

    return board
end

function BuildUtils.CreateWallSign(
    parent: Instance,
    name: string,
    position: Vector3,
    size: Vector3,
    title: string,
    subtitle: string,
    wallColor: Color3,
    promptAttributes: { [string]: any }?
): BasePart
    local wall = BuildUtils.CreatePart(
        parent,
        name,
        size,
        CFrame.new(position + Vector3.new(0, size.Y * 0.5, 0)),
        wallColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    createSignLabel(wall, title, subtitle, Color3.fromRGB(252, 249, 242))

    if promptAttributes then
        BuildUtils.AttachPrompt(wall, promptAttributes.ActionText, promptAttributes.ObjectText, promptAttributes.Attributes)
    end

    return wall
end

function BuildUtils.CreateBanner(parent: Instance, name: string, position: Vector3, clothColor: Color3)
    BuildUtils.CreatePart(parent, string.format("%s_Pole", name), Vector3.new(1, 16, 1), CFrame.new(position + Vector3.new(0, 8, 0)), Color3.fromRGB(111, 83, 53), Enum.Material.Wood, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Cloth", name), Vector3.new(7, 8, 0.6), CFrame.new(position + Vector3.new(3.6, 10.5, 0)), clothColor, Enum.Material.Fabric, nil, nil)
end

function BuildUtils.CreateLantern(parent: Instance, name: string, position: Vector3, accentColor: Color3)
    BuildUtils.CreatePart(parent, string.format("%s_Post", name), Vector3.new(1.4, 11, 1.4), CFrame.new(position + Vector3.new(0, 5.5, 0)), Color3.fromRGB(98, 73, 49), Enum.Material.WoodPlanks, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Arm", name), Vector3.new(5, 0.8, 0.8), CFrame.new(position + Vector3.new(1.8, 10.2, 0)), Color3.fromRGB(96, 78, 48), Enum.Material.WoodPlanks, nil, nil)

    local housing = BuildUtils.CreatePart(parent, string.format("%s_Housing", name), Vector3.new(2.5, 3.5, 2.5), CFrame.new(position + Vector3.new(3.8, 8.4, 0)), accentColor, Enum.Material.Metal, nil, nil)
    local glow = BuildUtils.CreatePart(parent, string.format("%s_Glow", name), Vector3.new(1.2, 1.8, 1.2), housing.CFrame, Color3.fromRGB(255, 223, 158), Enum.Material.Neon, nil, nil)
    BuildUtils.AddPointLight(glow, Color3.fromRGB(255, 224, 167), 1.5, 20)
end

function BuildUtils.CreatePalmTree(parent: Instance, name: string, position: Vector3)
    BuildUtils.CreatePart(parent, string.format("%s_Trunk", name), Vector3.new(3, 18, 3), CFrame.new(position + Vector3.new(0, 9, 0)), Color3.fromRGB(126, 87, 55), Enum.Material.Wood, nil, nil)

    for _, offset in ipairs({
        Vector3.new(0, 19, -5),
        Vector3.new(0, 19, 5),
        Vector3.new(5, 19, 0),
        Vector3.new(-5, 19, 0),
        Vector3.new(0, 21, 0),
    }) do
        BuildUtils.CreatePart(parent, string.format("%s_Leaf_%d_%d", name, offset.X, offset.Z), Vector3.new(18, 1.6, 6), CFrame.new(position + offset), Color3.fromRGB(71, 132, 73), Enum.Material.Grass, nil, nil)
    end
end

function BuildUtils.CreatePlanter(parent: Instance, name: string, position: Vector3, size: Vector3)
    BuildUtils.CreatePart(parent, string.format("%s_Border", name), size, CFrame.new(position + Vector3.new(0, 1.5, 0)), Color3.fromRGB(171, 153, 120), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Green", name), Vector3.new(size.X - 6, 2, size.Z - 6), CFrame.new(position + Vector3.new(0, 2.6, 0)), Color3.fromRGB(116, 149, 99), Enum.Material.Grass, nil, nil)
end

function BuildUtils.CreateHouse(parent: Instance, name: string, position: Vector3, footprint: Vector3, roofColor: Color3)
    BuildUtils.CreatePart(parent, string.format("%s_Base", name), Vector3.new(footprint.X, 20, footprint.Z), CFrame.new(position + Vector3.new(0, 10, 0)), Color3.fromRGB(226, 219, 196), Enum.Material.Limestone, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Roof", name), Vector3.new(footprint.X + 4, 3, footprint.Z + 4), CFrame.new(position + Vector3.new(0, 21.5, 0)), roofColor, Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Door", name), Vector3.new(4, 9, 1), CFrame.new(position + Vector3.new(0, 4.5, footprint.Z * -0.5 - 0.5)), Color3.fromRGB(110, 82, 49), Enum.Material.Wood, nil, nil)
end

function BuildUtils.CreateDune(parent: Instance, name: string, position: Vector3, size: Vector3, color: Color3)
    BuildUtils.CreatePart(parent, name, size, CFrame.new(position + Vector3.new(0, size.Y * 0.25, 0)), color, Enum.Material.Sand, Enum.PartType.Ball, nil)
end

function BuildUtils.CreateRockCluster(parent: Instance, name: string, position: Vector3)
    BuildUtils.CreatePart(parent, string.format("%s_A", name), Vector3.new(14, 11, 12), CFrame.new(position + Vector3.new(-16, 5.5, -16)), Color3.fromRGB(162, 136, 95), Enum.Material.Rock, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_B", name), Vector3.new(18, 15, 16), CFrame.new(position + Vector3.new(8, 7.5, 12)), Color3.fromRGB(154, 127, 89), Enum.Material.Rock, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_C", name), Vector3.new(10, 8, 10), CFrame.new(position + Vector3.new(20, 4, -10)), Color3.fromRGB(178, 146, 101), Enum.Material.Rock, nil, nil)
end

function BuildUtils.CreateVerticalCylinder(
    parent: Instance,
    name: string,
    height: number,
    radius: number,
    position: Vector3,
    color: Color3,
    material: Enum.Material,
    transparency: number?
): Part
    return BuildUtils.CreatePart(
        parent,
        name,
        Vector3.new(height, radius * 2, radius * 2),
        CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
        color,
        material,
        Enum.PartType.Cylinder,
        transparency
    )
end

function BuildUtils.CreateSphere(
    parent: Instance,
    name: string,
    diameter: number,
    position: Vector3,
    color: Color3,
    material: Enum.Material,
    transparency: number?
): Part
    return BuildUtils.CreatePart(
        parent,
        name,
        Vector3.new(diameter, diameter, diameter),
        CFrame.new(position),
        color,
        material,
        Enum.PartType.Ball,
        transparency
    )
end

function BuildUtils.CreateModernTower(
    parent: Instance,
    name: string,
    position: Vector3,
    footprint: Vector2,
    height: number,
    bodyColor: Color3,
    windowColor: Color3
)
    local podiumHeight = math.max(14, math.floor(height * 0.18))
    local shaftHeight = height

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Podium", name),
        Vector3.new(footprint.X + 16, podiumHeight, footprint.Y + 16),
        CFrame.new(position + Vector3.new(0, podiumHeight * 0.5, 0)),
        Color3.fromRGB(238, 237, 233),
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Shaft", name),
        Vector3.new(footprint.X, shaftHeight, footprint.Y),
        CFrame.new(position + Vector3.new(0, podiumHeight + shaftHeight * 0.5, 0)),
        bodyColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_GlassFront", name),
        Vector3.new(math.max(8, footprint.X * 0.42), math.max(16, shaftHeight - 18), 1.2),
        CFrame.new(position + Vector3.new(0, podiumHeight + shaftHeight * 0.5 + 2, footprint.Y * -0.5 - 0.7)),
        windowColor,
        Enum.Material.Glass,
        nil,
        0.2
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_GlassBack", name),
        Vector3.new(math.max(8, footprint.X * 0.42), math.max(16, shaftHeight - 18), 1.2),
        CFrame.new(position + Vector3.new(0, podiumHeight + shaftHeight * 0.5 + 2, footprint.Y * 0.5 + 0.7)),
        windowColor,
        Enum.Material.Glass,
        nil,
        0.2
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Crown", name),
        Vector3.new(footprint.X - 6, 8, footprint.Y - 6),
        CFrame.new(position + Vector3.new(0, podiumHeight + shaftHeight + 4, 0)),
        Color3.fromRGB(233, 231, 225),
        Enum.Material.Marble,
        nil,
        nil
    )
end

function BuildUtils.CreateMinaret(parent: Instance, name: string, position: Vector3, height: number, bodyColor: Color3, accentColor: Color3)
    local baseHeight = math.max(16, math.floor(height * 0.18))
    local lowerHeight = math.max(24, math.floor(height * 0.34))
    local upperHeight = math.max(20, math.floor(height * 0.24))
    local capHeight = math.max(10, math.floor(height * 0.12))

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Base", name),
        Vector3.new(14, baseHeight, 14),
        CFrame.new(position + Vector3.new(0, baseHeight * 0.5, 0)),
        bodyColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreateVerticalCylinder(
        parent,
        string.format("%s_Lower", name),
        lowerHeight,
        4,
        position + Vector3.new(0, baseHeight + lowerHeight * 0.5, 0),
        bodyColor,
        Enum.Material.Marble,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_BalconyLower", name),
        Vector3.new(12, 2, 12),
        CFrame.new(position + Vector3.new(0, baseHeight + lowerHeight + 1, 0)),
        accentColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreateVerticalCylinder(
        parent,
        string.format("%s_Upper", name),
        upperHeight,
        2.6,
        position + Vector3.new(0, baseHeight + lowerHeight + 2 + upperHeight * 0.5, 0),
        bodyColor,
        Enum.Material.Marble,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_BalconyUpper", name),
        Vector3.new(9, 2, 9),
        CFrame.new(position + Vector3.new(0, baseHeight + lowerHeight + upperHeight + 3, 0)),
        accentColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreateVerticalCylinder(
        parent,
        string.format("%s_Cap", name),
        capHeight,
        1.7,
        position + Vector3.new(0, baseHeight + lowerHeight + upperHeight + 3 + capHeight * 0.5 + 1, 0),
        bodyColor,
        Enum.Material.Marble,
        nil
    )

    BuildUtils.CreateSphere(
        parent,
        string.format("%s_Dome", name),
        4.8,
        position + Vector3.new(0, baseHeight + lowerHeight + upperHeight + capHeight + 7, 0),
        accentColor,
        Enum.Material.SmoothPlastic,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Spire", name),
        Vector3.new(1, 8, 1),
        CFrame.new(position + Vector3.new(0, baseHeight + lowerHeight + upperHeight + capHeight + 12, 0)),
        Color3.fromRGB(205, 176, 108),
        Enum.Material.Metal,
        nil,
        nil
    )
end

function BuildUtils.CreateCourtyardCanopy(parent: Instance, name: string, position: Vector3, canopyColor: Color3, poleColor: Color3)
    BuildUtils.CreateVerticalCylinder(
        parent,
        string.format("%s_Pole", name),
        16,
        0.7,
        position + Vector3.new(0, 8, 0),
        poleColor,
        Enum.Material.Metal,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Canopy", name),
        Vector3.new(22, 1, 22),
        CFrame.new(position + Vector3.new(0, 16.5, 0)),
        canopyColor,
        Enum.Material.Fabric,
        nil,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Cap", name),
        Vector3.new(7, 1, 7),
        CFrame.new(position + Vector3.new(0, 17.3, 0)),
        Color3.fromRGB(243, 242, 238),
        Enum.Material.Marble,
        nil,
        nil
    )

    for index, offset in ipairs({
        Vector3.new(-8.5, 15.8, -8.5),
        Vector3.new(8.5, 15.8, -8.5),
        Vector3.new(-8.5, 15.8, 8.5),
        Vector3.new(8.5, 15.8, 8.5),
    }) do
        BuildUtils.CreateSphere(
            parent,
            string.format("%s_Tip_%d", name, index),
            2.2,
            position + offset,
            canopyColor,
            Enum.Material.SmoothPlastic,
            nil
        )
    end
end

return BuildUtils
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="24">
      <Properties>
        <string name="Name">ShopService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local Debris = game:GetService("Debris")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShopCatalog = require(Shared.Data.ShopCatalog)
local BattleLoadout = require(script.Parent.Modules.BattleLoadout)

local shopFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Shop")
local requestShopState = shopFolder:WaitForChild("RequestShopState") :: RemoteEvent
local promptGamePassPurchase = shopFolder:WaitForChild("PromptGamePassPurchase") :: RemoteEvent
local promptDeveloperProductPurchase = shopFolder:WaitForChild("PromptDeveloperProductPurchase") :: RemoteEvent
local equipSkin = shopFolder:WaitForChild("EquipSkin") :: RemoteEvent
local useUltimate = shopFolder:WaitForChild("UseUltimate") :: RemoteEvent
local shopStateEvent = shopFolder:WaitForChild("ShopState") :: RemoteEvent
local purchaseFeedback = shopFolder:WaitForChild("PurchaseFeedback") :: RemoteEvent
local grantCurrency = shopFolder:FindFirstChild("GrantCurrency")

if not grantCurrency then
    local bindable = Instance.new("BindableEvent")
    bindable.Name = "GrantCurrency"
    bindable.Parent = shopFolder
    grantCurrency = bindable
end

local profileStore = DataStoreService:GetDataStore("PlayerMonetization_v1")
local receiptStore = DataStoreService:GetDataStore("ProcessedReceipts_v1")

local playerProfiles: { [Player]: { EquippedSkin: string, UltimateCharges: number, KnowledgeTokens: number, SupportPoints: number } } = {}
local playerPassOwnership: { [Player]: { [string]: boolean } } = {}
local ultimateCooldowns: { [Player]: number } = {}

local gamePassByKey = {}
local gamePassByProductId = {}
local developerProductByKey = {}
local developerProductByProductId = {}

for _, item in ipairs(ShopCatalog.GamePasses) do
    gamePassByKey[item.Key] = item

    if item.ProductId > 0 then
        gamePassByProductId[item.ProductId] = item
    end
end

for _, item in ipairs(ShopCatalog.DeveloperProducts) do
    developerProductByKey[item.Key] = item

    if item.ProductId > 0 then
        developerProductByProductId[item.ProductId] = item
    end
end

local function buildDefaultProfile()
    return {
        EquippedSkin = "default",
        UltimateCharges = 0,
        KnowledgeTokens = 0,
        SupportPoints = 0,
    }
end

local function cloneProfile(source)
    return {
        EquippedSkin = source.EquippedSkin,
        UltimateCharges = source.UltimateCharges,
        KnowledgeTokens = source.KnowledgeTokens,
        SupportPoints = source.SupportPoints,
    }
end

local function sendFeedback(player: Player, text: string, tone: string?)
    purchaseFeedback:FireClient(player, {
        Text = text,
        Tone = tone or "info",
    })
end

local function getOwnedSkins(ownedPasses: { [string]: boolean }): { [string]: boolean }
    local ownedSkins = {
        default = true,
    }

    for skinId, skinDefinition in pairs(ShopCatalog.SkinDefinitions) do
        if skinDefinition.UnlockType == "GamePass" and ownedPasses[skinDefinition.UnlockKey] then
            ownedSkins[skinId] = true
        end
    end

    return ownedSkins
end

local function sanitizeEquippedSkin(profile, ownedPasses: { [string]: boolean })
    local ownedSkins = getOwnedSkins(ownedPasses)

    if not ownedSkins[profile.EquippedSkin] then
        profile.EquippedSkin = "default"
    end
end

local function applyPlayerAttributes(player: Player)
    local profile = playerProfiles[player] or buildDefaultProfile()
    local ownedPasses = playerPassOwnership[player] or {}

    sanitizeEquippedSkin(profile, ownedPasses)
    playerProfiles[player] = profile

    player:SetAttribute("EquippedBattleSkin", profile.EquippedSkin)
    player:SetAttribute("UltimateCharges", profile.UltimateCharges)
    player:SetAttribute("KnowledgeTokens", profile.KnowledgeTokens)
    player:SetAttribute("SupportPoints", profile.SupportPoints)
    player:SetAttribute("HasFounderSupport", ownedPasses.founder_support == true)
end

local function saveProfile(player: Player)
    local profile = playerProfiles[player]

    if not profile then
        return
    end

    local profileCopy = cloneProfile(profile)

    task.spawn(function()
        local success, errorMessage = pcall(function()
            profileStore:SetAsync(string.format("player_%d", player.UserId), profileCopy)
        end)

        if not success then
            warn(string.format("[ShopService] Failed to save profile for %s: %s", player.Name, tostring(errorMessage)))
        end
    end)
end

local function refreshPassOwnership(player: Player)
    local ownedPasses = {}

    for _, item in ipairs(ShopCatalog.GamePasses) do
        local owned = false

        if item.ProductId > 0 then
            local success, result = pcall(function()
                return MarketplaceService:UserOwnsGamePassAsync(player.UserId, item.ProductId)
            end)

            if success then
                owned = result
            end
        end

        ownedPasses[item.Key] = owned
    end

    playerPassOwnership[player] = ownedPasses
    applyPlayerAttributes(player)
end

local function listOwnedKeys(lookup: { [string]: boolean }): { string }
    local results = {}

    for key, isOwned in pairs(lookup) do
        if isOwned then
            table.insert(results, key)
        end
    end

    table.sort(results)

    return results
end

local function sendShopState(player: Player, statusText: string?)
    local profile = playerProfiles[player] or buildDefaultProfile()
    local ownedPasses = playerPassOwnership[player] or {}
    local ownedSkins = getOwnedSkins(ownedPasses)

    shopStateEvent:FireClient(player, {
        OwnedPassKeys = listOwnedKeys(ownedPasses),
        OwnedSkinIds = listOwnedKeys(ownedSkins),
        EquippedSkinId = profile.EquippedSkin,
        UltimateCharges = profile.UltimateCharges,
        KnowledgeTokens = profile.KnowledgeTokens,
        SupportPoints = profile.SupportPoints,
        StatusText = statusText or "",
    })
end

local function loadProfile(player: Player)
    local profile = buildDefaultProfile()

    local success, storedProfile = pcall(function()
        return profileStore:GetAsync(string.format("player_%d", player.UserId))
    end)

    if success and type(storedProfile) == "table" then
        if type(storedProfile.EquippedSkin) == "string" then
            profile.EquippedSkin = storedProfile.EquippedSkin
        end

        if type(storedProfile.UltimateCharges) == "number" then
            profile.UltimateCharges = storedProfile.UltimateCharges
        end

        if type(storedProfile.KnowledgeTokens) == "number" then
            profile.KnowledgeTokens = storedProfile.KnowledgeTokens
        end

        if type(storedProfile.SupportPoints) == "number" then
            profile.SupportPoints = storedProfile.SupportPoints
        end
    elseif not success then
        warn(string.format("[ShopService] Failed to load profile for %s: %s", player.Name, tostring(storedProfile)))
    end

    playerProfiles[player] = profile
    refreshPassOwnership(player)
    sendShopState(player, "Shop ready.")
end

local function grantDeveloperProduct(player: Player, product)
    local profile = playerProfiles[player]

    if not profile then
        return false
    end

    if product.Grants then
        if product.Grants.UltimateCharges then
            profile.UltimateCharges += product.Grants.UltimateCharges
        end

        if product.Grants.KnowledgeTokens then
            profile.KnowledgeTokens += product.Grants.KnowledgeTokens
        end

        if product.Grants.SupportPoints then
            profile.SupportPoints += product.Grants.SupportPoints
        end
    end

    applyPlayerAttributes(player)
    saveProfile(player)
    sendShopState(player, string.format("%s granted.", product.DisplayName))
    sendFeedback(player, string.format("Purchase complete: %s", product.DisplayName), "success")

    return true
end

local function grantKnowledgeTokens(player: Player, amount: number, reason: string)
    local profile = playerProfiles[player]

    if not profile or amount <= 0 then
        return
    end

    profile.KnowledgeTokens += amount
    applyPlayerAttributes(player)
    saveProfile(player)
    sendShopState(player, string.format("%s: +%d %s", reason, amount, ShopCatalog.CurrencyName or "Knowledge Tokens"))
end

local function promptPass(player: Player, key: string)
    local item = gamePassByKey[key]

    if not item then
        sendFeedback(player, "That pass is not configured.", "warning")
        return
    end

    if item.ProductId <= 0 then
        sendFeedback(player, string.format("Create the %s pass in Creator Hub and paste the ProductId first.", item.DisplayName), "warning")
        return
    end

    MarketplaceService:PromptGamePassPurchase(player, item.ProductId)
end

local function promptProduct(player: Player, key: string)
    local item = developerProductByKey[key]

    if not item then
        sendFeedback(player, "That product is not configured.", "warning")
        return
    end

    if item.ProductId <= 0 then
        sendFeedback(player, string.format("Create the %s developer product in Creator Hub and paste the ProductId first.", item.DisplayName), "warning")
        return
    end

    MarketplaceService:PromptProductPurchase(player, item.ProductId)
end

local function tryEquipSkin(player: Player, skinId: string)
    local profile = playerProfiles[player]
    local ownedPasses = playerPassOwnership[player] or {}

    if not profile then
        return
    end

    local ownedSkins = getOwnedSkins(ownedPasses)

    if not ownedSkins[skinId] then
        sendFeedback(player, "You do not own that skin yet.", "warning")
        return
    end

    profile.EquippedSkin = skinId
    applyPlayerAttributes(player)
    saveProfile(player)
    BattleLoadout.ApplyCurrentSkin(player)
    sendShopState(player, string.format("Equipped %s.", ShopCatalog.SkinDefinitions[skinId].DisplayName))
    sendFeedback(player, string.format("Equipped %s.", ShopCatalog.SkinDefinitions[skinId].DisplayName), "success")
end

local function useUltimateCharge(player: Player)
    local profile = playerProfiles[player]

    if not profile then
        return
    end

    if player:GetAttribute("InBattle") ~= true then
        sendFeedback(player, "Ultimates can only be used during a battle round.", "warning")
        return
    end

    if profile.UltimateCharges <= 0 then
        sendFeedback(player, "No ultimate charges left. Buy more in the shop.", "warning")
        return
    end

    local now = os.clock()
    local lastUse = ultimateCooldowns[player]

    if lastUse and now - lastUse < 18 then
        sendFeedback(player, "Your ultimate is recharging.", "warning")
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local currentScenarioId = player:GetAttribute("CurrentScenarioId")
    local currentBattleTeam = player:GetAttribute("CurrentBattleTeam")

    if not character or not root or not root:IsA("BasePart") or typeof(currentScenarioId) ~= "string" or typeof(currentBattleTeam) ~= "string" then
        sendFeedback(player, "Your ultimate could not be activated right now.", "warning")
        return
    end

    profile.UltimateCharges -= 1
    ultimateCooldowns[player] = now
    applyPlayerAttributes(player)
    saveProfile(player)

    local pulse = Instance.new("Part")
    pulse.Name = "UltimatePulse"
    pulse.Shape = Enum.PartType.Ball
    pulse.Material = Enum.Material.Neon
    pulse.Color = Color3.fromRGB(230, 199, 121)
    pulse.Transparency = 0.35
    pulse.Anchored = true
    pulse.CanCollide = false
    pulse.CanTouch = false
    pulse.CanQuery = false
    pulse.Size = Vector3.new(2, 2, 2)
    pulse.CFrame = CFrame.new(root.Position)
    pulse.Parent = Workspace

    local tween = TweenService:Create(
        pulse,
        TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = Vector3.new(44, 44, 44),
            Transparency = 1,
        }
    )
    tween:Play()
    Debris:AddItem(pulse, 0.6)

    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("Humanoid") and descendant.Health > 0 then
            local targetModel = descendant.Parent

            if targetModel and targetModel:IsA("Model") and targetModel ~= character then
                local targetScenarioId = targetModel:GetAttribute("ScenarioId")
                local targetTeamId = targetModel:GetAttribute("BattleTeam")
                local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")

                if targetScenarioId == currentScenarioId and targetTeamId ~= currentBattleTeam and targetRoot and targetRoot:IsA("BasePart") then
                    local offset = targetRoot.Position - root.Position
                    local distance = offset.Magnitude

                    if distance <= 22 then
                        descendant:TakeDamage(30)

                        if distance > 0.1 then
                            targetRoot.AssemblyLinearVelocity += offset.Unit * 52
                        end
                    end
                end
            end
        end
    end

    sendShopState(player, "Ultimate activated.")
    sendFeedback(player, "Ultimate activated.", "success")
end

requestShopState.OnServerEvent:Connect(function(player: Player)
    if not playerProfiles[player] then
        loadProfile(player)
        return
    end

    sendShopState(player)
end)

promptGamePassPurchase.OnServerEvent:Connect(function(player: Player, key: string)
    if typeof(key) == "string" then
        promptPass(player, key)
    end
end)

promptDeveloperProductPurchase.OnServerEvent:Connect(function(player: Player, key: string)
    if typeof(key) == "string" then
        promptProduct(player, key)
    end
end)

equipSkin.OnServerEvent:Connect(function(player: Player, skinId: string)
    if typeof(skinId) == "string" then
        tryEquipSkin(player, skinId)
    end
end)

useUltimate.OnServerEvent:Connect(function(player: Player)
    useUltimateCharge(player)
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
    if not wasPurchased then
        return
    end

    local item = gamePassByProductId[gamePassId]

    if not item then
        return
    end

    refreshPassOwnership(player)
    sendShopState(player, string.format("Unlocked %s.", item.DisplayName))
    sendFeedback(player, string.format("Unlocked %s.", item.DisplayName), "success")
end)

MarketplaceService.ProcessReceipt = function(receiptInfo)
    local item = developerProductByProductId[receiptInfo.ProductId]

    if not item then
        warn(string.format("[ShopService] No receipt handler for product id %s", tostring(receiptInfo.ProductId)))
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)

    if not player then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    local receiptKey = string.format("receipt_%s", tostring(receiptInfo.PurchaseId))
    local alreadyProcessed = false

    local success, errorMessage = pcall(function()
        receiptStore:UpdateAsync(receiptKey, function(existing)
            if existing then
                alreadyProcessed = true
                return existing
            end

            return {
                ProductId = receiptInfo.ProductId,
                PlayerId = receiptInfo.PlayerId,
                ProcessedAt = os.time(),
            }
        end)
    end)

    if not success then
        warn(string.format("[ShopService] Failed to lock receipt %s: %s", tostring(receiptInfo.PurchaseId), tostring(errorMessage)))
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    if alreadyProcessed then
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end

    local granted = grantDeveloperProduct(player, item)

    if granted then
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end

    return Enum.ProductPurchaseDecision.NotProcessedYet
end

if grantCurrency and grantCurrency:IsA("BindableEvent") then
    grantCurrency.Event:Connect(function(player: Player, amount: number, reason: string?)
        grantKnowledgeTokens(player, amount, reason or "Reward")
    end)
end

Players.PlayerAdded:Connect(function(player)
    loadProfile(player)
end)

Players.PlayerRemoving:Connect(function(player)
    saveProfile(player)
    playerProfiles[player] = nil
    playerPassOwnership[player] = nil
    ultimateCooldowns[player] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(function()
        loadProfile(player)
    end)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="25">
      <Properties>
        <string name="Name">StoryService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Chat = game:GetService("Chat")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CompanionStories = require(Shared.Data.CompanionStories)
local TravelRoute = require(Shared.Data.TravelRoute)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local shopFolder = remotesFolder:WaitForChild("Shop")
local storyFolder = remotesFolder:WaitForChild("Story")
local showStoryDialogue = storyFolder:WaitForChild("ShowStoryDialogue") :: RemoteEvent
local updateStoryMission = storyFolder:WaitForChild("UpdateStoryMission") :: RemoteEvent
local clearStoryMission = storyFolder:WaitForChild("ClearStoryMission") :: RemoteEvent
local requestStartStory = storyFolder:WaitForChild("RequestStartStory") :: RemoteEvent

local STORY_WORLD_NAME = "GeneratedStories"
local LINE_DURATION_SECONDS = 2.4
local promptConnections = {}
local activeStories = {}
local storyById = {}

for _, story in ipairs(CompanionStories) do
    storyById[story.Id] = story
end

local function getGrantCurrencyBindable()
    local bindable = shopFolder:FindFirstChild("GrantCurrency")

    if bindable and bindable:IsA("BindableEvent") then
        return bindable
    end

    return nil
end

local function awardKnowledgeTokens(player: Player, amount: number, reason: string)
    if amount <= 0 then
        return
    end

    local bindable = getGrantCurrencyBindable()

    if bindable then
        bindable:Fire(player, amount, reason)
        return
    end

    local currentTokens = player:GetAttribute("KnowledgeTokens")

    if type(currentTokens) ~= "number" then
        currentTokens = 0
    end

    player:SetAttribute("KnowledgeTokens", currentTokens + amount)
end

local function getStoryWorld(): Folder?
    local folder = Workspace:FindFirstChild(STORY_WORLD_NAME)

    if folder and folder:IsA("Folder") then
        return folder
    end

    return nil
end

local function getStoryZone(storyId: string): Folder?
    local worldFolder = getStoryWorld()
    local zone = worldFolder and worldFolder:FindFirstChild(storyId)

    if zone and zone:IsA("Folder") then
        return zone
    end

    return nil
end

local function getAnchor(zone: Folder, anchorName: string): BasePart?
    local anchors = zone:FindFirstChild("Anchors")
    local anchor = anchors and anchors:FindFirstChild(anchorName)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function getHubAnchor(): BasePart?
    local hubFolder = Workspace:FindFirstChild(TravelRoute.WorldFolderName)
    local teleportFolder = hubFolder and hubFolder:FindFirstChild("TeleportPoints")
    local anchor = teleportFolder and teleportFolder:FindFirstChild(TravelRoute.StartDestinationId)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function getCharacter(player: Player): Model?
    if player.Character then
        return player.Character
    end

    local ok, character = pcall(function()
        return player.CharacterAdded:Wait()
    end)

    if ok then
        return character
    end

    return nil
end

local function getReadyCharacter(player: Player, timeoutSeconds: number): Model?
    local deadline = os.clock() + timeoutSeconds

    while os.clock() < deadline do
        local character = player.Character

        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local root = character:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
                return character
            end
        end

        task.wait(0.15)
    end

    return nil
end

local function teleportPlayerToAnchor(player: Player, anchor: BasePart)
    local character = getCharacter(player)

    if character then
        character:PivotTo(anchor.CFrame * CFrame.new(0, 4, 0))
    end
end

local function findNpcHead(zone: Folder, npcName: string): BasePart?
    local stations = zone:FindFirstChild("Stations")

    if not stations then
        return nil
    end

    for _, station in ipairs(stations:GetDescendants()) do
        if station:IsA("Model") and station.Name == npcName then
            local head = station:FindFirstChild("Head")

            if head and head:IsA("BasePart") then
                return head
            end
        end
    end

    return nil
end

local function speakDialogueBubble(zone: Folder, npcName: string, dialogueLines)
    local head = findNpcHead(zone, npcName)

    if not head then
        return
    end

    task.spawn(function()
        for _, line in ipairs(dialogueLines) do
            local text = line.Text or line

            if type(text) == "string" then
                Chat:Chat(head, text, Enum.ChatColor.White)
                task.wait(LINE_DURATION_SECONDS)
            end
        end
    end)
end

local function fireDialogue(player: Player, story, title: string, dialogueLines)
    showStoryDialogue:FireClient(player, {
        StoryName = story.DisplayName,
        Title = title,
        Lines = dialogueLines,
        AccentColor = story.AccentColor,
    })
end

local function getCurrentStep(state)
    return state.Story.ScenarioSteps[state.StepIndex]
end

local function updateMissionForPlayer(player: Player)
    local state = activeStories[player]

    if not state then
        clearStoryMission:FireClient(player)
        return
    end

    local step = getCurrentStep(state)

    if not step then
        clearStoryMission:FireClient(player)
        return
    end

    updateStoryMission:FireClient(player, {
        StoryName = state.Story.DisplayName,
        StepLabel = string.format("Step %d of %d", state.StepIndex, #state.Story.ScenarioSteps),
        Objective = step.Objective,
        LocationName = step.LocationName,
    })
end

local function clearStoryState(player: Player)
    activeStories[player] = nil
    player:SetAttribute("InStory", false)
    player:SetAttribute("CurrentStoryId", nil)
    player:SetAttribute("CurrentStoryStepIndex", nil)
    clearStoryMission:FireClient(player)
end

local function returnPlayerToHub(player: Player)
    local hubAnchor = getHubAnchor()

    if not hubAnchor then
        return
    end

    teleportPlayerToAnchor(player, hubAnchor)
end

local function completeStory(player: Player)
    local state = activeStories[player]

    if not state then
        return
    end

    fireDialogue(player, state.Story, state.Story.Completion.Title, state.Story.Completion.Lines)
    awardKnowledgeTokens(player, state.Story.RewardTokens or 0, string.format("%s story complete", state.Story.DisplayName))

    local returnDelay = math.max(5.5, #state.Story.Completion.Lines * LINE_DURATION_SECONDS + 0.7)

    task.delay(returnDelay, function()
        if activeStories[player] ~= state then
            return
        end

        clearStoryState(player)
        returnPlayerToHub(player)
    end)
end

local function triggerStoryStep(player: Player, storyId: string, stepIndex: number)
    local state = activeStories[player]

    if not state or state.Story.Id ~= storyId or state.StepIndex ~= stepIndex or state.StepLocked == true then
        return
    end

    local step = state.Story.ScenarioSteps[stepIndex]

    if not step then
        return
    end

    state.StepLocked = true

    speakDialogueBubble(state.Zone, step.NpcName, step.Dialogue)
    fireDialogue(player, state.Story, step.Title, step.Dialogue)

    local holdDuration = math.max(3.2, #step.Dialogue * LINE_DURATION_SECONDS + 0.7)

    task.delay(holdDuration, function()
        if activeStories[player] ~= state then
            return
        end

        if state.StepIndex ~= stepIndex then
            return
        end

        if stepIndex >= #state.Story.ScenarioSteps then
            state.StepLocked = false
            completeStory(player)
            return
        end

        state.StepIndex += 1
        state.StepLocked = false
        player:SetAttribute("CurrentStoryStepIndex", state.StepIndex)
        updateMissionForPlayer(player)
    end)
end

local function startStory(player: Player, storyId: string)
    local story = storyById[storyId]

    if not story then
        return
    end

    if player:GetAttribute("InBattle") == true then
        return
    end

    local zone = getStoryZone(storyId)
    local entryAnchor = zone and getAnchor(zone, "Entry")

    if not zone or not entryAnchor then
        return
    end

    local state = {
        Story = story,
        Zone = zone,
        StepIndex = 1,
    }

    activeStories[player] = state
    player:SetAttribute("InStory", true)
    player:SetAttribute("CurrentStoryId", story.Id)
    player:SetAttribute("CurrentStoryStepIndex", 1)

    teleportPlayerToAnchor(player, entryAnchor)
    fireDialogue(player, story, "Story Start", story.Introduction)
    updateMissionForPlayer(player)
end

local function exitStory(player: Player)
    if not activeStories[player] then
        return
    end

    clearStoryState(player)
    returnPlayerToHub(player)
end

requestStartStory.OnServerEvent:Connect(function(player: Player, storyId: string)
    if typeof(storyId) == "string" then
        startStory(player, storyId)
    end
end)

local function connectPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    local action = prompt:GetAttribute("PromptAction")

    if action ~= "StartStory" and action ~= "StoryStep" and action ~= "ReturnToHub" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        if action == "StartStory" then
            local storyId = prompt:GetAttribute("StoryId")

            if typeof(storyId) == "string" then
                startStory(player, storyId)
            end
        elseif action == "StoryStep" then
            local storyId = prompt:GetAttribute("StoryId")
            local stepIndex = prompt:GetAttribute("StepIndex")

            if typeof(storyId) == "string" and type(stepIndex) == "number" then
                triggerStoryStep(player, storyId, stepIndex)
            end
        elseif action == "ReturnToHub" then
            exitStory(player)
        end
    end)
end

local function connectPromptsIn(instance: Instance)
    for _, descendant in ipairs(instance:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end

    instance.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end)
end

task.spawn(function()
    local hubFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if hubFolder then
        connectPromptsIn(hubFolder)
    end
end)

task.spawn(function()
    local storyWorld = Workspace:WaitForChild(STORY_WORLD_NAME, 10)

    if storyWorld then
        connectPromptsIn(storyWorld)
    end
end)

local function handleCharacterAdded(player: Player, _character: Model)
    local state = activeStories[player]

    if not state then
        return
    end

    task.delay(0.4, function()
        if activeStories[player] ~= state then
            return
        end

        local anchor = getAnchor(state.Zone, string.format("Step_%d", state.StepIndex)) or getAnchor(state.Zone, "Entry")

        if anchor then
            teleportPlayerToAnchor(player, anchor)
        end
    end)
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(character)
        handleCharacterAdded(player, character)
    end)
end)

for _, player in ipairs(Players:GetPlayers()) do
    player.CharacterAdded:Connect(function(character)
        handleCharacterAdded(player, character)
    end)
end

Players.PlayerRemoving:Connect(function(player)
    activeStories[player] = nil
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="26">
      <Properties>
        <string name="Name">StoryWorldBuilder</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CompanionStories = require(Shared.Data.CompanionStories)
local BuildUtils = require(script.Parent.Modules.BuildUtils)

local STORY_FOLDER_NAME = "GeneratedStories"
local BASE_STONE = Color3.fromRGB(223, 214, 196)
local COURT_WHITE = Color3.fromRGB(239, 234, 224)
local SAND_ACCENT = Color3.fromRGB(204, 182, 137)
local GARDEN_GREEN = Color3.fromRGB(93, 133, 87)

local STORY_CENTERS = {
    bilal_ibn_rabah = Vector3.new(840, 4, -320),
    musab_ibn_umayr = Vector3.new(840, 4, 80),
    nusaybah_bint_kaab = Vector3.new(840, 4, 500),
    umar_ibn_al_khattab = Vector3.new(840, 4, 900),
}

local function createNpc(parent: Instance, name: string, cframe: CFrame, outfitColor: Color3, accentColor: Color3): Model
    local model = Instance.new("Model")
    model.Name = name
    model.Parent = parent

    local root = BuildUtils.CreatePart(model, "HumanoidRootPart", Vector3.new(2, 2, 1), cframe, Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    root.CanCollide = false

    BuildUtils.CreatePart(model, "Torso", Vector3.new(3, 4, 2), cframe * CFrame.new(0, 3, 0), outfitColor, Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(model, "Head", Vector3.new(2, 2, 2), cframe * CFrame.new(0, 6, 0), Color3.fromRGB(229, 201, 171), Enum.Material.SmoothPlastic, nil, nil)
    BuildUtils.CreatePart(model, "HeadWrap", Vector3.new(2.3, 1.1, 2.3), cframe * CFrame.new(0, 6.65, 0), accentColor, Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(model, "LeftArm", Vector3.new(1.2, 3.5, 1.2), cframe * CFrame.new(-2.05, 3.1, 0), outfitColor, Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(model, "RightArm", Vector3.new(1.2, 3.5, 1.2), cframe * CFrame.new(2.05, 3.1, 0), outfitColor, Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(model, "LeftLeg", Vector3.new(1.2, 3.6, 1.2), cframe * CFrame.new(-0.8, 0.6, 0), accentColor, Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(model, "RightLeg", Vector3.new(1.2, 3.6, 1.2), cframe * CFrame.new(0.8, 0.6, 0), accentColor, Enum.Material.Fabric, nil, nil)

    model.PrimaryPart = root

    return model
end

local function createZoneBounds(parent: Instance, center: Vector3, size: Vector3)
    local thickness = 10
    local wallHeight = 64

    BuildUtils.CreatePart(parent, "SafetyPlate", Vector3.new(size.X + 100, 10, size.Z + 100), CFrame.new(center + Vector3.new(0, -8, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(parent, "NorthBarrier", Vector3.new(size.X + 100, wallHeight, thickness), CFrame.new(center + Vector3.new(0, 22, size.Z * -0.5 - 50)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(parent, "SouthBarrier", Vector3.new(size.X + 100, wallHeight, thickness), CFrame.new(center + Vector3.new(0, 22, size.Z * 0.5 + 50)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(parent, "WestBarrier", Vector3.new(thickness, wallHeight, size.Z + 100), CFrame.new(center + Vector3.new(size.X * -0.5 - 50, 22, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(parent, "EastBarrier", Vector3.new(thickness, wallHeight, size.Z + 100), CFrame.new(center + Vector3.new(size.X * 0.5 + 50, 22, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
end

local function createStepStation(zone: Folder, story, step, stepIndex: number, position: Vector3)
    local stations = zone:FindFirstChild("Stations") or BuildUtils.CreateFolder(zone, "Stations")
    local prompts = zone:FindFirstChild("Prompts") or BuildUtils.CreateFolder(zone, "Prompts")
    local anchors = zone:FindFirstChild("Anchors") or BuildUtils.CreateFolder(zone, "Anchors")

    local stationFolder = BuildUtils.CreateFolder(stations, step.Id)
    BuildUtils.CreatePart(stationFolder, "Court", Vector3.new(72, 1, 72), CFrame.new(position + Vector3.new(0, 4.55, 0)), COURT_WHITE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(stationFolder, "Trim", Vector3.new(84, 2, 84), CFrame.new(position + Vector3.new(0, 1, 0)), BASE_STONE, Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreateWallSign(stationFolder, "StorySign", position + Vector3.new(0, 0, -26), Vector3.new(52, 10, 2), step.Title, step.LocationName, story.AccentColor, nil)

    local npc = createNpc(stationFolder, step.NpcName, CFrame.new(position + Vector3.new(0, 0, 12)) * CFrame.Angles(0, math.rad(180), 0), story.AccentColor, Color3.fromRGB(62, 58, 48))

    local promptBase = BuildUtils.CreatePart(prompts, string.format("%sPromptBase", step.Id), Vector3.new(8, 1, 8), CFrame.new(position + Vector3.new(0, 5, 4)), Color3.fromRGB(201, 182, 140), Enum.Material.Sandstone, nil, nil)
    BuildUtils.AttachPrompt(promptBase, step.PromptText, step.NpcName, {
        PromptAction = "StoryStep",
        StoryId = story.Id,
        StepIndex = stepIndex,
    })

    local anchor = BuildUtils.CreateTeleportAnchor(anchors, string.format("Step_%d", stepIndex), position + Vector3.new(0, 0, 24))
    anchor:SetAttribute("StoryId", story.Id)

    if story.Id == "bilal_ibn_rabah" then
        BuildUtils.CreateLantern(stationFolder, string.format("%sLantern", step.Id), position + Vector3.new(-22, 0, 16), Color3.fromRGB(182, 152, 87))
        BuildUtils.CreateHouse(stationFolder, string.format("%sHouse", step.Id), position + Vector3.new(22, 0, -6), Vector3.new(34, 28, 28), SAND_ACCENT)
    elseif story.Id == "musab_ibn_umayr" then
        BuildUtils.CreatePlanter(stationFolder, string.format("%sPlanter", step.Id), position + Vector3.new(-18, 0, 20), Vector3.new(26, 3, 18))
        BuildUtils.CreatePalmTree(stationFolder, string.format("%sPalm", step.Id), position + Vector3.new(-18, 0, 20))
        BuildUtils.CreateBanner(stationFolder, string.format("%sBanner", step.Id), position + Vector3.new(24, 0, 16), Color3.fromRGB(118, 96, 55))
    elseif story.Id == "nusaybah_bint_kaab" then
        BuildUtils.CreateLantern(stationFolder, string.format("%sLantern", step.Id), position + Vector3.new(22, 0, 20), Color3.fromRGB(170, 146, 79))
        BuildUtils.CreatePart(stationFolder, string.format("%sCover", step.Id), Vector3.new(18, 10, 14), CFrame.new(position + Vector3.new(-24, 5, 0)), Color3.fromRGB(199, 187, 168), Enum.Material.Fabric, nil, nil)
        BuildUtils.CreateBanner(stationFolder, string.format("%sBanner", step.Id), position + Vector3.new(-18, 0, 18), GARDEN_GREEN)
    elseif story.Id == "umar_ibn_al_khattab" then
        BuildUtils.CreatePart(stationFolder, string.format("%sArchLeft", step.Id), Vector3.new(6, 24, 6), CFrame.new(position + Vector3.new(-18, 12, -4)), BASE_STONE, Enum.Material.Marble, nil, nil)
        BuildUtils.CreatePart(stationFolder, string.format("%sArchRight", step.Id), Vector3.new(6, 24, 6), CFrame.new(position + Vector3.new(18, 12, -4)), BASE_STONE, Enum.Material.Marble, nil, nil)
        BuildUtils.CreatePart(stationFolder, string.format("%sArchTop", step.Id), Vector3.new(42, 6, 7), CFrame.new(position + Vector3.new(0, 23, -4)), BASE_STONE, Enum.Material.Marble, nil, nil)
    end

    return npc
end

local function buildStoryZone(parent: Instance, story, center: Vector3)
    local zone = BuildUtils.CreateFolder(parent, story.Id)
    zone:SetAttribute("StoryId", story.Id)

    local zoneSize = Vector3.new(340, 2, 260)
    createZoneBounds(zone, center, zoneSize)

    BuildUtils.CreatePart(zone, "BaseFloor", Vector3.new(320, 4, 240), CFrame.new(center + Vector3.new(0, 2, 0)), BASE_STONE, Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(zone, "InnerCourt", Vector3.new(236, 1, 168), CFrame.new(center + Vector3.new(0, 4.55, 0)), COURT_WHITE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(zone, "EntryPath", Vector3.new(32, 1, 100), CFrame.new(center + Vector3.new(0, 4.65, 74)), Color3.fromRGB(217, 206, 182), Enum.Material.Marble, nil, nil)
    BuildUtils.CreateWallSign(zone, "TitleBoard", center + Vector3.new(0, 0, 104), Vector3.new(78, 12, 2.5), story.DisplayName, story.Summary, story.AccentColor, nil)

    local anchors = BuildUtils.CreateFolder(zone, "Anchors")
    local entryAnchor = BuildUtils.CreateTeleportAnchor(anchors, "Entry", center + Vector3.new(0, 0, 88))
    entryAnchor:SetAttribute("StoryId", story.Id)

    local exitBoard = BuildUtils.CreateBoardSign(
        zone,
        "ReturnBoard",
        center + Vector3.new(-116, 0, 78),
        "Return To Hub",
        "Leave this sahabi playthrough and go back to the main courtyard.",
        Color3.fromRGB(72, 94, 71),
        {
            ActionText = "Return",
            ObjectText = "Hub Exit",
            Attributes = {
                PromptAction = "ReturnToHub",
                StoryId = story.Id,
            },
        }
    )
    exitBoard.Orientation = Vector3.new(0, 180, 0)

    local stepPositions = {
        center + Vector3.new(-86, 0, 18),
        center + Vector3.new(86, 0, 18),
        center + Vector3.new(-86, 0, -84),
        center + Vector3.new(86, 0, -84),
    }

    for index, step in ipairs(story.ScenarioSteps) do
        createStepStation(zone, story, step, index, stepPositions[index])
    end

    if story.Id == "bilal_ibn_rabah" then
        BuildUtils.CreateHouse(zone, "BilalHome", center + Vector3.new(0, 0, -120), Vector3.new(48, 26, 34), SAND_ACCENT)
        BuildUtils.CreateLantern(zone, "BilalLanternA", center + Vector3.new(-136, 0, 70), Color3.fromRGB(174, 147, 80))
        BuildUtils.CreateLantern(zone, "BilalLanternB", center + Vector3.new(136, 0, 70), Color3.fromRGB(174, 147, 80))
    elseif story.Id == "musab_ibn_umayr" then
        BuildUtils.CreateHouse(zone, "MusabHouseA", center + Vector3.new(-122, 0, -130), Vector3.new(42, 24, 30), Color3.fromRGB(197, 183, 150))
        BuildUtils.CreateHouse(zone, "MusabHouseB", center + Vector3.new(126, 0, -128), Vector3.new(42, 24, 30), Color3.fromRGB(197, 183, 150))
        BuildUtils.CreatePlanter(zone, "MusabGarden", center + Vector3.new(0, 0, -124), Vector3.new(58, 3, 24))
    elseif story.Id == "nusaybah_bint_kaab" then
        BuildUtils.CreatePalmTree(zone, "NusaybahPalmA", center + Vector3.new(-128, 0, -122))
        BuildUtils.CreatePalmTree(zone, "NusaybahPalmB", center + Vector3.new(126, 0, -120))
        BuildUtils.CreatePart(zone, "NusaybahLine", Vector3.new(180, 10, 18), CFrame.new(center + Vector3.new(0, 5, -132)), Color3.fromRGB(160, 142, 110), Enum.Material.Sandstone, nil, nil)
    elseif story.Id == "umar_ibn_al_khattab" then
        BuildUtils.CreatePart(zone, "JusticeHall", Vector3.new(96, 28, 48), CFrame.new(center + Vector3.new(0, 14, -126)), Color3.fromRGB(216, 212, 204), Enum.Material.Marble, nil, nil)
        BuildUtils.CreatePart(zone, "JusticeHallRoof", Vector3.new(108, 4, 60), CFrame.new(center + Vector3.new(0, 30, -126)), Color3.fromRGB(197, 190, 176), Enum.Material.Marble, nil, nil)
    end
end

local existingFolder = Workspace:FindFirstChild(STORY_FOLDER_NAME)

if existingFolder and existingFolder:GetAttribute("GeneratedBy") == "StoryWorldBuilder" then
    existingFolder:Destroy()
end

local storyFolder = Instance.new("Folder")
storyFolder.Name = STORY_FOLDER_NAME
storyFolder:SetAttribute("GeneratedBy", "StoryWorldBuilder")
storyFolder.Parent = Workspace

for _, story in ipairs(CompanionStories) do
    local center = STORY_CENTERS[story.Id]

    if center then
        buildStoryZone(storyFolder, story, center)
    end
end
]]></string>
      </Properties>
    </Item>
