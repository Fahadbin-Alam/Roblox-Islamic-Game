        GameplayNote = "The crowd is made of generic, blank-faced townspeople. The words are quoted from the hadith, not voiced.",
    },
    {
        Id = "persecution",
        Number = 9,
        Era = "Makkah",
        When = "613-615 CE",
        Title = "Ahad, Ahad: Patience Under Persecution",
        Site = "makkah_valley",
        People = {
            { Name = "Bilal ibn Rabah", Role = "An Abyssinian man enslaved in Makkah" },
            { Name = "Umayyah ibn Khalaf", Role = "His master, who tortured him" },
            { Name = "Sumayyah bint Khayyat", Role = "The first martyr of Islam" },
            { Name = "Yasir and Ammar", Role = "Her husband and son" },
            { Name = "Abu Bakr al-Siddiq", Role = "Freed Bilal and others" },
