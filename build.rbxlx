sceneReference.TextSize = 13
sceneReference.TextTransparency = 1
sceneReference.TextWrapped = true
sceneReference.TextXAlignment = Enum.TextXAlignment.Left
sceneReference.Parent = cinematicBottom

local sceneCounter = Instance.new("TextLabel")
sceneCounter.BackgroundTransparency = 1
sceneCounter.Position = UDim2.new(0, 38, 1, -20)
sceneCounter.Size = UDim2.new(1, -60, 0, 20)
sceneCounter.Font = Enum.Font.GothamMedium
sceneCounter.Text = ""
sceneCounter.TextColor3 = Color3.fromRGB(174, 166, 148)
sceneCounter.TextSize = 14
sceneCounter.TextXAlignment = Enum.TextXAlignment.Left
sceneCounter.Parent = cinematicBottom

local toastToken = 0
local cutsceneToken = 0

local function smoothStep(alpha: number): number
    local clamped = math.clamp(alpha, 0, 1)
    return clamped * clamped * (3 - 2 * clamped)
end

local function setCoreGuiVisibility(isVisible: boolean)
    for _, coreGuiType in ipairs({
        Enum.CoreGuiType.Backpack,
        Enum.CoreGuiType.Chat,
        Enum.CoreGuiType.PlayerList,
        Enum.CoreGuiType.Health,
    }) do
        pcall(function()
            StarterGui:SetCoreGuiEnabled(coreGuiType, isVisible)
        end)
    end

    pcall(function()
        StarterGui:SetCore("TopbarEnabled", isVisible)
    end)
end

local function setCutscenePostProcessing(isEnabled: boolean)
    cutsceneBlur.Enabled = true
    TweenService:Create(cutsceneBlur, TweenInfo.new(isEnabled and 0.32 or 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = isEnabled and 10 or 0,
    }):Play()

    cutsceneColor.Enabled = true
    TweenService:Create(cutsceneColor, TweenInfo.new(isEnabled and 0.32 or 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Brightness = isEnabled and -0.03 or 0,
        Contrast = isEnabled and 0.12 or 0,
        Saturation = isEnabled and -0.08 or 0,
    }):Play()

    if not isEnabled then
        task.delay(0.26, function()
            if cutsceneToken == 0 then
                cutsceneColor.Enabled = false
                cutsceneBlur.Enabled = false
            end
        end)
    end
end

local function showToast(text: string, duration: number)
    toastToken += 1
    local currentToken = toastToken

    toast.Text = text
    toast.Visible = true
    toast.Position = UDim2.new(0.5, 0, 0, -80)

    TweenService:Create(toast, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0, 18),
    }):Play()

    task.delay(duration, function()
        if currentToken ~= toastToken then
            return
        end

        local tween = TweenService:Create(toast, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, 0, 0, -80),
        })
        tween:Play()
        tween.Completed:Wait()

        if currentToken == toastToken then
            toast.Visible = false
        end
    end)
end

local function restoreCamera(cameraState)
    local camera = Workspace.CurrentCamera

    if not camera then
        return
    end

    cutsceneToken = 0
    setCoreGuiVisibility(true)
    setCutscenePostProcessing(false)
    camera.CameraType = Enum.CameraType.Custom
    camera.FieldOfView = cameraState.FieldOfView or 70

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        camera.CameraSubject = humanoid
    end
end

local function getKindLabel(kind: string?): string
    if kind == "Briefing" then
        return "Cinematic Battlefield Briefing"
    end

    return "Cinematic Historical Reenactment"
end

local function tweenCutsceneFrameIn()
    cutsceneFrame.BackgroundTransparency = 1
    TweenService:Create(cutsceneFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.76,
    }):Play()
end

local function tweenCutsceneFrameOut()
    local tween = TweenService:Create(cutsceneFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        BackgroundTransparency = 1,
    })
    tween:Play()
    tween.Completed:Wait()
end

local function resolveCameraPosition(desiredPosition: Vector3, lookTarget: Vector3): Vector3
    local rayDirection = desiredPosition - lookTarget

    if rayDirection.Magnitude <= 0.01 then
        return desiredPosition
    end

    local origin = lookTarget + rayDirection.Unit * 2
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local ignored = {}
    local character = player.Character

    if character then
        table.insert(ignored, character)
    end

    params.FilterDescendantsInstances = ignored

    local result = Workspace:Raycast(origin, desiredPosition - origin, params)

    if result then
        return result.Position + result.Normal * 2.2
    end

    return desiredPosition
end

local function moveCameraThroughScene(camera: Camera, scene, duration: number, token: number)
    local cframe = scene.CameraCFrame

    if not cframe then
        task.wait(duration)
        return
    end

    local targetFieldOfView = scene.FieldOfView or 66
    local baseLookTarget = cframe.Position + cframe.LookVector * 120
    local safeBasePosition = resolveCameraPosition(cframe.Position, baseLookTarget)
    local safeCFrame = CFrame.lookAt(safeBasePosition, baseLookTarget)
    local tweenDuration = math.min(1.9, math.max(0.6, duration * 0.34))
    local tween = TweenService:Create(camera, TweenInfo.new(tweenDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        CFrame = safeCFrame,
        FieldOfView = targetFieldOfView,
    })
    tween:Play()
    tween.Completed:Wait()

    if token ~= cutsceneToken then
        return
    end

    local drift = scene.CameraDrift
    local driftDuration = math.max(0, duration - tweenDuration)

    if typeof(drift) ~= "Vector3" or drift.Magnitude <= 0.05 or driftDuration <= 0 then
        if driftDuration > 0 then
            task.wait(driftDuration)
        end

        return
    end

    local elapsed = 0

    while elapsed < driftDuration and token == cutsceneToken do
        elapsed += RunService.RenderStepped:Wait()
        local alpha = smoothStep(elapsed / driftDuration)
        local offset = drift * alpha
        local desiredPosition = cframe.Position + offset
        local driftedLook = baseLookTarget + drift * 0.35 * alpha
        local driftedPosition = resolveCameraPosition(desiredPosition, driftedLook)
        camera.CFrame = CFrame.lookAt(driftedPosition, driftedLook)
        camera.FieldOfView = targetFieldOfView
    end
end

local function tweenSceneText(sceneTitleTransparency: number, sceneBodyTransparency: number, sceneCounterTransparency: number, duration: number)
    TweenService:Create(sceneTitle, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = sceneTitleTransparency,
    }):Play()
    TweenService:Create(sceneBody, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = sceneBodyTransparency,
    }):Play()
    TweenService:Create(sceneReference, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = sceneBodyTransparency,
    }):Play()
    TweenService:Create(sceneCounter, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = sceneCounterTransparency,
    }):Play()
end

showBattleMessage.OnClientEvent:Connect(function(payload)
    showToast(payload.Text or "", payload.Duration or 4)
end)

showBattleSummary.OnClientEvent:Connect(function(payload)
    scenarioLabel.Text = payload.ScenarioName or ""
    winnerLabel.Text = payload.WinnerText or ""
    summaryTitle.Text = payload.SummaryTitle or ""
    linesLabel.Text = table.concat(payload.SummaryLines or {}, "\n\n")
    summaryFrame.Visible = true
end)

playReenactment.OnClientEvent:Connect(function(payload)
    cutsceneToken += 1
    local currentToken = cutsceneToken
    local camera = Workspace.CurrentCamera

    if not camera then
        return
    end

    local cameraState = {
        FieldOfView = camera.FieldOfView,
    }

    summaryFrame.Visible = false
    cutsceneFrame.Visible = true
    setCoreGuiVisibility(false)
    setCutscenePostProcessing(true)
    tweenCutsceneFrameIn()
    introLabel.Text = string.format("%s | %s", getKindLabel(payload.Kind), payload.IntroTitle or "")
    cutsceneScenario.Text = payload.ScenarioName or ""
    cutsceneWinner.Text = payload.WinnerText or ""
    cutsceneWinner.Visible = payload.Kind ~= "Briefing"
    progressBar.Size = UDim2.fromScale(0, 1)
    camera.CameraType = Enum.CameraType.Scriptable

    local scenes = payload.Scenes or {}
    local totalDuration = 0
    sceneTitle.TextTransparency = 1
    sceneBody.TextTransparency = 1
    sceneReference.TextTransparency = 1
    sceneCounter.TextTransparency = 1

    for _, scene in ipairs(scenes) do
        totalDuration += scene.DurationSeconds or 5
    end

    local elapsedDuration = 0

    for index, scene in ipairs(scenes) do
        if currentToken ~= cutsceneToken then
            break
        end

        sceneTitle.Text = scene.Title or ""
        sceneBody.Text = scene.Body or ""
        sceneReference.Text = scene.Reference or ""
        sceneCounter.Text = string.format("%s %d of %d", payload.Kind == "Briefing" and "Briefing" or "Scene", index, #scenes)
        tweenSceneText(0, 0, 0, 0.22)

        local sceneDuration = scene.DurationSeconds or 5

        progressBar.Size = UDim2.fromScale(math.clamp(elapsedDuration / math.max(totalDuration, 1), 0, 1), 1)
        TweenService:Create(progressBar, TweenInfo.new(sceneDuration, Enum.EasingStyle.Linear), {
            Size = UDim2.fromScale(math.clamp((elapsedDuration + sceneDuration) / math.max(totalDuration, 1), 0, 1), 1),
        }):Play()

        moveCameraThroughScene(camera, scene, math.max(0.4, sceneDuration - 0.18), currentToken)
        tweenSceneText(1, 1, 1, 0.18)
        task.wait(0.18)
        elapsedDuration += sceneDuration
    end

    if currentToken == cutsceneToken then
        tweenCutsceneFrameOut()
        cutsceneFrame.Visible = false
        restoreCamera(cameraState)
    end
end)

closeButton.MouseButton1Click:Connect(function()
    setCoreGuiVisibility(true)
    setCutscenePostProcessing(false)
    summaryFrame.Visible = false
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="77">
        <Properties>
          <string name="Name">BattleWeaponAnimation</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BattleAnimationLibrary = require(Shared.Config.BattleAnimationLibrary)

local player = Players.LocalPlayer
local toolConnections: { [Tool]: { RBXScriptConnection } } = {}
local lifecycleConnections: { RBXScriptConnection } = {}
local toolAnimationStates: { [Tool]: { Animator: Animator?, Tracks: { [string]: AnimationTrack } } } = {}

local SWORD_IDLE_GRIP = CFrame.new(0.16, -0.95, -0.12) * CFrame.Angles(math.rad(-18), math.rad(12), math.rad(-10))
local SWORD_WINDUP_GRIP = CFrame.new(0.22, -0.82, -0.08) * CFrame.Angles(math.rad(-70), math.rad(18), math.rad(18))
local SWORD_MID_SWING_GRIP = CFrame.new(0.18, -0.9, -0.11) * CFrame.Angles(math.rad(-14), math.rad(10), math.rad(-8))
local SWORD_STRIKE_GRIP = CFrame.new(0.08, -1.0, -0.2) * CFrame.Angles(math.rad(18), math.rad(-8), math.rad(-42))
local SWORD_FOLLOW_THROUGH_GRIP = CFrame.new(0.04, -0.98, -0.26) * CFrame.Angles(math.rad(28), math.rad(-14), math.rad(-56))
local SWORD_RECOVER_GRIP = CFrame.new(0.14, -0.96, -0.14) * CFrame.Angles(math.rad(-24), math.rad(6), math.rad(-12))
local BOW_IDLE_GRIP = CFrame.new(0, -0.2, 0.04) * CFrame.Angles(0, math.rad(90), 0)
local BOW_DRAW_GRIP = CFrame.new(-0.24, -0.05, 0.16) * CFrame.Angles(math.rad(-10), math.rad(96), math.rad(-6))

local BOW_DRAW_TIME_SECONDS = 0.9
local BOW_RELEASE_RESET_SECONDS = 0.22
local SWORD_SWING_SECONDS = 0.44

local function smoothStep(alpha: number): number
    local clamped = math.clamp(alpha, 0, 1)
    return clamped * clamped * (3 - 2 * clamped)
end

local function animateGrip(tool: Tool, target: CFrame, duration: number, tokenGetter: () -> number)
    local startGrip = tool.Grip
    local elapsed = 0
    local token = tokenGetter()

    while elapsed < duration and tool.Parent and token == tokenGetter() do
        elapsed += RunService.RenderStepped:Wait()
        local alpha = smoothStep(elapsed / duration)
        tool.Grip = startGrip:Lerp(target, alpha)
    end

    if tool.Parent and token == tokenGetter() then
        tool.Grip = target
    end
end

local function kickCamera(offsetDegrees: number, duration: number)
    local camera = Workspace.CurrentCamera

    if not camera then
        return
    end

    local startFov = camera.FieldOfView
    local peakFov = startFov + offsetDegrees
    local elapsed = 0

    while elapsed < duration do
        elapsed += RunService.RenderStepped:Wait()
        local alpha = smoothStep(elapsed / duration)
        camera.FieldOfView = startFov + (peakFov - startFov) * (1 - alpha)
    end

    camera.FieldOfView = startFov
end

local function findPartWeld(part: BasePart?): Weld?
    if not part then
        return nil
    end

    local weld = part:FindFirstChildOfClass("Weld")

    if weld then
        return weld
    end

    return nil
end

local function getHumanoidFromTool(tool: Tool): Humanoid?
    local parent = tool.Parent

    if not parent or not parent:IsA("Model") then
        return nil
    end

    return parent:FindFirstChildOfClass("Humanoid")
end

local function getAnimatorFromTool(tool: Tool): Animator?
    local humanoid = getHumanoidFromTool(tool)

    if not humanoid then
        return nil
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if animator then
        return animator
    end

    animator = Instance.new("Animator")
    animator.Parent = humanoid

    return animator
end

local function normalizeAnimationId(animationId: string): string
    if string.find(animationId, "rbxassetid://", 1, true) == 1 then
        return animationId
    end

    return "rbxassetid://" .. animationId
end

local function getAnimationState(tool: Tool, animator: Animator?): { Animator: Animator?, Tracks: { [string]: AnimationTrack } }
    local state = toolAnimationStates[tool]

    if state and state.Animator ~= animator then
        for _, track in pairs(state.Tracks) do
            pcall(function()
                track:Stop(0.08)
                track:Destroy()
            end)
        end

        state = nil
        toolAnimationStates[tool] = nil
    end

    if state then
        return state
    end

    state = {
        Animator = animator,
        Tracks = {},
    }
    toolAnimationStates[tool] = state

    return state
end

local function loadTrack(tool: Tool, key: string, entry): AnimationTrack?
    if not BattleAnimationLibrary.HasAnimation(entry) then
        return nil
    end

    local animator = getAnimatorFromTool(tool)

    if not animator then
        return nil
    end

    local state = getAnimationState(tool, animator)
    local existing = state.Tracks[key]

    if existing then
        return existing
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = normalizeAnimationId(entry.AnimationId)

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    animation:Destroy()

    if not ok or not track then
        return nil
    end

    track.Priority = entry.Priority or Enum.AnimationPriority.Action
    track.Looped = entry.Looped == true
    state.Tracks[key] = track

    return track
end

local function playConfiguredTrack(tool: Tool, key: string, entry)
    local track = loadTrack(tool, key, entry)

    if not track then
        return nil
    end

    if track.IsPlaying then
        track:Stop(entry.FadeTime or 0.08)
    end

    track.TimePosition = 0
    track:Play(entry.FadeTime or 0.08, 1, 1)
    track:AdjustSpeed(entry.Speed or 1)

    return track
end

local function stopConfiguredTrack(tool: Tool, key: string, fadeTime: number?)
    local state = toolAnimationStates[tool]

    if not state then
        return
    end

    local track = state.Tracks[key]

    if not track then
        return
    end

    pcall(function()
        track:Stop(fadeTime or 0.08)
    end)
end

local function stopAllConfiguredTracks(tool: Tool)
    local state = toolAnimationStates[tool]

    if not state then
        return
    end

    for _, track in pairs(state.Tracks) do
        pcall(function()
            track:Stop(0.08)
            track:Destroy()
        end)
    end

    toolAnimationStates[tool] = nil
end

local function disconnectTool(tool: Tool)
    local connections = toolConnections[tool]

    if not connections then
        return
    end

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    stopAllConfiguredTracks(tool)
    toolConnections[tool] = nil
end

local function clearLifecycleConnections()
    for _, connection in ipairs(lifecycleConnections) do
        connection:Disconnect()
    end

    table.clear(lifecycleConnections)
end

local function trackLifecycle(connection: RBXScriptConnection)
    table.insert(lifecycleConnections, connection)
end

local function trackConnection(tool: Tool, connection: RBXScriptConnection)
    local list = toolConnections[tool]

    if not list then
        list = {}
        toolConnections[tool] = list
    end

    table.insert(list, connection)
end

local function attachSwordAnimation(tool: Tool)
    local animationToken = 0
    local swinging = false
    local swordConfig = BattleAnimationLibrary.Sword

    local function getToken(): number
        return animationToken
    end

    local function resumeIdle()
        playConfiguredTrack(tool, "SwordIdle", swordConfig.Idle)
    end

    local function resetSword()
        animationToken += 1
        swinging = false
        tool.Grip = SWORD_IDLE_GRIP
        stopConfiguredTrack(tool, "SwordSlash", 0.08)
        resumeIdle()
    end

    trackConnection(tool, tool.Equipped:Connect(function()
        tool.Grip = SWORD_IDLE_GRIP
        playConfiguredTrack(tool, "SwordEquip", swordConfig.Equip)
        task.delay(0.08, function()
            if tool.Parent then
                resumeIdle()
            end
        end)
    end))

    trackConnection(tool, tool.Unequipped:Connect(function()
        animationToken += 1
        swinging = false
        stopAllConfiguredTracks(tool)
        tool.Grip = SWORD_IDLE_GRIP
    end))

    trackConnection(tool, tool.Activated:Connect(function()
        if swinging then
            return
        end

        if player:GetAttribute("InBattle") ~= true then
            return
        end

        swinging = true
        animationToken += 1
        stopConfiguredTrack(tool, "SwordIdle", 0.05)
        playConfiguredTrack(tool, "SwordSlash", swordConfig.Slash)

        task.spawn(function()
            animateGrip(tool, SWORD_WINDUP_GRIP, 0.1, getToken)
            animateGrip(tool, SWORD_MID_SWING_GRIP, 0.05, getToken)
            animateGrip(tool, SWORD_STRIKE_GRIP, 0.06, getToken)
            animateGrip(tool, SWORD_FOLLOW_THROUGH_GRIP, 0.08, getToken)
            animateGrip(tool, SWORD_RECOVER_GRIP, 0.08, getToken)
            animateGrip(tool, SWORD_IDLE_GRIP, 0.14, getToken)
        end)

        task.spawn(function()
            kickCamera(1.6, 0.16)
        end)

        task.delay(SWORD_SWING_SECONDS, function()
            swinging = false

            if tool.Parent then
                resumeIdle()
            end
        end)
    end))

    if tool.Parent then
        resetSword()
    end
end

local function attachBowAnimation(tool: Tool)
    local animationToken = 0
    local drawing = false
    local drawStartedAt = 0
    local bowConfig = BattleAnimationLibrary.Bow

    local upperString = tool:FindFirstChild("UpperString", true)
    local lowerString = tool:FindFirstChild("LowerString", true)
    local displayArrow = tool:FindFirstChild("DisplayArrow", true)
    local upperStringPart = (upperString and upperString:IsA("BasePart")) and upperString or nil
    local lowerStringPart = (lowerString and lowerString:IsA("BasePart")) and lowerString or nil
    local displayArrowPart = (displayArrow and displayArrow:IsA("BasePart")) and displayArrow or nil

    local upperStringWeld = findPartWeld(upperStringPart)
    local lowerStringWeld = findPartWeld(lowerStringPart)
    local displayArrowWeld = findPartWeld(displayArrowPart)

    local upperIdle = CFrame.new(1.0, -2.18, 0)
    local lowerIdle = CFrame.new(1.0, 2.18, 0)
    local upperDraw = CFrame.new(0.52, -2.18, 0)
    local lowerDraw = CFrame.new(0.52, 2.18, 0)
    local arrowIdle = CFrame.new(-0.32, 0, -0.7) * CFrame.Angles(math.rad(90), 0, 0)
    local arrowDraw = CFrame.new(-0.98, 0, -0.7) * CFrame.Angles(math.rad(90), 0, 0)

    local function getToken(): number
        return animationToken
    end

    local function setDrawPose(alpha: number)
        local clamped = math.clamp(alpha, 0, 1)
        tool.Grip = BOW_IDLE_GRIP:Lerp(BOW_DRAW_GRIP, clamped)

        if upperStringWeld then
            upperStringWeld.C0 = upperIdle:Lerp(upperDraw, clamped)
        end

        if lowerStringWeld then
            lowerStringWeld.C0 = lowerIdle:Lerp(lowerDraw, clamped)
        end

        if displayArrowWeld then
            displayArrowWeld.C0 = arrowIdle:Lerp(arrowDraw, clamped)
        end

        local state = toolAnimationStates[tool]
        local drawTrack = state and state.Tracks["BowDrawLoop"] or nil

        if drawTrack and drawTrack.IsPlaying then
            drawTrack:AdjustSpeed(0.72 + clamped * 0.4)
        end
    end

    local function resumeIdle()
        playConfiguredTrack(tool, "BowIdle", bowConfig.Idle)
    end

    local function resetBow()
        animationToken += 1
        drawing = false
        tool.Grip = BOW_IDLE_GRIP
        setDrawPose(0)
        stopConfiguredTrack(tool, "BowDrawLoop", 0.08)
        stopConfiguredTrack(tool, "BowRelease", 0.08)
        resumeIdle()

        if displayArrowPart then
            displayArrowPart.Transparency = 0
        end
    end

    trackConnection(tool, tool.Equipped:Connect(function()
        playConfiguredTrack(tool, "BowEquip", bowConfig.Equip)
        task.delay(0.08, function()
            if tool.Parent then
                resetBow()
            end
        end)
    end))

    trackConnection(tool, tool.Unequipped:Connect(function()
        animationToken += 1
        drawing = false
        stopAllConfiguredTracks(tool)
        tool.Grip = BOW_IDLE_GRIP
        setDrawPose(0)

        if displayArrowPart then
            displayArrowPart.Transparency = 0
        end
    end))

    trackConnection(tool, tool.Activated:Connect(function()
        if drawing then
            return
        end

        if player:GetAttribute("InBattle") ~= true then
            return
        end

        drawing = true
        drawStartedAt = os.clock()
        animationToken += 1
        local activeToken = animationToken

        stopConfiguredTrack(tool, "BowIdle", 0.05)
        playConfiguredTrack(tool, "BowDrawLoop", bowConfig.DrawLoop)

        task.spawn(function()
            while drawing and activeToken == animationToken and tool.Parent do
                local elapsed = os.clock() - drawStartedAt
                setDrawPose(smoothStep(elapsed / BOW_DRAW_TIME_SECONDS))
                RunService.RenderStepped:Wait()
            end
        end)
    end))

    trackConnection(tool, tool.Deactivated:Connect(function()
        if not drawing then
            return
        end

        drawing = false
        stopConfiguredTrack(tool, "BowDrawLoop", 0.08)
        playConfiguredTrack(tool, "BowRelease", bowConfig.Release)

        if displayArrowPart then
            displayArrowPart.Transparency = 1
        end

        local releaseToken = animationToken

        task.spawn(function()
            local elapsed = 0
            local startGrip = tool.Grip

            while elapsed < BOW_RELEASE_RESET_SECONDS and tool.Parent and releaseToken == animationToken do
                elapsed += RunService.RenderStepped:Wait()
                local alpha = smoothStep(elapsed / BOW_RELEASE_RESET_SECONDS)
                local nextGrip = startGrip:Lerp(BOW_IDLE_GRIP, alpha)
                tool.Grip = nextGrip
                setDrawPose(1 - alpha)
            end

            if tool.Parent and releaseToken == animationToken then
                setDrawPose(0)

                if displayArrowPart then
                    displayArrowPart.Transparency = 0
                end

                resumeIdle()
            end
        end)

        task.spawn(function()
            kickCamera(2.1, 0.22)
        end)
    end))

    if tool.Parent then
        resetBow()
    end
end

local function tryAttachTool(tool: Tool)
    if toolConnections[tool] then
        return
    end

    if tool.Name == "Training Sword" then
        attachSwordAnimation(tool)
    elseif tool.Name == "Bow" then
        attachBowAnimation(tool)
    else
        return
    end

    trackConnection(tool, tool.AncestryChanged:Connect(function(_, parent)
        if not parent then
            disconnectTool(tool)
        end
    end))
end

local function attachCharacter(character: Model)
    clearLifecycleConnections()

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            tryAttachTool(child)
        end
    end

    local backpack = player:FindFirstChildOfClass("Backpack")

    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                tryAttachTool(child)
            end
        end
    end

    trackLifecycle(character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            tryAttachTool(child)
        end
    end))

    if backpack then
        trackLifecycle(backpack.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                tryAttachTool(child)
            end
        end))
    end
end

if player.Character then
    attachCharacter(player.Character)
end

player.CharacterAdded:Connect(function(character)
    attachCharacter(character)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="78">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ContentIndex = require(Shared.Modules.ContentIndex)

local player = Players.LocalPlayer
local content = ContentIndex.GetStartupPayload()

print(string.format(
    "[ClientBootstrap] %s entered %s. Stories: %d, Battles: %d, Travel Stops: %d.",
    player.Name,
    content.Config.HubName,
    #content.Stories,
    #content.Battles,
    #content.TravelRoute.Destinations
))
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="79">
        <Properties>
          <string name="Name">GuideDialogue</string>
          <string name="Source"><![CDATA[--!strict

-- Dialogue box for the hub's guide teachers. The guide greets the player, names their next
-- quest from the suggested path, and offers to take them there.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Guides = require(Shared.Data.Guides)

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local requestTeleport = remotes:WaitForChild("Hub"):WaitForChild("RequestTeleport") :: RemoteEvent
local profileUpdated = remotes:WaitForChild("Progress"):WaitForChild("ProfileUpdated") :: RemoteEvent
local requestProfile = remotes:WaitForChild("Progress"):WaitForChild("RequestProfile") :: RemoteEvent

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local COLORS = {
    Panel = Color3.fromRGB(250, 244, 230),
    Border = Color3.fromRGB(193, 162, 86),
    Ink = Color3.fromRGB(46, 38, 28),
    Muted = Color3.fromRGB(110, 94, 70),
    Accent = Color3.fromRGB(63, 98, 88),
    Quiet = Color3.fromRGB(206, 194, 168),
    White = Color3.fromRGB(250, 246, 234),
}

local guideById: { [string]: Guides.Guide } = {}

for _, guide in ipairs(Guides) do
    guideById[guide.Id] = guide
end

local snapshot: any = nil

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GuideDialogue"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 95
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(0.5, 1)
panel.Position = UDim2.new(0.5, 0, 1, -24)
panel.Size = UDim2.new(0.92, 0, 0, 0)
panel.AutomaticSize = Enum.AutomaticSize.Y
panel.BackgroundColor3 = COLORS.Panel
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = screenGui

local sizeLimit = Instance.new("UISizeConstraint")
sizeLimit.MaxSize = Vector2.new(620, math.huge)
sizeLimit.Parent = panel

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 16)
corner.Parent = panel

local stroke = Instance.new("UIStroke")
stroke.Color = COLORS.Border
stroke.Thickness = 2
stroke.Parent = panel

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 14)
padding.PaddingBottom = UDim.new(0, 14)
padding.PaddingLeft = UDim.new(0, 18)
padding.PaddingRight = UDim.new(0, 18)
padding.Parent = panel

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = panel

local function textLine(order: number, size: number, font: Enum.Font, color: Color3): TextLabel
    local line = Instance.new("TextLabel")
    line.BackgroundTransparency = 1
    line.Size = UDim2.new(1, 0, 0, 0)
    line.AutomaticSize = Enum.AutomaticSize.Y
    line.Font = font
    line.TextColor3 = color
    line.TextSize = size
    line.TextWrapped = true
    line.TextXAlignment = Enum.TextXAlignment.Left
    line.LayoutOrder = order
    line.Text = ""
    line.Parent = panel

    return line
end

local nameLabel = textLine(1, 18, Enum.Font.GothamBold, COLORS.Accent)
local greetingLabel = textLine(2, 16, Enum.Font.GothamMedium, COLORS.Ink)
local questLabel = textLine(3, 16, Enum.Font.GothamBold, COLORS.Ink)
local hintLabel = textLine(4, 14, Enum.Font.Gotham, COLORS.Muted)
local sayingLabel = textLine(5, 14, Enum.Font.GothamMedium, COLORS.Muted)

local buttonRow = Instance.new("Frame")
buttonRow.BackgroundTransparency = 1
buttonRow.Size = UDim2.new(1, 0, 0, 40)
buttonRow.LayoutOrder = 6
buttonRow.Parent = panel

local rowLayout = Instance.new("UIListLayout")
rowLayout.FillDirection = Enum.FillDirection.Horizontal
rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
rowLayout.Padding = UDim.new(0, 10)
rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
rowLayout.Parent = buttonRow

local function button(text: string, order: number, color: Color3, textColor: Color3): TextButton
    local newButton = Instance.new("TextButton")
    newButton.AutoButtonColor = true
    newButton.BackgroundColor3 = color
    newButton.Size = UDim2.fromOffset(150, 40)
    newButton.Font = Enum.Font.GothamBold
    newButton.Text = text
    newButton.TextColor3 = textColor
    newButton.TextSize = 15
    newButton.LayoutOrder = order
    newButton.Parent = buttonRow

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 10)
    buttonCorner.Parent = newButton

    return newButton
end

local goButton = button("Take me there", 1, COLORS.Accent, COLORS.White)
local closeButton = button("Goodbye", 2, COLORS.Quiet, COLORS.Ink)

local currentStep: any = nil
local currentGuide: Guides.Guide? = nil

local function close()
    panel.Visible = false
    currentStep = nil
    currentGuide = nil
end

local function isBusy(): boolean
    return player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true
end

local function render(guide: Guides.Guide)
    local step = snapshot and snapshot.NextStep
    currentStep = step
    nameLabel.Text = string.format("%s  ·  %s", guide.DisplayName, guide.Role)
    greetingLabel.Text = guide.Greeting

    if not snapshot then
        questLabel.Text = "Your journal is still opening."
        hintLabel.Text = "Talk to me again in a moment and I will tell you what to do next."
        goButton.Visible = false
    elseif step then
        questLabel.Text = string.format("Your next quest: %s", tostring(step.Title))
        hintLabel.Text = tostring(step.Hint or "")
        goButton.Visible = true
        goButton.Text = if step.HallUnitId or not step.Destination then "Open the lesson" else "Take me there"
    else
        questLabel.Text = "MashaAllah, you have finished every quest on the path!"
        hintLabel.Text = "Keep the daily streak going, replay stories, and bring friends to a study circle."
        goButton.Visible = false
    end
end

local function open(guide: Guides.Guide)
    if isBusy() then
        return
    end

    currentGuide = guide
    sayingLabel.Text = guide.Sayings[math.random(1, #guide.Sayings)]
    render(guide)
    panel.Visible = true
end

goButton.Activated:Connect(function()
    local step = currentStep
    close()

    if not step then
        return
    end

    if step.Destination and not step.HallUnitId then
        requestTeleport:FireServer(step.Destination)
        return
    end

    local hall = playerGui:FindFirstChild("LearningHall")
    local openRequest = hall and hall:FindFirstChild("Open")

    if openRequest and openRequest:IsA("BindableEvent") then
        openRequest:Fire(step.HallUnitId)
    end
end)

closeButton.Activated:Connect(close)

ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, triggeringPlayer: Player)
    if triggeringPlayer ~= player or prompt:GetAttribute("PromptAction") ~= "TalkToGuide" then
        return
    end

    local guide = guideById[tostring(prompt:GetAttribute("GuideId"))]

    if guide then
        open(guide)
    end
end)

-- Walking away from the guide ends the conversation.
ProximityPromptService.PromptHidden:Connect(function(prompt: ProximityPrompt)
    if panel.Visible and prompt:GetAttribute("PromptAction") == "TalkToGuide" and currentGuide and prompt:GetAttribute("GuideId") == currentGuide.Id then
        close()
    end
end)

profileUpdated.OnClientEvent:Connect(function(payload: any)
    if type(payload) ~= "table" or type(payload.Level) ~= "number" then
        return
    end

    snapshot = payload

    if panel.Visible and currentGuide then
        render(currentGuide)
    end
end)

player:GetAttributeChangedSignal("InBattle"):Connect(function()
    if isBusy() then
        close()
    end
end)

player:GetAttributeChangedSignal("InStory"):Connect(function()
    if isBusy() then
        close()
    end
end)

-- The first snapshot may have been sent before this script was listening.
requestProfile:FireServer()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="80">
        <Properties>
          <string name="Name">HubAmbience</string>
          <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local trailPulses: { Instance } = {}
local rideableCamels: { Instance } = {}
local camelRootPoseCache: { [Model]: CFrame } = {}

local function getNumberAttribute(instance: Instance, name: string, fallback: number): number
    local value = instance:GetAttribute(name)

    if type(value) == "number" then
        return value
    end

    return fallback
end

local function getBasePart(parent: Instance, name: string): BasePart?
    local child = parent:FindFirstChild(name)

    if child and child:IsA("BasePart") then
        return child
    end

    return nil
end

local function addTrackedInstance(list: { Instance }, instance: Instance)
    if table.find(list, instance) then
        return
    end

    table.insert(list, instance)
end

local function removeTrackedInstance(list: { Instance }, instance: Instance)
    local index = table.find(list, instance)

    if index then
        table.remove(list, index)
    end
end

local function dampAlpha(deltaTime: number, responsiveness: number): number
    return math.clamp(deltaTime * responsiveness, 0, 1)
end

local function animateTrailPulse(part: BasePart, now: number)
    local phase = getNumberAttribute(part, "PulsePhase", 0)
    local pulse = (math.sin(now * 2.8 + phase) + 1) * 0.5

    part.Transparency = 0.18 + pulse * 0.36
end

local function setCamelPart(model: Model, name: string, cframe: CFrame)
    local part = getBasePart(model, name)

    if part then
        part.CFrame = cframe
    end
end

local function animateCamelLeg(model: Model, pivot: CFrame, index: number, localOffset: Vector3, stride: number, lift: number)
    local leg = getBasePart(model, string.format("Leg_%d", index))
    local hoof = getBasePart(model, string.format("Hoof_%d", index))
    local swingOffset = Vector3.new(stride * 0.42, lift * 0.16, 0)

    if leg then
        leg.CFrame = pivot * CFrame.new(localOffset + swingOffset) * CFrame.Angles(0, 0, stride * 0.12)
    end

    if hoof then
        hoof.CFrame = pivot * CFrame.new(localOffset + Vector3.new(stride * 0.62, -4.9 + lift, 0)) * CFrame.Angles(0, 0, stride * 0.1)
    end
end

local function animateRideableCamel(model: Model, now: number, deltaTime: number)
    local root = model.PrimaryPart or getBasePart(model, "CamelRoot")

    if not root then
        return
    end

    model.PrimaryPart = root

    local seat = model:FindFirstChild("CamelSeat", true)
    local throttle = 0
    local steer = 0

    if seat and seat:IsA("VehicleSeat") and seat.Occupant then
        throttle = seat.ThrottleFloat
        steer = seat.SteerFloat
    end

    local moving = math.abs(throttle) > 0.04 or math.abs(steer) > 0.04
    local phase = getNumberAttribute(model, "StridePhase", 0)
    local pace = moving and 7.4 or 1.4
    local strideScale = moving and 1 or 0.14
    local wave = now * pace + phase
    local strideA = math.sin(wave) * strideScale
    local strideB = math.sin(wave + math.pi) * strideScale
    local liftA = math.max(0, math.sin(wave)) * (moving and 0.65 or 0.08)
    local liftB = math.max(0, math.sin(wave + math.pi)) * (moving and 0.65 or 0.08)
    local bob = (moving and math.abs(math.sin(wave)) * 0.28 or math.sin(now * 1.1 + phase) * 0.08)
    local neckNod = math.sin(wave + 0.6) * (moving and 0.08 or 0.025)
    local tailSway = math.sin(wave + 1.1) * (moving and 0.18 or 0.06)
    local smoothedRoot = camelRootPoseCache[model] and camelRootPoseCache[model]:Lerp(root.CFrame, dampAlpha(deltaTime, 9.2)) or root.CFrame
    camelRootPoseCache[model] = smoothedRoot
    local pivot = smoothedRoot * CFrame.new(0, bob, 0)

    setCamelPart(model, "Body", pivot * CFrame.new(0, 1.2, 0))
    setCamelPart(model, "Hump", pivot * CFrame.new(-1.6, 5.2, 0) * CFrame.Angles(0, math.rad(180), 0))
    setCamelPart(model, "Chest", pivot * CFrame.new(-7.2, 1.4, 0))
    setCamelPart(model, "Neck", pivot * CFrame.new(-10, 6.6, 0) * CFrame.Angles(0, 0, math.rad(-18) + neckNod))
    setCamelPart(model, "Head", pivot * CFrame.new(-11.9, 10.8, 0) * CFrame.Angles(0, 0, neckNod * 0.45))
    setCamelPart(model, "Muzzle", pivot * CFrame.new(-15.4, 10.3, 0) * CFrame.Angles(0, 0, neckNod * 0.45))
    setCamelPart(model, "LeftEar", pivot * CFrame.new(-11.7, 13.1, -1.15) * CFrame.Angles(math.rad(12), 0, math.rad(-10) + neckNod))
    setCamelPart(model, "RightEar", pivot * CFrame.new(-11.7, 13.1, 1.15) * CFrame.Angles(math.rad(-12), 0, math.rad(-10) + neckNod))
    setCamelPart(model, "Tail", pivot * CFrame.new(8.8, 2.7, 0) * CFrame.Angles(0, 0, math.rad(34) + tailSway))
    setCamelPart(model, "SaddleBlanket", pivot * CFrame.new(1.2, 5, 0))
    setCamelPart(model, "SaddleBack", pivot * CFrame.new(4.2, 6.1, 0))
    setCamelPart(model, "SaddleFront", pivot * CFrame.new(-2.4, 5.95, 0))

    animateCamelLeg(model, pivot, 1, Vector3.new(-5.2, -3.2, -2.1), strideA, liftA)
    animateCamelLeg(model, pivot, 2, Vector3.new(-5.2, -3.2, 2.1), strideB, liftB)
    animateCamelLeg(model, pivot, 3, Vector3.new(5.2, -3.2, -2.1), strideB, liftB)
    animateCamelLeg(model, pivot, 4, Vector3.new(5.2, -3.2, 2.1), strideA, liftA)
end

local function applyCameraPolish(now: number)
    local camera = Workspace.CurrentCamera

    if not camera or camera.CameraType == Enum.CameraType.Scriptable then
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return
    end

    local seatPart = humanoid.SeatPart

    if seatPart and seatPart:IsA("VehicleSeat") and seatPart:GetAttribute("PromptAction") == "RideCamel" then
        local rideInput = math.clamp(math.abs(seatPart.ThrottleFloat) + math.abs(seatPart.SteerFloat) * 0.45, 0, 1)
        local rideBob = math.sin(now * 7.4) * 0.07 * rideInput
        local rideSide = math.cos(now * 3.7) * 0.04 * rideInput

        humanoid.CameraOffset = humanoid.CameraOffset:Lerp(Vector3.new(rideSide, rideBob, 0), 0.16)
        camera.FieldOfView = camera.FieldOfView + ((73 + rideInput * 4.5) - camera.FieldOfView) * 0.08
        return
    end

    local speed = root.AssemblyLinearVelocity.Magnitude

    if speed < 1 then
        humanoid.CameraOffset = humanoid.CameraOffset:Lerp(Vector3.zero, 0.14)
        camera.FieldOfView = camera.FieldOfView + ((player:GetAttribute("InBattle") == true and 76 or 72) - camera.FieldOfView) * 0.08
        return
    end

    local battleScale = player:GetAttribute("InBattle") == true and 0.1 or 0.06
    local bob = math.sin(now * 9.2) * battleScale
    local side = math.cos(now * 4.6) * battleScale * 0.55
    local baseFov = player:GetAttribute("InBattle") == true and 76 or 72
    local targetFov = baseFov + math.clamp(speed / 24, 0, 1) * 3.5

    humanoid.CameraOffset = humanoid.CameraOffset:Lerp(Vector3.new(side, bob, 0), 0.18)
    camera.FieldOfView = camera.FieldOfView + (targetFov - camera.FieldOfView) * 0.08
end

for _, instance in ipairs(CollectionService:GetTagged("TrailPulse")) do
    addTrackedInstance(trailPulses, instance)
end

for _, instance in ipairs(CollectionService:GetTagged("RideableCamel")) do
    addTrackedInstance(rideableCamels, instance)
end

CollectionService:GetInstanceAddedSignal("TrailPulse"):Connect(function(instance: Instance)
    addTrackedInstance(trailPulses, instance)
end)

CollectionService:GetInstanceRemovedSignal("TrailPulse"):Connect(function(instance: Instance)
    removeTrackedInstance(trailPulses, instance)
end)

CollectionService:GetInstanceAddedSignal("RideableCamel"):Connect(function(instance: Instance)
    addTrackedInstance(rideableCamels, instance)
end)

CollectionService:GetInstanceRemovedSignal("RideableCamel"):Connect(function(instance: Instance)
    removeTrackedInstance(rideableCamels, instance)
end)

RunService.RenderStepped:Connect(function(deltaTime)
    local now = os.clock()

    for index = #trailPulses, 1, -1 do
        local instance = trailPulses[index]

        if not instance.Parent then
            table.remove(trailPulses, index)
            continue
        end

        if instance:IsA("BasePart") then
            animateTrailPulse(instance, now)
        end
    end

    for index = #rideableCamels, 1, -1 do
        local instance = rideableCamels[index]

        if not instance.Parent then
            if instance:IsA("Model") then
                camelRootPoseCache[instance] = nil
            end
            table.remove(rideableCamels, index)
            continue
        end

        if instance:IsA("Model") then
            animateRideableCamel(instance, now, deltaTime)
        end
    end

    applyCameraPolish(now)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="81">
        <Properties>
          <string name="Name">HubQuickButtons</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "HubQuickButtons"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 100
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

local function connectButton(button: GuiButton, onClick: () -> ())
    local lastClickAt = 0

    local function runClick()
        local now = os.clock()

        if now - lastClickAt < 0.12 then
            return
        end

        lastClickAt = now
        onClick()
    end

    button.Activated:Connect(runClick)
    button.MouseButton1Click:Connect(runClick)
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            runClick()
        end
    end)
end

local function createButton(name: string, text: string, yOffset: number, color: Color3): TextButton
    local button = Instance.new("TextButton")
    button.Name = name
    button.AnchorPoint = Vector2.new(0, 1)
    button.Position = UDim2.new(0, 20, 1, yOffset)
    button.Size = UDim2.fromOffset(150, 44)
    button.Active = true
    button.AutoButtonColor = true
    button.BackgroundColor3 = color
    button.Font = Enum.Font.GothamBold
    pcall(function()
        button.Modal = true
    end)
    button.Selectable = true
    button.Text = text
    button.TextColor3 = Color3.fromRGB(250, 246, 234)
    button.TextScaled = true
    button.ZIndex = 20
    button.Parent = screenGui

    local textLimit = Instance.new("UITextSizeConstraint")
    textLimit.MinTextSize = 12
    textLimit.MaxTextSize = 18
    textLimit.Parent = button

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(244, 236, 211)
    stroke.Thickness = 1
    stroke.Transparency = 0.24
    stroke.Parent = button

    return button
end

local journeysButton = createButton("JourneysButton", "Journeys", -256, Color3.fromRGB(96, 76, 112))
local learnButton = createButton("LearnButton", "Learn", -200, Color3.fromRGB(121, 94, 63))
local itemShopButton = createButton("ItemShopButton", "Item Shop", -144, Color3.fromRGB(73, 97, 61))
local menuButton = createButton("MenuButton", "Menu", -88, Color3.fromRGB(31, 46, 38))
local watchedPanels: { [Frame]: RBXScriptConnection } = {}
local PANEL_GUIS = { "MainMenu", "ShopMenu", "LearningHall", "JourneyBook" }
local updateAvailability

local function getPanel(guiName: string): Frame?
    local gui = playerGui:FindFirstChild(guiName)

    if not gui then
        return nil
    end

    local panel = gui:FindFirstChild("Panel")

    if panel and panel:IsA("Frame") then
        return panel
    end

    return nil
end

local function setTemporaryText(button: TextButton, text: string)
    local originalText = button.Text
    button.Text = text

    task.delay(0.85, function()
        if button and button.Parent and button.Text == text then
            button.Text = originalText
        end
    end)
end

local function requestFreshShopState()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local shopFolder = remotes and remotes:FindFirstChild("Shop")
    local requestShopState = shopFolder and shopFolder:FindFirstChild("RequestShopState")

    if requestShopState and requestShopState:IsA("RemoteEvent") then
        requestShopState:FireServer()
    end
end

local function openPanel(targetGuiName: string, sourceButton: TextButton)
    local targetPanel = getPanel(targetGuiName)

    if not targetPanel then
        setTemporaryText(sourceButton, "Loading")
        return
    end

    local nextVisible = not targetPanel.Visible

    for _, guiName in ipairs(PANEL_GUIS) do
        local otherPanel = getPanel(guiName)

        if otherPanel then
            otherPanel.Visible = false
        end
    end

    targetPanel.Visible = nextVisible

    if targetGuiName == "ShopMenu" and nextVisible then
        requestFreshShopState()
    end

    if updateAvailability then
        updateAvailability()
    end
end

local function anyPanelOpen(): boolean
    for _, guiName in ipairs(PANEL_GUIS) do
        local panel = getPanel(guiName)

        if panel and panel.Visible then
            return true
        end
    end

    return false
end

local function watchPanel(guiName: string)
    local panel = getPanel(guiName)

    if not panel or watchedPanels[panel] then
        return
    end

    watchedPanels[panel] = panel:GetPropertyChangedSignal("Visible"):Connect(function()
        if updateAvailability then
            updateAvailability()
        end
    end)
end

updateAvailability = function()
    for _, guiName in ipairs(PANEL_GUIS) do
        watchPanel(guiName)
    end

    local blocked = player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true
    local panelOpen = anyPanelOpen()
    journeysButton.Visible = not blocked and not panelOpen
    learnButton.Visible = not blocked and not panelOpen
    itemShopButton.Visible = not blocked and not panelOpen
    menuButton.Visible = not blocked and not panelOpen

    if blocked then
        for _, guiName in ipairs(PANEL_GUIS) do
            local panel = getPanel(guiName)

            if panel then
                panel.Visible = false
            end
        end
    end
end

connectButton(journeysButton, function()
    openPanel("JourneyBook", journeysButton)
end)

connectButton(learnButton, function()
    openPanel("LearningHall", learnButton)
end)

connectButton(itemShopButton, function()
    openPanel("ShopMenu", itemShopButton)
end)

connectButton(menuButton, function()
    openPanel("MainMenu", menuButton)
end)

player:GetAttributeChangedSignal("InBattle"):Connect(updateAvailability)
player:GetAttributeChangedSignal("InStory"):Connect(updateAvailability)
playerGui.ChildAdded:Connect(function(child)
    if table.find(PANEL_GUIS, child.Name) then
        task.defer(function()
            watchPanel(child.Name)
            updateAvailability()
        end)
    end
end)
updateAvailability()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="82">
        <Properties>
          <string name="Name">JourneyBook</string>
          <string name="Source"><![CDATA[--!strict

-- The Journeys book: one panel for the Seerah campaign checklist, the Sahabi mysteries, the
-- activities (parkour, co-op, sparring, historical zones), friends and safety tools, and
-- optional support. Opened from the "Journeys" button (HubQuickButtons).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local StarterGui = game:GetService("StarterGui")

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SahabiMysteries = require(Shared.Data.SahabiMysteries)
local ParkourRules = require(Shared.Modules.ParkourRules)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local function remote(folder: string, name: string): RemoteEvent
    return remotes:WaitForChild(folder):WaitForChild(name) :: RemoteEvent
end

local campaignRequest, campaignState = remote("Campaign", "Request"), remote("Campaign", "State")
local mysteryRequest = remote("Mystery", "Request")
local pvpRequest = remote("Pvp", "Request")
local socialRequest, socialState = remote("Social", "Request"), remote("Social", "State")
local supportRequest, supportState = remote("Support", "Request"), remote("Support", "State")
local teleportRequest = remote("Hub", "RequestTeleport")
local profileUpdated = remote("Progress", "ProfileUpdated")

local C = UiKit.Colors

local gui = Instance.new("ScreenGui")
gui.Name = "JourneyBook"
gui.ResetOnSpawn = false
gui.DisplayOrder = 110
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local panel = UiKit.Frame(gui, "Panel", UDim2.fromOffset(780, 520), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
panel.Visible = false

UiKit.Label(panel, "Journeys", UDim2.new(1, -80, 0, 34), UDim2.fromOffset(18, 12), 26, true, C.Gold)
UiKit.Button(panel, "X", UDim2.fromOffset(40, 36), UDim2.new(1, -52, 0, 10), C.Red, function()
    panel.Visible = false
end)

local tabBar = Instance.new("Frame")
tabBar.BackgroundTransparency = 1
tabBar.Size = UDim2.new(1, -36, 0, 40)
tabBar.Position = UDim2.fromOffset(18, 52)
tabBar.Parent = panel

local tabLayout = Instance.new("UIListLayout")
tabLayout.FillDirection = Enum.FillDirection.Horizontal
tabLayout.Padding = UDim.new(0, 8)
tabLayout.Parent = tabBar

local content = UiKit.Scroller(panel, UDim2.new(1, -36, 1, -112), UDim2.fromOffset(18, 100))

local state = {
    Tab = "Seerah",
    Campaign = nil :: any,
    Profile = nil :: any,
    Support = nil :: any,
    Voice = {} :: { [string]: boolean },
    Muted = {} :: { [number]: boolean },
    Message = "",
}

local render: () -> ()

local function close()
    panel.Visible = false
end

local function teleport(destinationId: string)
    teleportRequest:FireServer(destinationId)
    close()
end

local function completedSet(category: string): { [string]: boolean }
    local set = {}
    local profile = state.Profile

    if profile and profile.Completed and profile.Completed[category] then
        for _, id in ipairs(profile.Completed[category]) do
            set[id] = true
        end
    end

    return set
end

-- Tabs ---------------------------------------------------------------------------------------

local tabs = {}

function tabs.Seerah()
    local data = state.Campaign

    if not data then
        UiKit.Paragraph(content, "Loading the campaign...", 16)
        return
    end

    UiKit.Paragraph(content, string.format("<b>The Seerah campaign</b>: %d of %d chapters complete. Chapters open in order. The Prophet ﷺ is never shown or voiced: his life is told in written narration only, in historical reconstructions of Makkah and Madinah.", data.DoneCount, data.Total), 15)

    local era = ""

    for index, entry in ipairs(data.Checklist) do
        if entry.Era ~= era then
            era = entry.Era
            local heading = UiKit.Paragraph(content, if era == "Makkah" then "The Makkan years" else "The Madinan years", 18, true, C.Gold)
            heading.LayoutOrder = index * 2 - 1
        end

        local status = if entry.Done then "Done" elseif entry.Unlocked then "Open" else "Locked"
        local buttons = {}

        if entry.Unlocked then
            table.insert(buttons, {
                Text = if entry.Done then "Replay" else "Start",
                Color = if entry.Done then C.Blue else C.Green,
                OnClick = function()
                    campaignRequest:FireServer("Start", entry.Id)
                    close()
                end,
            })
        end

        local row = UiKit.Row(content, index * 2, string.format("%s  %d. %s", if entry.Done then "✓" elseif entry.Unlocked then "▶" else "🔒", entry.Number, entry.Title), string.format("%s  ·  %s", entry.When, status), buttons)
        row.LayoutOrder = index * 2
    end
end

function tabs.Mysteries()
    local solved = completedSet("mystery")
    local stats = (state.Profile and state.Profile.Stats) or {}

    UiKit.Paragraph(content, "<b>Sahabi Mystery Rooms</b>: escape-room puzzles about the companions. Friends in the same room share clues. Clue objects are game props; every room ends with the documented story and its sources.", 15)

    for index, mystery in ipairs(SahabiMysteries.Mysteries) do
        local stars = stats["MysteryStars_" .. mystery.Id] or 0
        local status = if solved[mystery.Id] then string.format("Solved  %s", string.rep("★", stars) .. string.rep("☆", 3 - stars)) else "Not solved yet"
        UiKit.Row(content, index, mystery.Title, string.format("%s  ·  %s", mystery.Tagline, status), {
            {
                Text = "Go",
                Color = C.Purple,
                OnClick = function()
                    mysteryRequest:FireServer("Teleport", mystery.Id)
                    close()
                end,
            },
        })
    end
end

function tabs.Activities()
    local stats = (state.Profile and state.Profile.Stats) or {}
    local best = stats.ParkourBest_lobby_tower
    local rows = {
        { "Old Makkah (historical)", "Seerah reconstruction of Makkah, c. 570-630 CE. Not today's city.", "seerah_campaign" },
        { "Old Madinah (historical)", "Seerah reconstruction of Madinah, c. 622-632 CE. Not today's city.", "seerah_madinah" },
        { "Masjid al-Haram (today)", "Present-day Makkah: explore today's mosque around the Kaaba.", "kaaba_courtyard" },
        { "Prophet's Mosque (today)", "Present-day Madinah: the courtyard of today's Masjid an-Nabawi.", "medina_courtyard" },
        { "Lobby Parkour Tower", if best and best > 0 then "Your best time: " .. ParkourRules.FormatTime(best) else "Timed climb with checkpoints. No best time yet.", "parkour_tower" },
        { "Trials of Brotherhood", "Two-player co-op puzzles. Bring a friend.", "coop_trials" },
        { "Training Grounds", "PvP sparring for 2-8 players, first to 3 rounds.", "training_grounds" },
        { "Badr and Uhud gates", "Story Missions and Team Skirmish.", "badr_gate" },
    }

    for index, entry in ipairs(rows) do
        local buttons = {
            {
                Text = "Go",
                OnClick = function()
                    teleport(entry[3])
                end,
            },
        }

        if entry[3] == "training_grounds" then
            table.insert(buttons, {
                Text = "Join match",
                Color = C.Red,
                OnClick = function()
                    pvpRequest:FireServer("Teleport")
                    task.delay(0.6, function()
                        pvpRequest:FireServer("Join")
                    end)
                    close()
                end,
            })
        end

        UiKit.Row(content, index, entry[1], entry[2], buttons)
    end
end

local function inviteFriends()
    local ok, canInvite = pcall(function()
        return SocialService:CanSendGameInviteAsync(player)
    end)

    if ok and canInvite then
        pcall(function()
            SocialService:PromptGameInvite(player)
        end)
    else
        state.Message = "Invites aren't available on this account or device. Friends can still join you from the Roblox app."
        render()
    end
end

function tabs.Friends()
    UiKit.Paragraph(content, "<b>Play together</b>: invite friends, jump to a friend's activity, and keep chat friendly. Voice chat is Roblox's own: it works only for eligible players (13+ and verified) who turned it on. Mute, block, and report always work.", 15)

    if state.Message ~= "" then
        UiKit.Paragraph(content, state.Message, 14, true, C.Gold)
    end

    UiKit.Row(content, 1, "Invite friends", "Send a Roblox invite to friends so they can join this server.", {
        { Text = "Invite", OnClick = inviteFriends },
    })

    local order = 2

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local muted = state.Muted[other.UserId] == true
            local voice = state.Voice[tostring(other.UserId)]
            local body = string.format("@%s%s", other.Name, if voice then "  ·  voice on" else "")
            local row = UiKit.Row(content, order, other.DisplayName, body, {
                {
                    Text = "Join",
                    Color = C.Blue,
                    OnClick = function()
                        socialRequest:FireServer("JumpTo", other.UserId)
                        close()
                    end,
                },
                {
                    Text = if muted then "Unmute" else "Mute",
                    Color = C.PanelLight,
                    OnClick = function()
                        socialRequest:FireServer("Mute", { UserId = other.UserId, Muted = not muted })
                    end,
                },
            })

            -- Block and report sit on a second line so they are never pressed by accident.
            row.Size = UDim2.new(1, 0, 0, 110)
            UiKit.Button(row, "Block", UDim2.fromOffset(108, 36), UDim2.new(1, -232, 0, 64), C.Red, function()
                pcall(function()
                    StarterGui:SetCore("PromptBlockPlayer", other)
                end)
            end)
            UiKit.Button(row, "Report", UDim2.fromOffset(108, 36), UDim2.new(1, -116, 0, 64), C.Red, function()
                state.Message = string.format("To report %s: open the Roblox menu (Esc, or the Roblox logo at the top left), choose Report, and pick them from the list. Reports go straight to Roblox.", other.DisplayName)
                render()
            end)
            order += 1
        end
    end

    if order == 2 then
        UiKit.Paragraph(content, "Nobody else is in this server yet. Invite a friend!", 15, false, C.Muted)
    end
end

function tabs.Support()
    local data = state.Support or {}

    UiKit.Paragraph(content, "<b>Support the game</b>: everything here is optional. No lesson, chapter, or mission is ever locked behind an ad or a purchase.", 15)

    if data.Message then
        UiKit.Paragraph(content, data.Message, 14, true, C.Gold)
    end

    local adBody = if data.AdsConfigured == false
        then "Rewarded videos are not set up for this game yet."
        else string.format("Watch a short video for +%d Knowledge Tokens. %d left today. Roblox only shows ads to eligible players.", data.RewardTokens or 0, data.AdsLeftToday or 0)

    UiKit.Row(content, 1, "Watch a video", adBody, {
        {
            Text = "Watch",
            OnClick = function()
                supportRequest:FireServer("WatchAd")
            end,
        },
    })

    UiKit.Row(content, 2, "Item Shop", "Cosmetic outfits and support packs.", {
        {
            Text = "Open",
            Color = C.Blue,
            OnClick = function()
                close()
                local shop = playerGui:FindFirstChild("ShopMenu")
                local shopPanel = shop and shop:FindFirstChild("Panel")

                if shopPanel and shopPanel:IsA("GuiObject") then
                    shopPanel.Visible = true
                end
            end,
        },
    })

    if data.IsCreator then
        UiKit.Row(content, 3, "Creator numbers (last 14 days)", "Revenue, ads, joins, and returns recorded by this game. Creator Hub has the official totals.", {
            {
                Text = "Load",
                Color = C.Purple,
                OnClick = function()
                    supportRequest:FireServer("Ledger")
                end,
            },
        })

        if data.Ledger then
            local lines = { "<b>Day (UTC)  Robux  Purchases  Ads  Joins  New  D1  D7  Minutes</b>" }

            for _, row in ipairs(data.Ledger) do
                local d = row.Data
                table.insert(lines, string.format("%s  %d  %d  %d  %d  %d  %d  %d  %d", os.date("!%Y-%m-%d", row.Day * 86400), d.RobuxSpent or 0, d.Purchases or 0, d.AdRewards or 0, d.Joins or 0, d.NewPlayers or 0, d.D1Returns or 0, d.D7Returns or 0, d.SessionMinutes or 0))
            end

            local costs = data.Costs or {}
            local monthly = (costs.SponsoredAds or 0) + (costs.AssetUploads or 0) + (costs.Other or 0)
            local taken = 0

            for _, row in ipairs(data.Ledger) do
                taken += row.Data.RobuxSpent or 0
            end

            local periodCosts = math.floor(monthly * #data.Ledger / 30 + 0.5)
            table.insert(lines, string.format("Robux spent by players over these %d days: %d. Costs for the same days: %d (from %d a month in MonetizationConfig). Before the Roblox fee: %d.", #data.Ledger, taken, periodCosts, monthly, taken - periodCosts))
            local label = UiKit.Paragraph(content, table.concat(lines, "\n"), 13)
            label.LayoutOrder = 4
            label.Font = Enum.Font.Code
        end
    end
end

local TAB_ORDER = { "Seerah", "Mysteries", "Activities", "Friends", "Support" }

for _, name in ipairs(TAB_ORDER) do
    UiKit.Button(tabBar, name, UDim2.fromOffset(136, 36), UDim2.new(), C.PanelLight, function()
        state.Tab = name

        if name == "Friends" then
            state.Message = ""
            socialRequest:FireServer("Voice")
        elseif name == "Support" then
            supportRequest:FireServer("State")
        end

        render()
    end)
end

render = function()
    UiKit.Clear(content)

    for _, button in ipairs(tabBar:GetChildren()) do
        if button:IsA("TextButton") then
            button.BackgroundColor3 = if button.Text == state.Tab then C.Gold else C.PanelLight
            button.TextColor3 = if button.Text == state.Tab then Color3.fromRGB(30, 30, 24) else C.Text
        end
    end

    local ok, err = pcall(tabs[state.Tab])

    if not ok then
        warn("[JourneyBook] " .. tostring(err))
    end
end

campaignState.OnClientEvent:Connect(function(data)
    state.Campaign = data

    if panel.Visible and state.Tab == "Seerah" then
        render()
    end
end)

profileUpdated.OnClientEvent:Connect(function(snapshot)
    state.Profile = snapshot

    if panel.Visible and state.Tab ~= "Seerah" and state.Tab ~= "Friends" then
        render()
    end
end)

socialState.OnClientEvent:Connect(function(data)
    if data.Voice then
        state.Voice = data.Voice
    end

    if data.Muted then
        state.Muted[data.Muted.UserId] = data.Muted.Muted
    end

    if data.Message then
        state.Message = data.Message
    end

    if panel.Visible and state.Tab == "Friends" then
        render()
    end
end)

supportState.OnClientEvent:Connect(function(data)
    local previous = state.Support or {}

    if data.Ledger == nil then
        data.Ledger = previous.Ledger
        data.Costs = previous.Costs
    end

    state.Support = data

    if panel.Visible and state.Tab == "Support" then
        render()
    end
end)

panel:GetPropertyChangedSignal("Visible"):Connect(function()
    if panel.Visible then
        campaignRequest:FireServer("State")
        render()
    end
end)

Players.PlayerAdded:Connect(function()
    if panel.Visible and state.Tab == "Friends" then
        render()
    end
end)

Players.PlayerRemoving:Connect(function()
    if panel.Visible and state.Tab == "Friends" then
        task.defer(render)
    end
end)

campaignRequest:FireServer("State")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="83">
        <Properties>
          <string name="Name">JourneyHud</string>
          <string name="Source"><![CDATA[--!strict

-- On-screen guidance for the Seerah campaign, the mystery rooms, parkour runs, the co-op
-- trials, and sparring matches. Everything shown here comes from the server's state messages;
-- the client only displays it and sends the player's choices back.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SeerahCampaign = require(Shared.Data.SeerahCampaign)
local HistoricalSites = require(Shared.Data.HistoricalSites)
local SahabiMysteries = require(Shared.Data.SahabiMysteries)
local BattleScenarios = require(Shared.Data.BattleScenarios)
local ParkourRules = require(Shared.Modules.ParkourRules)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local C = UiKit.Colors

local function remote(folder: string, name: string): RemoteEvent
    return remotes:WaitForChild(folder):WaitForChild(name) :: RemoteEvent
end

local campaignRequest, campaignState = remote("Campaign", "Request"), remote("Campaign", "State")
local mysteryRequest, mysteryState = remote("Mystery", "Request"), remote("Mystery", "State")
local parkourRequest, parkourState = remote("Parkour", "Request"), remote("Parkour", "State")
local coopState = remote("Coop", "State")
local pvpRequest, pvpState = remote("Pvp", "Request"), remote("Pvp", "State")

local chapterById = {}

for _, chapter in ipairs(SeerahCampaign.Chapters) do
    chapterById[chapter.Id] = chapter
end

local mysteryById = {}

for _, mystery in ipairs(SahabiMysteries.Mysteries) do
    mysteryById[mystery.Id] = mystery
end

local gui = Instance.new("ScreenGui")
gui.Name = "JourneyHud"
gui.ResetOnSpawn = false
gui.DisplayOrder = 105
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

-- Toasts ------------------------------------------------------------------------------------

local toasts = Instance.new("Frame")
toasts.BackgroundTransparency = 1
toasts.Size = UDim2.fromOffset(520, 200)
toasts.Position = UDim2.new(0.5, 0, 0, 70)
toasts.AnchorPoint = Vector2.new(0.5, 0)
toasts.Parent = gui

local toastLayout = Instance.new("UIListLayout")
toastLayout.Padding = UDim.new(0, 6)
toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
toastLayout.Parent = toasts

local function toast(text: string, color: Color3?)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 0)
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.BackgroundColor3 = color or C.Panel
    label.BackgroundTransparency = 0.1
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextColor3 = C.Text
    label.TextSize = 16
    label.TextWrapped = true
    label.Parent = toasts
    UiKit.Round(label, 8)

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 8)
    padding.PaddingBottom = UDim.new(0, 8)
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 10)
    padding.Parent = label

    task.delay(4.5, function()
        label:Destroy()
    end)
end

-- Modal (story pages, questions, conclusions) -----------------------------------------------

local modal = UiKit.Frame(gui, "Modal", UDim2.fromOffset(640, 440), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
modal.Visible = false
local modalTitle = UiKit.Label(modal, "", UDim2.new(1, -36, 0, 34), UDim2.fromOffset(18, 14), 22, true, C.Gold)
local modalBody = UiKit.Scroller(modal, UDim2.new(1, -36, 1, -170), UDim2.fromOffset(18, 54))
local modalButtons = Instance.new("Frame")
modalButtons.BackgroundTransparency = 1
modalButtons.Size = UDim2.new(1, -36, 0, 100)
modalButtons.Position = UDim2.new(0, 18, 1, -110)
modalButtons.Parent = modal

local buttonGrid = Instance.new("UIGridLayout")
buttonGrid.CellSize = UDim2.new(0.5, -6, 0, 44)
buttonGrid.CellPadding = UDim2.fromOffset(8, 8)
buttonGrid.HorizontalAlignment = Enum.HorizontalAlignment.Center
buttonGrid.Parent = modalButtons

type ButtonSpec = { Text: string, Color: Color3?, OnClick: () -> () }

local modalOwner = ""

local function showModal(owner: string, title: string, paragraphs: { string }, buttons: { ButtonSpec })
    modalOwner = owner
    modalTitle.Text = title
    UiKit.Clear(modalBody)
    UiKit.Clear(modalButtons)

    for index, text in ipairs(paragraphs) do
        UiKit.Paragraph(modalBody, text, 16).LayoutOrder = index
    end

    for _, spec in ipairs(buttons) do
        UiKit.Button(modalButtons, spec.Text, UDim2.new(), UDim2.new(), spec.Color, spec.OnClick)
    end

    modalBody.CanvasPosition = Vector2.zero
    modal.Visible = true
end

local function hideModal(owner: string?)
    if owner == nil or modalOwner == owner then
        modal.Visible = false
        modalOwner = ""
    end
end

-- Seerah campaign ---------------------------------------------------------------------------

local card = UiKit.Frame(gui, "CampaignCard", UDim2.fromOffset(560, 118), UDim2.new(0.5, 0, 1, -16), Vector2.new(0.5, 1))
card.Visible = false
local cardTitle = UiKit.Label(card, "", UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 8), 17, true, C.Gold)
local cardBody = UiKit.Label(card, "", UDim2.new(1, -24, 0, 40), UDim2.fromOffset(12, 32), 14)
local cardButtons = Instance.new("Frame")
cardButtons.BackgroundTransparency = 1
cardButtons.Size = UDim2.new(1, -24, 0, 36)
cardButtons.Position = UDim2.new(0, 12, 1, -42)
cardButtons.Parent = card

local cardLayout = Instance.new("UIListLayout")
cardLayout.FillDirection = Enum.FillDirection.Horizontal
cardLayout.Padding = UDim.new(0, 8)
cardLayout.Parent = cardButtons

local function setCard(title: string, body: string, buttons: { ButtonSpec })
    cardTitle.Text = title
    cardBody.Text = body
    UiKit.Clear(cardButtons)

    for _, spec in ipairs(buttons) do
        UiKit.Button(cardButtons, spec.Text, UDim2.fromOffset(160, 34), UDim2.new(), spec.Color, spec.OnClick)
    end

    card.Visible = true
end

local campaign = { Run = nil :: any, StoryPage = 1, LastStage = "", LastChapter = "" }
local marker: Part? = nil

local function clearMarker()
    if marker then
        marker:Destroy()
        marker = nil
    end
end

-- A tall light at the chapter's site, visible only to this player.
local function showMarker(position: Vector3)
    clearMarker()
    local beam = Instance.new("Part")
    beam.Name = "ChapterMarker"
    beam.Anchored = true
    beam.CanCollide = false
    beam.CanQuery = false
    beam.CanTouch = false
    beam.Material = Enum.Material.Neon
    beam.Color = C.Gold
    beam.Transparency = 0.45
    beam.Size = Vector3.new(2, 120, 2)
    beam.CFrame = CFrame.new(position + Vector3.new(0, 60, 0))
    beam.Parent = Workspace
    marker = beam
end

-- Collect items: show only this chapter's, and only the ones not yet picked up.
local function updateItems(run: any)
    local world = Workspace:FindFirstChild(HistoricalSites.FolderName)
    local items = world and world:FindFirstChild("CampaignItems")

    if not items then
        return
    end

    local collected = {}

    if run then
        for _, index in ipairs(run.Collected or {}) do
            collected[index] = true
        end
    end

    for _, folder in ipairs(items:GetChildren()) do
        local active = run ~= nil and run.Stage == "Activity" and folder.Name == run.ChapterId

        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("BasePart") then
                local visible = active and not collected[item:GetAttribute("ItemIndex") :: number]
                item.Transparency = if visible then 0.1 else 1
                local prompt = item:FindFirstChildOfClass("ProximityPrompt")

                if prompt then
                    prompt.Enabled = visible
                end
            end
        end
    end
end

local function battleName(scenarioId: string?): string
    for _, scenario in ipairs(BattleScenarios) do
        if scenario.Id == scenarioId then
            return scenario.DisplayName
        end
    end

    return "the battle"
end

local function peopleText(chapter: any): string
    local lines = {}

    for _, person in ipairs(chapter.People) do
        table.insert(lines, string.format("• <b>%s</b>: %s", person.Name, person.Role))
    end

    return table.concat(lines, "\n")
end

local function showStoryPage(chapter: any)
    local page = campaign.StoryPage
    local total = #chapter.Story
    local paragraphs = { chapter.Story[page] }

    if page == 1 then
        table.insert(paragraphs, 1, string.format("<i>%s · %s</i>", chapter.When, (HistoricalSites.GetSite(chapter.Site) :: any).DisplayName))
        table.insert(paragraphs, "<b>People in this chapter</b>\n" .. peopleText(chapter))
    end

    local buttons: { ButtonSpec } = {}

    if page > 1 then
        table.insert(buttons, {
            Text = "Back",
            Color = C.PanelLight,
            OnClick = function()
                campaign.StoryPage -= 1
                showStoryPage(chapter)
            end,
        })
    end

    table.insert(buttons, {
        Text = if page < total then "Next" else "Continue",
        OnClick = function()
            if page < total then
                campaign.StoryPage += 1
                showStoryPage(chapter)
            else
                hideModal("campaign")
                campaignRequest:FireServer("FinishStory")
            end
        end,
    })

    showModal("campaign", string.format("Chapter %d: %s  (%d/%d)", chapter.Number, chapter.Title, page, total), paragraphs, buttons)
end

local function showDecision(chapter: any, retryText: string?)
    local buttons: { ButtonSpec } = {}

    for index, option in ipairs(chapter.Decision.Options) do
        table.insert(buttons, {
            Text = option,
            Color = C.Blue,
            OnClick = function()
                campaignRequest:FireServer("Answer", index)
            end,
        })
    end

    local paragraphs = { chapter.Decision.Prompt }

    if retryText then
        table.insert(paragraphs, string.format("<font color=\"#E2BA60\">%s</font>", retryText))
    end

    -- Four options need two rows of buttons; make room.
    showModal("campaign", string.format("Chapter %d: what happened?", chapter.Number), paragraphs, buttons)
end

local function showConclusion(chapter: any, explanation: string)
    local sources = {}

    for _, source in ipairs(chapter.Sources) do
        table.insert(sources, "• " .. source)
    end

    local nextChapter = SeerahCampaign.Chapters[chapter.Number + 1]
    local buttons: { ButtonSpec } = {
        {
            Text = "Close",
            Color = C.PanelLight,
            OnClick = function()
                hideModal("campaign")
                campaignRequest:FireServer("Close")
            end,
        },
    }

    if nextChapter then
        table.insert(buttons, {
            Text = "Next chapter",
            OnClick = function()
                hideModal("campaign")
                campaignRequest:FireServer("Start", nextChapter.Id)
            end,
        })
    end

    showModal("campaign", string.format("Chapter %d complete: %s", chapter.Number, chapter.Title), {
        "<b>Correct.</b> " .. explanation,
        "<b>What happened next</b>\n" .. chapter.Consequence,
        "<b>Lesson</b>\n" .. chapter.Lesson,
        "<b>Sources</b>\n" .. table.concat(sources, "\n"),
        "<b>History and gameplay</b>\n" .. chapter.GameplayNote,
    }, buttons)
end

local function renderCampaign(data: any)
    local run = data.Run
    campaign.Run = run
    updateItems(run)

    if not run then
        card.Visible = false
        clearMarker()
        hideModal("campaign")
        return
    end

    local chapter = chapterById[run.ChapterId]
    local site = chapter and HistoricalSites.GetSite(chapter.Site)

    if not chapter or not site then
        return
    end

    local changed = run.Stage ~= campaign.LastStage or run.ChapterId ~= campaign.LastChapter
    campaign.LastStage = run.Stage
    campaign.LastChapter = run.ChapterId
    local heading = string.format("Seerah %d/30 · %s", chapter.Number, chapter.Title)
    local quit = { Text = "Leave chapter", Color = C.PanelLight, OnClick = function()
        campaignRequest:FireServer("Close")
    end }

    if run.Stage == "Travel" then
        showMarker(HistoricalSites.ArrivalPoint(site))
        hideModal("campaign")
        setCard(heading, string.format("Go to <b>%s</b>. Follow the golden light and stand in the ring.%s", site.DisplayName, if site.Kind == "Mountain" then " Climb the ramps to the cave ledge." else ""), {
            { Text = "Travel there", OnClick = function()
                campaignRequest:FireServer("Travel")
            end },
            quit,
        })
    elseif run.Stage == "Story" then
        clearMarker()
        card.Visible = false

        if changed then
            campaign.StoryPage = 1
        end

        showStoryPage(chapter)
    elseif run.Stage == "Activity" then
        hideModal("campaign")
        local activity = chapter.Activity

        if not activity then
            return
        end

        if activity.Kind == "Collect" then
            showMarker(HistoricalSites.ArrivalPoint(site))
            setCard(heading, string.format("Find %d %s%s around %s (%d/%d). Glowing objects are game items.", activity.Count, activity.Item, if activity.Count > 1 then "s" else "", site.DisplayName, #(run.Collected or {}), activity.Count), { quit })
        else
            clearMarker()
            setCard(heading, string.format("Play the <b>%s</b> Story Mission, then come back here.", battleName(activity.ScenarioId)), {
                { Text = "Go to the gate", Color = C.Red, OnClick = function()
                    campaignRequest:FireServer("GoBattle")
                end },
                { Text = "I finished it", OnClick = function()
                    campaignRequest:FireServer("CheckBattle")
                end },
                quit,
            })
        end
    elseif run.Stage == "Decision" then
        clearMarker()
        card.Visible = false
        local feedback = data.Feedback

        showDecision(chapter, if feedback and feedback.Kind == "retry" then feedback.Text else nil)
    elseif run.Stage == "Done" then
        clearMarker()
        card.Visible = false
        local feedback = data.Feedback

        if feedback and feedback.Kind == "success" then
            showConclusion(chapter, feedback.Text)
        end
    end

    if data.Feedback and data.Feedback.Kind ~= "retry" and data.Feedback.Kind ~= "success" then
        toast(data.Feedback.Text)
    elseif data.Feedback and data.Feedback.Kind == "success" and run.Stage ~= "Done" then
        toast(data.Feedback.Text, C.Green)
    end
end

campaignState.OnClientEvent:Connect(function(data)
    local ok, err = pcall(renderCampaign, data)

    if not ok then
        warn("[JourneyHud] campaign: " .. tostring(err))
    end
end)

-- Mystery rooms -----------------------------------------------------------------------------

local mysteryCard = UiKit.Frame(gui, "MysteryCard", UDim2.fromOffset(320, 150), UDim2.new(1, -16, 0, 80), Vector2.new(1, 0))
mysteryCard.Visible = false
local mysteryTitle = UiKit.Label(mysteryCard, "", UDim2.new(1, -20, 0, 22), UDim2.fromOffset(10, 8), 16, true, C.Gold)
local mysteryBody = UiKit.Label(mysteryCard, "", UDim2.new(1, -20, 0, 70), UDim2.fromOffset(10, 32), 14)
UiKit.Button(mysteryCard, "Hint", UDim2.fromOffset(90, 30), UDim2.new(0, 10, 1, -38), C.Blue, function()
    mysteryRequest:FireServer("Hint")
end)

local lockAnswers: { number } = {}

local function showLock(mystery: any, questionIndex: number)
    local question = mystery.Lock[questionIndex]
    local buttons: { ButtonSpec } = {}

    for optionIndex, option in ipairs(question.Options) do
        table.insert(buttons, {
            Text = option,
            Color = C.Purple,
            OnClick = function()
                lockAnswers[questionIndex] = optionIndex

                if questionIndex < #mystery.Lock then
                    showLock(mystery, questionIndex + 1)
                else
                    hideModal("mystery")
                    mysteryRequest:FireServer("Lock", lockAnswers)
                end
            end,
        })
    end

    showModal("mystery", string.format("The lock (%d/%d)", questionIndex, #mystery.Lock), { question.Prompt }, buttons)
end

local function showMysteryConclusion(mystery: any, data: any)
    local sources = {}

    for _, source in ipairs(mystery.Sources) do
        table.insert(sources, "• " .. source)
    end

    local paragraphs = { string.format("<b>%s</b>   %s", data.FinishText or mystery.Episode.FinishText, string.rep("★", data.Stars) .. string.rep("☆", 3 - data.Stars)) }

    for _, text in ipairs(mystery.Conclusion) do
        table.insert(paragraphs, text)
    end

    table.insert(paragraphs, "<b>Sources</b>\n" .. table.concat(sources, "\n"))
    table.insert(paragraphs, "<b>History and gameplay</b>\n" .. mystery.FictionNote)

    showModal("mystery", string.format("Solved: %s", mystery.Companion), paragraphs, {
        { Text = "Close", OnClick = function()
            hideModal("mystery")
        end },
    })
end

mysteryState.OnClientEvent:Connect(function(data)
    if not data.InRoom then
        mysteryCard.Visible = false
        hideModal("mystery")
        return
    end

    local mystery = mysteryById[data.MysteryId]

    if not mystery then
        return
    end

    local stage = if data.Done then "Episode complete" elseif data.LockOpen then string.format("Episode: %s. Next: %s", mystery.Episode.Title, if data.NextStation then mystery.Episode.Stations[data.NextStation].Name else "-") else "Examine the objects, then open the lock on the far door."
    mysteryTitle.Text = mystery.Title
    mysteryBody.Text = string.format("Clues %d/%d · Hints used %d · %d here\n%s", #data.Found, #mystery.Clues, data.HintsUsed, data.Players, stage)
    mysteryCard.Visible = true

    if data.ShowClue then
        for _, clue in ipairs(mystery.Clues) do
            if clue.Id == data.ShowClue then
                showModal("mystery", clue.Object, { clue.Text, "<i>This object is a game prop. The event it describes is documented.</i>" }, {
                    { Text = "Close", OnClick = function()
                        hideModal("mystery")
                    end },
                })
            end
        end
    end

    if data.OpenLock and not data.LockOpen then
        lockAnswers = {}
        showLock(mystery, 1)
    end

    if data.Toast then
        toast(data.Toast, C.Purple)
    end

    if data.Finished then
        showMysteryConclusion(mystery, data)
    end

    if data.Reset then
        toast("The room has reset for the next group.")
    end
end)

-- Parkour -----------------------------------------------------------------------------------

local timer = UiKit.Label(gui, "", UDim2.fromOffset(260, 40), UDim2.new(0.5, -130, 0, 24), 26, true, C.Gold)
timer.TextXAlignment = Enum.TextXAlignment.Center
timer.Visible = false
local parkour = { StartedAt = nil :: number?, Offset = 0 }

local checkpointButton = UiKit.Button(gui, "Back to checkpoint", UDim2.fromOffset(170, 36), UDim2.new(0.5, -85, 0, 66), C.Blue, function()
    parkourRequest:FireServer("Checkpoint")
end)
checkpointButton.Visible = false

parkourState.OnClientEvent:Connect(function(data)
    parkour.Offset = (data.ServerNow or Workspace:GetServerTimeNow()) - Workspace:GetServerTimeNow()
    parkour.StartedAt = if data.Active then data.StartedAt else nil
    timer.Visible = data.Active == true
    checkpointButton.Visible = data.Active == true and (data.Checkpoint or 0) >= 2

    if data.Event == "start" then
        toast("Timer started. Gold steps are checkpoints.", C.Green)
    elseif data.Event == "checkpoint" then
        toast(string.format("Checkpoint %d of %d", data.Checkpoint - 1, data.Total - 2), C.Green)
    elseif data.Event == "fell" then
        toast("Back to your last checkpoint.")
    elseif data.Event == "finish" then
        toast(string.format("Summit! %s%s", data.Text, if data.Improved then " · new best time" else ""), C.Gold)
    elseif data.Event == "rejected" then
        toast("That run was too fast to count. Climb from the start pad.", C.Red)
    end
end)

RunService.RenderStepped:Connect(function()
    if parkour.StartedAt then
        timer.Text = ParkourRules.FormatTime(math.max(0, Workspace:GetServerTimeNow() + parkour.Offset - parkour.StartedAt))
    end
end)

-- Co-op trials ------------------------------------------------------------------------------

local lastCoop = ""

coopState.OnClientEvent:Connect(function(data)
    if data.Event == "finish" then
        toast(string.format("Trials of Brotherhood complete with %d players!", data.Players or 2), C.Gold)
    elseif data.Event == "state" then
        local text = if data.StairsDown then "The stairway is down: climb!" elseif data.LiftUp then "The lift is rising." elseif data.GateOpen then "The gate is open." else ""

        if text ~= "" and text ~= lastCoop then
            toast(text, C.Blue)
        end

        lastCoop = text
    end
end)

-- Sparring ----------------------------------------------------------------------------------

local board = UiKit.Frame(gui, "PvpBoard", UDim2.fromOffset(280, 260), UDim2.new(0, 16, 0, 80))
board.Visible = false
local boardTitle = UiKit.Label(board, "Training Grounds", UDim2.new(1, -20, 0, 22), UDim2.fromOffset(10, 8), 17, true, C.Gold)
local boardBody = UiKit.Label(board, "", UDim2.new(1, -20, 0, 160), UDim2.fromOffset(10, 34), 14)
local boardButtons = Instance.new("Frame")
boardButtons.BackgroundTransparency = 1
boardButtons.Size = UDim2.new(1, -20, 0, 36)
boardButtons.Position = UDim2.new(0, 10, 1, -44)
boardButtons.Parent = board
local boardLayout = Instance.new("UIListLayout")
boardLayout.FillDirection = Enum.FillDirection.Horizontal
boardLayout.Padding = UDim.new(0, 8)
boardLayout.Parent = boardButtons

local pvp = { RoundEndsAt = nil :: number?, CountdownEndsAt = nil :: number?, Phase = "" }

pvpState.OnClientEvent:Connect(function(data)
    board.Visible = data.InMatch == true

    if data.Banner then
        toast(data.Banner, C.Red)
    end

    if not data.InMatch then
        return
    end

    pvp.Phase = data.Phase

    if data.RoundEndsAt then
        pvp.RoundEndsAt = data.RoundEndsAt
    end

    if data.CountdownEndsAt then
        pvp.CountdownEndsAt = data.CountdownEndsAt
    end

    table.sort(data.Players, function(a, b)
        return a.Wins > b.Wins
    end)

    local lines = { string.format("Round %d · first to %d", data.Round, data.RoundsToWin) }

    for _, row in ipairs(data.Players) do
        table.insert(lines, string.format("%s%s  %d wins · %d KOs%s", if row.Alive then "● " else "○ ", data.Names[tostring(row.UserId)] or "Player", row.Wins, row.Knockouts, if row.Rematch then " · ready" else ""))
    end

    boardBody.Text = table.concat(lines, "\n")
    boardTitle.Text = if data.Phase == "Over" then "Match over" else "Training Grounds"
    UiKit.Clear(boardButtons)

    if data.Phase == "Over" then
        UiKit.Button(boardButtons, "Play again", UDim2.fromOffset(124, 34), UDim2.new(), C.Green, function()
            pvpRequest:FireServer("Rematch")
        end)
    end

    UiKit.Button(boardButtons, "Leave", UDim2.fromOffset(124, 34), UDim2.new(), C.PanelLight, function()
        pvpRequest:FireServer("Leave")
    end)
end)

RunService.Heartbeat:Connect(function()
    if not board.Visible then
        return
    end

    local now = Workspace:GetServerTimeNow()

    if pvp.Phase == "Round" and pvp.RoundEndsAt then
        boardTitle.Text = string.format("Round time %ds", math.max(0, math.ceil(pvp.RoundEndsAt - now)))
    elseif pvp.CountdownEndsAt and pvp.CountdownEndsAt > now then
        boardTitle.Text = string.format("Next round in %ds", math.ceil(pvp.CountdownEndsAt - now))
    end
end)

-- Ask for the current state once everything is connected.
campaignRequest:FireServer("State")
parkourRequest:FireServer("State")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="84">
        <Properties>
          <string name="Name">LearningHall</string>
          <string name="Source"><![CDATA[--!strict

-- Islamic Studies hall: browse units, read a lesson page by page, take its checkpoint quiz
-- (graded by the server), and view the journal of levels and badges.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local IslamicStudies = require(Shared.Data.IslamicStudies)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local progressFolder = remotesFolder:WaitForChild("Progress")
local learningFolder = remotesFolder:WaitForChild("Learning")
local profileUpdated = progressFolder:WaitForChild("ProfileUpdated") :: RemoteEvent
local openLearningHall = learningFolder:WaitForChild("OpenLearningHall") :: RemoteEvent
local submitQuiz = learningFolder:WaitForChild("SubmitQuiz") :: RemoteEvent
local quizResult = learningFolder:WaitForChild("QuizResult") :: RemoteEvent
local submitOrder = learningFolder:WaitForChild("SubmitOrder") :: RemoteEvent
local orderResult = learningFolder:WaitForChild("OrderResult") :: RemoteEvent
local submitDailyAnswer = learningFolder:WaitForChild("SubmitDailyAnswer") :: RemoteEvent
local dailyResult = learningFolder:WaitForChild("DailyResult") :: RemoteEvent

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local COLORS = {
    Parchment = Color3.fromRGB(246, 238, 218),
    Card = Color3.fromRGB(255, 251, 240),
    Ink = Color3.fromRGB(42, 38, 30),
    SoftInk = Color3.fromRGB(88, 78, 62),
    Border = Color3.fromRGB(101, 83, 55),
    Gold = Color3.fromRGB(193, 162, 86),
    Success = Color3.fromRGB(63, 120, 78),
    Danger = Color3.fromRGB(150, 74, 60),
    Locked = Color3.fromRGB(176, 168, 150),
    Light = Color3.fromRGB(250, 246, 234),
}

type Snapshot = {
    Level: number,
    XP: number,
    XPIntoLevel: number,
    XPForNext: number,
    RankTitle: string,
    Badges: { { Id: string, DisplayName: string, Description: string, Earned: boolean } },
    Completed: { [string]: { string } },
    Stats: { [string]: number },
    Path: { { Id: string, Title: string, Hint: string, Done: boolean } },
    NextStep: { Title: string, Hint: string }?,
    Daily: any,
}

local snapshot: Snapshot? = nil
local pendingLessonId: string? = nil
local refreshCurrentView: (() -> ())? = nil
local dailyAnswerPending = false
local lastDailyResult: any = nil

local unitById = {}
local lessonById = {}
local unitIdByLessonId = {}

for _, unit in ipairs(IslamicStudies.Units) do
    unitById[unit.Id] = unit

    for _, lesson in ipairs(unit.Lessons) do
        lessonById[lesson.Id] = lesson
        unitIdByLessonId[lesson.Id] = unit.Id
    end
end

local function rgb(values: { number }): Color3
    return Color3.fromRGB(values[1], values[2], values[3])
end

local function completedSet(category: string): { [string]: boolean }
    local set = {}

    if snapshot and snapshot.Completed[category] then
        for _, id in ipairs(snapshot.Completed[category]) do
            set[id] = true
        end
    end

    return set
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LearningHall"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 1001
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.52)
panel.Size = UDim2.fromScale(0.94, 0.86)
panel.BackgroundColor3 = COLORS.Parchment
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = screenGui

local panelLimit = Instance.new("UISizeConstraint")
panelLimit.MaxSize = Vector2.new(900, 600)
panelLimit.Parent = panel

local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 18)
panelCorner.Parent = panel

local panelStroke = Instance.new("UIStroke")
panelStroke.Color = COLORS.Border
panelStroke.Thickness = 2
panelStroke.Parent = panel

local function label(parent: Instance, text: string, size: number, font: Enum.Font, color: Color3): TextLabel
    local textLabel = Instance.new("TextLabel")
    textLabel.BackgroundTransparency = 1
    textLabel.Font = font
    textLabel.Text = text
    textLabel.TextColor3 = color
    textLabel.TextSize = size
    textLabel.TextWrapped = true
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.TextYAlignment = Enum.TextYAlignment.Top
    textLabel.Parent = parent

    return textLabel
end

local function corner(parent: Instance, radius: number)
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, radius)
    uiCorner.Parent = parent
end

local function button(parent: Instance, text: string, color: Color3, onClick: () -> ()): TextButton
    local textButton = Instance.new("TextButton")
    textButton.AutoButtonColor = true
    textButton.BackgroundColor3 = color
    textButton.BorderSizePixel = 0
    textButton.Font = Enum.Font.GothamBold
    textButton.Text = text
    textButton.TextColor3 = COLORS.Light
    textButton.TextSize = 16
    textButton.TextWrapped = true
    textButton.Parent = parent
    corner(textButton, 8)

    local lastClickAt = 0

    textButton.Activated:Connect(function()
        local now = os.clock()

        if now - lastClickAt < 0.2 then
            return
        end

        lastClickAt = now
        onClick()
    end)

    return textButton
end

local titleLabel = label(panel, "Islamic Studies", 26, Enum.Font.GothamBold, COLORS.Ink)
titleLabel.Position = UDim2.fromOffset(22, 16)
titleLabel.Size = UDim2.new(1, -90, 0, 32)

local subtitleLabel = label(panel, "Learn, take the checkpoint quiz, and earn XP and badges.", 15, Enum.Font.GothamMedium, COLORS.SoftInk)
subtitleLabel.Position = UDim2.fromOffset(22, 50)
subtitleLabel.Size = UDim2.new(1, -90, 0, 20)

local closeButton = button(panel, "X", COLORS.Border, function()
    panel.Visible = false
end)
closeButton.AnchorPoint = Vector2.new(1, 0)
closeButton.Position = UDim2.new(1, -16, 0, 16)
closeButton.Size = UDim2.fromOffset(42, 42)

local sidebar = Instance.new("ScrollingFrame")
sidebar.Name = "Units"
sidebar.Position = UDim2.fromOffset(16, 84)
sidebar.Size = UDim2.new(0.28, -16, 1, -100)
sidebar.BackgroundTransparency = 1
sidebar.BorderSizePixel = 0
sidebar.AutomaticCanvasSize = Enum.AutomaticSize.Y
sidebar.CanvasSize = UDim2.new()
sidebar.ScrollBarThickness = 4
sidebar.Parent = panel

local sidebarLayout = Instance.new("UIListLayout")
sidebarLayout.Padding = UDim.new(0, 8)
sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
sidebarLayout.Parent = sidebar

local content = Instance.new("Frame")
content.Name = "Content"
content.Position = UDim2.new(0.28, 12, 0, 84)
content.Size = UDim2.new(0.72, -28, 1, -100)
content.BackgroundColor3 = COLORS.Card
content.BorderSizePixel = 0
content.ClipsDescendants = true
content.Parent = panel
corner(content, 12)

local contentPadding = Instance.new("UIPadding")
contentPadding.PaddingTop = UDim.new(0, 14)
contentPadding.PaddingBottom = UDim.new(0, 14)
contentPadding.PaddingLeft = UDim.new(0, 16)
contentPadding.PaddingRight = UDim.new(0, 16)
contentPadding.Parent = content

local function clearContent()
    for _, child in ipairs(content:GetChildren()) do
        if not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
end

-- A vertical scrolling list filling the content area above an optional footer bar.
local function contentList(footerHeight: number): ScrollingFrame
    local list = Instance.new("ScrollingFrame")
    list.Size = UDim2.new(1, 0, 1, -footerHeight)
    list.BackgroundTransparency = 1
    list.BorderSizePixel = 0
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.CanvasSize = UDim2.new()
    list.ScrollBarThickness = 5
    list.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 10)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = list

    local padding = Instance.new("UIPadding")
    padding.PaddingRight = UDim.new(0, 8)
    padding.Parent = list

    return list
end

local function autoLabel(parent: Instance, text: string, size: number, font: Enum.Font, color: Color3, order: number): TextLabel
    local textLabel = label(parent, text, size, font, color)
    textLabel.AutomaticSize = Enum.AutomaticSize.Y
    textLabel.Size = UDim2.new(1, 0, 0, 0)
    textLabel.LayoutOrder = order

    return textLabel
end

local function footer(): Frame
    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0, 1)
    bar.Position = UDim2.fromScale(0, 1)
    bar.Size = UDim2.new(1, 0, 0, 46)
    bar.BackgroundTransparency = 1
    bar.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.Padding = UDim.new(0, 10)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = bar

    return bar
end

local function footerButton(bar: Frame, text: string, color: Color3, order: number, onClick: () -> ())
    local footerBtn = button(bar, text, color, onClick)
    footerBtn.Size = UDim2.new(0.3, 0, 0, 42)
    footerBtn.LayoutOrder = order
end

local showUnit: (unitId: string) -> ()
local showLesson: (lessonId: string, pageIndex: number) -> ()
local showJournal: () -> ()
local showToday: () -> ()
local showOrder: (lessonId: string) -> ()

local function showQuestion(lessonId: string, questionIndex: number, answers: { number })
    local lesson = lessonById[lessonId]
    local question = lesson.Quiz[questionIndex]
    refreshCurrentView = nil
    clearContent()

    local list = contentList(56)
    autoLabel(list, string.format("Checkpoint quiz  ·  Question %d of %d", questionIndex, #lesson.Quiz), 14, Enum.Font.GothamBold, COLORS.SoftInk, 1)
    autoLabel(list, question.Prompt, 21, Enum.Font.GothamBold, COLORS.Ink, 2)

    for optionIndex, optionText in ipairs(question.Options) do
        local optionButton = button(list, optionText, rgb(unitById[unitIdByLessonId[lessonId]].AccentRGB), function()
            answers[questionIndex] = optionIndex

            if questionIndex < #lesson.Quiz then
                showQuestion(lessonId, questionIndex + 1, answers)
            else
                clearContent()
                autoLabel(content, "Checking your answers...", 18, Enum.Font.GothamMedium, COLORS.SoftInk, 1)
                pendingLessonId = lessonId
                submitQuiz:FireServer(lessonId, answers)

                task.delay(6, function()
                    if pendingLessonId == lessonId then
                        pendingLessonId = nil
                        clearContent()
                        autoLabel(content, "We could not check your answers. Please try again.", 18, Enum.Font.GothamMedium, COLORS.Danger, 1)
                        footerButton(footer(), "Back To Lesson", COLORS.Border, 1, function()
                            showLesson(lessonId, 1)
                        end)
                    end
                end)
            end
        end)
        optionButton.Size = UDim2.new(1, 0, 0, 48)
        optionButton.LayoutOrder = 2 + optionIndex
    end

    local bar = footer()
    footerButton(bar, "Back To Lesson", COLORS.Border, 1, function()
        showLesson(lessonId, 1)
    end)
end

local function showResult(result: any)
    local lesson = lessonById[result.LessonId]

    if not lesson then
        return
    end

    refreshCurrentView = nil
    clearContent()

    local list = contentList(56)
    local headline = if result.Passed then "Lesson complete!" else "Almost there"
    autoLabel(list, headline, 24, Enum.Font.GothamBold, if result.Passed then COLORS.Success else COLORS.Danger, 1)

    local summary = string.format("You answered %d of %d correctly.", result.Correct, result.Total)

    if result.Passed and result.XPAwarded > 0 then
        summary ..= string.format(" +%d XP", result.XPAwarded)
    elseif not result.Passed then
        summary ..= string.format(" You need %d to pass. Review the lesson and try again.", result.Required)
    end

    autoLabel(list, summary, 16, Enum.Font.GothamMedium, COLORS.Ink, 2)

    for index, question in ipairs(lesson.Quiz) do
        local entry = result.Results[index]

        if entry then
            local mark = if entry.Correct then "Correct" else "Not quite"
            local text = string.format("%d. %s\n%s: %s\n%s", index, question.Prompt, mark, question.Options[entry.CorrectIndex] or "", entry.Explanation)
            local textLabel = autoLabel(list, text, 15, Enum.Font.Gotham, if entry.Correct then COLORS.Ink else COLORS.Danger, 2 + index)
            textLabel.LineHeight = 1.1
        end
    end

    local bar = footer()

    if not result.Passed then
        footerButton(bar, "Try Again", COLORS.Gold, 1, function()
            showQuestion(lesson.Id, 1, {})
        end)
    end

    if lesson.Order then
        footerButton(bar, "Order Puzzle", COLORS.Success, 2, function()
            showOrder(lesson.Id)
        end)
    end

    footerButton(bar, "Back To Lessons", COLORS.Border, 3, function()
        showUnit(unitIdByLessonId[lesson.Id])
    end)
end

local pendingOrderLessonId: string? = nil
local lastPlaced: { number } = {}

local function shuffledIndexes(count: number): { number }
    local order = {}

    for index = 1, count do
        order[index] = index
    end

    -- Shuffle until the steps are out of order, so the puzzle never starts solved.
    for _ = 1, 10 do
        for index = count, 2, -1 do
            local swap = math.random(1, index)
            order[index], order[swap] = order[swap], order[index]
        end

        for index = 1, count do
            if order[index] ~= index then
                return order
            end
        end
    end

    return order
end

local function showOrderPuzzle(lessonId: string, shuffled: { number }, placed: { number })
    local lesson = lessonById[lessonId]
    local puzzle = lesson.Order

    if not puzzle then
        return
    end

    refreshCurrentView = nil
    clearContent()

    local accent = rgb(unitById[unitIdByLessonId[lessonId]].AccentRGB)
    local list = contentList(56)
    autoLabel(list, string.format("Order puzzle  ·  %s", lesson.DisplayName), 14, Enum.Font.GothamBold, COLORS.SoftInk, 1)
    autoLabel(list, puzzle.Prompt, 20, Enum.Font.GothamBold, COLORS.Ink, 2)

    local used = {}

    for _, stepIndex in ipairs(placed) do
        used[stepIndex] = true
    end

    local order = 3

    if #placed > 0 then
        local lines = {}

        for position, stepIndex in ipairs(placed) do
            table.insert(lines, string.format("%d. %s", position, puzzle.Steps[stepIndex]))
        end

        autoLabel(list, "Your order:\n" .. table.concat(lines, "\n"), 16, Enum.Font.GothamMedium, COLORS.Ink, order)
        order += 1
    end

    autoLabel(list, string.format("Tap step %d of %d:", #placed + 1, #puzzle.Steps), 15, Enum.Font.GothamBold, COLORS.SoftInk, order)
    order += 1

    for _, stepIndex in ipairs(shuffled) do
        if not used[stepIndex] then
            local stepButton = button(list, puzzle.Steps[stepIndex], accent, function()
                table.insert(placed, stepIndex)

                if #placed < #puzzle.Steps then
                    showOrderPuzzle(lessonId, shuffled, placed)
                    return
                end

                clearContent()
                autoLabel(content, "Checking your order...", 18, Enum.Font.GothamMedium, COLORS.SoftInk, 1)
                pendingOrderLessonId = lessonId
                lastPlaced = table.clone(placed)
                submitOrder:FireServer(lessonId, placed)

                task.delay(6, function()
                    if pendingOrderLessonId == lessonId then
                        pendingOrderLessonId = nil
                        clearContent()
                        autoLabel(content, "We could not check your order. Please try again.", 18, Enum.Font.GothamMedium, COLORS.Danger, 1)
                        footerButton(footer(), "Try Again", COLORS.Gold, 1, function()
                            showOrder(lessonId)
                        end)
                    end
                end)
            end)
            stepButton.Size = UDim2.new(1, 0, 0, 44)
            stepButton.LayoutOrder = order
            order += 1
        end
    end

    local bar = footer()

    if #placed > 0 then
        footerButton(bar, "Undo", COLORS.Gold, 1, function()
            table.remove(placed)
            showOrderPuzzle(lessonId, shuffled, placed)
        end)
    end

    footerButton(bar, "Back To Lesson", COLORS.Border, 2, function()
        showLesson(lessonId, 1)
    end)
end

showOrder = function(lessonId: string)
    local lesson = lessonById[lessonId]

    if lesson and lesson.Order then
        showOrderPuzzle(lessonId, shuffledIndexes(#lesson.Order.Steps), {})
    end
end

local function showOrderResult(result: any)
    local lesson = lessonById[result.LessonId]
    local puzzle = lesson and lesson.Order

    if not lesson or not puzzle then
        return
    end

    refreshCurrentView = nil
    clearContent()

    local list = contentList(56)
    autoLabel(list, if result.Solved then "Puzzle solved!" else "Not quite yet", 24, Enum.Font.GothamBold, if result.Solved then COLORS.Success else COLORS.Danger, 1)

    local summary = string.format("%d of %d steps are in the right place.", result.CorrectCount, result.Total)

    if result.Solved and result.XPAwarded > 0 then
        summary ..= string.format(" +%d XP", result.XPAwarded)
    end

    autoLabel(list, summary, 16, Enum.Font.GothamMedium, COLORS.Ink, 2)

    if result.Solved then
        local lines = {}

        for position, step in ipairs(puzzle.Steps) do
            table.insert(lines, string.format("%d. %s", position, step))
        end

        autoLabel(list, table.concat(lines, "\n"), 16, Enum.Font.Gotham, COLORS.Ink, 3)
        autoLabel(list, puzzle.Explanation, 15, Enum.Font.Gotham, COLORS.SoftInk, 4)
    else
        local lines = {}

        for position, stepIndex in ipairs(lastPlaced) do
            local inPlace = type(result.InPlace) == "table" and result.InPlace[position] == true
            local color = if inPlace then "#3F784E" else "#964A3C"
            local mark = if inPlace then "right place" else "move this"
            table.insert(lines, string.format('<font color="%s">%d. %s  (%s)</font>', color, position, puzzle.Steps[stepIndex] or "", mark))
        end

        local placedLabel = autoLabel(list, table.concat(lines, "\n"), 16, Enum.Font.GothamMedium, COLORS.Ink, 3)
        placedLabel.RichText = true
        autoLabel(list, "Review the lesson if you need to, then try again.", 15, Enum.Font.Gotham, COLORS.SoftInk, 4)
    end

    local bar = footer()

    if not result.Solved then
        footerButton(bar, "Try Again", COLORS.Gold, 1, function()
            showOrder(lesson.Id)
        end)
    end

    footerButton(bar, "Back To Lessons", COLORS.Border, 2, function()
        showUnit(unitIdByLessonId[lesson.Id])
    end)
end

showLesson = function(lessonId: string, pageIndex: number)
    local lesson = lessonById[lessonId]
    refreshCurrentView = nil
    clearContent()

    local list = contentList(56)
    autoLabel(list, lesson.DisplayName, 22, Enum.Font.GothamBold, COLORS.Ink, 1)
    autoLabel(list, string.format("Page %d of %d", pageIndex, #lesson.Pages), 14, Enum.Font.GothamMedium, COLORS.SoftInk, 2)
    local body = autoLabel(list, lesson.Pages[pageIndex], 19, Enum.Font.Gotham, COLORS.Ink, 3)
    body.LineHeight = 1.15

    local bar = footer()

    if pageIndex > 1 then
        footerButton(bar, "Previous", COLORS.Border, 1, function()
            showLesson(lessonId, pageIndex - 1)
        end)
    else
        footerButton(bar, "All Lessons", COLORS.Border, 1, function()
            showUnit(unitIdByLessonId[lessonId])
        end)
    end

    if pageIndex < #lesson.Pages then
        footerButton(bar, "Next", COLORS.Success, 2, function()
            showLesson(lessonId, pageIndex + 1)
        end)
    else
        if lesson.Order then
            footerButton(bar, "Order Puzzle", COLORS.Success, 2, function()
                showOrder(lessonId)
            end)
        end

        footerButton(bar, "Take The Quiz", COLORS.Gold, 3, function()
            showQuestion(lessonId, 1, {})
        end)
    end
end

showUnit = function(unitId: string)
    local unit = unitById[unitId] or IslamicStudies.Units[1]
    clearContent()

    local done = completedSet("lesson")
    local finished = 0

    for _, lesson in ipairs(unit.Lessons) do
        if done[lesson.Id] then
            finished += 1
        end
    end

    local list = contentList(0)
    autoLabel(list, unit.DisplayName, 24, Enum.Font.GothamBold, COLORS.Ink, 1)
    autoLabel(list, string.format("%s  ·  %d of %d complete", unit.Summary, finished, #unit.Lessons), 15, Enum.Font.GothamMedium, COLORS.SoftInk, 2)

    for index, lesson in ipairs(unit.Lessons) do
        local card = Instance.new("TextButton")
        card.AutoButtonColor = true
        card.BackgroundColor3 = COLORS.Parchment
        card.BorderSizePixel = 0
        card.Size = UDim2.new(1, 0, 0, 68)
        card.Text = ""
        card.LayoutOrder = 2 + index
        card.Parent = list
        corner(card, 10)

        local stroke = Instance.new("UIStroke")
        stroke.Color = if done[lesson.Id] then COLORS.Success else rgb(unit.AccentRGB)
        stroke.Thickness = 1.5
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = card

        local name = label(card, lesson.DisplayName, 17, Enum.Font.GothamBold, COLORS.Ink)
        name.Position = UDim2.fromOffset(14, 10)
        name.Size = UDim2.new(1, -130, 0, 22)
        name.TextTruncate = Enum.TextTruncate.AtEnd

        local blurb = label(card, lesson.Summary, 14, Enum.Font.Gotham, COLORS.SoftInk)
        blurb.Position = UDim2.fromOffset(14, 36)
        blurb.Size = UDim2.new(1, -130, 0, 22)
        blurb.TextTruncate = Enum.TextTruncate.AtEnd

        local status = label(card, if done[lesson.Id] then "Completed" else "Start", 15, Enum.Font.GothamBold, if done[lesson.Id] then COLORS.Success else rgb(unit.AccentRGB))
        status.AnchorPoint = Vector2.new(1, 0.5)
        status.Position = UDim2.new(1, -14, 0.5, 0)
        status.Size = UDim2.fromOffset(100, 22)
        status.TextXAlignment = Enum.TextXAlignment.Right
        status.TextYAlignment = Enum.TextYAlignment.Center

        card.Activated:Connect(function()
            showLesson(lesson.Id, 1)
        end)
    end

    refreshCurrentView = function()
        showUnit(unit.Id)
    end
end

showJournal = function()
    clearContent()

    local list = contentList(0)
    autoLabel(list, "My Journal", 24, Enum.Font.GothamBold, COLORS.Ink, 1)

    if not snapshot then
        autoLabel(list, "Loading your progress...", 16, Enum.Font.GothamMedium, COLORS.SoftInk, 2)
        refreshCurrentView = showJournal
        return
    end

    local current = snapshot :: Snapshot
    local lessonsDone = #(current.Completed.lesson or {})
    local lessonsTotal = 0

    for _ in pairs(lessonById) do
        lessonsTotal += 1
    end

    local earnedCount = 0

    for _, badge in ipairs(current.Badges) do
        if badge.Earned then
            earnedCount += 1
        end
    end

    autoLabel(list, string.format(
        "Level %d  ·  %s  ·  %d XP total\nLessons passed: %d of %d   Stories: %d   Battles: %d   Trivia correct: %d\nBadges: %d of %d",
        current.Level,
        current.RankTitle,
        current.XP,
        lessonsDone,
        lessonsTotal,
        #(current.Completed.story or {}),
        #(current.Completed.battle or {}),
        current.Stats.TriviaCorrect or 0,
        earnedCount,
        #current.Badges
    ), 15, Enum.Font.GothamMedium, COLORS.SoftInk, 2)

    autoLabel(list, "Your Path", 18, Enum.Font.GothamBold, COLORS.Ink, 3)

    local pathLines = {}

    for index, step in ipairs(current.Path or {}) do
        local mark = if step.Done then "[Done]" else string.format("%d.", index)
        local line = string.format("%s  %s", mark, step.Title)

        if not step.Done and current.NextStep and current.NextStep.Title == step.Title then
            line ..= string.format("\n      Next: %s", step.Hint)
        end

        table.insert(pathLines, line)
    end

    local pathLabel = autoLabel(list, table.concat(pathLines, "\n"), 15, Enum.Font.Gotham, COLORS.Ink, 4)
    pathLabel.LineHeight = 1.15

    autoLabel(list, "Badges", 18, Enum.Font.GothamBold, COLORS.Ink, 5)

    local grid = Instance.new("Frame")
    grid.BackgroundTransparency = 1
    grid.AutomaticSize = Enum.AutomaticSize.Y
    grid.Size = UDim2.new(1, 0, 0, 0)
    grid.LayoutOrder = 6
    grid.Parent = list

    local gridLayout = Instance.new("UIGridLayout")
    gridLayout.CellPadding = UDim2.fromOffset(10, 10)
    gridLayout.CellSize = UDim2.new(0.5, -5, 0, 74)
    gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
    gridLayout.Parent = grid

    for index, badge in ipairs(current.Badges) do
        local tile = Instance.new("Frame")
        tile.BackgroundColor3 = if badge.Earned then COLORS.Gold else COLORS.Locked
        tile.BackgroundTransparency = if badge.Earned then 0 else 0.35
        tile.LayoutOrder = if badge.Earned then index else 1000 + index
        tile.Parent = grid
        corner(tile, 10)

        local name = label(tile, badge.DisplayName, 15, Enum.Font.GothamBold, if badge.Earned then COLORS.Ink else COLORS.SoftInk)
        name.Position = UDim2.fromOffset(10, 8)
        name.Size = UDim2.new(1, -20, 0, 20)
        name.TextTruncate = Enum.TextTruncate.AtEnd

        local description = label(tile, badge.Description, 13, Enum.Font.Gotham, COLORS.Ink)
        description.Position = UDim2.fromOffset(10, 30)
        description.Size = UDim2.new(1, -20, 0, 36)
    end

    refreshCurrentView = showJournal
end

showToday = function()
    clearContent()

    local list = contentList(0)
    autoLabel(list, "Today", 24, Enum.Font.GothamBold, COLORS.Ink, 1)

    local daily = snapshot and snapshot.Daily

    if not daily then
        autoLabel(list, "Loading today's lesson...", 16, Enum.Font.GothamMedium, COLORS.SoftInk, 2)
        refreshCurrentView = showToday
        return
    end

    local streakText = if daily.Streak > 1
        then string.format("You have visited %d days in a row. Best streak: %d days.", daily.Streak, daily.BestStreak)
        else "Visit every day to build a streak and earn more XP each day."
    autoLabel(list, streakText, 15, Enum.Font.GothamMedium, COLORS.SoftInk, 2)

    local reflection = autoLabel(list, string.format("\"%s\"\n%s", daily.Reflection.Text, daily.Reflection.Source), 19, Enum.Font.GothamBold, COLORS.Ink, 3)
    reflection.LineHeight = 1.15
    autoLabel(list, daily.Reflection.Thought, 16, Enum.Font.Gotham, COLORS.Ink, 4)

    autoLabel(list, string.format("Daily question  ·  from %s", daily.Question.LessonName), 15, Enum.Font.GothamBold, COLORS.SoftInk, 5)
    autoLabel(list, daily.Question.Prompt, 19, Enum.Font.GothamBold, COLORS.Ink, 6)

    local result = lastDailyResult

    for optionIndex, optionText in ipairs(daily.Question.Options) do
        local color = COLORS.Border

        if result then
            if optionIndex == result.CorrectIndex then
                color = COLORS.Success
            elseif optionIndex == result.SelectedIndex then
                color = COLORS.Danger
            else
                color = COLORS.Locked
            end
        elseif daily.QuestionAnswered then
            color = COLORS.Locked
        end

        local optionButton = button(list, optionText, color, function()
            if daily.QuestionAnswered or dailyAnswerPending or lastDailyResult then
                return
            end

            dailyAnswerPending = true
            lastDailyResult = { SelectedIndex = optionIndex, Pending = true }
            submitDailyAnswer:FireServer(optionIndex)

            task.delay(6, function()
                if dailyAnswerPending then
                    dailyAnswerPending = false
                    lastDailyResult = nil

                    if panel.Visible and refreshCurrentView == showToday then
                        showToday()
                    end
                end
            end)
        end)
        optionButton.Size = UDim2.new(1, 0, 0, 46)
        optionButton.LayoutOrder = 6 + optionIndex
    end

    local footerText

    if result and not result.Pending then
        footerText = if result.Correct
            then string.format("Correct! +%d XP. %s", result.XPAwarded or 0, result.Explanation)
            else string.format("Not quite. %s Come back tomorrow for a new question.", result.Explanation)
    elseif daily.QuestionAnswered then
        footerText = "You already answered today's question. A new one arrives tomorrow."
    else
        footerText = string.format("Answer correctly for +%d XP. You get one try each day.", daily.QuestionReward)
    end

    autoLabel(list, footerText, 15, Enum.Font.GothamMedium, COLORS.SoftInk, 20)
    refreshCurrentView = showToday
end

local function buildSidebar()
    local todayButton = button(sidebar, "Today", COLORS.Gold, function()
        showToday()
    end)
    todayButton.Size = UDim2.new(1, -6, 0, 50)
    todayButton.LayoutOrder = 0
    todayButton.TextSize = 15

    for index, unit in ipairs(IslamicStudies.Units) do
        local unitButton = button(sidebar, unit.DisplayName, rgb(unit.AccentRGB), function()
            showUnit(unit.Id)
        end)
        unitButton.Size = UDim2.new(1, -6, 0, 50)
        unitButton.LayoutOrder = index
        unitButton.TextSize = 15
    end

    local journalButton = button(sidebar, "My Journal", COLORS.Border, showJournal)
    journalButton.Size = UDim2.new(1, -6, 0, 50)
    journalButton.LayoutOrder = #IslamicStudies.Units + 1
    journalButton.TextSize = 15
end

buildSidebar()

local function openHall(unitId: string?)
    if player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true then
        return
    end

    for _, guiName in ipairs({ "MainMenu", "ShopMenu" }) do
        local gui = playerGui:FindFirstChild(guiName)
        local otherPanel = gui and gui:FindFirstChild("Panel")

        if otherPanel and otherPanel:IsA("GuiObject") then
            otherPanel.Visible = false
        end
    end

    if unitId then
        showUnit(unitId)
    else
        showToday()
    end

    panel.Visible = true
end

-- Opening the panel from elsewhere (the quick button toggles Visible) lands on a lesson list.
panel:GetPropertyChangedSignal("Visible"):Connect(function()
    if panel.Visible and #content:GetChildren() <= 1 then
        showToday()
    end
end)

-- Other client scripts (the guide dialogue) open the hall through this, optionally on a unit.
local openRequest = Instance.new("BindableEvent")
openRequest.Name = "Open"
openRequest.Parent = screenGui
openRequest.Event:Connect(function(unitId: any)
    openHall(if type(unitId) == "string" then unitId else nil)
end)

openLearningHall.OnClientEvent:Connect(function(payload: any)
    local unitId = if type(payload) == "table" and type(payload.UnitId) == "string" then payload.UnitId else nil
    openHall(unitId)
end)

dailyResult.OnClientEvent:Connect(function(result: any)
    if type(result) ~= "table" then
        return
    end

    local selected = lastDailyResult and lastDailyResult.SelectedIndex
    dailyAnswerPending = false
    lastDailyResult = result
    lastDailyResult.SelectedIndex = selected

    if panel.Visible and refreshCurrentView == showToday then
        showToday()
    end
end)

orderResult.OnClientEvent:Connect(function(result: any)
    if type(result) ~= "table" or result.LessonId ~= pendingOrderLessonId then
        return
    end

    pendingOrderLessonId = nil
    showOrderResult(result)
end)

quizResult.OnClientEvent:Connect(function(result: any)
    if type(result) ~= "table" or result.LessonId ~= pendingLessonId then
        return
    end

    pendingLessonId = nil
    showResult(result)
end)

profileUpdated.OnClientEvent:Connect(function(payload: any)
    if type(payload) ~= "table" or type(payload.Level) ~= "number" then
        return
    end

    if snapshot and snapshot.Daily and payload.Daily and snapshot.Daily.Day ~= payload.Daily.Day then
        lastDailyResult = nil
    end

    snapshot = payload
    subtitleLabel.Text = string.format("Level %d  ·  %s  ·  Learn, take the checkpoint quiz, and earn XP and badges.", payload.Level, tostring(payload.RankTitle))

    if panel.Visible and refreshCurrentView then
        refreshCurrentView()
    end
end)

local function closeIfBusy()
    if player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true then
        panel.Visible = false
    end
end

player:GetAttributeChangedSignal("InBattle"):Connect(closeIfBusy)
player:GetAttributeChangedSignal("InStory"):Connect(closeIfBusy)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="85">
        <Properties>
          <string name="Name">LearningTrailHud</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local hubFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Hub")
local showLearningTrail = hubFolder:WaitForChild("ShowLearningTrail") :: RemoteEvent
local updateLearningTrail = hubFolder:WaitForChild("UpdateLearningTrail") :: RemoteEvent
local clearLearningTrail = hubFolder:WaitForChild("ClearLearningTrail") :: RemoteEvent

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LearningTrailHud"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 17
screenGui.Parent = playerGui

local missionFrame = Instance.new("Frame")
missionFrame.AnchorPoint = Vector2.new(1, 0)
missionFrame.Position = UDim2.new(1, -22, 0, 22)
missionFrame.Size = UDim2.new(0.92, 0, 0, 112)
missionFrame.BackgroundColor3 = Color3.fromRGB(35, 38, 34)
missionFrame.BackgroundTransparency = 0.08
missionFrame.Visible = false
missionFrame.Parent = screenGui

local missionSize = Instance.new("UISizeConstraint")
missionSize.MaxSize = Vector2.new(340, 112)
missionSize.MinSize = Vector2.new(260, 112)
missionSize.Parent = missionFrame

local missionCorner = Instance.new("UICorner")
missionCorner.CornerRadius = UDim.new(0, 8)
missionCorner.Parent = missionFrame

local missionStroke = Instance.new("UIStroke")
missionStroke.Color = Color3.fromRGB(198, 164, 88)
missionStroke.Thickness = 1.4
missionStroke.Parent = missionFrame

local missionTitle = Instance.new("TextLabel")
missionTitle.BackgroundTransparency = 1
missionTitle.Position = UDim2.fromOffset(16, 12)
missionTitle.Size = UDim2.new(1, -32, 0, 22)
missionTitle.Font = Enum.Font.GothamBold
missionTitle.Text = ""
missionTitle.TextColor3 = Color3.fromRGB(248, 239, 216)
missionTitle.TextSize = 17
missionTitle.TextXAlignment = Enum.TextXAlignment.Left
missionTitle.Parent = missionFrame

local missionStep = Instance.new("TextLabel")
missionStep.BackgroundTransparency = 1
missionStep.Position = UDim2.fromOffset(16, 38)
missionStep.Size = UDim2.new(1, -32, 0, 18)
missionStep.Font = Enum.Font.GothamMedium
missionStep.Text = ""
missionStep.TextColor3 = Color3.fromRGB(223, 190, 112)
missionStep.TextSize = 14
missionStep.TextXAlignment = Enum.TextXAlignment.Left
missionStep.Parent = missionFrame

local missionObjective = Instance.new("TextLabel")
missionObjective.BackgroundTransparency = 1
missionObjective.Position = UDim2.fromOffset(16, 61)
missionObjective.Size = UDim2.new(1, -32, 0, 32)
missionObjective.Font = Enum.Font.Gotham
missionObjective.Text = ""
missionObjective.TextColor3 = Color3.fromRGB(235, 231, 219)
missionObjective.TextSize = 14
missionObjective.TextWrapped = true
missionObjective.TextXAlignment = Enum.TextXAlignment.Left
missionObjective.TextYAlignment = Enum.TextYAlignment.Top
missionObjective.Parent = missionFrame

local locationLabel = Instance.new("TextLabel")
locationLabel.BackgroundTransparency = 1
locationLabel.Position = UDim2.fromOffset(16, 91)
locationLabel.Size = UDim2.new(1, -32, 0, 16)
locationLabel.Font = Enum.Font.GothamMedium
locationLabel.Text = ""
locationLabel.TextColor3 = Color3.fromRGB(183, 198, 174)
locationLabel.TextSize = 12
locationLabel.TextXAlignment = Enum.TextXAlignment.Left
locationLabel.Parent = missionFrame

local dialogueFrame = Instance.new("Frame")
dialogueFrame.AnchorPoint = Vector2.new(0.5, 1)
dialogueFrame.Position = UDim2.new(0.5, 0, 1, -220)
dialogueFrame.Size = UDim2.new(0.92, 0, 0, 132)
dialogueFrame.BackgroundColor3 = Color3.fromRGB(26, 27, 25)
dialogueFrame.BackgroundTransparency = 0.05
dialogueFrame.Visible = false
dialogueFrame.Parent = screenGui

local dialogueSize = Instance.new("UISizeConstraint")
dialogueSize.MaxSize = Vector2.new(660, 132)
dialogueSize.MinSize = Vector2.new(300, 132)
dialogueSize.Parent = dialogueFrame

local dialogueCorner = Instance.new("UICorner")
dialogueCorner.CornerRadius = UDim.new(0, 8)
dialogueCorner.Parent = dialogueFrame

local dialogueStroke = Instance.new("UIStroke")
dialogueStroke.Color = Color3.fromRGB(198, 164, 88)
dialogueStroke.Thickness = 1.4
dialogueStroke.Parent = dialogueFrame

local dialogueTitle = Instance.new("TextLabel")
dialogueTitle.BackgroundTransparency = 1
dialogueTitle.Position = UDim2.fromOffset(18, 12)
dialogueTitle.Size = UDim2.new(1, -36, 0, 22)
dialogueTitle.Font = Enum.Font.GothamBold
dialogueTitle.Text = ""
dialogueTitle.TextColor3 = Color3.fromRGB(248, 239, 216)
dialogueTitle.TextSize = 17
dialogueTitle.TextXAlignment = Enum.TextXAlignment.Left
dialogueTitle.Parent = dialogueFrame

local dialogueSpeaker = Instance.new("TextLabel")
dialogueSpeaker.BackgroundTransparency = 1
dialogueSpeaker.Position = UDim2.fromOffset(18, 39)
dialogueSpeaker.Size = UDim2.new(1, -36, 0, 18)
dialogueSpeaker.Font = Enum.Font.GothamMedium
dialogueSpeaker.Text = ""
dialogueSpeaker.TextColor3 = Color3.fromRGB(183, 211, 177)
dialogueSpeaker.TextSize = 14
dialogueSpeaker.TextXAlignment = Enum.TextXAlignment.Left
dialogueSpeaker.Parent = dialogueFrame

local dialogueBody = Instance.new("TextLabel")
dialogueBody.BackgroundTransparency = 1
dialogueBody.Position = UDim2.fromOffset(18, 62)
dialogueBody.Size = UDim2.new(1, -36, 1, -74)
dialogueBody.Font = Enum.Font.Gotham
dialogueBody.Text = ""
dialogueBody.TextColor3 = Color3.fromRGB(239, 235, 224)
dialogueBody.TextSize = 16
dialogueBody.TextWrapped = true
dialogueBody.TextXAlignment = Enum.TextXAlignment.Left
dialogueBody.TextYAlignment = Enum.TextYAlignment.Top
dialogueBody.Parent = dialogueFrame

local dialogueToken = 0
local LINE_DURATION_SECONDS = 2.45

local function normalizeDialogueLine(rawLine)
    if typeof(rawLine) == "table" then
        return rawLine.Speaker or "", rawLine.Text or ""
    end

    return "", tostring(rawLine)
end

updateLearningTrail.OnClientEvent:Connect(function(payload)
    missionFrame.Visible = true
    missionTitle.Text = payload.TrailName or "Learning Walk"
    missionStep.Text = payload.StepLabel or ""
    missionObjective.Text = payload.Objective or ""
    locationLabel.Text = payload.LocationName or ""
end)

showLearningTrail.OnClientEvent:Connect(function(payload)
    dialogueToken += 1
    local currentToken = dialogueToken
    local lines = payload.Lines or {}

    dialogueFrame.Visible = true
    dialogueTitle.Text = payload.Title or payload.TrailName or "Learning Walk"

    for _, rawLine in ipairs(lines) do
        if currentToken ~= dialogueToken then
            return
        end

        local speaker, body = normalizeDialogueLine(rawLine)
        dialogueSpeaker.Text = speaker
        dialogueBody.Text = body
        task.wait(LINE_DURATION_SECONDS)
    end

    if currentToken == dialogueToken then
        dialogueFrame.Visible = false
    end
end)

clearLearningTrail.OnClientEvent:Connect(function()
    dialogueToken += 1
    missionFrame.Visible = false
    dialogueFrame.Visible = false
end)
]]></string>
