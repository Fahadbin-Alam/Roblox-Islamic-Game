        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">BattleAnimationLibrary</string>
            <string name="Source"><![CDATA[--!strict

local BattleAnimationLibrary = {
    Sword = {
        Idle = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Idle,
            FadeTime = 0.18,
            Speed = 1,
            Looped = true,
        },
        Equip = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.08,
            Speed = 1,
            Looped = false,
        },
        Slash = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.06,
            Speed = 1.08,
            Looped = false,
        },
    },
    Bow = {
        Idle = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Idle,
            FadeTime = 0.18,
            Speed = 1,
            Looped = true,
        },
        Equip = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.08,
            Speed = 1,
            Looped = false,
        },
        DrawLoop = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.08,
            Speed = 1,
            Looped = true,
        },
        Release = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.06,
            Speed = 1.04,
            Looped = false,
        },
    },
}

function BattleAnimationLibrary.HasAnimation(entry): boolean
    if typeof(entry) ~= "table" then
        return false
    end

    local animationId = entry.AnimationId

    return typeof(animationId) == "string" and animationId ~= "" and animationId ~= "rbxassetid://0"
end

return table.freeze(BattleAnimationLibrary)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict

local GameConfig = {
    GameName = "Path of the Sahabah",
    Genre = "Educational Adventure",
    Engine = "Luau",
    TargetAudience = "Ages 9-17",
    HubName = "Makkah Courtyard",
    TravelRouteName = "Main Menu",
    StartingStoryId = "bilal_ibn_rabah",
    StartingBattleId = "badr",
    StartingDestinationId = "kaaba_courtyard",
    DefaultCurrency = "Knowledge Tokens",
    TeleportMenuEnabled = true,
    CorePillars = {
        "StoryDrivenLearning",
        "ObjectiveBasedBattles",
        "HubBasedExploration",
        "RespectfulPresentation",
        "CosmeticFirstMonetization",
    },
    ContentRules = {
        AvoidDepictingProphets = true,
        UseNarrationForHistoricalContext = true,
        KeepCombatAgeAppropriate = true,
        RewardLearningAsMuchAsCombat = true,
        TreatSacredSpacesWithRespect = true,
    },
}

return table.freeze(GameConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">MonetizationConfig</string>
            <string name="Source"><![CDATA[--!strict

-- Settings for platform-supported monetization. Fill the ids in after creating the products in
-- Creator Hub (see docs/monetization-setup.md). While an id is 0 the feature stays switched off
-- and the game says so instead of failing.

return table.freeze({
    RewardedAd = table.freeze({
        -- A developer product used as the reward for a rewarded video ad (AdService).
        DevProductId = 0,
        -- Optional ad placement id from Creator Hub; nil uses the default placement.
        PlacementId = nil :: number?,
        RewardTokens = 40,
        -- Rewarded ads a player can watch per UTC day. Ads are optional and never block play.
        DailyLimit = 3,
    }),
    -- DataStore with one row per UTC day of business numbers (revenue, retention, joins).
    LedgerStore = "BusinessLedger_v1",
    -- Monthly operating costs you enter yourself, in Robux, so the ledger can show net income.
    -- Roblox hosts servers for free; typical costs are sponsored ads and asset uploads.
    MonthlyCostsRobux = table.freeze({
        SponsoredAds = 0,
        AssetUploads = 0,
        Other = 0,
    }),
})
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="6">
