subtitle.Size = UDim2.new(1, -48, 0, 44)
subtitle.Font = Enum.Font.GothamMedium
subtitle.Text = ""
subtitle.TextColor3 = Color3.fromRGB(77, 97, 68)
subtitle.TextSize = 16
