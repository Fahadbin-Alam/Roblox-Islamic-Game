            Routes = {
                { From = "Camp", To = "HillFoot" },
                { From = "HillFoot", To = "HillTop" },
                { From = "HillTop", To = "HillFoot" },
                { From = "HillFoot", To = "Spoils" },
                { From = "Spoils", To = "RampFoot" },
                { From = "HillFoot", To = "RampFoot" },
                { From = "RampFoot", To = "Rally" },
            },
        },
        -- The Archers' Hill and the path up the slope of Uhud are built only for this layout.
        Structures = {
            ArchersHill = { Center = Vector3.new(-1470, 0, 1357), Size = Vector3.new(46, 14, 40), Slope = 26 },
            -- A rock shelf against the west face of the mountain, reached by a path from the field.
            MountainShelf = { Center = Vector3.new(-1540, 0, 1198), Size = Vector3.new(60, 30, 72), PathWidth = 24, PathRun = 62 },
        },
        Allies = {
            { Unit = "AllyFighter", Count = 4, Point = "Line" },
            { Unit = "AllyArcher", Count = 4, Point = "HillTop", Tag = "HillArcher" },
        },
        Objectives = {
            {
                Id = "post",
                Type = "Reach",
                Title = "Take Your Post",
                Instruction = "Climb the Archers' Hill south-west of the camp. Use the slope on its north side.",
                Zone = "HillTop",
                Radius = 22,
                AllyPoint = "Line",
                Narration = {
                    Title = "The Order To The Archers",
                    Body = "Fifty archers under 'Abdullah ibn Jubayr were placed on the hill and told: do not leave your place, even if you see birds snatching us, until you are sent for.",
                    Reference = "Sahih al-Bukhari 3039",
                },
            },
            {
                Id = "cover",
                Type = "Defeat",
                Title = "Cover The Line",
                Instruction = "Stay on the hill and drive back the Quraysh advance with your bow.",
                RespawnPoint = "HillFoot",
                Zone = "HillTop",
                Radius = 22,
                AllyPoint = "Line",
                Narration = {
                    Title = "Early Success",
                    Body = "Allah fulfilled His promise to you when you were defeating them by His permission.",
                    Reference = "Qur'an 3:152",
                },
                Waves = {
                    { AtSecond = 1, Spawns = {
                        { Unit = "Swordsman", Count = 3, PerExtraPlayer = 1, Lane = "Front" },
                        { Unit = "Spearman", Count = 2, PerExtraPlayer = 1, Lane = "FrontSouth" },
                    } },
                    { AfterCleared = true, Spawns = {
                        { Unit = "Swordsman", Count = 3, PerExtraPlayer = 1, Lane = "FrontSouth" },
                        { Unit = "Archer", Count = 2, PerExtraPlayer = 0.5, Lane = "Front" },
                    } },
                },
            },
            {
                Id = "spoils",
                Type = "Discipline",
                Title = "The Test Of The Spoils",
                Instruction = "The field looks won and spoils lie below. Your order is to stay on the hill.",
                Zone = "HillTop",
                Radius = 22,
                Seconds = 25,
                ClearEnemies = true,
                AllyPoint = "Line",
                -- Most of the hill archers leave, as the report describes.
                DesertingAllies = { Tag = "HillArcher", Keep = 1, To = "Spoils" },
                Narration = {
                    Title = "\"The Spoils!\"",
                    Body = "When the archers saw the enemy fleeing, most of them said 'The spoils!' Their commander reminded them of the order, but they left the hill anyway.",
                    Reference = "Sahih al-Bukhari 3039",
                },
            },
            {
                Id = "flank",
                Type = "Defeat",
                Title = "The Flank Turns",
                Instruction = "Riders sweep around the hill from behind. Hold together and drive them off.",
                AllyPoint = "Line",
                Narration = {
                    Title = "From Behind The Hill",
                    Body = "Among you were some who desired this world and some who desired the Hereafter. Then He turned you back from them to test you.",
                    Reference = "Qur'an 3:152",
                },
                Waves = {
                    { AtSecond = 1, Spawns = {
                        { Unit = "Raider", Count = 4, PerExtraPlayer = 1, Lane = "Flank" },
                        { Unit = "Swordsman", Count = 2, PerExtraPlayer = 1, Lane = "Front" },
                    } },
                    { AtSecond = 12, Spawns = {
                        { Unit = "Raider", Count = 2, PerExtraPlayer = 1, Lane = "Flank" },
                    } },
                },
                -- Leaving the hill during the test of the spoils brings a larger flank attack.
                BrokenOrderExtra = { { Unit = "Raider", Count = 3, PerExtraPlayer = 1, Lane = "Flank" } },
            },
            {
                Id = "climb",
                Type = "Reach",
                Title = "Climb The Slope Of Uhud",
                Instruction = "Regroup on the mountain. Take the stone path up to the shelf in the north-west.",
                Zone = "Rally",
                Radius = 24,
                AllyPoint = "Rally",
                Narration = {
                    Title = "Up The Mountain",
                    Body = "You were climbing and not looking back at anyone, while the Messenger was calling you from behind.",
                    Reference = "Qur'an 3:153",
                },
            },
            {
                Id = "mountain",
                Type = "Hold",
                Title = "Hold The Mountain Path",
                Instruction = "Hold the ground on the slope until the attack breaks.",
                RespawnPoint = "Rally",
                Zone = "Rally",
                Radius = 24,
                Seconds = 50,
                AllyPoint = "Rally",
                Narration = {
                    Title = "The Few Who Stood",
                    Body = "When the pressure closed in, a small group of the Ansar stood their ground one after another to protect the Messenger of Allah, peace be upon him.",
                    Reference = "Sahih Muslim 1789",
                },
                Waves = {
                    { AtSecond = 3, Spawns = {
                        { Unit = "Swordsman", Count = 3, PerExtraPlayer = 1, Lane = "Mountain" },
                        { Unit = "Spearman", Count = 1, PerExtraPlayer = 1, Lane = "MountainFlank" },
                    } },
                    { AtSecond = 20, Spawns = {
                        { Unit = "Raider", Count = 2, PerExtraPlayer = 1, Lane = "MountainFlank" },
                        { Unit = "Archer", Count = 1, PerExtraPlayer = 0.5, Lane = "Mountain" },
                    } },
                    { AtSecond = 34, Spawns = {
                        { Unit = "Swordsman", Count = 2, PerExtraPlayer = 1, Lane = "Mountain" },
                        { Unit = "Spearman", Count = 2, PerExtraPlayer = 1, Lane = "MountainFlank" },
                    } },
                },
            },
            {
                Id = "withdraw",
                Type = "Narration",
                Title = "The Quraysh Withdraw",
                Instruction = "The attack breaks and Quraysh turn back toward Makkah.",
                RespawnPoint = "Rally",
                Seconds = 10,
                ClearEnemies = true,
                HealPlayers = true,
                AllyPoint = "Rally",
                Narration = {
                    Title = "Do Not Weaken",
                    Body = "Do not weaken and do not grieve, for you will be superior if you are believers. Those who answered Allah and the Messenger after being wounded have a great reward.",
                    Reference = "Qur'an 3:139 · Qur'an 3:172",
                },
            },
        },
        Steadfast = {
            Label = "Every player kept their post on the hill",
            Kind = "Discipline",
            Objective = "spoils",
        },
        Reflection = {
            {
                Id = "uhud_order",
                Prompt = "What order were the archers given at Uhud?",
                Choices = {
                    "Stay on the hill no matter what, until sent for",
                    "Join the fighting once it looks won",
                    "Collect the spoils first",
                },
                Answer = 1,
                Explanation = "Sahih al-Bukhari 3039: do not leave your place even if you see birds snatching us.",
            },
            {
                Id = "uhud_turn",
                Prompt = "What turned the battle at Uhud?",
                Choices = {
                    "Most archers left their post for the spoils",
                    "The Muslims ran out of water",
                    "A storm stopped the fighting",
                },
                Answer = 1,
                Explanation = "When the hill was left open, riders came around behind the Muslim line (Qur'an 3:152).",
            },
            {
                Id = "uhud_lesson",
                Prompt = "What does Qur'an 3:139 tell the believers after Uhud?",
                Choices = { "Do not weaken and do not grieve", "Never fight again", "Blame one another" },
                Answer = 1,
                Explanation = "Uhud teaches obedience, patience after pain, and getting back up.",
            },
        },
    },
}

BattleMissions.Order = { "badr", "uhud" }

function BattleMissions.Get(scenarioId: string)
    return (BattleMissions.Missions :: any)[scenarioId]
end

return BattleMissions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">BattleScenarios</string>
            <string name="Source"><![CDATA[--!strict

local BattleScenarios = {
    {
        Id = "badr",
        DisplayName = "Battle of Badr",
        QueuePrompt = "Join the Battle of Badr queue.",
        Format = "TeamBattleScenario",
        ArenaTheme = "DesertValley",
        RecommendedPlayers = 60,
        MinPlayersToLaunch = 2,
        PlayersPerTeam = 30,
        FillEmptySlotsWithBots = false,
        CountdownSeconds = 8,
        RoundDurationSeconds = 240,
        LearningGoal = "Teach courage, preparation, unity, and the importance of a major early turning point.",
        Teams = {
            {
                Id = "medina",
                DisplayName = "Medina Side",
                AccentColor = Color3.fromRGB(56, 123, 79),
            },
            {
                Id = "makkah",
                DisplayName = "Makkah Side",
                AccentColor = Color3.fromRGB(160, 109, 60),
            },
        },
        KeyFigures = {
            Medina = "Medina side: Prophet Muhammad, peace be upon him, led the Muslims but is never depicted. Companions connected to this period include Abu Bakr, Umar, Ali, Hamzah, and Bilal, may Allah be pleased with them.",
            Makkah = "Makkah Quraysh side: leaders remembered in the conflict include Abu Jahl, Umayyah ibn Khalaf, Utbah ibn Rabi'ah, and other chiefs of Quraysh.",
        },
        SpawnPositions = {
            medina = {
                Vector3.new(-1460, 10, 640),
                Vector3.new(-1460, 10, 668),
                Vector3.new(-1440, 10, 612),
            },
            makkah = {
                Vector3.new(-982, 10, 720),
                Vector3.new(-996, 10, 752),
                Vector3.new(-1010, 10, 692),
            },
        },
        GameplayPhases = {
            {
                Id = "briefing",
                Title = "Briefing",
                Objective = "Enter the valley, study the wells and ridges, and prepare your side for the clash.",
            },
            {
                Id = "clash",
                Title = "Main Clash",
                Objective = "Push through the valley with swords and arrows while using terrain and cover.",
            },
            {
                Id = "reenactment",
                Title = "Historical Reenactment",
                Objective = "Watch the battle aftermath play out through a short staged retelling.",
            },
        },
        Briefing = {
            IntroTitle = "Before The Battle",
            Scenes = {
                {
                    CameraName = "BriefingMap1",
                    Title = "17 Ramadan, 2 AH | 624 CE",
                    Body = "Badr happened after the Hijrah, when the Muslims had settled in Medina and conflict with the Quraysh of Makkah was still rising.",
                    DurationSeconds = 7,
                    FieldOfView = 62,
                    CameraDrift = Vector3.new(10, 1, -4),
                },
                {
                    CameraName = "BriefingMap2",
                    Title = "The Situation",
                    Body = "The young Muslim community in Medina faced pressure from Quraysh power in Makkah. Badr became the first major battle between the two sides.",
                    DurationSeconds = 8,
                    FieldOfView = 58,
                    CameraDrift = Vector3.new(0, -2, 10),
                },
                {
                    CameraName = "BriefingMap3",
                    Title = "Main People To Know",
                    Body = "Medina side: the Prophet, peace be upon him, led but is not depicted. Companions such as Abu Bakr, Umar, Ali, Hamzah, and Bilal, may Allah be pleased with them, are connected to this period.",
                    DurationSeconds = 9,
                    FieldOfView = 64,
                    CameraDrift = Vector3.new(-8, 0, 12),
                },
                {
                    CameraName = "BriefingMap4",
                    Title = "The Opposing Side",
                    Body = "Quraysh leaders remembered in this conflict include Abu Jahl, Umayyah ibn Khalaf, and Utbah ibn Rabi'ah. In the game, opponents are generic Quraysh soldiers, never these named people.",
                    DurationSeconds = 8,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-10, 1, -5),
                },
                {
                    CameraName = "BriefingMap5",
                    Title = "Your Objective",
                    Body = "Take the wells, hold the line, and break the advance. The reenactment at the end connects the action to courage, preparation, unity, and gratitude.",
                    DurationSeconds = 7,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(8, 0, -8),
                },
            },
        },
        Reenactment = {
            IntroTitle = "Badr Reenactment",
            Scenes = {
                {
                    CameraName = "Scene1",
                    Title = "The Wells Of Badr",
                    Body = "17 Ramadan, 2 AH. The valley and wells mattered because preparation and position shaped what happened before the clash.",
                    DurationSeconds = 7,
                    FieldOfView = 63,
                    CameraDrift = Vector3.new(8, 0, -6),
                },
                {
                    CameraName = "Scene2",
                    Title = "Standing Together",
                    Body = "The Medina side was a small, vulnerable community under pressure. The scene keeps the Prophet, peace be upon him, out of visual depiction.",
                    DurationSeconds = 8,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(0, 1, 10),
                },
                {
                    CameraName = "Scene3",
                    Title = "The Opposing Command",
                    Body = "The Quraysh side had powerful chiefs, a larger army, and confidence from Makkah, yet the smaller army that stood firm together held the field.",
                    DurationSeconds = 7,
                    FieldOfView = 61,
                    CameraDrift = Vector3.new(-9, 0, 8),
                },
                {
                    CameraName = "Scene4",
                    Title = "A Turning Point",
                    Body = "Badr raised morale and changed how the community was seen. The ending should feel like a lesson, not only a scoreboard.",
                    DurationSeconds = 7,
                    FieldOfView = 58,
                    CameraDrift = Vector3.new(6, 2, -10),
                },
                {
                    CameraName = "Scene5",
                    Title = "What Players Should Remember",
                    Body = "In the game you fought for fun. In the lesson, remember preparation, unity, gratitude, and responsibility after victory.",
                    DurationSeconds = 7,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-5, 0, -8),
                },
            },
        },
        StorySummary = {
            Title = "What Happened At Badr",
            Lines = {
                "Badr took place on 17 Ramadan, 2 AH / 624 CE and became a major victory for the early Muslim community.",
                "The battle strengthened morale and marked a turning point in the public standing of the community.",
                "How it ended: the Quraysh line broke and they fled back to Makkah. About 70 of them were killed, including Abu Jahl, and about 70 were taken captive; 14 Muslims were martyred (Ibn Hisham; Sahih al-Bukhari 3976).",
                "The lessons: preparation, standing firm, unity, gratitude after victory, and mercy toward captives.",
            },
        },
        Rewards = {
            KnowledgeTokens = 100,
            UnlockStoryIds = {
                "bilal_ibn_rabah",
                "umar_ibn_al_khattab",
            },
        },
    },
    {
        Id = "uhud",
        DisplayName = "Battle of Uhud",
        QueuePrompt = "Join the Battle of Uhud queue.",
        Format = "TeamBattleScenario",
        ArenaTheme = "MountainPass",
        RecommendedPlayers = 60,
        MinPlayersToLaunch = 2,
        PlayersPerTeam = 30,
        FillEmptySlotsWithBots = false,
        CountdownSeconds = 8,
        RoundDurationSeconds = 250,
        LearningGoal = "Teach discipline, the cost of leaving an assigned post, sacrifice under pressure, and the emotional weight of Uhud.",
        Teams = {
            {
                Id = "medina",
                DisplayName = "Medina Side",
                AccentColor = Color3.fromRGB(63, 132, 86),
            },
            {
                Id = "makkah",
                DisplayName = "Makkah Side",
                AccentColor = Color3.fromRGB(143, 101, 68),
            },
        },
        KeyFigures = {
            Medina = "Medina side: Prophet Muhammad, peace be upon him, led the Muslims but is never depicted. Companions connected to Uhud include Hamzah ibn Abd al-Muttalib, Mus'ab ibn Umayr, and Nusaybah bint Ka'b, may Allah be pleased with them.",
            Makkah = "Makkah Quraysh side: leaders and commanders connected to Uhud include Abu Sufyan and Khalid ibn al-Walid before he accepted Islam. The game uses a generic commander role instead of making them playable.",
        },
        SpawnPositions = {
            medina = {
                Vector3.new(-1420, 10, 1262),
                Vector3.new(-1400, 10, 1282),
                Vector3.new(-1440, 10, 1290),
            },
            makkah = {
                Vector3.new(-1170, 10, 1262),
                Vector3.new(-1180, 10, 1282),
                Vector3.new(-1160, 10, 1244),
            },
        },
        GameplayPhases = {
            {
                Id = "briefing",
                Title = "Briefing",
                Objective = "Study the mountain pass, the archer ridge, and the approaches before the clash begins.",
            },
            {
                Id = "clash",
                Title = "Main Clash",
                Objective = "Fight through the pass with swords and arrows while using the ridge and rocky cover.",
            },
            {
                Id = "reenactment",
                Title = "Historical Reenactment",
                Objective = "Watch the mountain-side story retold through a short staged scene.",
            },
        },
        Briefing = {
            IntroTitle = "Before The Battle",
            Scenes = {
                {
                    CameraName = "BriefingMap1",
                    Title = "Dawn At Uhud | 3 AH / 625 CE",
                    Body = "Qur'an 3:121 remembers the believers being placed into battle positions. This opening view frames Mount Uhud, the approaches from Medina, and the ground where the lines were formed before the clash.",
                    DurationSeconds = 8,
                    FieldOfView = 62,
                    CameraDrift = Vector3.new(14, 2, -8),
                    Reference = "Qur'an 3:121 · Quran.com",
                },
                {
                    CameraName = "BriefingMap2",
                    Title = "The Archer Ridge Must Hold",
                    Body = "Sunan Abi Dawud 2662 reports that 'Abd Allah ibn Jubayr led fifty archers with a strict order: hold the ridge and do not leave, even if the battlefield appears won.",
                    DurationSeconds = 9,
                    FieldOfView = 58,
                    CameraDrift = Vector3.new(10, 0, 10),
                    Reference = "Sunan Abi Dawud 2662 · Sunnah.com",
                },
                {
                    CameraName = "BriefingMap3",
                    Title = "Early Pressure On Quraysh",
                    Body = "Qur'an 3:152 describes the early stage when victory seemed within reach. In the game camera pass, the Medina line pushes forward while the ridge still protects the flank.",
                    DurationSeconds = 9,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-10, 0, 12),
                    Reference = "Qur'an 3:152 · Quran.com",
                },
                {
                    CameraName = "BriefingMap4",
                    Title = "The Turn In The Field",
                    Body = "Qur'an 3:152-153 links the setback to dispute and disobedience after success. Once the ridge opened, the field broke, people ran uphill in confusion, and the battle changed in moments.",
                    DurationSeconds = 9,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-12, 1, -9),
                    Reference = "Qur'an 3:152-153 · Quran.com",
                },
                {
                    CameraName = "BriefingMap5",
                    Title = "Wounds And Protection",
                    Body = "Sahih Muslim 1790a records the injuries of that day: the Messenger of Allah, peace be upon him, was wounded, and Fatimah and 'Ali worked urgently to stop the bleeding.",
                    DurationSeconds = 8,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(8, 2, -8),
                    Reference = "Sahih Muslim 1790a · Sunnah.com",
                },
                {
                    CameraName = "BriefingMap6",
                    Title = "After The Shock",
                    Body = "Qur'an 3:172 and Sahih al-Bukhari 4077 preserve that wounded believers still answered the call after Uhud. The lesson is not surface-level victory, but obedience, endurance, and return after pain.",
                    DurationSeconds = 9,
                    FieldOfView = 57,
                    CameraDrift = Vector3.new(0, -2, 10),
                    Reference = "Qur'an 3:172 · Sahih al-Bukhari 4077",
                },
            },
        },
        Reenactment = {
            IntroTitle = "Uhud Reenactment",
            Scenes = {
                {
                    CameraName = "Scene1",
                    Title = "A Mountain With Meaning",
                    Body = "Sahih al-Bukhari 4422 preserves the line that Uhud is a mountain that loves us and is loved by us. The place itself became part of the memory of the battle.",
                    DurationSeconds = 8,
                    FieldOfView = 61,
                    CameraDrift = Vector3.new(12, 1, -8),
                    Reference = "Sahih al-Bukhari 4422 · Sunnah.com",
                },
                {
                    CameraName = "Scene2",
                    Title = "Stations For Battle",
                    Body = "Qur'an 3:121 recalls the believers being placed into battle positions. This scene turns from the mountain face to the ridge and pass so players can connect the reports to the actual terrain.",
                    DurationSeconds = 9,
                    FieldOfView = 59,
                    CameraDrift = Vector3.new(6, 2, 10),
                    Reference = "Qur'an 3:121 · Quran.com",
                },
                {
                    CameraName = "Scene3",
                    Title = "The Ridge Must Hold",
                    Body = "Sunan Abi Dawud 2662 ties Uhud to the order given to the archers not to leave their place, even when the field looked won and the temptation of booty appeared.",
                    DurationSeconds = 9,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-12, 0, 10),
                    Reference = "Sunan Abi Dawud 2662 · Sunnah.com",
                },
                {
                    CameraName = "Scene4",
                    Title = "Confusion And The Uphill Flight",
                    Body = "Qur'an 3:153 describes the believers climbing and not looking back while the Messenger called from behind. Sahih Muslim 1789 remembers how fiercely the pressure closed in during the late battle.",
                    DurationSeconds = 9,
                    FieldOfView = 58,
                    CameraDrift = Vector3.new(-8, 3, -12),
                    Reference = "Qur'an 3:153 · Sahih Muslim 1789",
                },
                {
                    CameraName = "Scene5",
                    Title = "Wounds And Rescue",
                    Body = "Sahih Muslim 1790a records the injuries suffered that day and the urgent effort to stop the bleeding. Uhud is taught here as pain, rescue, loss, and steadfast protection under pressure.",
                    DurationSeconds = 9,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(10, 1, -6),
                    Reference = "Sahih Muslim 1790a · Sunnah.com",
                },
                {
                    CameraName = "Scene6",
                    Title = "Martyrs, Grief, And Response",
                    Body = "Sahih Muslim 940a remembers Mus'ab ibn Umayr among the martyrs of Uhud. Qur'an 3:169 and 3:172 turn the lesson toward honor, patience, and answering again after being wounded.",
                    DurationSeconds = 9,
                    FieldOfView = 57,
                    CameraDrift = Vector3.new(0, -3, 12),
                    Reference = "Qur'an 3:169-172 · Sahih Muslim 940a",
                },
            },
        },
        StorySummary = {
            Title = "What Happened At Uhud",
            Lines = {
                "Qur'an 3:121, 3:152, and 3:153 frame Uhud through placement, early success, disobedience, confusion, and the cost of a broken position.",
                "Sunan Abi Dawud 2662 preserves the command to the archers, while Sahih Muslim 1789 and 1790a preserve the pressure, wounds, and rescue of the late battle.",
                "How it ended: the Muslims regrouped on the slope of the mountain and the Quraysh withdrew to Makkah without taking Madinah. About 70 Muslims were martyred, including Hamzah; the next day the Muslims marched out to Hamra al-Asad to show they were still standing (Ibn Hisham; Sahih al-Bukhari 4043, 4077).",
                "The lesson of Uhud is obedience: one broken position changed the day, and patience after pain is what the Qur'an praises.",
            },
        },
        -- Uhud builds on the lessons of Badr, so it opens after Badr or once a player has
        -- learned enough elsewhere to follow it.
        Unlock = {
            AfterBattleId = "badr",
            OrLevel = 3,
        },
        Rewards = {
            KnowledgeTokens = 125,
            UnlockStoryIds = {
                "musab_ibn_umayr",
                "nusaybah_bint_kaab",
            },
        },
    },
}

return table.freeze(BattleScenarios)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">CompanionStories</string>
            <string name="Source"><![CDATA[--!strict

local CompanionStories = {
    {
        Id = "abu_bakr_as_siddiq",
        DisplayName = "Abu Bakr as-Siddiq (RA)",
        Theme = "Truthfulness and leadership",
        Summary = "Learn why Abu Bakr was called as-Siddiq, how he supported the early Muslims, and how he became the first caliph.",
        Difficulty = "Beginner",
        AccentColor = Color3.fromRGB(124, 108, 67),
        KeyLessons = {
            "Truthfulness",
            "Loyal companionship",
            "Leadership after hardship",
        },
        Introduction = {
            "This story follows Abu Bakr as-Siddiq through trust, sacrifice, companionship, and leadership.",
            "Each stop teaches one major moment: his title, his support, the Hijrah, and becoming the first caliph.",
            "You will also see direct references so the lesson is tied to Qur'an and Hadith, not just a summary.",
        },
        ScenarioSteps = {
            {
                Id = "as_siddiq_title",
                Title = "Why He Was Called As-Siddiq",
                Objective = "Speak to the guide to learn why Abu Bakr was known as as-Siddiq.",
                NpcName = "Truthfulness Guide",
                PromptText = "Ask",
                LocationName = "Trust Courtyard",
                Dialogue = {
                    { Speaker = "Guide", Text = "Abu Bakr is remembered with the title as-Siddiq, meaning the truthful one or the one who strongly confirms the truth." },
                    { Speaker = "Guide", Text = "A famous reason connected to this title is that he believed the Prophet's account of the Night Journey without hesitation, showing immediate trust in revelation." },
                    { Speaker = "Reference", Text = "Related Hadith: Sahih Muslim 2607c says truth leads to righteousness and a person who keeps telling the truth is recorded with Allah as truthful." },
                    { Speaker = "Narrator", Text = "This stop teaches that trust and truthfulness were central to Abu Bakr's character." },
                },
            },
            {
                Id = "early_support",
                Title = "Supporting The Early Muslims",
                Objective = "Walk to the support station and learn what Abu Bakr did for the early community.",
                NpcName = "Community Guide",
                PromptText = "Learn",
                LocationName = "Support Station",
                Dialogue = {
                    { Speaker = "Guide", Text = "Abu Bakr was among the earliest Muslims and used his position, wealth, and courage to support the community." },
                    { Speaker = "Guide", Text = "He is remembered for helping free persecuted believers, including Bilal ibn Rabah." },
                    { Speaker = "Reference", Text = "Related Hadith: Sahih al-Bukhari 3656 describes Abu Bakr as the Prophet's close companion, showing how near he was in loyalty and support." },
                    { Speaker = "Narrator", Text = "His story shows that leadership starts with service and sacrifice." },
                },
            },
            {
                Id = "hijrah_companion",
                Title = "Companion On The Hijrah",
                Objective = "Move to the cave marker and learn about Abu Bakr's companionship during the Hijrah.",
                NpcName = "Journey Guide",
                PromptText = "Listen",
                LocationName = "Hijrah Path",
                Dialogue = {
                    { Speaker = "Guide", Text = "Abu Bakr accompanied the Prophet during the Hijrah from Makkah to Medina." },
                    { Speaker = "Guide", Text = "He is remembered as the companion who stayed close during one of the most important journeys in Islamic history." },
                    { Speaker = "Reference", Text = "Qur'an: Surah At-Tawbah 9:40 mentions the two in the cave. Hadith: Sahih al-Bukhari 3653 records Abu Bakr saying that if the pursuers looked down they would see them." },
                    { Speaker = "Narrator", Text = "This moment teaches loyalty, courage, and trust during danger." },
                },
            },
            {
                Id = "first_caliph",
                Title = "The First Caliph",
                Objective = "Reach the leadership hall and learn how Abu Bakr became the first caliph.",
                NpcName = "Leadership Guide",
                PromptText = "Reflect",
                LocationName = "Leadership Hall",
                Dialogue = {
                    { Speaker = "Guide", Text = "After the Prophet's death in 632 CE, the Muslim community needed leadership and unity." },
                    { Speaker = "Guide", Text = "Abu Bakr became the first caliph, known as the successor to the Messenger of Allah, and served from 632 to 634 CE." },
                    { Speaker = "Reference", Text = "Related Hadith: Sahih Muslim 418a records the Prophet ordering Abu Bakr to lead the people in prayer, and Sahih al-Bukhari 4986 records Abu Bakr overseeing the collection of the Qur'an after Yamamah." },
                    { Speaker = "Reflection", Text = "His final lesson in this route is steady leadership after grief and confusion." },
                },
            },
        },
        Completion = {
            Title = "Abu Bakr Story Complete",
            Lines = {
                "Abu Bakr as-Siddiq is remembered for truthfulness, loyalty, service, and leadership.",
                "Reference trail: Qur'an 9:40, Sahih Muslim 2607c, Sahih al-Bukhari 3653, Sahih Muslim 418a, and Sahih al-Bukhari 4986.",
                "You completed the Abu Bakr as-Siddiq playthrough.",
            },
        },
        LinkedBattles = {
            "badr",
        },
        RewardTokens = 45,
    },
    {
        Id = "bilal_ibn_rabah",
        DisplayName = "Bilal ibn Rabah (RA)",
        Theme = "Perseverance and faith",
        Summary = "Walk through Bilal's early faith, service to the community, and lasting resilience.",
        Difficulty = "Beginner",
        AccentColor = Color3.fromRGB(101, 78, 49),
        KeyLessons = {
            "Perseverance",
            "Faith under pressure",
            "Service to the community",
        },
        Introduction = {
            "Begin in Makkah and follow Bilal's path from hardship to honor in the Muslim community.",
            "Talk to the guides at each station to unlock the next part of the journey.",
            "This route links Bilal's story to references about dignity, worship, and sincere service.",
        },
        ScenarioSteps = {
            {
                Id = "early_faith",
                Title = "Early Faith In Makkah",
                Objective = "Speak to the market guide to learn how Bilal accepted Islam.",
                NpcName = "Makkah Story Guide",
                PromptText = "Talk",
                LocationName = "Makkah Market Court",
                Dialogue = {
                    { Speaker = "Guide", Text = "Bilal was among the early people who believed in Islam in Makkah." },
                    { Speaker = "Guide", Text = "He stayed firm even when his master punished him and tried to force him to turn away." },
                    { Speaker = "Reference", Text = "Related Qur'an: Surah Al-Hujurat 49:13 teaches that the most honored with Allah are the most righteous, not the most privileged by race or status." },
                    { Speaker = "Bilal's Story", Text = "His faith became an example of patience and trust in Allah." },
                },
            },
            {
                Id = "steadfastness",
                Title = "Steadfastness",
                Objective = "Go to the shaded courtyard and hear how Bilal stayed steadfast through hardship.",
                NpcName = "Courtyard Elder",
                PromptText = "Listen",
                LocationName = "Courtyard of Patience",
                Dialogue = {
                    { Speaker = "Elder", Text = "Bilal is remembered for repeating words of tawhid while enduring severe hardship." },
                    { Speaker = "Elder", Text = "His story teaches players that dignity and faith are not taken away by pressure." },
                    { Speaker = "Reference", Text = "Related Hadith: Jami` at-Tirmidhi 3689 later praises Bilal by mentioning the Prophet hearing Bilal's footsteps in Paradise." },
                    { Speaker = "Narrator", Text = "Steadfast hearts often change the future of a community." },
                },
            },
            {
                Id = "community_service",
                Title = "Serving The Community",
                Objective = "Walk to the masjid court and learn how Bilal served the growing Muslim community.",
                NpcName = "Masjid Caretaker",
                PromptText = "Learn",
                LocationName = "Masjid Court",
                Dialogue = {
                    { Speaker = "Caretaker", Text = "Bilal became known for his beautiful call to prayer and his service among the believers." },
                    { Speaker = "Caretaker", Text = "In the game, this station reminds players that strength is not only on the battlefield." },
                    { Speaker = "Reference", Text = "Related Hadith: Jami` at-Tirmidhi 3689 ties Bilal's honored rank to sincere worship and steady deeds." },
                    { Speaker = "Narrator", Text = "Service, loyalty, and consistency made Bilal beloved in the community." },
                },
            },
            {
                Id = "legacy",
                Title = "Bilal's Legacy",
                Objective = "Reach the reflection garden and hear the final lesson from Bilal's journey.",
                NpcName = "Reflection Guide",
                PromptText = "Reflect",
                LocationName = "Reflection Garden",
                Dialogue = {
                    { Speaker = "Guide", Text = "Bilal lived on after the earliest battles and remained honored for his faith and sincerity." },
                    { Speaker = "Guide", Text = "He is remembered as one of the best-known voices of the early Muslim community." },
                    { Speaker = "Reference", Text = "Reference trail: Qur'an 49:13 and Jami` at-Tirmidhi 3689." },
                    { Speaker = "Reflection", Text = "The lasting lesson is courage with humility and service." },
                },
            },
        },
        Completion = {
            Title = "Bilal Story Complete",
            Lines = {
                "Bilal's journey teaches resilience, faith, and service.",
                "Reference trail: Qur'an 49:13 and Jami` at-Tirmidhi 3689.",
                "You completed the Bilal ibn Rabah playthrough.",
            },
        },
        LinkedBattles = {
            "badr",
        },
        RewardTokens = 40,
    },
    {
        Id = "musab_ibn_umayr",
        DisplayName = "Mus'ab ibn Umayr (RA)",
        Theme = "Sacrifice and leadership",
        Summary = "Travel through Mus'ab's conversion, teaching mission, and sacrifice at Uhud.",
        Difficulty = "Intermediate",
        AccentColor = Color3.fromRGB(95, 91, 58),
        KeyLessons = {
            "Sacrifice",
            "Leadership",
            "Teaching others",
        },
        Introduction = {
            "This story follows Mus'ab from the comfort of Makkah to the mission of teaching Islam in Yathrib.",
            "Each stop focuses on a moment that made him one of the great teachers of the early community.",
            "The route now includes related references on sacrifice, da'wah, and Uhud.",
        },
        ScenarioSteps = {
            {
                Id = "private_conversion",
                Title = "A Quiet Conversion",
                Objective = "Speak to the house guide to learn how Mus'ab accepted Islam.",
                NpcName = "House Guide",
                PromptText = "Enter",
                LocationName = "Private Courtyard",
                Dialogue = {
                    { Speaker = "Guide", Text = "Mus'ab was known for comfort and refinement before Islam reached his heart." },
                    { Speaker = "Guide", Text = "After hearing the message, he chose faith even though it cost him ease and status." },
                    { Speaker = "Reference", Text = "Related Qur'an: Surah Al-Ankabut 29:2 reminds believers that they will be tested after saying, 'We believe'." },
                    { Speaker = "Narrator", Text = "The first lesson of Mus'ab's life is that truth can demand sacrifice." },
                },
            },
            {
                Id = "teacher_of_medina",
                Title = "Teacher Of Medina",
                Objective = "Visit the teaching hall and hear how Mus'ab taught the people of Yathrib.",
                NpcName = "Teaching Elder",
                PromptText = "Study",
                LocationName = "Teaching Hall",
                Dialogue = {
                    { Speaker = "Elder", Text = "Mus'ab was sent ahead to Yathrib to teach Islam and help prepare the city for the Hijrah." },
                    { Speaker = "Elder", Text = "He taught with wisdom, patience, and strong character." },
                    { Speaker = "Reference", Text = "Related Qur'an: Surah An-Nahl 16:125 commands calling to Allah with wisdom and good instruction." },
                    { Speaker = "Narrator", Text = "This is why he is remembered as one of the first great teachers in Medina." },
                },
            },
            {
                Id = "banner_bearer",
                Title = "Banner Bearer",
                Objective = "Climb to the ridge and learn about Mus'ab carrying the banner in battle.",
                NpcName = "Battle Guide",
                PromptText = "Hear Story",
                LocationName = "Banner Ridge",
                Dialogue = {
                    { Speaker = "Battle Guide", Text = "Mus'ab carried the banner in battle and stood firm when the fighting became difficult." },
                    { Speaker = "Battle Guide", Text = "His courage showed leadership through action, not only words." },
                    { Speaker = "Reference", Text = "Related Hadith: Jami` at-Tirmidhi 3853 remembers Mus'ab among those who gave their lives without enjoying worldly reward." },
                    { Speaker = "Narrator", Text = "Players see that teaching and bravery can live in the same person." },
                },
            },
            {
                Id = "martyrdom",
                Title = "A Lasting Sacrifice",
                Objective = "Reach the remembrance court to reflect on Mus'ab's martyrdom at Uhud.",
                NpcName = "Remembrance Guide",
                PromptText = "Reflect",
                LocationName = "Remembrance Court",
                Dialogue = {
                    { Speaker = "Guide", Text = "Mus'ab was martyred at Uhud after a life of sacrifice and service." },
                    { Speaker = "Guide", Text = "His story is remembered because he gave up comfort, then gave his effort, and finally gave his life." },
                    { Speaker = "Reference", Text = "Hadith: Jami` at-Tirmidhi 3853 and Sunan an-Nasa'i 1903 describe how little cloth remained to shroud Mus'ab after Uhud." },
                    { Speaker = "Reflection", Text = "Mus'ab teaches sincere leadership and sacrifice for the truth." },
                },
            },
        },
        Completion = {
            Title = "Mus'ab Story Complete",
            Lines = {
                "Mus'ab ibn Umayr is remembered for sacrifice, teaching, and courage.",
                "Reference trail: Qur'an 29:2, Qur'an 16:125, Jami` at-Tirmidhi 3853, and Sunan an-Nasa'i 1903.",
                "You completed the Mus'ab ibn Umayr playthrough.",
            },
        },
        LinkedBattles = {
            "uhud",
        },
        RewardTokens = 45,
    },
    {
        Id = "nusaybah_bint_kaab",
        DisplayName = "Nusaybah bint Ka'b (RA)",
        Theme = "Courage and protection",
        Summary = "Play through Nusaybah's courage, service, and defense of the community.",
        Difficulty = "Intermediate",
        AccentColor = Color3.fromRGB(73, 111, 76),
        KeyLessons = {
            "Courage",
            "Protection",
            "Commitment",
        },
        Introduction = {
            "Walk through a story of courage and loyalty with Nusaybah bint Ka'b.",
            "This route focuses on service, bravery, and standing firm when the community needed protection.",
            "Where direct reports are brief, the route uses clearly marked related Qur'an reflections on steadfastness and sacrifice.",
        },
        ScenarioSteps = {
            {
                Id = "pledge_and_commitment",
                Title = "Commitment To The Cause",
                Objective = "Talk to the family elder to learn about Nusaybah's commitment to Islam.",
                NpcName = "Family Elder",
                PromptText = "Talk",
                LocationName = "Family Courtyard",
                Dialogue = {
                    { Speaker = "Elder", Text = "Nusaybah became known among the Ansar for firm commitment and loyalty." },
                    { Speaker = "Elder", Text = "She is remembered as one of the courageous companions who supported the Muslim community." },
                    { Speaker = "Reference", Text = "Related Qur'an reflection: Surah Al-Ahzab 33:23 praises believers who stayed true to their covenant with Allah." },
                    { Speaker = "Narrator", Text = "Her story begins with sincere faith and readiness to serve." },
                },
            },
            {
                Id = "service",
                Title = "Service In The Community",
                Objective = "Visit the aid station and hear about serving and supporting others.",
                NpcName = "Aid Guide",
                PromptText = "Serve",
                LocationName = "Aid Station",
                Dialogue = {
                    { Speaker = "Aid Guide", Text = "Nusaybah's story includes service, family commitment, and strong support for the believers." },
                    { Speaker = "Aid Guide", Text = "Great courage is often built from everyday loyalty and service." },
                    { Speaker = "Reference", Text = "Related Qur'an: Surah Al-Ma'idah 5:2 commands cooperation in righteousness and piety." },
                    { Speaker = "Narrator", Text = "This station connects bravery to care, readiness, and responsibility." },
                },
            },
            {
                Id = "uhud_defense",
                Title = "Defense At Uhud",
                Objective = "Move to the defense line and learn why Nusaybah is remembered at Uhud.",
                NpcName = "Defense Guide",
                PromptText = "Stand Firm",
                LocationName = "Defense Line",
                Dialogue = {
                    { Speaker = "Defense Guide", Text = "At Uhud, Nusaybah became famous for defending the Messenger's side during a difficult moment." },
                    { Speaker = "Defense Guide", Text = "Her courage made her one of the most memorable figures of that battle." },
                    { Speaker = "Reference", Text = "Related Qur'an reflection: Surah Al-Ahzab 33:23 is often used to reflect on believers who stayed firm when the test became severe." },
                    { Speaker = "Narrator", Text = "Players are meant to feel the urgency of protection and commitment here." },
                },
            },
            {
                Id = "later_life",
                Title = "A Life Of Commitment",
                Objective = "Finish at the remembrance canopy and hear the final lesson from her life.",
                NpcName = "Remembrance Guide",
                PromptText = "Reflect",
                LocationName = "Remembrance Canopy",
                Dialogue = {
                    { Speaker = "Guide", Text = "Nusaybah remained known for courage and commitment beyond a single moment on the battlefield." },
                    { Speaker = "Guide", Text = "Her story reminds players that bravery can belong to those who protect faith, family, and community." },
                    { Speaker = "Reference", Text = "Related Qur'an: Surah At-Tawbah 9:111 praises believers who give themselves in Allah's cause." },
                    { Speaker = "Reflection", Text = "The lesson of Nusaybah is courage joined with loyalty." },
                },
            },
        },
        Completion = {
            Title = "Nusaybah Story Complete",
            Lines = {
                "Nusaybah bint Ka'b is remembered for courage, protection, and loyalty.",
                "Related reflection references: Qur'an 33:23, Qur'an 5:2, and Qur'an 9:111.",
                "You completed the Nusaybah bint Ka'b playthrough.",
            },
        },
        LinkedBattles = {
            "uhud",
        },
        RewardTokens = 45,
    },
    {
        Id = "umar_ibn_al_khattab",
        DisplayName = "Umar ibn al-Khattab (RA)",
        Theme = "Justice and strength",
        Summary = "Experience Umar's turning point, public strength, justice, and lasting legacy.",
        Difficulty = "Intermediate",
        AccentColor = Color3.fromRGB(82, 90, 99),
        KeyLessons = {
            "Justice",
            "Discipline",
            "Strength with principle",
        },
        Introduction = {
            "This story route explores Umar's change, leadership, and reputation for justice.",
            "Move from the moment of turning to the legacy of principled strength.",
            "You will see related references for justice, courage, and responsibility in public leadership.",
        },
        ScenarioSteps = {
            {
                Id = "turning_point",
                Title = "A Turning Point",
                Objective = "Speak to the street guide to learn about Umar's change of heart.",
                NpcName = "Street Guide",
                PromptText = "Hear Story",
                LocationName = "Stone Street",
                Dialogue = {
                    { Speaker = "Guide", Text = "Umar is remembered for a powerful turning point that brought him into Islam." },
                    { Speaker = "Guide", Text = "His strength, once feared, later became a source of support for the Muslim community." },
                    { Speaker = "Reference", Text = "Related Hadith: Jami` at-Tirmidhi 3686 says that if there had been a prophet after Muhammad, peace be upon him, it would have been Umar." },
                    { Speaker = "Narrator", Text = "The story begins with change, humility, and truth." },
                },
            },
            {
                Id = "public_strength",
                Title = "Strength In Public",
                Objective = "Walk to the gate court and hear how Umar stood openly with the believers.",
                NpcName = "Gate Elder",
                PromptText = "Listen",
                LocationName = "Gate Court",
                Dialogue = {
                    { Speaker = "Elder", Text = "Umar became known for visible strength and confidence once he embraced Islam." },
                    { Speaker = "Elder", Text = "Players learn here that strong personalities can become forces for good when guided by principle." },
                    { Speaker = "Reference", Text = "Related Qur'an: Surah Al-Ma'idah 8 commands believers not to let emotion pull them away from justice." },
                    { Speaker = "Narrator", Text = "Public courage can help protect a growing community." },
                },
            },
            {
                Id = "justice",
                Title = "Justice And Responsibility",
                Objective = "Visit the justice court and hear why Umar is remembered for fairness.",
                NpcName = "Justice Guide",
                PromptText = "Learn",
                LocationName = "Justice Court",
                Dialogue = {
                    { Speaker = "Justice Guide", Text = "Umar is widely remembered for justice, discipline, and responsibility." },
                    { Speaker = "Justice Guide", Text = "His legacy shows that power must be tied to fairness and accountability." },
                    { Speaker = "Reference", Text = "Related Hadith: Sahih al-Bukhari 4160-4161 records Umar stopping to help a widow and her hungry children instead of passing by their need." },
                    { Speaker = "Narrator", Text = "This station turns strength into a lesson about responsibility." },
                },
            },
            {
                Id = "legacy",
                Title = "A Lasting Legacy",
                Objective = "Reach the legacy hall and hear the final lesson from Umar's life.",
                NpcName = "Legacy Guide",
                PromptText = "Reflect",
                LocationName = "Legacy Hall",
                Dialogue = {
                    { Speaker = "Guide", Text = "Umar died later in Medina after a life remembered for leadership, strength, and justice." },
                    { Speaker = "Guide", Text = "His story remains one of disciplined power used with responsibility." },
                    { Speaker = "Reference", Text = "Reference trail: Jami` at-Tirmidhi 3686, Qur'an 5:8, and Sahih al-Bukhari 4160-4161." },
                    { Speaker = "Reflection", Text = "The lasting lesson is that justice must stay at the center of strength." },
                },
            },
        },
        Completion = {
            Title = "Umar Story Complete",
            Lines = {
                "Umar ibn al-Khattab is remembered for justice, strength, and responsibility.",
                "Reference trail: Jami` at-Tirmidhi 3686, Qur'an 5:8, and Sahih al-Bukhari 4160-4161.",
                "You completed the Umar ibn al-Khattab playthrough.",
            },
        },
        LinkedBattles = {
            "badr",
        },
        RewardTokens = 45,
    },
}

return table.freeze(CompanionStories)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">DailyReflections</string>
            <string name="Source"><![CDATA[--!strict

-- One reflection is shown each day in the Islamic Studies hall, cycling through this list.
-- Every entry is a short, widely known ayah or authentic hadith with its reference.

export type Reflection = {
    Text: string,
    Source: string,
    Thought: string,
}

local DailyReflections: { Reflection } = {
    {
        Text = "Indeed, with hardship comes ease.",
        Source = "Qur'an 94:6",
        Thought = "When something feels hard today, remember that Allah has promised ease alongside it.",
    },
    {
        Text = "So remember Me; I will remember you.",
        Source = "Qur'an 2:152",
        Thought = "Say SubhanAllah, Alhamdulillah, or Allahu Akbar a few times today and remember Allah is remembering you.",
    },
    {
        Text = "Allah does not burden a soul beyond what it can bear.",
        Source = "Qur'an 2:286",
        Thought = "Whatever you are facing, you have been given the strength to handle it.",
    },
    {
        Text = "And speak to people good words.",
        Source = "Qur'an 2:83",
        Thought = "Try to say something kind to every person you talk to today, online or offline.",
    },
    {
        Text = "Indeed, Allah is with the patient.",
        Source = "Qur'an 2:153",
        Thought = "Patience is not doing nothing. It is staying calm and doing the right thing while you wait.",
    },
    {
        Text = "Verily, in the remembrance of Allah do hearts find rest.",
        Source = "Qur'an 13:28",
        Thought = "If you feel worried, take a quiet minute to make dua.",
    },
    {
        Text = "Whoever does an atom's weight of good will see it.",
        Source = "Qur'an 99:7",
        Thought = "No good deed is too small. Holding a door or sharing a snack counts.",
    },
    {
        Text = "The most noble of you in the sight of Allah is the most righteous of you.",
        Source = "Qur'an 49:13",
        Thought = "What makes someone great is their character, not their looks, money, or where they come from.",
    },
    {
        Text = "Actions are judged by intentions.",
        Source = "Sahih al-Bukhari 1",
        Thought = "Before you start something, make the intention to do it for Allah. Even studying can become worship.",
    },
    {
        Text = "None of you truly believes until he loves for his brother what he loves for himself.",
        Source = "Sahih al-Bukhari 13",
        Thought = "Cheer for your friends when they win, the way you would want them to cheer for you.",
    },
    {
        Text = "The strong person is not the one who wrestles others down, but the one who controls himself when angry.",
        Source = "Sahih al-Bukhari 6114",
        Thought = "If a game or a person makes you angry today, pause and breathe before you react.",
    },
    {
        Text = "Whoever believes in Allah and the Last Day, let him speak good or stay silent.",
        Source = "Sahih al-Bukhari 6018",
        Thought = "Check your words in chat today: if it isn't good, it's better not to send it.",
    },
    {
        Text = "The best of you are those who learn the Qur'an and teach it.",
        Source = "Sahih al-Bukhari 5027",
        Thought = "Learn one new ayah or its meaning today, then share it with someone.",
    },
    {
        Text = "Make things easy and do not make them difficult.",
        Source = "Sahih al-Bukhari 69",
        Thought = "Help a new player or a younger sibling today instead of making things harder for them.",
    },
    {
        Text = "Allah does not look at your appearance or wealth, but He looks at your hearts and deeds.",
        Source = "Sahih Muslim 2564",
        Thought = "Focus on being a good person rather than on looking cool.",
    },
    {
        Text = "Your smile in the face of your brother is charity.",
        Source = "Jami' at-Tirmidhi 1956",
        Thought = "Smiling is a sadaqah you can give for free, as many times as you like.",
    },
    {
        Text = "The most beloved deeds to Allah are those done regularly, even if they are small.",
        Source = "Sahih al-Bukhari 6464",
        Thought = "Coming back every day to learn a little is exactly the kind of habit Allah loves.",
    },
    {
        Text = "Whoever takes a path seeking knowledge, Allah makes easy for him a path to Paradise.",
        Source = "Sahih Muslim 2699",
        Thought = "Every lesson you finish here is a step on that path.",
    },
    {
        Text = "Do not become angry.",
        Source = "Sahih al-Bukhari 6116",
        Thought = "This was the advice given to a man who asked for something short to remember. Try it today.",
    },
    {
        Text = "My Lord, increase me in knowledge.",
        Source = "Qur'an 20:114",
        Thought = "Make this dua before you start a lesson or your homework.",
    },
}

return DailyReflections
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Guides</string>
            <string name="Source"><![CDATA[--!strict

-- Friendly teachers who stand around the hub and point players to their next quest on the
-- suggested path. They are ordinary present-day teachers, not historical figures, so nobody
-- from the Seerah is ever shown as a character.

export type Guide = {
    Id: string,
    DisplayName: string,
    Role: string,
    -- Placed beside this TravelRoute destination's teleport point, at this offset.
    Destination: string,
    Offset: Vector3,
    -- Body colors for the teacher's avatar (head, torso, arms, legs).
    SkinRGB: { number },
    RobeRGB: { number },
    Greeting: string,
    -- Short reminders, one picked at random each conversation.
    Sayings: { string },
}

local Guides: { Guide } = {
    {
        Id = "noor",
        DisplayName = "Ustadha Noor",
        Role = "Welcome Guide",
        Destination = "kaaba_courtyard",
        Offset = Vector3.new(16, 0, 6),
        SkinRGB = { 198, 150, 112 },
        RobeRGB = { 63, 98, 88 },
        Greeting = "Assalamu alaykum, welcome! I help new students find their way around.",
        Sayings = {
            "The Prophet ﷺ said: \"Whoever takes a path seeking knowledge, Allah makes easy for him a path to Paradise.\" (Sahih Muslim 2699)",
            "Learning a little every day is better than a lot once in a while.",
            "Bring a friend to the Trivia Court and you can study together in a circle.",
        },
    },
    {
        Id = "kareem",
        DisplayName = "Ustadh Kareem",
        Role = "Islamic Studies Teacher",
        Destination = "trivia_court",
        Offset = Vector3.new(-30, 0, 4),
        SkinRGB = { 141, 98, 70 },
        RobeRGB = { 240, 236, 224 },
        Greeting = "Assalamu alaykum! The Islamic Studies podium is right behind me.",
        Sayings = {
            "Allah says: \"Say, are those who know equal to those who do not know?\" (Qur'an 39:9)",
            "Take your time with each lesson page. The quiz is there to help you remember.",
            "Ask your local imam or teacher about anything you want to learn more deeply.",
        },
    },
    {
        Id = "salim",
        DisplayName = "Storyteller Salim",
        Role = "Story Keeper",
        Destination = "story_court",
        Offset = Vector3.new(18, 0, 4),
        SkinRGB = { 176, 128, 92 },
        RobeRGB = { 121, 94, 63 },
        Greeting = "Assalamu alaykum, friend! Every companion's story holds a lesson for us.",
        Sayings = {
            "Allah says: \"In their stories there is truly a lesson for people of understanding.\" (Qur'an 12:111)",
            "The companions were ordinary people who chose to be brave, honest, and kind.",
            "After a story, think about one thing you can do like that companion did.",
        },
    },
}

return Guides
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">HaramLearningTrail</string>
            <string name="Source"><![CDATA[--!strict

local HaramLearningTrail = {
    Id = "haram_learning_walk",
    DisplayName = "Haram Learning Walk",
    RewardTokens = 35,
    AccentColor = Color3.fromRGB(193, 162, 86),
    StartObjective = "Begin at the gold learning marker on the north side of the mataf, near where you arrive.",
    Steps = {
        {
            Title = "Enter With Respect",
            LocationName = "Orientation Marker",
            Objective = "Begin at the gold learning marker on the north side of the mataf, near where you arrive.",
            Lines = {
                { Speaker = "Guide", Text = "Start by slowing down and looking around. This hub is for learning and respectful exploration." },
                { Speaker = "Guide", Text = "Follow the gold trail lights. Each stop teaches one landmark or idea without turning worship into a game objective." },
            },
        },
        {
            Title = "The Kaaba As A Direction",
            LocationName = "Kaaba View Stop",
            Objective = "Walk to the stop facing the Black Stone corner on the east side of the Kaaba.",
            Lines = {
                { Speaker = "Guide", Text = "The Kaaba is the central landmark of Masjid al-Haram and the direction Muslims face in prayer. Its black cover, the kiswa, has a gold embroidered band called the hizam." },
                { Speaker = "Guide", Text = "The Black Stone sits in a silver frame in this eastern corner. Tawaf begins in line with it, and a green light on the gallery marks the spot." },
                { Speaker = "Guide", Text = "This build is a respectful learning model of today's mosque, not an exact replica of the sacred site." },
            },
        },
        {
            Title = "The Tawaf Flow",
            LocationName = "Tawaf Path Stop",
            Objective = "Follow the gold trail to the marker on the west side of the white marble mataf.",
            Lines = {
                { Speaker = "Guide", Text = "The white marble floor around the Kaaba is the mataf. Pilgrims walk around the Kaaba seven times, keeping it on their left." },
                { Speaker = "Guide", Text = "In real life, tawaf is worship. Here, the path is only a learning and navigation guide." },
            },
        },
        {
            Title = "Maqam Ibrahim Marker",
            LocationName = "Maqam Stop",
            Objective = "Study Maqam Ibrahim, the gold-and-glass case in front of the Kaaba door.",
            Lines = {
                { Speaker = "Guide", Text = "Maqam Ibrahim is the stone Prophet Ibrahim stood on while building the Kaaba, now kept in a gold and glass case facing the door." },
                { Speaker = "Guide", Text = "After tawaf, pilgrims pray two rak'ahs behind it if they can (Qur'an 2:125)." },
            },
        },
        {
            Title = "Hijr / Hateem Marker",
            LocationName = "Hijr Ismail Stop",
            Objective = "Walk to the curved white wall of Hijr Ismail on the north-west side of the Kaaba.",
            Lines = {
                { Speaker = "Guide", Text = "This low curved wall marks Hijr Ismail, also called the Hateem. Part of it was originally inside the Kaaba, so tawaf goes around the outside of the wall." },
                { Speaker = "Guide", Text = "Above it, the gold rain spout on the Kaaba roof is the Mizab ar-Rahmah." },
            },
        },
        {
            Title = "Galleries, Gates, And Minarets",
            LocationName = "Mataf Gallery Stop",
            Objective = "Finish under the multi-level mataf galleries on the north side and look back over the courtyard.",
            Lines = {
                { Speaker = "Guide", Text = "The ring of galleries around you is the mataf expansion, built so more people can make tawaf on every floor. The ramps take you up to see the Kaaba from above." },
                { Speaker = "Guide", Text = "Beyond it are the King Fahd and King Abdullah expansions, the mas'a between Safa and Marwah on the east side, thirteen minarets and the clock tower to the south." },
                { Speaker = "Guide", Text = "A good learning hub gives you orientation first, then lets stories, battles, and manners lessons branch out naturally." },
            },
        },
    },
    Completion = {
        Title = "Learning Walk Complete",
        Lines = {
            { Speaker = "Guide", Text = "You finished the Haram Learning Walk. Now you know the main landmarks this hub is trying to teach." },
            { Speaker = "Guide", Text = "Next, try a sahabi story, manners lesson, or battle scenario to keep learning through play." },
        },
    },
}

return table.freeze(HaramLearningTrail)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">HistoricalSites</string>
            <string name="Source"><![CDATA[--!strict

-- The historical campaign zones. They are reconstructions of 7th-century Makkah and Madinah
-- and stand far from the present-day hub (which is built around today's Masjid al-Haram and
-- Masjid an-Nabawi) so the two are never confused. Every sign in these zones says
-- "Historical reconstruction". The Prophet Muhammad ﷺ is never shown in them: his place in
-- each scene is told only through written narration.

export type Site = {
    Id: string,
    Zone: string,
    DisplayName: string,
    Description: string,
    Position: Vector3,
    -- What the builder puts here (see HistoricalWorldBuilder).
    Kind: string,
}

export type Zone = {
    Id: string,
    DisplayName: string,
    Period: string,
    Center: Vector3,
    Size: Vector3,
    Disclaimer: string,
}

local MAKKAH = Vector3.new(4000, 0, 0)
local MADINAH = Vector3.new(4000, 0, 1900)

local zones: { Zone } = {
    {
        Id = "makkah_610",
        DisplayName = "Makkah, c. 570-630 CE",
        Period = "Historical reconstruction",
        Center = MAKKAH,
        Size = Vector3.new(1300, 0, 1300),
        Disclaimer = "Historical reconstruction for the Seerah campaign. It is not today's Makkah: visit Masjid al-Haram in the hub for that.",
    },
    {
        Id = "madinah_622",
        DisplayName = "Madinah, c. 622-632 CE",
        Period = "Historical reconstruction",
        Center = MADINAH,
        Size = Vector3.new(1300, 0, 1300),
        Disclaimer = "Historical reconstruction for the Seerah campaign. It is not today's Madinah: visit the present-day Prophet's Mosque courtyard in the hub for that.",
    },
}

local function site(id: string, zone: string, name: string, description: string, offset: Vector3, kind: string): Site
    local center = if zone == "makkah_610" then MAKKAH else MADINAH

    return {
        Id = id,
        Zone = zone,
        DisplayName = name,
        Description = description,
        Position = center + offset,
        Kind = kind,
    }
end

local sites: { Site } = {
    -- Makkah
    site("kaaba_old", "makkah_610", "The Kaaba (c. 600 CE)", "The Kaaba before the large mosque existed, with the houses of Quraysh close around it.", Vector3.new(0, 0, 0), "Kaaba"),
    site("banu_sad_camp", "makkah_610", "Banu Sa'd Tents", "Desert tents of the Banu Sa'd, where children of Makkah were nursed in the open desert.", Vector3.new(-520, 0, -480), "Camp"),
    site("makkah_market", "makkah_610", "Makkah Market", "Stalls where traders from Yemen and Syria met.", Vector3.new(-180, 0, 200), "Market"),
    site("khadijah_house", "makkah_610", "House of Khadijah", "The home of Khadijah bint Khuwaylid, a respected merchant of Makkah.", Vector3.new(170, 0, 180), "House"),
    site("jabal_nour", "makkah_610", "Jabal al-Nour and the Cave of Hira", "The mountain north-east of Makkah with the small cave where the first revelation came.", Vector3.new(-430, 0, 430), "Mountain"),
    site("dar_al_arqam", "makkah_610", "Dar al-Arqam", "The house near Safa where the first Muslims met to learn in secret.", Vector3.new(-200, 0, -40), "House"),
    site("safa_hill", "makkah_610", "Mount Safa", "The low hill near the Kaaba from which public announcements were made to Quraysh.", Vector3.new(-150, 0, -160), "Hill"),
    site("makkah_valley", "makkah_610", "The Hot Valley", "The open, sun-baked ground outside the town where weak believers were tortured.", Vector3.new(320, 0, -260), "Valley"),
    site("red_sea_harbour", "makkah_610", "Harbour and the Court of Abyssinia", "A Red Sea harbour, and a hall standing for the court of the Najashi across the sea.", Vector3.new(560, 0, 120), "Harbour"),
    site("fatimah_house", "makkah_610", "House of Fatimah bint al-Khattab", "The home of Umar's sister, where he heard Surah Ta-Ha.", Vector3.new(230, 0, -40), "House"),
    site("shib_abi_talib", "makkah_610", "Shi'b Abi Talib", "The narrow valley where Banu Hashim lived through the boycott.", Vector3.new(-360, 0, 120), "Valley"),
    site("taif_orchard", "makkah_610", "Orchard near Ta'if", "A walled vineyard on the road from Ta'if, standing for the orchard of Utbah and Shaybah.", Vector3.new(560, 0, -500), "Orchard"),
    site("aqabah_mina", "makkah_610", "Al-Aqabah at Mina", "A hillside pass at Mina where people of Yathrib met at night during the pilgrimage season.", Vector3.new(420, 0, 420), "Hill"),
    site("jabal_thawr", "makkah_610", "Jabal Thawr", "The mountain south of Makkah with the cave where the Hijrah began.", Vector3.new(0, 0, -560), "Mountain"),
    site("hudaybiyyah", "makkah_610", "Al-Hudaybiyyah", "A well and a tree on the edge of the sacred area, where the treaty was agreed.", Vector3.new(-560, 0, 0), "Camp"),
    site("arafat_plain", "makkah_610", "Plain of Arafat", "The wide plain and the Mount of Mercy where pilgrims stand on the Day of Arafah.", Vector3.new(560, 0, 560), "Plain"),

    -- Madinah
    site("quba", "madinah_622", "Quba", "The village south of Madinah where the first mosque was built.", Vector3.new(0, 0, -520), "Mosque"),
    site("masjid_early", "madinah_622", "The First Prophet's Mosque", "A mud-brick courtyard with palm-trunk pillars and a palm-frond roof.", Vector3.new(0, 0, 0), "Mosque"),
    site("abu_ayyub_house", "madinah_622", "House of Abu Ayyub al-Ansari", "The two-storey house where the Prophet ﷺ first stayed in Madinah.", Vector3.new(90, 0, -60), "House"),
    site("madinah_market", "madinah_622", "Madinah Market", "The open market of Madinah.", Vector3.new(-200, 0, -120), "Market"),
    site("council_ground", "madinah_622", "Gathering Ground", "An open space where the tribes of Madinah met and agreements were made.", Vector3.new(220, 0, 160), "Plain"),
    site("qiblatayn", "madinah_622", "Masjid al-Qiblatayn site", "A small prayer place on the north-west edge of Madinah.", Vector3.new(-380, 0, 240), "Mosque"),
    site("war_council", "madinah_622", "War Council", "The tents where the believers prepared before marching out to Badr and Uhud.", Vector3.new(260, 0, -260), "Camp"),
    site("trench_line", "madinah_622", "The Trench", "The northern edge of Madinah where the trench was dug.", Vector3.new(0, 0, 480), "Trench"),
    site("letters_house", "madinah_622", "House of the Scribes", "Where letters were written, sealed, and given to messengers.", Vector3.new(-120, 0, 120), "House"),
    site("tabuk_camp", "madinah_622", "Road North to Tabuk", "The edge of Madinah where the army left for Tabuk in the summer heat.", Vector3.new(420, 0, 460), "Camp"),
}

local siteById: { [string]: Site } = {}

for _, entry in ipairs(sites) do
    siteById[entry.Id] = entry
end

local zoneById: { [string]: Zone } = {}

for _, entry in ipairs(zones) do
    zoneById[entry.Id] = entry
end

-- Height of the cave ledge on Mountain sites.
local MOUNTAIN_LEDGE = 36

-- Where a player must stand to begin a chapter at this site: the cave ledge on mountains,
-- the ground in front of everything else.
local function arrivalPoint(entry: Site): Vector3
    if entry.Kind == "Mountain" then
        return entry.Position + Vector3.new(0, 4 + MOUNTAIN_LEDGE, 0)
    end

    return entry.Position + Vector3.new(0, 4, 0)
end

return {
    FolderName = "HistoricalWorld",
    GroundTop = 4,
    MountainLedge = MOUNTAIN_LEDGE,
    ArrivalPoint = arrivalPoint,
    Zones = zones,
    Sites = sites,
    GetSite = function(id: string): Site?
        return siteById[id]
    end,
    GetZone = function(id: string): Zone?
        return zoneById[id]
    end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">IslamicStudies</string>
            <string name="Source"><![CDATA[--!strict

-- Lessons for the Islamic Studies hall. Each lesson is a few short pages followed by a
-- checkpoint quiz; passing the quiz marks the lesson complete and awards XP.
-- Prophets are taught through narration only and are never shown as characters.
-- Rulings that differ between schools of thought are kept general on purpose, and the
-- lessons point players to a trusted teacher for the details of their own madhhab.

export type QuizQuestion = {
    Prompt: string,
    Options: { string },
    CorrectIndex: number,
    Explanation: string,
}

-- An optional bonus puzzle: put the steps back in the right order.
export type OrderPuzzle = {
    Prompt: string,
    -- Listed in the correct order. The hall shuffles them for the player.
    Steps: { string },
    Explanation: string,
}

export type Lesson = {
    Id: string,
    DisplayName: string,
    Summary: string,
    Pages: { string },
    Quiz: { QuizQuestion },
    Order: OrderPuzzle?,
}

export type Unit = {
    Id: string,
    DisplayName: string,
    Summary: string,
    AccentRGB: { number },
    Lessons: { Lesson },
}

local IslamicStudies: { Units: { Unit }, PassRatio: number } = {
    -- Fraction of quiz questions a player must answer correctly to complete a lesson.
    PassRatio = 0.66,
    Units = {
        {
            Id = "pillars",
            DisplayName = "The Five Pillars",
            Summary = "The five acts every Muslim builds their life on.",
            AccentRGB = { 63, 98, 88 },
            Lessons = {
                {
                    Id = "pillars_intro",
                    DisplayName = "Islam Is Built On Five",
                    Summary = "Why these five acts are called pillars.",
                    Pages = {
                        "A pillar holds a building up. The Prophet, peace be upon him, taught that Islam is built on five pillars (Sahih al-Bukhari 8, Sahih Muslim 16).",
                        "The five pillars are: the Shahadah (declaring faith), Salah (prayer), Zakah (charity), Sawm (fasting in Ramadan), and Hajj (pilgrimage to Makkah).",
                        "Each pillar connects a Muslim to Allah and to other people. Together they shape a believer's day, year, wealth, and whole life.",
                    },
                    Quiz = {
                        {
                            Prompt = "How many pillars of Islam are there?",
                            Options = { "Three", "Five", "Six", "Seven" },
                            CorrectIndex = 2,
                            Explanation = "Islam is built on five pillars, as taught in Sahih al-Bukhari 8.",
                        },
                        {
                            Prompt = "Which of these is NOT one of the five pillars?",
                            Options = { "Salah", "Zakah", "Reading every night", "Hajj" },
                            CorrectIndex = 3,
                            Explanation = "Reading is a great habit, but the pillars are Shahadah, Salah, Zakah, Sawm, and Hajj.",
                        },
                        {
                            Prompt = "Why are they called pillars?",
                            Options = { "They are made of stone", "They hold up a Muslim's faith and practice", "They are only for scholars", "They are optional" },
                            CorrectIndex = 2,
                            Explanation = "Like pillars holding up a building, these five acts hold up a Muslim's religion.",
                        },
                    },
                },
                {
                    Id = "shahadah",
                    DisplayName = "Shahadah: The Declaration Of Faith",
                    Summary = "The first pillar and the meaning of its words.",
                    Pages = {
                        "The Shahadah is: Ash-hadu an la ilaha illa Allah, wa ash-hadu anna Muhammadan rasulullah.",
                        "It means: I bear witness that there is no god worthy of worship except Allah, and I bear witness that Muhammad is the Messenger of Allah.",
                        "The first part is tawhid: believing Allah is One, with no partner. The second part means following the guidance Allah sent through His final Messenger.",
                        "A person becomes Muslim by sincerely believing and saying the Shahadah. Muslims repeat it in every prayer and in the call to prayer.",
                    },
                    Quiz = {
                        {
                            Prompt = "What does 'la ilaha illa Allah' mean?",
                            Options = { "Allah is great", "There is no god worthy of worship except Allah", "All praise is for Allah", "In the name of Allah" },
                            CorrectIndex = 2,
                            Explanation = "It is the declaration of tawhid: worship belongs to Allah alone.",
                        },
                        {
                            Prompt = "What is the belief that Allah is One with no partner called?",
                            Options = { "Tawhid", "Sadaqah", "Hijrah", "Sunnah" },
                            CorrectIndex = 1,
                            Explanation = "Tawhid means the Oneness of Allah.",
                        },
                        {
                            Prompt = "Which pillar comes first?",
                            Options = { "Hajj", "Sawm", "Shahadah", "Zakah" },
                            CorrectIndex = 3,
                            Explanation = "The Shahadah is the first pillar and the foundation for the rest.",
                        },
                    },
                },
                {
                    Id = "salah_pillar",
                    DisplayName = "Salah: The Five Daily Prayers",
                    Summary = "The names and times of the five prayers.",
                    Pages = {
                        "Salah is the second pillar. Muslims pray five times every day, facing the Kaaba in Makkah. This direction is called the qiblah.",
                        "Fajr is prayed before sunrise (2 rak'ahs). Dhuhr is just after midday (4). Asr is in the afternoon (4). Maghrib is just after sunset (3). Isha is at night (4).",
                        "Allah says: 'Indeed, prayer has been decreed upon the believers at fixed times' (Qur'an 4:103).",
                        "Salah is a daily meeting with Allah. It keeps a believer close to Him and away from wrongdoing (Qur'an 29:45).",
                    },
                    Quiz = {
                        {
                            Prompt = "How many obligatory prayers are there each day?",
                            Options = { "Three", "Four", "Five", "Seven" },
