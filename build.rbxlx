    <Item class="Script" referent="35">
      <Properties>
        <string name="Name">CamelMountService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CAMEL_TAG = "RideableCamel"

type CamelState = {
    Seat: VehicleSeat?,
    PromptConnections: { RBXScriptConnection },
    CurrentThrottle: number,
    CurrentSteer: number,
}

local camelStates: { [Model]: CamelState } = {}
local promptConnections: { [ProximityPrompt]: RBXScriptConnection } = {}

local function getCamelFromInstance(instance: Instance): Model?
    local current: Instance? = instance

    while current do
        if current:IsA("Model") and CollectionService:HasTag(current, CAMEL_TAG) then
            return current
        end

        current = current.Parent
    end

    return nil
end

local function getSeat(camel: Model): VehicleSeat?
    local existing = camel:FindFirstChild("CamelSeat", true)

    if existing and existing:IsA("VehicleSeat") then
        return existing
    end

    return nil
end

local function getRoot(camel: Model): BasePart?
    if camel.PrimaryPart then
        return camel.PrimaryPart
    end

    local root = camel:FindFirstChild("CamelRoot", true)

    if root and root:IsA("BasePart") then
        camel.PrimaryPart = root
        return root
    end

    return nil
end

local function setCamelPromptEnabled(camel: Model, enabled: boolean)
    for _, descendant in ipairs(camel:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant:GetAttribute("PromptAction") == "RideCamel" then
            descendant.Enabled = enabled
        end
    end
end

local function seatPlayerOnCamel(player: Player, camel: Model)
    local seat = getSeat(camel)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not seat or not humanoid or humanoid.Health <= 0 then
        return
    end

    if seat.Occupant and seat.Occupant ~= humanoid then
        return
    end

    seat:Sit(humanoid)
    setCamelPromptEnabled(camel, false)
end

local function connectPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    if prompt:GetAttribute("PromptAction") ~= "RideCamel" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local camel = getCamelFromInstance(prompt)

        if camel then
            seatPlayerOnCamel(player, camel)
        end
    end)
end

local function setupCamel(camel: Model)
    if camelStates[camel] then
        return
    end

    local seat = getSeat(camel)

    if not seat then
        return
    end

    local promptState = {
        Seat = seat,
        PromptConnections = {},
        CurrentThrottle = 0,
        CurrentSteer = 0,
    }
    camelStates[camel] = promptState

    for _, descendant in ipairs(camel:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end

    table.insert(promptState.PromptConnections, camel.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end))

    table.insert(promptState.PromptConnections, seat:GetPropertyChangedSignal("Occupant"):Connect(function()
        setCamelPromptEnabled(camel, seat.Occupant == nil)
    end))
end

local function cleanupCamel(camel: Model)
    local state = camelStates[camel]

    if not state then
        return
    end

    for _, connection in ipairs(state.PromptConnections) do
        connection:Disconnect()
    end

    camelStates[camel] = nil
end

local function getCamelControls(seat: VehicleSeat): (number?, number?)
    local occupant = seat.Occupant

    if not occupant or occupant.Health <= 0 then
        return nil, nil
    end

    local player = Players:GetPlayerFromCharacter(occupant.Parent)

    if not player or player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true then
        occupant.Sit = false
        return nil, nil
    end

    local throttle = seat.ThrottleFloat
    local steer = seat.SteerFloat

    return throttle, steer
end

RunService.Heartbeat:Connect(function(deltaTime)
    for camel, state in pairs(camelStates) do
        local seat = state.Seat
        local root = getRoot(camel)

        if not camel.Parent or not seat or not root then
            cleanupCamel(camel)
            continue
        end

        local throttle, steer = getCamelControls(seat)
        local inputAlpha = math.min(1, deltaTime * 4.8)
        state.CurrentThrottle += ((throttle or 0) - state.CurrentThrottle) * inputAlpha
        state.CurrentSteer += ((steer or 0) - state.CurrentSteer) * inputAlpha

        if math.abs(state.CurrentThrottle) > 0.015 or math.abs(state.CurrentSteer) > 0.015 then
            local speed = camel:GetAttribute("CamelSpeed")

            if type(speed) ~= "number" then
                speed = 46
            end

            local currentCFrame = camel:GetPivot()
            local turnRate = camel:GetAttribute("CamelTurnRate")

            if type(turnRate) ~= "number" then
                turnRate = 2.2
            end

            local steeredCFrame = currentCFrame * CFrame.Angles(0, -state.CurrentSteer * turnRate * deltaTime, 0)
            local forward = -steeredCFrame.RightVector
            local flatForward = Vector3.new(forward.X, 0, forward.Z)

            if flatForward.Magnitude > 0.01 then
                local nextPosition = steeredCFrame.Position + flatForward.Unit * state.CurrentThrottle * speed * deltaTime
                camel:PivotTo(CFrame.new(nextPosition) * (steeredCFrame - steeredCFrame.Position))
            else
                camel:PivotTo(steeredCFrame)
            end
        end
    end
end)

for _, camel in ipairs(CollectionService:GetTagged(CAMEL_TAG)) do
    if camel:IsA("Model") then
        setupCamel(camel)
    end
end

CollectionService:GetInstanceAddedSignal(CAMEL_TAG):Connect(function(instance)
    if instance:IsA("Model") then
        setupCamel(instance)
    end
end)

CollectionService:GetInstanceRemovedSignal(CAMEL_TAG):Connect(function(instance)
    if instance:IsA("Model") then
        cleanupCamel(instance)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="36">
      <Properties>
        <string name="Name">CoopTrialsService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

-- Trials of Brotherhood: a two-player co-op puzzle course. Its theme is the brotherhood between
-- the Muhajirun and the Ansar in Madinah (Seerah chapter 19); the puzzles themselves are game
-- inventions and the signs say so.
--
-- 1. Twin Plates: a gate opens only while someone stands on a plate. One plate is before the
--    gate and one after it, so one player holds it for the other, who then holds it back.
-- 2. The Lift: the lift rises while a partner stands on the counterweight. On the ledge, the
--    rider holds a plate that lowers the stairway for the partner below.
-- 3. Together: the finish counts only when two players stand on the twin pads at once.
--
-- One player can never pass gate 1 alone: the gate shuts the moment its plate is empty.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TravelRoute = require(Shared.Data.TravelRoute)
local BuildUtils = require(script.Parent.Modules.BuildUtils)
local PlayerProgress = require(script.Parent.Modules.PlayerProgress)
local Analytics = require(script.Parent.Modules.Analytics)

local remotes = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Coop")
local stateEvent = remotes:WaitForChild("State") :: RemoteEvent

local CENTER = (TravelRoute.GetDestinationById("coop_trials") :: any).Position - Vector3.new(0, 4, 0)
local G = 4 -- ground top
local LEDGE = 20
local STONE = Color3.fromRGB(184, 172, 150)
local TEAL = Color3.fromRGB(71, 112, 128)

local existing = Workspace:FindFirstChild("CoopTrials")

if existing then
    existing:Destroy()
end

local folder = BuildUtils.CreateFolder(Workspace, "CoopTrials")

local function block(name: string, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material?, transparency: number?): Part
    return BuildUtils.CreatePart(folder, name, size, CFrame.new(CENTER + offset), color, material or Enum.Material.Slate, nil, transparency)
end

local function boardAt(name: string, offset: Vector3, title: string, body: string)
    local board = BuildUtils.CreateBoardSign(folder, name, CENTER + offset, title, body, TEAL, nil)
    board.Orientation = Vector3.new(0, 0, 0)
end

-- Ground, side walls, and the start area.
block("SafetyPlate", Vector3.new(300, 10, 400), Vector3.new(0, -8, 0), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, 1)
block("Ground", Vector3.new(84, G, 260), Vector3.new(0, G / 2, 0), Color3.fromRGB(208, 196, 172), Enum.Material.Sandstone)
block("WallWest", Vector3.new(2, 34, 260), Vector3.new(-42, G + 17, 0), STONE)
block("WallEast", Vector3.new(2, 34, 260), Vector3.new(42, G + 17, 0), STONE)
block("WallBack", Vector3.new(84, 34, 2), Vector3.new(0, G + 17, -130), STONE)
boardAt("StartSign", Vector3.new(0, G, -100), "Trials of Brotherhood", "A co-op course for two or more. In Madinah, each emigrant was paired with a helper of the Ansar. Help each other through. The puzzles are a game; the brotherhood is history.")

-- Stage 1: gate wall with a doorway, plate A before it and plate B after it.
block("GateWallWest", Vector3.new(37, 34, 2), Vector3.new(-23.5, G + 17, -40), STONE)
block("GateWallEast", Vector3.new(37, 34, 2), Vector3.new(23.5, G + 17, -40), STONE)
local gate = block("Gate", Vector3.new(10, 34, 1.6), Vector3.new(0, G + 17, -40), Color3.fromRGB(110, 80, 52), Enum.Material.WoodPlanks)
local plateA = block("PlateA", Vector3.new(8, 0.6, 8), Vector3.new(-28, G + 0.3, -62), Color3.fromRGB(196, 150, 70), Enum.Material.Metal)
local plateB = block("PlateB", Vector3.new(8, 0.6, 8), Vector3.new(-28, G + 0.3, -24), Color3.fromRGB(196, 150, 70), Enum.Material.Metal)
boardAt("Stage1Sign", Vector3.new(0, G, -72), "1. Twin Plates", "The gate stays open only while someone stands on a gold plate. One of you holds it, the other goes through and holds the far plate.")

-- Stage 2: the ledge, the lift, the counterweight, and the hidden stairway.
block("LedgeFace", Vector3.new(84, LEDGE, 120), Vector3.new(0, G + LEDGE / 2, 70), STONE)
local lift = block("Lift", Vector3.new(10, 1, 10), Vector3.new(-24, G + 0.5, 4), TEAL, Enum.Material.Metal)
local liftBottom = lift.CFrame
local liftTop = lift.CFrame + Vector3.new(0, LEDGE, 0)
local counterweight = block("Counterweight", Vector3.new(8, 0.6, 8), Vector3.new(6, G + 0.3, -12), Color3.fromRGB(196, 150, 70), Enum.Material.Metal)
local plateC = block("PlateC", Vector3.new(8, 0.6, 8), Vector3.new(0, G + LEDGE + 0.3, 24), Color3.fromRGB(196, 150, 70), Enum.Material.Metal)
local stairs = BuildUtils.CreateWedge(folder, "Stairway", Vector3.new(10, LEDGE, 34), CFrame.new(CENTER + Vector3.new(26, G + LEDGE / 2, -7)), Color3.fromRGB(160, 140, 112), Enum.Material.Slate, 0.85)
stairs.CanCollide = false
boardAt("Stage2Sign", Vector3.new(-14, G, -34), "2. The Lift", "Stand on the counterweight to raise your partner's lift. Up on the ledge, hold the plate to lower the stairway for the one below.")

-- Stage 3: twin finish pads on the ledge.
local padLeft = block("FinishLeft", Vector3.new(8, 0.6, 8), Vector3.new(-14, G + LEDGE + 0.3, 104), Color3.fromRGB(120, 170, 120), Enum.Material.Neon)
local padRight = block("FinishRight", Vector3.new(8, 0.6, 8), Vector3.new(14, G + LEDGE + 0.3, 104), Color3.fromRGB(120, 170, 120), Enum.Material.Neon)
boardAt("Stage3Sign", Vector3.new(0, G + LEDGE, 84), "3. Together", "Stand on both green pads at the same time to finish the trial together.")

local function playersOn(plate: BasePart): { Player }
    local list = {}
    local half = plate.Size / 2

    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
            local offset = plate.CFrame:PointToObjectSpace(root.Position)

            if math.abs(offset.X) <= half.X + 1 and math.abs(offset.Z) <= half.Z + 1 and offset.Y > 0 and offset.Y < 6 then
                table.insert(list, player)
            end
        end
    end

    return list
end

local function inCourse(player: Player): boolean
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root or not root:IsA("BasePart") then
        return false
    end

    local offset = root.Position - CENTER

    return math.abs(offset.X) < 44 and math.abs(offset.Z) < 132 and offset.Y < 70
end

local function setLit(plate: BasePart, lit: boolean)
    plate.Material = if lit then Enum.Material.Neon else Enum.Material.Metal
end

local liftUp = false
local liftTween: Tween? = nil
local finishedAt = 0

local function moveLift(up: boolean)
    if up == liftUp then
        return
    end

    liftUp = up

    if liftTween then
        liftTween:Cancel()
    end

    local tween = TweenService:Create(lift, TweenInfo.new(if up then 3 else 1.5, Enum.EasingStyle.Sine), { CFrame = if up then liftTop else liftBottom })
    liftTween = tween
    tween:Play()
end

local lastState = ""

task.spawn(function()
    while true do
        task.wait(0.1)

        local onA, onB = playersOn(plateA), playersOn(plateB)
        local gateOpen = #onA > 0 or #onB > 0
        gate.CanCollide = not gateOpen
        gate.Transparency = if gateOpen then 0.8 else 0
        setLit(plateA, #onA > 0)
        setLit(plateB, #onB > 0)

        -- The counterweight only works when the person on it is not also riding the lift.
        local weight = playersOn(counterweight)
        moveLift(#weight > 0)
        setLit(counterweight, #weight > 0)

        local onC = playersOn(plateC)
        local stairsDown = #onC > 0
        stairs.CanCollide = stairsDown
        stairs.Transparency = if stairsDown then 0 else 0.85
        setLit(plateC, stairsDown)

        local left, right = playersOn(padLeft), playersOn(padRight)
        local together = {}

        for _, player in ipairs(left) do
            together[player] = true
        end

        for _, player in ipairs(right) do
            together[player] = true
        end

        local distinct = 0

        for _ in pairs(together) do
            distinct += 1
        end

        if #left > 0 and #right > 0 and distinct >= 2 and os.clock() - finishedAt > 8 then
            finishedAt = os.clock()

            for _, player in ipairs(Players:GetPlayers()) do
                if inCourse(player) then
                    PlayerProgress.RecordCompletion(player, "coop", "brotherhood_trials", "Trials of Brotherhood")
                    PlayerProgress.IncrementStat(player, "CoopFinishes", 1)
                    Analytics.Custom(player, "CoopFinish", distinct)
                    stateEvent:FireClient(player, { Event = "finish", Players = distinct })
                end
            end
        end

        local state = string.format("%s%s%s%s", tostring(gateOpen), tostring(liftUp), tostring(stairsDown), tostring(#left > 0 and #right > 0))

        if state ~= lastState then
            lastState = state

            for _, player in ipairs(Players:GetPlayers()) do
                if inCourse(player) then
                    stateEvent:FireClient(player, { Event = "state", GateOpen = gateOpen, LiftUp = liftUp, StairsDown = stairsDown })
                end
            end
        end
    end
end)

folder:SetAttribute("Built", true)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="37">
      <Properties>
        <string name="Name">FallGuard</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TravelRoute = require(Shared.Data.TravelRoute)

local FALL_LIMIT_Y = -20

local function findFirstBasePart(parent: Instance?): BasePart?
    if not parent then
        return nil
    end

    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("BasePart") then
            return child
        end
    end

    return nil
end

local function getHubAnchor(): BasePart?
    local hubFolder = Workspace:FindFirstChild(TravelRoute.WorldFolderName)

    if not hubFolder then
        return nil
    end

    local teleportFolder = hubFolder:FindFirstChild("TeleportPoints")

    if not teleportFolder then
        return nil
    end

    local anchor = teleportFolder:FindFirstChild(TravelRoute.StartDestinationId)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function getBattleAnchor(character: Model): BasePart?
    local scenarioId = character:GetAttribute("ScenarioId")
    local teamId = character:GetAttribute("BattleTeam")

    if typeof(scenarioId) ~= "string" or typeof(teamId) ~= "string" then
        return nil
    end

    local battlesFolder = Workspace:FindFirstChild("GeneratedBattles")
    local scenarioFolder = battlesFolder and battlesFolder:FindFirstChild(scenarioId)
    local spawns = scenarioFolder and scenarioFolder:FindFirstChild("Spawns")
    local teamFolder = spawns and spawns:FindFirstChild(teamId)

    return findFirstBasePart(teamFolder)
end

local function getStoryAnchor(player: Player): BasePart?
    local storyId = player:GetAttribute("CurrentStoryId")

    if typeof(storyId) ~= "string" then
        return nil
    end

    local storiesFolder = Workspace:FindFirstChild("GeneratedStories")
    local zoneFolder = storiesFolder and storiesFolder:FindFirstChild(storyId)
    local anchors = zoneFolder and zoneFolder:FindFirstChild("Anchors")
    local stepIndex = player:GetAttribute("CurrentStoryStepIndex")
    local preferredName = nil

    if type(stepIndex) == "number" then
        preferredName = string.format("Step_%d", stepIndex)
    end

    local preferredAnchor = preferredName and anchors and anchors:FindFirstChild(preferredName)

    if preferredAnchor and preferredAnchor:IsA("BasePart") then
        return preferredAnchor
    end

    local entryAnchor = anchors and anchors:FindFirstChild("Entry")

    if entryAnchor and entryAnchor:IsA("BasePart") then
        return entryAnchor
    end

    return nil
end

local function moveCharacterToAnchor(character: Model, anchor: BasePart)
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
        return
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    character:PivotTo(anchor.CFrame + Vector3.new(0, 5, 0))
end

task.spawn(function()
    while true do
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character

            if character then
                local root = character:FindFirstChild("HumanoidRootPart")

                if root and root:IsA("BasePart") and root.Position.Y < FALL_LIMIT_Y then
                    local anchor = getBattleAnchor(character) or getStoryAnchor(player) or getHubAnchor()

                    if anchor then
                        moveCharacterToAnchor(character, anchor)
                    end
                end
            end
        end

        task.wait(0.35)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="38">
      <Properties>
        <string name="Name">GameBootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ContentIndex = require(Shared.Modules.ContentIndex)

local function ensureFolder(parent: Instance, name: string): Folder
    local existing = parent:FindFirstChild(name)

    if existing then
        if existing:IsA("Folder") then
            return existing
        end

        error(string.format("Expected Folder named %s under %s, found %s", name, parent:GetFullName(), existing.ClassName))
    end

    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent

    return folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
    local existing = parent:FindFirstChild(name)

    if existing then
        if existing:IsA("RemoteEvent") then
            return existing
        end

        error(string.format("Expected RemoteEvent named %s under %s, found %s", name, parent:GetFullName(), existing.ClassName))
    end

    local remoteEvent = Instance.new("RemoteEvent")
    remoteEvent.Name = name
    remoteEvent.Parent = parent

    return remoteEvent
end

local content = ContentIndex.GetStartupPayload()
local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")

local storyFolder = ensureFolder(remotesFolder, "Story")
local battleFolder = ensureFolder(remotesFolder, "Battle")
local shopFolder = ensureFolder(remotesFolder, "Shop")
local hubFolder = ensureFolder(remotesFolder, "Hub")
local mannersFolder = ensureFolder(remotesFolder, "Manners")
local triviaFolder = ensureFolder(remotesFolder, "Trivia")
local progressFolder = ensureFolder(remotesFolder, "Progress")
local learningFolder = ensureFolder(remotesFolder, "Learning")

ensureRemoteEvent(hubFolder, "RequestTeleport")
ensureRemoteEvent(hubFolder, "RequestHaramTrail")
ensureRemoteEvent(hubFolder, "ShowLearningTrail")
ensureRemoteEvent(hubFolder, "UpdateLearningTrail")
ensureRemoteEvent(hubFolder, "ClearLearningTrail")
ensureRemoteEvent(battleFolder, "ShowBattleMessage")
ensureRemoteEvent(battleFolder, "ShowBattleSummary")
ensureRemoteEvent(battleFolder, "PlayReenactment")
ensureRemoteEvent(battleFolder, "RequestJoinBattle")
ensureRemoteEvent(battleFolder, "RequestBlock")
ensureRemoteEvent(battleFolder, "MissionUpdate")
ensureRemoteEvent(battleFolder, "MissionResult")
ensureRemoteEvent(battleFolder, "SubmitReflection")
ensureRemoteEvent(battleFolder, "ReflectionResult")
ensureRemoteEvent(storyFolder, "ShowStoryDialogue")
ensureRemoteEvent(storyFolder, "UpdateStoryMission")
ensureRemoteEvent(storyFolder, "ClearStoryMission")
ensureRemoteEvent(storyFolder, "RequestStartStory")
ensureRemoteEvent(mannersFolder, "RequestLesson")
ensureRemoteEvent(mannersFolder, "ShowMannersLesson")
ensureRemoteEvent(triviaFolder, "RequestStartTrivia")
ensureRemoteEvent(triviaFolder, "SubmitTriviaAnswer")
ensureRemoteEvent(triviaFolder, "ShowTriviaQuestion")
ensureRemoteEvent(triviaFolder, "ShowTriviaResult")
ensureRemoteEvent(triviaFolder, "UpdateTriviaScores")
ensureRemoteEvent(triviaFolder, "ClearTrivia")
ensureRemoteEvent(progressFolder, "RequestProfile")
ensureRemoteEvent(progressFolder, "ProfileUpdated")
ensureRemoteEvent(progressFolder, "ProgressToast")
ensureRemoteEvent(learningFolder, "OpenLearningHall")
ensureRemoteEvent(learningFolder, "SubmitQuiz")
ensureRemoteEvent(learningFolder, "QuizResult")
ensureRemoteEvent(learningFolder, "SubmitOrder")
ensureRemoteEvent(learningFolder, "OrderResult")
ensureRemoteEvent(learningFolder, "SubmitDailyAnswer")
ensureRemoteEvent(learningFolder, "DailyResult")
ensureRemoteEvent(learningFolder, "StudyCircleUpdate")
ensureRemoteEvent(learningFolder, "StudyCircleAnswer")
ensureRemoteEvent(shopFolder, "RequestShopState")
ensureRemoteEvent(shopFolder, "PromptGamePassPurchase")
ensureRemoteEvent(shopFolder, "PromptDeveloperProductPurchase")
ensureRemoteEvent(shopFolder, "EquipSkin")
ensureRemoteEvent(shopFolder, "UseUltimate")
ensureRemoteEvent(shopFolder, "ShopState")
ensureRemoteEvent(shopFolder, "PurchaseFeedback")

-- Systems added for the Seerah campaign, mysteries, activities, social tools, and support.
for _, name in ipairs({ "Campaign", "Mystery", "Parkour", "Coop", "Pvp", "Social", "Support" }) do
    local folder = ensureFolder(remotesFolder, name)
    ensureRemoteEvent(folder, "Request")
    ensureRemoteEvent(folder, "State")
end

print(string.format(
    "[GameBootstrap] %s loaded with %d stories, %d Islamic Studies units, %d battle scenarios, %d travel landmarks, and %d premium products.",
    content.Config.GameName,
    #content.Stories,
    #content.IslamicStudies.Units,
    #content.Battles,
    #content.TravelRoute.Destinations,
    #content.Shop.GamePasses + #content.Shop.DeveloperProducts
))
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="39">
      <Properties>
        <string name="Name">GuideService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

-- Builds the hub's guide teachers (see Shared/Data/Guides). Talking to one opens a dialogue
-- on the client that names the player's next quest and can take them straight there.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Guides = require(Shared.Data.Guides)
local TravelRoute = require(Shared.Data.TravelRoute)
local Figures = require(script.Parent.Modules.Figures)

local worldFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName)

while worldFolder:GetAttribute("Built") ~= true do
    worldFolder:GetAttributeChangedSignal("Built"):Wait()
end

local function rgb(values: { number }): Color3
    return Color3.fromRGB(values[1], values[2], values[3])
end

-- Finds the walkable surface under a point so guides stand on whatever the hub built there.
-- The ray starts just above head height so canopies and roofs overhead are never hit.
local function groundBelow(position: Vector3, ignore: { Instance }): Vector3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore

    local result = Workspace:Raycast(position + Vector3.new(0, 8, 0), Vector3.new(0, -40, 0), params)

    return if result then result.Position else position
end

local function buildAvatar(guide: Guides.Guide): Model
    local description = Instance.new("HumanoidDescription")
    local skin = rgb(guide.SkinRGB)
    description.HeadColor = skin
    description.LeftArmColor = skin
    description.RightArmColor = skin
    description.TorsoColor = rgb(guide.RobeRGB)
    description.LeftLegColor = rgb(guide.RobeRGB)
    description.RightLegColor = rgb(guide.RobeRGB)

    local ok, result = pcall(function()
        return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
    end)

    description:Destroy()

    if ok and result then
        return result
    end

    warn(string.format("[GuideService] Avatar for %s fell back to a simple figure: %s", guide.DisplayName, tostring(result)))

    -- Fallback: a plain robed figure so the guide still exists if avatar loading fails.
    local model = Instance.new("Model")
    local root = Instance.new("Part")
    root.Name = "HumanoidRootPart"
    root.Size = Vector3.new(2, 5, 1.4)
    root.Color = rgb(guide.RobeRGB)
    root.Material = Enum.Material.Fabric
    root.Parent = model

    local head = Instance.new("Part")
    head.Name = "Head"
    head.Shape = Enum.PartType.Ball
    head.Size = Vector3.new(1.6, 1.6, 1.6)
    head.Color = skin
    head.CFrame = root.CFrame * CFrame.new(0, 3.3, 0)
    head.Parent = model

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = head
    weld.Parent = root

    local humanoid = Instance.new("Humanoid")
    humanoid.Parent = model
    model.PrimaryPart = root

    return model
end

local function buildGuide(parent: Instance, guide: Guides.Guide)
    local destination = TravelRoute.GetDestinationById(guide.Destination)

    if not destination then
        warn(string.format("[GuideService] Unknown destination %s for guide %s", guide.Destination, guide.Id))
        return
    end

    local anchor = destination.TeleportPosition or destination.Position
    local model = buildAvatar(guide)
    -- Every figure in the game has a blank face (see Modules/Figures).
    Figures.StripFaces(model)
    model.Name = guide.Id

    local humanoid = model:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.DisplayName = guide.DisplayName
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        humanoid.BreakJointsOnDeath = false
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge
    end

    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
        end
    end

    local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")

    if not root or not root:IsA("BasePart") then
        model:Destroy()
        return
    end

    root.CanCollide = true

    local hipHeight = if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then humanoid.HipHeight + root.Size.Y / 2 else root.Size.Y / 2
    local feet = groundBelow(anchor + guide.Offset, { model, parent })
    -- Face the teleport point, which is where players arrive.
    local standAt = feet + Vector3.new(0, hipHeight, 0)
    local lookAt = Vector3.new(anchor.X, standAt.Y, anchor.Z)
    model:PivotTo(if (lookAt - standAt).Magnitude > 0.1 then CFrame.lookAt(standAt, lookAt) else CFrame.new(standAt))
    model.Parent = parent

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NameTag"
    billboard.Size = UDim2.fromOffset(220, 54)
    billboard.StudsOffset = Vector3.new(0, 4.2, 0)
    billboard.MaxDistance = 90
    billboard.AlwaysOnTop = false
    billboard.Parent = root

    local nameLabel = Instance.new("TextLabel")
    nameLabel.BackgroundTransparency = 1
    nameLabel.Size = UDim2.new(1, 0, 0, 28)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Text = guide.DisplayName
    nameLabel.TextColor3 = Color3.fromRGB(250, 246, 234)
    nameLabel.TextStrokeTransparency = 0.4
    nameLabel.TextSize = 20
    nameLabel.Parent = billboard

    local roleLabel = Instance.new("TextLabel")
    roleLabel.BackgroundTransparency = 1
    roleLabel.Position = UDim2.fromOffset(0, 28)
    roleLabel.Size = UDim2.new(1, 0, 0, 20)
    roleLabel.Font = Enum.Font.GothamMedium
    roleLabel.Text = string.format("! %s", guide.Role)
    roleLabel.TextColor3 = Color3.fromRGB(240, 207, 120)
    roleLabel.TextStrokeTransparency = 0.5
    roleLabel.TextSize = 15
    roleLabel.Parent = billboard

    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Talk"
    prompt.ObjectText = guide.DisplayName
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 12
    prompt.RequiresLineOfSight = false
    prompt:SetAttribute("PromptAction", "TalkToGuide")
    prompt:SetAttribute("GuideId", guide.Id)
    prompt.Parent = root
end

local guidesFolder = Instance.new("Folder")
guidesFolder.Name = "Guides"
guidesFolder.Parent = worldFolder

for _, guide in ipairs(Guides) do
    local ok: boolean, err: any = pcall(function()
        buildGuide(guidesFolder, guide)
    end)

    if not ok then
        warn(string.format("[GuideService] Could not build guide %s: %s", guide.Id, tostring(err)))
    end
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="40">
      <Properties>
        <string name="Name">HaramLearningTrailService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HaramLearningTrail = require(Shared.Data.HaramLearningTrail)
local TravelRoute = require(Shared.Data.TravelRoute)
local PlayerProgress = require(script.Parent.Modules.PlayerProgress)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local hubFolder = remotesFolder:WaitForChild("Hub")
local shopFolder = remotesFolder:WaitForChild("Shop")
local requestHaramTrail = hubFolder:WaitForChild("RequestHaramTrail") :: RemoteEvent
local showLearningTrail = hubFolder:WaitForChild("ShowLearningTrail") :: RemoteEvent
local updateLearningTrail = hubFolder:WaitForChild("UpdateLearningTrail") :: RemoteEvent
local clearLearningTrail = hubFolder:WaitForChild("ClearLearningTrail") :: RemoteEvent

local LINE_DURATION_SECONDS = 2.45
local activeTrails = {}
local rewardedPlayers = {}
local promptConnections = {}

local function getGrantCurrencyBindable(): BindableEvent?
    local bindable = shopFolder:FindFirstChild("GrantCurrency")

    if bindable and bindable:IsA("BindableEvent") then
        return bindable
    end

    return nil
end

local function awardKnowledgeTokens(player: Player, amount: number, reason: string)
    if amount <= 0 or rewardedPlayers[player] == true then
        return
    end

    rewardedPlayers[player] = true

    local bindable = getGrantCurrencyBindable()

    if bindable then
        bindable:Fire(player, amount, reason)
        return
    end

    local currentTokens = player:GetAttribute("KnowledgeTokens")

    if type(currentTokens) ~= "number" then
        currentTokens = 0
    end

    player:SetAttribute("KnowledgeTokens", currentTokens + amount)
end

local function canUseTrail(player: Player): boolean
    return player:GetAttribute("InBattle") ~= true and player:GetAttribute("InStory") ~= true
end

local function showTrailMessage(player: Player, title: string, lines)
    showLearningTrail:FireClient(player, {
        TrailName = HaramLearningTrail.DisplayName,
        Title = title,
        Lines = lines,
        AccentColor = HaramLearningTrail.AccentColor,
    })
end

local function updateTrailMission(player: Player)
    local state = activeTrails[player]

    if not state then
        clearLearningTrail:FireClient(player)
        return
    end

    local step = HaramLearningTrail.Steps[state.StepIndex]

    if not step then
        clearLearningTrail:FireClient(player)
        return
    end

    updateLearningTrail:FireClient(player, {
        TrailName = HaramLearningTrail.DisplayName,
        StepLabel = string.format("Stop %d of %d", state.StepIndex, #HaramLearningTrail.Steps),
        Objective = step.Objective,
        LocationName = step.LocationName,
        AccentColor = HaramLearningTrail.AccentColor,
    })
end

local function startTrail(player: Player)
    if not canUseTrail(player) then
        return
    end

    local existingState = activeTrails[player]

    if existingState then
        updateTrailMission(player)
        return
    end

    activeTrails[player] = {
        StepIndex = 1,
        StepLocked = false,
    }

    player:SetAttribute("CurrentLearningTrailId", HaramLearningTrail.Id)
    player:SetAttribute("CurrentLearningTrailStep", 1)
    updateTrailMission(player)
    showTrailMessage(player, "Learning Walk Started", {
        { Speaker = "Guide", Text = HaramLearningTrail.StartObjective },
    })
end

local function completeTrail(player: Player, state)
    showTrailMessage(player, HaramLearningTrail.Completion.Title, HaramLearningTrail.Completion.Lines)
    awardKnowledgeTokens(player, HaramLearningTrail.RewardTokens or 0, HaramLearningTrail.DisplayName)
    PlayerProgress.RecordCompletion(player, "trail", HaramLearningTrail.Id, HaramLearningTrail.DisplayName)

    task.delay(math.max(5, #HaramLearningTrail.Completion.Lines * LINE_DURATION_SECONDS + 0.8), function()
        if activeTrails[player] ~= state then
            return
        end

        activeTrails[player] = nil
        player:SetAttribute("CurrentLearningTrailId", nil)
        player:SetAttribute("CurrentLearningTrailStep", nil)
        clearLearningTrail:FireClient(player)
    end)
end

local function triggerTrailStep(player: Player, stepIndex: number)
    if not canUseTrail(player) then
        return
    end

    if not activeTrails[player] and stepIndex == 1 then
        startTrail(player)
    elseif not activeTrails[player] then
        showTrailMessage(player, "Start The Walk First", {
            { Speaker = "Guide", Text = HaramLearningTrail.StartObjective },
        })
        return
    end

    local state = activeTrails[player]

    if not state or state.StepLocked == true then
        return
    end

    if state.StepIndex ~= stepIndex then
        local currentStep = HaramLearningTrail.Steps[state.StepIndex]

        if currentStep then
            showTrailMessage(player, "Follow The Gold Trail", {
                { Speaker = "Guide", Text = currentStep.Objective },
            })
        end

        return
    end

    local step = HaramLearningTrail.Steps[stepIndex]

    if not step then
        return
    end

    state.StepLocked = true
    showTrailMessage(player, step.Title, step.Lines)

    local holdDuration = math.max(3.2, #step.Lines * LINE_DURATION_SECONDS + 0.75)

    task.delay(holdDuration, function()
        if activeTrails[player] ~= state then
            return
        end

        if state.StepIndex ~= stepIndex then
            return
        end

        if stepIndex >= #HaramLearningTrail.Steps then
            state.StepLocked = false
            completeTrail(player, state)
            return
        end

        state.StepIndex += 1
        state.StepLocked = false
        player:SetAttribute("CurrentLearningTrailStep", state.StepIndex)
        updateTrailMission(player)
    end)
end

local function connectPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    if prompt:GetAttribute("PromptAction") ~= "HaramTrailStep" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local stepIndex = prompt:GetAttribute("StepIndex")

        if type(stepIndex) == "number" then
            triggerTrailStep(player, stepIndex)
        end
    end)
end

local function connectPromptsIn(instance: Instance)
    for _, descendant in ipairs(instance:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end

    instance.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end)
end

requestHaramTrail.OnServerEvent:Connect(function(player: Player)
    startTrail(player)
end)

task.spawn(function()
    local worldFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if worldFolder then
        connectPromptsIn(worldFolder)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    activeTrails[player] = nil
    rewardedPlayers[player] = nil
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="41">
      <Properties>
        <string name="Name">HaramTimeService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

-- Keeps the Masjid al-Haram hub alive over the day cycle:
--   * the four Abraj Al-Bait clock faces show the real time in Makkah (UTC+3),
--   * night lights (tagged by MasjidAlHaram) switch on after dark, and lamps, clock dials and
--     the green sa'i lights glow as Neon at night and return to their day material at dawn.
-- HubAtmosphere drives Lighting.ClockTime; this script only reads it.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local MasjidAlHaram = require(script.Parent.Modules.MasjidAlHaram)

local MAKKAH_UTC_OFFSET = 3 * 3600
local NIGHT_STARTS = 18.1
local NIGHT_ENDS = 6.2

local function isNight(clockTime: number): boolean
    return clockTime >= NIGHT_STARTS or clockTime < NIGHT_ENDS
end

local function setNight(night: boolean)
    for _, light in ipairs(CollectionService:GetTagged(MasjidAlHaram.NightLightTag)) do
        if light:IsA("Light") then
            light.Enabled = night
        end
    end

    for _, glowing in ipairs(CollectionService:GetTagged(MasjidAlHaram.NightGlowTag)) do
        if glowing:IsA("BasePart") then
            if night then
                glowing.Material = Enum.Material.Neon
            else
                local dayMaterial = glowing:GetAttribute("DayMaterial")
                local ok, material = pcall(function()
                    return (Enum.Material :: any)[dayMaterial]
                end)
                glowing.Material = if ok and material then material else Enum.Material.SmoothPlastic
            end
        end
    end
end

local function updateClockHands()
    local now = os.time() + MAKKAH_UTC_OFFSET
    local minutes = (now % 3600) / 60
    local hours = (now % 43200) / 3600

    for _, hand in ipairs(CollectionService:GetTagged(MasjidAlHaram.ClockHandTag)) do
        if hand:IsA("BasePart") then
            local pivot = hand:GetAttribute("Pivot")
            local offset = hand:GetAttribute("Offset")

            if typeof(pivot) == "CFrame" and type(offset) == "number" then
                local turns = if hand:GetAttribute("HandType") == "Hour" then hours / 12 else minutes / 60
                -- Positive rotation about the face's Z axis reads as clockwise from the front.
                hand.CFrame = pivot * CFrame.Angles(0, 0, turns * math.pi * 2) * CFrame.new(0, offset, 0)
            end
        end
    end
end

local nightShown: boolean? = nil

task.spawn(function()
    while true do
        local night = isNight(Lighting.ClockTime)

        if night ~= nightShown then
            nightShown = night
            setNight(night)
        end

        updateClockHands()
        task.wait(2)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="42">
      <Properties>
        <string name="Name">HistoricalWorldBuilder</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

-- Builds the two historical zones of the Seerah campaign: Makkah c. 570-630 CE and Madinah
-- c. 622-632 CE (see Shared/Data/HistoricalSites). They are deliberately plain: mud brick,
-- palm wood, tents, and bare hills, so they never look like the present-day hub with its
-- marble mosque. Every sign says "Historical reconstruction".
--
-- No figure in these zones stands for the Prophet ﷺ or any named companion. Townspeople, where
-- used, are generic and have blank faces.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HistoricalSites = require(Shared.Data.HistoricalSites)
local SeerahCampaign = require(Shared.Data.SeerahCampaign)
local CampaignRules = require(Shared.Modules.CampaignRules)
local BuildUtils = require(script.Parent.Modules.BuildUtils)
local Figures = require(script.Parent.Modules.Figures)

local GROUND_TOP = HistoricalSites.GroundTop
local SAND = Color3.fromRGB(205, 178, 132)
local MUD = Color3.fromRGB(176, 136, 96)
local MUD_DARK = Color3.fromRGB(143, 106, 72)
local PALM_WOOD = Color3.fromRGB(112, 84, 56)
local FROND = Color3.fromRGB(104, 128, 72)
local ROCK = Color3.fromRGB(128, 104, 82)
local CLOTH = { Color3.fromRGB(150, 62, 48), Color3.fromRGB(64, 92, 120), Color3.fromRGB(196, 168, 112), Color3.fromRGB(92, 116, 74) }

local existing = Workspace:FindFirstChild(HistoricalSites.FolderName)

if existing then
    existing:Destroy()
end

local root = BuildUtils.CreateFolder(Workspace, HistoricalSites.FolderName)

local function sign(parent: Instance, name: string, position: Vector3, title: string, body: string, yaw: number)
    local board = BuildUtils.CreateBoardSign(parent, name, position, title, body, Color3.fromRGB(122, 92, 58), nil)
    board.Orientation = Vector3.new(0, yaw, 0)
end

local function mudHouse(parent: Instance, name: string, position: Vector3, size: Vector3, yaw: number)
    local base = CFrame.new(position) * CFrame.Angles(0, math.rad(yaw), 0)
    BuildUtils.CreatePart(parent, name .. "_Walls", size, base * CFrame.new(0, size.Y / 2, 0), MUD, Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(parent, name .. "_Roof", Vector3.new(size.X + 1.5, 1.2, size.Z + 1.5), base * CFrame.new(0, size.Y + 0.6, 0), PALM_WOOD, Enum.Material.WoodPlanks, nil, nil)
    BuildUtils.CreatePart(parent, name .. "_Door", Vector3.new(4, 8, 0.6), base * CFrame.new(0, 4, -size.Z / 2 - 0.3), Color3.fromRGB(86, 62, 40), Enum.Material.Wood, nil, nil)
    BuildUtils.CreatePart(parent, name .. "_Window", Vector3.new(2.4, 2, 0.4), base * CFrame.new(size.X / 4, size.Y * 0.7, -size.Z / 2 - 0.2), Color3.fromRGB(40, 30, 24), Enum.Material.Wood, nil, nil)
end

local function palm(parent: Instance, name: string, position: Vector3)
    -- `position` is on the ground surface, as the hub's palms are.
    BuildUtils.CreatePalmTree(parent, name, position)
end

local function tent(parent: Instance, name: string, position: Vector3, yaw: number, color: Color3)
    local base = CFrame.new(position) * CFrame.Angles(0, math.rad(yaw), 0)
    BuildUtils.CreatePart(parent, name .. "_Rug", Vector3.new(18, 0.4, 14), base * CFrame.new(0, 0.2, 0), Color3.fromRGB(150, 110, 70), Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(parent, name .. "_RoofL", Vector3.new(10, 0.6, 14), base * CFrame.new(-4.4, 5.2, 0) * CFrame.Angles(0, 0, math.rad(28)), color, Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(parent, name .. "_RoofR", Vector3.new(10, 0.6, 14), base * CFrame.new(4.4, 5.2, 0) * CFrame.Angles(0, 0, math.rad(-28)), color, Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(parent, name .. "_Back", Vector3.new(14, 7, 0.4), base * CFrame.new(0, 3.5, 6.8), color, Enum.Material.Fabric, nil, nil)
end

local function rockMass(parent: Instance, name: string, position: Vector3, size: Vector3, yaw: number)
    BuildUtils.CreatePart(parent, name, size, CFrame.new(position + Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, math.rad(yaw), 0), ROCK, Enum.Material.Slate, nil, nil)
end

-- A stepped hill with ramps up its south side and a dark cave mouth on the ledge.
local function mountain(parent: Instance, name: string, position: Vector3)
    local ledge = HistoricalSites.MountainLedge
    local levels = 3
    local step = ledge / levels

    for level = 1, levels do
        local width = 140 - (level - 1) * 40
        BuildUtils.CreatePart(parent, string.format("%s_Level%d", name, level), Vector3.new(width, step, width), CFrame.new(position + Vector3.new(0, GROUND_TOP + step * (level - 0.5), 0)), ROCK, Enum.Material.Slate, nil, nil)
        -- Ramp from the level below onto this level, on the south (-Z) face.
        local rampLength = 26
        local faceZ = -width / 2 - rampLength / 2 + 0.5
        local xShift = (level % 2 == 0) and 18 or -18
        BuildUtils.CreateWedge(
            parent,
            string.format("%s_Ramp%d", name, level),
            Vector3.new(10, step, rampLength),
            CFrame.new(position + Vector3.new(xShift, GROUND_TOP + step * (level - 0.5), faceZ)),
            ROCK,
            Enum.Material.Slate,
            nil
        )
    end

    local top = position + Vector3.new(0, GROUND_TOP + ledge, 0)
    BuildUtils.CreatePart(parent, name .. "_CaveRock", Vector3.new(30, 16, 14), CFrame.new(top + Vector3.new(0, 8, 20)), Color3.fromRGB(104, 84, 66), Enum.Material.Slate, nil, nil)
    BuildUtils.CreatePart(parent, name .. "_CaveMouth", Vector3.new(7, 7, 1), CFrame.new(top + Vector3.new(0, 3.5, 12.6)), Color3.fromRGB(22, 18, 14), Enum.Material.Slate, nil, nil)
end

local function market(parent: Instance, name: string, position: Vector3)
    for index = 1, 6 do
        local x = ((index - 1) % 3 - 1) * 22
        local z = if index <= 3 then -14 else 14
        local base = position + Vector3.new(x, GROUND_TOP, z)
        BuildUtils.CreatePart(parent, string.format("%s_Stall%d", name, index), Vector3.new(10, 3, 5), CFrame.new(base + Vector3.new(0, 1.5, 0)), PALM_WOOD, Enum.Material.WoodPlanks, nil, nil)
        BuildUtils.CreatePart(parent, string.format("%s_Awning%d", name, index), Vector3.new(12, 0.4, 8), CFrame.new(base + Vector3.new(0, 8, 0)) * CFrame.Angles(math.rad(8), 0, 0), CLOTH[(index % #CLOTH) + 1], Enum.Material.Fabric, nil, nil)
        for _, px in ipairs({ -5.5, 5.5 }) do
            BuildUtils.CreatePart(parent, string.format("%s_Pole%d_%d", name, index, px), Vector3.new(0.6, 8, 0.6), CFrame.new(base + Vector3.new(px, 4, -3.5)), PALM_WOOD, Enum.Material.Wood, nil, nil)
        end
        BuildUtils.CreatePart(parent, string.format("%s_Goods%d", name, index), Vector3.new(3, 1.6, 2), CFrame.new(base + Vector3.new(-2, 3.8, 0)), CLOTH[((index + 1) % #CLOTH) + 1], Enum.Material.Fabric, nil, nil)
    end
end

-- The early mosque: mud walls, palm-trunk pillars, and a palm-frond roof over the north side.
local function earlyMosque(parent: Instance, name: string, position: Vector3, width: number, depth: number)
    local wallHeight = 9
    local base = position + Vector3.new(0, GROUND_TOP, 0)
    BuildUtils.CreatePart(parent, name .. "_Floor", Vector3.new(width, 0.4, depth), CFrame.new(base + Vector3.new(0, 0.2, 0)), Color3.fromRGB(196, 170, 128), Enum.Material.Sand, nil, nil)

    for _, wall in ipairs({
        { Name = "North", Size = Vector3.new(width, wallHeight, 2), Offset = Vector3.new(0, wallHeight / 2, depth / 2) },
        { Name = "West", Size = Vector3.new(2, wallHeight, depth), Offset = Vector3.new(-width / 2, wallHeight / 2, 0) },
        { Name = "East", Size = Vector3.new(2, wallHeight, depth), Offset = Vector3.new(width / 2, wallHeight / 2, 0) },
        { Name = "SouthWest", Size = Vector3.new(width / 2 - 8, wallHeight, 2), Offset = Vector3.new(-width / 4 - 4, wallHeight / 2, -depth / 2) },
        { Name = "SouthEast", Size = Vector3.new(width / 2 - 8, wallHeight, 2), Offset = Vector3.new(width / 4 + 4, wallHeight / 2, -depth / 2) },
    }) do
        BuildUtils.CreatePart(parent, name .. "_Wall" .. wall.Name, wall.Size, CFrame.new(base + wall.Offset), MUD, Enum.Material.Sandstone, nil, nil)
    end

    local roofDepth = depth * 0.35
    local columns = math.floor(width / 14)

    for row = 1, 2 do
        for column = 1, columns do
            local x = -width / 2 + (column - 0.5) * (width / columns)
            local z = depth / 2 - roofDepth * (row / 2.2)
            BuildUtils.CreateVerticalCylinder(parent, string.format("%s_Pillar%d_%d", name, row, column), wallHeight, 0.8, base + Vector3.new(x, wallHeight / 2, z), PALM_WOOD, Enum.Material.Wood, nil)
        end
    end

    BuildUtils.CreatePart(parent, name .. "_FrondRoof", Vector3.new(width, 0.8, roofDepth), CFrame.new(base + Vector3.new(0, wallHeight + 0.4, depth / 2 - roofDepth / 2)), FROND, Enum.Material.Grass, nil, nil)
end

local function siteBuild(parent: Instance, site: HistoricalSites.Site)
    local folder = BuildUtils.CreateFolder(parent, site.Id)
    local p = site.Position
    local kind = site.Kind

    if kind == "Kaaba" then
        -- The Kaaba as Quraysh rebuilt it, with a plain open area and houses close by.
        BuildUtils.CreatePart(folder, "OpenGround", Vector3.new(90, 0.3, 90), CFrame.new(p + Vector3.new(0, GROUND_TOP + 0.15, 0)), Color3.fromRGB(214, 190, 150), Enum.Material.Sandstone, nil, nil)
        BuildUtils.CreatePart(folder, "Kaaba", Vector3.new(22, 26, 18), CFrame.new(p + Vector3.new(0, GROUND_TOP + 13, 40)), Color3.fromRGB(26, 24, 22), Enum.Material.Fabric, nil, nil)
        BuildUtils.CreatePart(folder, "KaabaBase", Vector3.new(23, 1.5, 19), CFrame.new(p + Vector3.new(0, GROUND_TOP + 0.75, 40)), Color3.fromRGB(150, 130, 104), Enum.Material.Slate, nil, nil)
        BuildUtils.CreatePart(folder, "BlackStone", Vector3.new(1.2, 1.6, 1.2), CFrame.new(p + Vector3.new(-11.2, GROUND_TOP + 5, 31.2)), Color3.fromRGB(12, 10, 10), Enum.Material.Basalt, nil, nil)

        for index = 1, 10 do
            local angle = math.rad(index * 36 + 10)
            local houseAt = p + Vector3.new(math.cos(angle) * 78, GROUND_TOP, 40 + math.sin(angle) * 78)
            mudHouse(folder, string.format("House%d", index), houseAt, Vector3.new(16, 11 + (index % 3) * 2, 14), -math.deg(angle) + 90)
        end
    elseif kind == "House" then
        mudHouse(folder, "House", p + Vector3.new(0, GROUND_TOP, 22), Vector3.new(26, 13, 20), 0)
        BuildUtils.CreatePart(folder, "Yard", Vector3.new(30, 0.3, 18), CFrame.new(p + Vector3.new(0, GROUND_TOP + 0.15, 4)), Color3.fromRGB(190, 164, 124), Enum.Material.Sandstone, nil, nil)
        palm(folder, "Palm", p + Vector3.new(-20, GROUND_TOP, 6))
    elseif kind == "Market" then
        market(folder, "Market", p)
    elseif kind == "Mountain" then
        mountain(folder, "Mountain", p)
    elseif kind == "Hill" then
        rockMass(folder, "Hill", p + Vector3.new(0, GROUND_TOP, 26), Vector3.new(50, 10, 34), 0)
        BuildUtils.CreateWedge(folder, "HillSlope", Vector3.new(16, 10, 22), CFrame.new(p + Vector3.new(0, GROUND_TOP + 5, -2)), ROCK, Enum.Material.Slate, nil)
    elseif kind == "Valley" then
        rockMass(folder, "WallWest", p + Vector3.new(-40, GROUND_TOP, 0), Vector3.new(20, 28, 120), 4)
        rockMass(folder, "WallEast", p + Vector3.new(40, GROUND_TOP, 0), Vector3.new(20, 24, 120), -6)

        for index = 1, 3 do
            tent(folder, "Tent" .. index, p + Vector3.new(-14 + (index - 1) * 14, GROUND_TOP, 30 + (index % 2) * 10), 180, CLOTH[index])
        end
    elseif kind == "Harbour" then
        BuildUtils.CreatePart(folder, "Sea", Vector3.new(160, 1, 120), CFrame.new(p + Vector3.new(80, GROUND_TOP - 1.4, 0)), Color3.fromRGB(52, 102, 130), Enum.Material.Glass, nil, 0.15).CanCollide = false
        BuildUtils.CreatePart(folder, "SeaBed", Vector3.new(160, 1, 120), CFrame.new(p + Vector3.new(80, GROUND_TOP - 6, 0)), Color3.fromRGB(160, 140, 104), Enum.Material.Sand, nil, nil)
        BuildUtils.CreatePart(folder, "Pier", Vector3.new(40, 1, 8), CFrame.new(p + Vector3.new(20, GROUND_TOP + 0.5, 0)), PALM_WOOD, Enum.Material.WoodPlanks, nil, nil)
        BuildUtils.CreatePart(folder, "BoatHull", Vector3.new(26, 4, 9), CFrame.new(p + Vector3.new(50, GROUND_TOP - 0.5, 10)), Color3.fromRGB(98, 70, 46), Enum.Material.WoodPlanks, nil, nil)
        BuildUtils.CreatePart(folder, "BoatMast", Vector3.new(0.8, 22, 0.8), CFrame.new(p + Vector3.new(50, GROUND_TOP + 12, 10)), PALM_WOOD, Enum.Material.Wood, nil, nil)
        BuildUtils.CreatePart(folder, "BoatSail", Vector3.new(0.3, 14, 12), CFrame.new(p + Vector3.new(50.6, GROUND_TOP + 14, 10)), Color3.fromRGB(226, 214, 186), Enum.Material.Fabric, nil, nil).CanCollide = false
        -- A hall standing for the Najashi's court across the sea.
        earlyMosque(folder, "CourtHall", p + Vector3.new(-40, 0, 30), 44, 30)
    elseif kind == "Orchard" then
        for index = 1, 4 do
            local side = ({ Vector3.new(0, 0, 36), Vector3.new(0, 0, -36), Vector3.new(36, 0, 0), Vector3.new(-36, 0, 0) })[index]
            local size = if index <= 2 then Vector3.new(72, 6, 2) else Vector3.new(2, 6, 72)
            if index == 2 then
                -- Leave a gate in the south wall.
                BuildUtils.CreatePart(folder, "WallSouthW", Vector3.new(28, 6, 2), CFrame.new(p + side + Vector3.new(-22, GROUND_TOP + 3, 0)), MUD, Enum.Material.Sandstone, nil, nil)
                BuildUtils.CreatePart(folder, "WallSouthE", Vector3.new(28, 6, 2), CFrame.new(p + side + Vector3.new(22, GROUND_TOP + 3, 0)), MUD, Enum.Material.Sandstone, nil, nil)
            else
                BuildUtils.CreatePart(folder, "Wall" .. index, size, CFrame.new(p + side + Vector3.new(0, GROUND_TOP + 3, 0)), MUD, Enum.Material.Sandstone, nil, nil)
            end
        end

        for row = -1, 1 do
            BuildUtils.CreatePart(folder, "Vines" .. row, Vector3.new(50, 4, 3), CFrame.new(p + Vector3.new(0, GROUND_TOP + 2, row * 18)), Color3.fromRGB(86, 120, 60), Enum.Material.Grass, nil, nil)
        end
    elseif kind == "Camp" then
        for index = 1, 4 do
            local angle = math.rad(index * 90 + 45)
            tent(folder, "Tent" .. index, p + Vector3.new(math.cos(angle) * 30, GROUND_TOP, math.sin(angle) * 30), -math.deg(angle) - 90, CLOTH[index])
        end

        BuildUtils.CreateVerticalCylinder(folder, "Well", 3, 3, p + Vector3.new(0, GROUND_TOP + 1.5, 10), Color3.fromRGB(150, 128, 98), Enum.Material.Slate, nil)
        palm(folder, "PalmA", p + Vector3.new(-12, GROUND_TOP, 20))
    elseif kind == "Plain" then
        BuildUtils.CreatePart(folder, "MountOfMercy", Vector3.new(40, 12, 40), CFrame.new(p + Vector3.new(0, GROUND_TOP + 6, 50)) * CFrame.Angles(0, math.rad(45), 0), ROCK, Enum.Material.Slate, nil, nil)
        BuildUtils.CreateVerticalCylinder(folder, "Marker", 10, 1.2, p + Vector3.new(0, GROUND_TOP + 17, 50), Color3.fromRGB(226, 218, 200), Enum.Material.Limestone, nil)
    elseif kind == "Mosque" then
        local size = if site.Id == "masjid_early" then Vector3.new(100, 0, 80) else Vector3.new(50, 0, 40)
        earlyMosque(folder, "Mosque", p + Vector3.new(0, 0, size.Z / 2 + 6), size.X, size.Z)
    elseif kind == "Trench" then
        BuildUtils.CreatePart(folder, "TrenchFloor", Vector3.new(220, 0.4, 12), CFrame.new(p + Vector3.new(0, GROUND_TOP - 5.8, 30)), Color3.fromRGB(120, 96, 70), Enum.Material.Ground, nil, nil)
        BuildUtils.CreatePart(folder, "TrenchLipSouth", Vector3.new(220, 3, 4), CFrame.new(p + Vector3.new(0, GROUND_TOP + 1.5, 22)), Color3.fromRGB(150, 120, 88), Enum.Material.Ground, nil, nil)
        BuildUtils.CreatePart(folder, "TrenchLipNorth", Vector3.new(220, 3, 4), CFrame.new(p + Vector3.new(0, GROUND_TOP + 1.5, 38)), Color3.fromRGB(150, 120, 88), Enum.Material.Ground, nil, nil)
    end

    local arrival = HistoricalSites.ArrivalPoint(site)
    sign(folder, "Sign", arrival + Vector3.new(0, 0, -12), site.DisplayName, "Historical reconstruction. " .. site.Description, 180)

    -- A soft ring marks where chapters begin; the campaign HUD points players to it.
    local ring = BuildUtils.CreateVerticalCylinder(folder, "ChapterRing", 0.3, 9, arrival + Vector3.new(0, 0.2, 0), Color3.fromRGB(247, 208, 117), Enum.Material.Neon, 0.55)
    ring.CanCollide = false
    ring.CanQuery = false
    ring.CanTouch = false
end

local function townspeople(parent: Instance, center: Vector3, count: number)
    for index = 1, count do
        local angle = index * 2.4
        local radius = 120 + (index % 5) * 70
        local position = center + Vector3.new(math.cos(angle) * radius, GROUND_TOP, math.sin(angle) * radius)
        Figures.CreateTownsperson(parent, string.format("Townsperson_%d", index), CFrame.new(position) * CFrame.Angles(0, angle, 0), CLOTH[(index % #CLOTH) + 1])
    end
end

for _, zone in ipairs(HistoricalSites.Zones) do
    local zoneFolder = BuildUtils.CreateFolder(root, zone.Id)
    local c = zone.Center
    BuildUtils.CreatePart(zoneFolder, "SafetyPlate", Vector3.new(zone.Size.X + 200, 10, zone.Size.Z + 200), CFrame.new(c + Vector3.new(0, -8, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(zoneFolder, "Ground", Vector3.new(zone.Size.X, GROUND_TOP, zone.Size.Z), CFrame.new(c + Vector3.new(0, GROUND_TOP / 2, 0)), SAND, Enum.Material.Sand, nil, nil)

    -- Invisible walls keep players inside the reconstruction.
    local half = zone.Size / 2

    for _, wall in ipairs({
        { Vector3.new(zone.Size.X, 80, 4), Vector3.new(0, 40, half.Z) },
        { Vector3.new(zone.Size.X, 80, 4), Vector3.new(0, 40, -half.Z) },
        { Vector3.new(4, 80, zone.Size.Z), Vector3.new(half.X, 40, 0) },
        { Vector3.new(4, 80, zone.Size.Z), Vector3.new(-half.X, 40, 0) },
    }) do
        BuildUtils.CreatePart(zoneFolder, "Boundary", wall[1], CFrame.new(c + wall[2]), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    end

    -- Low hills around the edge give the valley feel of both towns.
    for index = 1, 12 do
        local angle = math.rad(index * 30)
        local at = c + Vector3.new(math.cos(angle) * (half.X - 40), 0, math.sin(angle) * (half.Z - 40))
        rockMass(zoneFolder, "EdgeHill" .. index, at + Vector3.new(0, GROUND_TOP, 0), Vector3.new(90, 30 + (index % 3) * 14, 50), math.deg(angle) + 90)
    end

    for index = 1, 26 do
        local angle = index * 1.7
        local radius = 90 + (index * 37) % 420
        palm(zoneFolder, "Palm" .. index, c + Vector3.new(math.cos(angle) * radius, GROUND_TOP, math.sin(angle) * radius))
    end

    local entrance = if zone.Id == "makkah_610" then c + Vector3.new(0, 0, 110) else c + Vector3.new(0, 0, -90)
    sign(zoneFolder, "EntranceSign", entrance + Vector3.new(0, 0, if zone.Id == "makkah_610" then 14 else -14), zone.DisplayName, zone.Disclaimer, if zone.Id == "makkah_610" then 0 else 180)

    local sitesFolder = BuildUtils.CreateFolder(zoneFolder, "Sites")

    for _, site in ipairs(HistoricalSites.Sites) do
        if site.Zone == zone.Id then
            local ok, err = pcall(siteBuild, sitesFolder, site)

            if not ok then
                warn(string.format("[HistoricalWorldBuilder] Site %s failed: %s", site.Id, tostring(err)))
            end
        end
    end

    townspeople(BuildUtils.CreateFolder(zoneFolder, "Townspeople"), c, 10)
end

-- Items for Collect chapters. They start hidden; the campaign HUD shows a player only the items
-- of the chapter they are playing, and the server checks every pickup.
local itemsFolder = BuildUtils.CreateFolder(root, "CampaignItems")

for _, chapter in ipairs(SeerahCampaign.Chapters) do
    local activity = chapter.Activity
    local site = HistoricalSites.GetSite(chapter.Site)

    if activity and activity.Kind == "Collect" and site then
        local chapterFolder = BuildUtils.CreateFolder(itemsFolder, chapter.Id)
        local arrival = HistoricalSites.ArrivalPoint(site)
        local onLedge = site.Kind == "Mountain"

        for index = 1, activity.Count or 0 do
            local position = arrival + CampaignRules.ItemOffset(chapter, index, onLedge) + Vector3.new(0, 1.2, 0)
            local item = BuildUtils.CreatePart(chapterFolder, string.format("Item_%d", index), Vector3.new(2, 2, 2), CFrame.new(position), Color3.fromRGB(240, 206, 120), Enum.Material.Neon, nil, 1)
            item.CanCollide = false
            item.CanTouch = false
            item:SetAttribute("ChapterId", chapter.Id)
            item:SetAttribute("ItemIndex", index)

            local prompt = BuildUtils.AttachPrompt(item, "Pick up", activity.Item or "item", {
                PromptAction = "CampaignCollect",
                ChapterId = chapter.Id,
                ItemIndex = index,
            })
            prompt.Enabled = false
        end
    end
end

root:SetAttribute("Built", true)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="43">
      <Properties>
        <string name="Name">HubAtmosphere</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")
local Workspace = game:GetService("Workspace")

local START_CLOCK_TIME = 10.3
local FULL_CYCLE_SECONDS = 780
local MIN_NIGHT_BRIGHTNESS = 1.38
local MAX_DAY_BRIGHTNESS = 2.08

local function ensureAtmosphere(): Atmosphere
    local existing = Lighting:FindFirstChild("JourneyAtmosphere")

    if existing then
        if existing:IsA("Atmosphere") then
            return existing
        end

        existing:Destroy()
    end

    local atmosphere = Instance.new("Atmosphere")
    atmosphere.Name = "JourneyAtmosphere"
    atmosphere.Parent = Lighting

    return atmosphere
end

local function ensureBloom(): BloomEffect
    local existing = Lighting:FindFirstChild("JourneyBloom")

    if existing then
        if existing:IsA("BloomEffect") then
            return existing
        end

        existing:Destroy()
    end

    local bloom = Instance.new("BloomEffect")
    bloom.Name = "JourneyBloom"
    bloom.Parent = Lighting

    return bloom
end

local function ensureColorCorrection(): ColorCorrectionEffect
    local existing = Lighting:FindFirstChild("JourneyColor")

    if existing then
        if existing:IsA("ColorCorrectionEffect") then
            return existing
        end

        existing:Destroy()
    end

    local colorCorrection = Instance.new("ColorCorrectionEffect")
    colorCorrection.Name = "JourneyColor"
    colorCorrection.Parent = Lighting

    return colorCorrection
end

local function ensureSunRays(): SunRaysEffect
    local existing = Lighting:FindFirstChild("JourneySunRays")

    if existing then
        if existing:IsA("SunRaysEffect") then
            return existing
        end

        existing:Destroy()
    end

    local sunRays = Instance.new("SunRaysEffect")
    sunRays.Name = "JourneySunRays"
    sunRays.Parent = Lighting

    return sunRays
end

local function ensureDepthOfField(): DepthOfFieldEffect
    local existing = Lighting:FindFirstChild("JourneyDepthOfField")

    if existing then
        if existing:IsA("DepthOfFieldEffect") then
            return existing
        end

        existing:Destroy()
    end

    local depthOfField = Instance.new("DepthOfFieldEffect")
    depthOfField.Name = "JourneyDepthOfField"
    depthOfField.Parent = Lighting

    return depthOfField
end

local function ensureSky(): Sky
    local existing = Lighting:FindFirstChild("JourneySky")

    if existing then
        if existing:IsA("Sky") then
            return existing
        end

        existing:Destroy()
    end

    local fallback = Lighting:FindFirstChildOfClass("Sky")

    if fallback then
        fallback.Name = "JourneySky"
        return fallback
    end

    local sky = Instance.new("Sky")
    sky.Name = "JourneySky"
    sky.Parent = Lighting

    return sky
end

local function ensureClouds(): Clouds
    local existing = Workspace.Terrain:FindFirstChild("JourneyClouds")

    if existing then
        if existing:IsA("Clouds") then
            return existing
        end

        existing:Destroy()
    end

    local clouds = Instance.new("Clouds")
    clouds.Name = "JourneyClouds"
    clouds.Parent = Workspace.Terrain

    return clouds
end

local function lerpNumber(a: number, b: number, alpha: number): number
    return a + (b - a) * alpha
end

local function lerpColor(a: Color3, b: Color3, alpha: number): Color3
    return Color3.new(
        lerpNumber(a.R, b.R, alpha),
        lerpNumber(a.G, b.G, alpha),
        lerpNumber(a.B, b.B, alpha)
    )
end

local function getDaylightAlpha(clockTime: number): number
    local angular = ((clockTime - 12) / 12) * math.pi
    local cosine = math.cos(angular)

    -- Keep dawn/dusk softer so the switch from day to night feels natural.
    return math.clamp((cosine + 0.25) / 1.25, 0, 1)
end

pcall(function()
    Lighting.Technology = Enum.Technology.Future
end)
pcall(function()
    MaterialService.Use2022Materials = true
end)
pcall(function()
    Workspace.Terrain.Decoration = true
end)
pcall(function()
    Workspace.Terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(198, 176, 129))
    Workspace.Terrain:SetMaterialColor(Enum.Material.Sandstone, Color3.fromRGB(172, 145, 104))
    Workspace.Terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(120, 108, 96))
end)

local atmosphere = ensureAtmosphere()
local bloom = ensureBloom()
local colorCorrection = ensureColorCorrection()
local sunRays = ensureSunRays()
local depthOfField = ensureDepthOfField()
local sky = ensureSky()
local clouds = ensureClouds()

sky.CelestialBodiesShown = true
pcall(function()
    sky.MoonAngularSize = 18
end)
pcall(function()
    sky.SunAngularSize = 20
end)

local function applyCycleLighting(clockTime: number)
    local dayAlpha = getDaylightAlpha(clockTime)
    local nightAlpha = 1 - dayAlpha

    Lighting.ClockTime = clockTime
    Lighting.Brightness = lerpNumber(MIN_NIGHT_BRIGHTNESS, MAX_DAY_BRIGHTNESS, dayAlpha)
    Lighting.EnvironmentDiffuseScale = lerpNumber(0.42, 0.58, dayAlpha)
    Lighting.EnvironmentSpecularScale = lerpNumber(0.2, 0.34, dayAlpha)
    Lighting.OutdoorAmbient = lerpColor(Color3.fromRGB(78, 85, 104), Color3.fromRGB(176, 168, 152), dayAlpha)
    Lighting.Ambient = lerpColor(Color3.fromRGB(56, 62, 79), Color3.fromRGB(132, 124, 110), dayAlpha)
    Lighting.ColorShift_Top = lerpColor(Color3.fromRGB(118, 132, 174), Color3.fromRGB(233, 219, 198), dayAlpha)
    Lighting.ColorShift_Bottom = lerpColor(Color3.fromRGB(84, 96, 132), Color3.fromRGB(194, 181, 156), dayAlpha)
    Lighting.ShadowSoftness = lerpNumber(0.68, 0.48, dayAlpha)

    pcall(function()
        Lighting.ExposureCompensation = lerpNumber(0.03, -0.06, dayAlpha)
    end)

    atmosphere.Color = lerpColor(Color3.fromRGB(104, 123, 166), Color3.fromRGB(221, 206, 182), dayAlpha)
    atmosphere.Decay = lerpColor(Color3.fromRGB(81, 98, 138), Color3.fromRGB(191, 170, 138), dayAlpha)
    atmosphere.Density = lerpNumber(0.31, 0.22, dayAlpha)
    atmosphere.Glare = lerpNumber(0.03, 0.1, dayAlpha)
    atmosphere.Haze = lerpNumber(1.08, 0.88, dayAlpha)
    atmosphere.Offset = lerpNumber(0.08, 0.02, dayAlpha)

    bloom.Intensity = lerpNumber(0.05, 0.12, dayAlpha)
    bloom.Size = lerpNumber(18, 25, dayAlpha)
    bloom.Threshold = lerpNumber(1.28, 1.18, dayAlpha)

    colorCorrection.Brightness = lerpNumber(-0.03, 0.02, dayAlpha)
    colorCorrection.Contrast = lerpNumber(0.16, 0.14, dayAlpha)
    colorCorrection.Saturation = lerpNumber(-0.04, 0.02, dayAlpha)
    colorCorrection.TintColor = lerpColor(Color3.fromRGB(190, 202, 231), Color3.fromRGB(236, 223, 200), dayAlpha)

    sunRays.Intensity = lerpNumber(0.003, 0.048, dayAlpha)
    sunRays.Spread = lerpNumber(0.28, 0.72, dayAlpha)

    depthOfField.FarIntensity = lerpNumber(0.2, 0.12, dayAlpha)
    depthOfField.FocusDistance = lerpNumber(90, 120, dayAlpha)
    depthOfField.InFocusRadius = lerpNumber(65, 86, dayAlpha)
    depthOfField.NearIntensity = lerpNumber(0.03, 0.02, dayAlpha)

    -- Keep stars and moon much clearer at night.
    sky.StarCount = math.floor(lerpNumber(2900, 260, dayAlpha))
    sky.SunAngularSize = lerpNumber(12, 20, dayAlpha)
    pcall(function()
        sky.MoonAngularSize = lerpNumber(20, 14, dayAlpha)
    end)

    pcall(function()
        Lighting.GlobalShadows = true
        Lighting.FogEnd = lerpNumber(12000, 132000, dayAlpha)
        Lighting.FogStart = 0
        Lighting.FogColor = lerpColor(Color3.fromRGB(72, 82, 112), Color3.fromRGB(195, 184, 164), dayAlpha)
    end)

    -- Tiny nudge to moon visibility on darker moments.
    if nightAlpha > 0.7 then
        sky.CelestialBodiesShown = true
    end

    -- Terrain clouds help break up the flat Roblox sky look.
    clouds.Cover = lerpNumber(0.42, 0.28, dayAlpha)
    clouds.Density = lerpNumber(0.86, 0.62, dayAlpha)
    clouds.Color = lerpColor(Color3.fromRGB(168, 179, 208), Color3.fromRGB(246, 241, 231), dayAlpha)
    clouds.Enabled = true
end

local cycleStart = os.clock()

applyCycleLighting(START_CLOCK_TIME)

task.spawn(function()
    while true do
        local elapsed = os.clock() - cycleStart
        local clockTime = (START_CLOCK_TIME + (elapsed / FULL_CYCLE_SECONDS) * 24) % 24
        applyCycleLighting(clockTime)
        task.wait(0.2)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="44">
      <Properties>
        <string name="Name">HubTeleportService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TravelRoute = require(Shared.Data.TravelRoute)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local hubFolder = remotesFolder:WaitForChild("Hub")
local requestTeleport = hubFolder:WaitForChild("RequestTeleport") :: RemoteEvent

local cooldowns = {}
local promptConnections = {}

local function getTeleportAnchor(destinationId: string): BasePart?
    local worldFolder = Workspace:FindFirstChild(TravelRoute.WorldFolderName)

    if not worldFolder then
        return nil
    end

    local teleportFolder = worldFolder:FindFirstChild("TeleportPoints")

    if not teleportFolder then
        return nil
    end

    local anchor = teleportFolder:FindFirstChild(destinationId)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function teleportPlayerToDestination(player: Player, destinationId: string)
    if typeof(destinationId) ~= "string" then
        return
    end

    if not TravelRoute.GetDestinationById(destinationId) then
        return
    end

    if player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true then
        return
    end

    local now = os.clock()
    local lastTeleport = cooldowns[player]

    if lastTeleport and now - lastTeleport < 1 then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return
    end

    local anchor = getTeleportAnchor(destinationId)

    if not anchor then
        return
    end

    cooldowns[player] = now
    character:PivotTo(anchor.CFrame * CFrame.new(0, 4, 0))
end

requestTeleport.OnServerEvent:Connect(function(player: Player, destinationId: string)
    teleportPlayerToDestination(player, destinationId)
end)

local function connectTeleportPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    if prompt:GetAttribute("PromptAction") ~= "Teleport" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local destinationId = prompt:GetAttribute("DestinationId")

        if typeof(destinationId) == "string" then
            teleportPlayerToDestination(player, destinationId)
        end
    end)
end

task.spawn(function()
    local worldFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if not worldFolder then
        return
    end

    for _, descendant in ipairs(worldFolder:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectTeleportPrompt(descendant)
        end
    end

    worldFolder.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectTeleportPrompt(descendant)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player: Player)
    cooldowns[player] = nil
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="45">
      <Properties>
        <string name="Name">HubWorldBuilder</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CompanionStories = require(Shared.Data.CompanionStories)
local HaramLearningTrail = require(Shared.Data.HaramLearningTrail)
local MannersLessons = require(Shared.Data.MannersLessons)
local TravelRoute = require(Shared.Data.TravelRoute)
local BuildUtils = require(script.Parent.Modules.BuildUtils)
local ParkourCourses = require(Shared.Data.ParkourCourses)
local MasjidAlHaram = require(script.Parent.Modules.MasjidAlHaram)

local MECCA_STONE = Color3.fromRGB(196, 186, 168)
local MECCA_MARBLE = Color3.fromRGB(214, 208, 196)
local MECCA_DARK = Color3.fromRGB(124, 106, 80)
local DESERT_SAND = Color3.fromRGB(188, 166, 121)
local DESERT_ROCK = Color3.fromRGB(138, 110, 80)
local MEDINA_WHITE = Color3.fromRGB(232, 231, 224)
local MEDINA_GREEN = Color3.fromRGB(77, 128, 88)
local MEDINA_STONE = Color3.fromRGB(214, 210, 198)
local GOLD_ACCENT = Color3.fromRGB(193, 162, 86)
local GLASS_TINT = Color3.fromRGB(108, 119, 132)

local function scaleColor(color: Color3, scale: number): Color3
    return Color3.fromRGB(
        math.clamp(math.floor(color.R * 255 * scale), 0, 255),
        math.clamp(math.floor(color.G * 255 * scale), 0, 255),
        math.clamp(math.floor(color.B * 255 * scale), 0, 255)
    )
end

local function makeDecorativePart(part: BasePart): BasePart
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = true

    return part
end

local function createStylizedRidge(parent: Instance, name: string, center: Vector3, yawDegrees: number, length: number, height: number, depth: number, color: Color3)
    local ridge = BuildUtils.CreateFolder(parent, name)
    local baseCFrame = CFrame.new(center) * CFrame.Angles(0, math.rad(yawDegrees), 0)

    makeDecorativePart(BuildUtils.CreatePart(
        ridge,
        "MassCore",
        Vector3.new(length * 0.94, height * 0.34, depth * 0.82),
        baseCFrame * CFrame.new(0, height * 0.17, 0),
        scaleColor(color, 0.9),
        Enum.Material.Rock,
        nil,
        nil
    ))

    makeDecorativePart(BuildUtils.CreatePart(
        ridge,
        "MesaShelf",
        Vector3.new(length * 0.72, height * 0.18, depth * 0.58),
        baseCFrame * CFrame.new(0, height * 0.38, -depth * 0.02),
        scaleColor(color, 1.03),
        Enum.Material.Slate,
        nil,
        nil
    ))

    for segment = 1, 7 do
        local alpha = (segment - 4) / 3
        local widthFactor = 1 - math.abs(alpha) * 0.3
        local segmentLength = length * (0.13 + widthFactor * 0.035)
        local segmentHeight = height * (0.62 + widthFactor * 0.22)
        local segmentDepth = depth * (0.52 + widthFactor * 0.16)
        local x = alpha * length * 0.37
        local z = math.sin(segment * 1.11) * depth * 0.06
        local cframe = baseCFrame
            * CFrame.new(x, segmentHeight * 0.38, z)
            * CFrame.Angles(math.rad((segment % 3 - 1) * 3), math.rad((segment % 2 == 0) and -5 or 6), math.rad((segment % 4 - 1.5) * 2))

        makeDecorativePart(BuildUtils.CreateWedge(
            ridge,
            string.format("Face_%d", segment),
            Vector3.new(segmentLength, segmentHeight, segmentDepth),
            cframe,
            scaleColor(color, 0.8 + widthFactor * 0.18),
            Enum.Material.Rock,
            nil
        ))
    end

    for layer = 1, 3 do
        makeDecorativePart(BuildUtils.CreatePart(
            ridge,
            string.format("Strata_%d", layer),
            Vector3.new(length * (0.82 - layer * 0.12), 0.3, 1.4),
            baseCFrame * CFrame.new(0, height * (0.2 + layer * 0.17), depth * (-0.26 + layer * 0.14)) * CFrame.Angles(0, math.rad((layer % 2 == 0) and -4 or 5), 0),
            scaleColor(color, 0.6 + layer * 0.08),
            Enum.Material.Slate,
            nil,
            0.04
        ))
    end

    return ridge
end

local function createPromenadePath(parent: Instance, name: string, startPosition: Vector3, endPosition: Vector3, width: number, baseColor: Color3, edgeColor: Color3)
    local difference = endPosition - startPosition
    local length = difference.Magnitude

    if length < 1 then
        return
    end

    local midpoint = startPosition:Lerp(endPosition, 0.5)
    local yaw = math.atan2(difference.X, difference.Z)
    local baseY = math.max(startPosition.Y, endPosition.Y) + 4.3

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Base", name),
        Vector3.new(width, 0.9, length),
        CFrame.new(midpoint.X, baseY, midpoint.Z) * CFrame.Angles(0, yaw, 0),
        baseColor,
        Enum.Material.Sandstone,
        nil,
        nil
    )
    BuildUtils.CreatePart(
        parent,
        string.format("%s_EdgeWest", name),
        Vector3.new(2.2, 0.24, length),
        CFrame.new(midpoint.X, baseY + 0.48, midpoint.Z) * CFrame.Angles(0, yaw, 0) * CFrame.new(width * -0.5 + 1.1, 0, 0),
        edgeColor,
        Enum.Material.Slate,
        nil,
        nil
    ).CanCollide = false
    BuildUtils.CreatePart(
        parent,
        string.format("%s_EdgeEast", name),
        Vector3.new(2.2, 0.24, length),
        CFrame.new(midpoint.X, baseY + 0.48, midpoint.Z) * CFrame.Angles(0, yaw, 0) * CFrame.new(width * 0.5 - 1.1, 0, 0),
        edgeColor,
        Enum.Material.Slate,
        nil,
        nil
    ).CanCollide = false
    BuildUtils.CreatePart(
        parent,
        string.format("%s_Inlay", name),
        Vector3.new(6, 0.22, length - 18),
        CFrame.new(midpoint.X, baseY + 0.5, midpoint.Z) * CFrame.Angles(0, yaw, 0),
        Color3.fromRGB(231, 216, 181),
        Enum.Material.Marble,
        nil,
        nil
    ).CanCollide = false
end

local function createSafetyBounds(parent: Instance, namePrefix: string, center: Vector3, footprint: Vector3)
    local barrierHeight = 110
    local thickness = 12
    local barrierYOffset = 28

    -- Each wall is split in two halves because Roblox caps a part at 2048 studs per side.
    for _, wall in ipairs({
        { Name = "North", Offset = Vector3.new(0, 0, footprint.Z * -0.5), Along = Vector3.new(1, 0, 0), Length = footprint.X },
        { Name = "South", Offset = Vector3.new(0, 0, footprint.Z * 0.5), Along = Vector3.new(1, 0, 0), Length = footprint.X },
        { Name = "West", Offset = Vector3.new(footprint.X * -0.5, 0, 0), Along = Vector3.new(0, 0, 1), Length = footprint.Z },
        { Name = "East", Offset = Vector3.new(footprint.X * 0.5, 0, 0), Along = Vector3.new(0, 0, 1), Length = footprint.Z },
    }) do
        for half = -1, 1, 2 do
            local size = wall.Along * (wall.Length * 0.5) + Vector3.new(0, barrierHeight, 0) + (Vector3.new(1, 0, 1) - wall.Along) * thickness
            local position = center + wall.Offset + wall.Along * (half * wall.Length * 0.25) + Vector3.new(0, barrierYOffset, 0)
            BuildUtils.CreatePart(parent, string.format("%s_%sBarrier_%d", namePrefix, wall.Name, half), size, CFrame.new(position), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
        end
    end
end

local function createLightPost(parent: Instance, name: string, position: Vector3, poleColor: Color3?)
    BuildUtils.CreateVerticalCylinder(parent, string.format("%s_Pole", name), 13, 0.6, position + Vector3.new(0, 6.5, 0), poleColor or Color3.fromRGB(124, 107, 84), Enum.Material.Metal, nil)
    BuildUtils.CreateSphere(parent, string.format("%s_Light", name), 3.2, position + Vector3.new(0, 13.4, 0), Color3.fromRGB(255, 242, 206), Enum.Material.Neon, nil)
end

local function createWallPanel(
    parent: Instance,
    name: string,
    position: Vector3,
    size: Vector3,
    title: string,
    subtitle: string,
    wallColor: Color3,
    orientationY: number,
    promptData
)
    local sign = BuildUtils.CreateWallSign(parent, name, position, size, title, subtitle, wallColor, promptData)
    sign.Orientation = Vector3.new(0, orientationY, 0)

    return sign
end

local function createDigitalScreen(parent: Instance, name: string, position: Vector3, size: Vector3, title: string, subtitle: string)
    local screen = BuildUtils.CreatePart(parent, name, size, CFrame.new(position + Vector3.new(0, size.Y * 0.5, 0)), Color3.fromRGB(39, 44, 50), Enum.Material.Metal, nil, nil)
    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Face = Enum.NormalId.Front
    surfaceGui.CanvasSize = Vector2.new(760, 360)
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surfaceGui.PixelsPerStud = 48
    surfaceGui.Parent = screen

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.fromOffset(30, 24)
    titleLabel.Size = UDim2.new(1, -60, 0, 92)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(246, 240, 220)
    titleLabel.TextScaled = true
    titleLabel.TextWrapped = true
    titleLabel.Parent = surfaceGui

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.fromOffset(30, 130)
    subtitleLabel.Size = UDim2.new(1, -60, 0, 150)
    subtitleLabel.Font = Enum.Font.Gotham
    subtitleLabel.Text = subtitle
    subtitleLabel.TextColor3 = Color3.fromRGB(203, 212, 224)
    subtitleLabel.TextScaled = true
    subtitleLabel.TextWrapped = true
    subtitleLabel.Parent = surfaceGui

    return screen
end

local function createFloorPlaque(
    parent: Instance,
    name: string,
    cframe: CFrame,
    size: Vector3,
    title: string,
    subtitle: string,
    plaqueColor: Color3,
    promptData
): BasePart
    local plaque = BuildUtils.CreatePart(parent, name, size, cframe, plaqueColor, Enum.Material.Slate, nil, nil)
    plaque.CanCollide = false

    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Face = Enum.NormalId.Top
    surfaceGui.CanvasSize = Vector2.new(760, 260)
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surfaceGui.PixelsPerStud = 46
    surfaceGui.Parent = plaque

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.fromOffset(24, 18)
    titleLabel.Size = UDim2.new(1, -48, 0, 92)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(250, 245, 230)
    titleLabel.TextScaled = true
    titleLabel.TextWrapped = true
    titleLabel.Parent = surfaceGui

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.fromOffset(28, 120)
    subtitleLabel.Size = UDim2.new(1, -56, 0, 112)
    subtitleLabel.Font = Enum.Font.Gotham
    subtitleLabel.Text = subtitle
    subtitleLabel.TextColor3 = Color3.fromRGB(222, 215, 196)
    subtitleLabel.TextScaled = true
    subtitleLabel.TextWrapped = true
    subtitleLabel.Parent = surfaceGui

    if promptData then
        BuildUtils.AttachPrompt(plaque, promptData.ActionText, promptData.ObjectText, promptData.Attributes)
    end

    return plaque
end

local function createFloorInlayGrid(parent: Instance, namePrefix: string, center: Vector3, extent: number, spacing: number, color: Color3, yOffset: number)
    local lineIndex = 0

    for x = -extent, extent, spacing do
        lineIndex += 1
        BuildUtils.CreatePart(
            parent,
            string.format("%s_X_%d", namePrefix, lineIndex),
            Vector3.new(1.1, 0.18, extent * 2),
            CFrame.new(center + Vector3.new(x, yOffset, 0)),
            color,
            Enum.Material.Marble,
            nil,
            nil
        )
    end

    for z = -extent, extent, spacing do
        lineIndex += 1
        BuildUtils.CreatePart(
            parent,
            string.format("%s_Z_%d", namePrefix, lineIndex),
            Vector3.new(extent * 2, 0.18, 1.1),
            CFrame.new(center + Vector3.new(0, yOffset, z)),
            color,
            Enum.Material.Marble,
            nil,
            nil
        )
    end
end

local function createLowBollard(parent: Instance, name: string, position: Vector3, accentColor: Color3)
    BuildUtils.CreateVerticalCylinder(parent, string.format("%s_Post", name), 5.5, 0.45, position + Vector3.new(0, 2.75, 0), Color3.fromRGB(117, 102, 77), Enum.Material.Metal, nil)
    BuildUtils.CreateSphere(parent, string.format("%s_Glow", name), 1.7, position + Vector3.new(0, 5.8, 0), accentColor, Enum.Material.Neon, nil)
end

-- `skip` names ridges or aprons (e.g. "NorthFrame", "Apron_3") that would land inside a
-- neighbouring district.
local function createDistrictTerrainBand(parent: Instance, namePrefix: string, center: Vector3, radiusX: number, radiusZ: number, rockColor: Color3, skip: { [string]: boolean }?)
    local band = BuildUtils.CreateFolder(parent, string.format("%sTerrainBand", namePrefix))
    local skipped = skip or {}

    for index, ridge in ipairs({
        { Name = "WestNorthFrame", Offset = Vector3.new(-radiusX * 1.02, 0, -radiusZ * 0.52), Yaw = -20, Length = 360, Height = 122, Depth = 136 },
        { Name = "EastNorthFrame", Offset = Vector3.new(radiusX * 1.02, 0, -radiusZ * 0.48), Yaw = 18, Length = 350, Height = 118, Depth = 132 },
        { Name = "WestSouthFrame", Offset = Vector3.new(-radiusX * 0.98, 0, radiusZ * 0.58), Yaw = -16, Length = 374, Height = 126, Depth = 142 },
        { Name = "EastSouthFrame", Offset = Vector3.new(radiusX * 1.04, 0, radiusZ * 0.62), Yaw = 16, Length = 366, Height = 124, Depth = 140 },
        { Name = "NorthFrame", Offset = Vector3.new(0, 0, -radiusZ * 1.08), Yaw = 0, Length = 470, Height = 136, Depth = 108 },
        { Name = "SouthFrame", Offset = Vector3.new(0, 0, radiusZ * 1.12), Yaw = 180, Length = 500, Height = 142, Depth = 112 },
    }) do
        if skipped[ridge.Name] then
            continue
        end

        createStylizedRidge(
            band,
            string.format("%s_%s_%d", namePrefix, ridge.Name, index),
            center + ridge.Offset,
            ridge.Yaw,
            ridge.Length,
            ridge.Height,
            ridge.Depth,
            rockColor
        )
    end

    for index, apron in ipairs({
        { Offset = Vector3.new(-radiusX * 0.86, 5, 0), Size = Vector3.new(224, 12, 164), Yaw = -10 },
        { Offset = Vector3.new(radiusX * 0.86, 5, 0), Size = Vector3.new(224, 12, 164), Yaw = 10 },
        { Offset = Vector3.new(0, 4, -radiusZ * 0.94), Size = Vector3.new(300, 10, 118), Yaw = 0 },
        { Offset = Vector3.new(0, 4, radiusZ * 0.98), Size = Vector3.new(320, 10, 122), Yaw = 0 },
    }) do
        if skipped[string.format("Apron_%d", index)] then
            continue
        end

        makeDecorativePart(BuildUtils.CreatePart(
            band,
            string.format("%sApron_%d", namePrefix, index),
            apron.Size,
            CFrame.new(center + apron.Offset) * CFrame.Angles(0, math.rad(apron.Yaw), 0),
            scaleColor(rockColor, 1.08),
            Enum.Material.Sandstone,
            nil,
            nil
        ))
    end
end

local function createWorldBackdrop(parent: Instance, center: Vector3)
    local backdrop = BuildUtils.CreateFolder(parent, "WorldBackdrop")

    for index, ridge in ipairs({
        { Name = "FarNorthWest", Position = center + Vector3.new(-1120, 0, -1180), Length = 560, Height = 196, Depth = 194, Yaw = 16, Color = DESERT_ROCK },
        { Name = "FarNorth", Position = center + Vector3.new(0, 0, -1990), Length = 760, Height = 228, Depth = 186, Yaw = -2, Color = Color3.fromRGB(142, 114, 83) },
        { Name = "FarNorthEast", Position = center + Vector3.new(1120, 0, -1160), Length = 560, Height = 192, Depth = 190, Yaw = -16, Color = DESERT_ROCK },
        { Name = "FarWest", Position = center + Vector3.new(-1320, 0, 260), Length = 470, Height = 182, Depth = 214, Yaw = 26, Color = Color3.fromRGB(136, 108, 79) },
        { Name = "FarEast", Position = center + Vector3.new(1320, 0, 260), Length = 470, Height = 182, Depth = 214, Yaw = -24, Color = Color3.fromRGB(140, 112, 81) },
        { Name = "FarSouthWest", Position = center + Vector3.new(-1080, 0, 1290), Length = 540, Height = 184, Depth = 166, Yaw = 18, Color = DESERT_ROCK },
        { Name = "FarSouth", Position = center + Vector3.new(0, 0, 1360), Length = 760, Height = 208, Depth = 154, Yaw = 0, Color = Color3.fromRGB(146, 118, 86) },
        { Name = "FarSouthEast", Position = center + Vector3.new(1080, 0, 1290), Length = 540, Height = 184, Depth = 166, Yaw = -18, Color = DESERT_ROCK },
    }) do
        createStylizedRidge(backdrop, string.format("%sBackdrop_%d", ridge.Name, index), ridge.Position, ridge.Yaw, ridge.Length, ridge.Height, ridge.Depth, ridge.Color)
    end
end

local function createArcadeBlock(parent: Instance, namePrefix: string, center: Vector3, width: number, depth: number, floorColor: Color3, wallColor: Color3, roofColor: Color3)
    BuildUtils.CreatePart(parent, string.format("%s_Floor", namePrefix), Vector3.new(width, 1, depth), CFrame.new(center + Vector3.new(0, 4.55, 0)), floorColor, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Roof", namePrefix), Vector3.new(width, 4, depth), CFrame.new(center + Vector3.new(0, 22, 0)), roofColor, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_GlassFront", namePrefix), Vector3.new(width - 20, 3, 1.2), CFrame.new(center + Vector3.new(0, 15.5, depth * -0.5 + 3)), GLASS_TINT, Enum.Material.Glass, nil, 0.18)
    BuildUtils.CreatePart(parent, string.format("%s_GlassBack", namePrefix), Vector3.new(width - 20, 3, 1.2), CFrame.new(center + Vector3.new(0, 15.5, depth * 0.5 - 3)), GLASS_TINT, Enum.Material.Glass, nil, 0.18)

    local xCount = math.max(2, math.floor((width - 24) / 32))
    local zCount = math.max(1, math.floor((depth - 24) / 32))

    for index = 0, xCount do
        local alpha = index / xCount
        local x = -width * 0.5 + 12 + alpha * (width - 24)
        BuildUtils.CreatePart(parent, string.format("%s_ColumnFront_%d", namePrefix, index + 1), Vector3.new(4.5, 18, 4.5), CFrame.new(center + Vector3.new(x, 13, depth * -0.5 + 10)), wallColor, Enum.Material.Marble, nil, nil)
        BuildUtils.CreatePart(parent, string.format("%s_ColumnBack_%d", namePrefix, index + 1), Vector3.new(4.5, 18, 4.5), CFrame.new(center + Vector3.new(x, 13, depth * 0.5 - 10)), wallColor, Enum.Material.Marble, nil, nil)
    end

    for index = 1, zCount - 1 do
        local alpha = index / zCount
        local z = -depth * 0.5 + 12 + alpha * (depth - 24)
        BuildUtils.CreatePart(parent, string.format("%s_ColumnLeft_%d", namePrefix, index), Vector3.new(4.5, 18, 4.5), CFrame.new(center + Vector3.new(width * -0.5 + 10, 13, z)), wallColor, Enum.Material.Marble, nil, nil)
        BuildUtils.CreatePart(parent, string.format("%s_ColumnRight_%d", namePrefix, index), Vector3.new(4.5, 18, 4.5), CFrame.new(center + Vector3.new(width * 0.5 - 10, 13, z)), wallColor, Enum.Material.Marble, nil, nil)
    end
end

local function createTent(parent: Instance, name: string, position: Vector3, clothColor: Color3)
    local floor = BuildUtils.CreatePart(parent, string.format("%s_Floor", name), Vector3.new(22, 1, 18), CFrame.new(position + Vector3.new(0, 0.5, 0)), Color3.fromRGB(176, 152, 111), Enum.Material.Sandstone, nil, nil)
    floor.CanCollide = true

    local leftRoof = BuildUtils.CreatePart(parent, string.format("%s_LeftRoof", name), Vector3.new(12, 1, 18), CFrame.new(position + Vector3.new(-5.8, 7.5, 0)) * CFrame.Angles(0, 0, math.rad(24)), clothColor, Enum.Material.Fabric, nil, nil)
    local rightRoof = BuildUtils.CreatePart(parent, string.format("%s_RightRoof", name), Vector3.new(12, 1, 18), CFrame.new(position + Vector3.new(5.8, 7.5, 0)) * CFrame.Angles(0, 0, math.rad(-24)), clothColor, Enum.Material.Fabric, nil, nil)
    leftRoof.CanCollide = true
    rightRoof.CanCollide = true

    BuildUtils.CreatePart(parent, string.format("%s_Back", name), Vector3.new(18, 8, 1), CFrame.new(position + Vector3.new(0, 4, 8.5)), Color3.fromRGB(121, 94, 62), Enum.Material.WoodPlanks, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_PoleA", name), Vector3.new(1, 10, 1), CFrame.new(position + Vector3.new(-6.8, 5, 0)), Color3.fromRGB(108, 78, 48), Enum.Material.Wood, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_PoleB", name), Vector3.new(1, 10, 1), CFrame.new(position + Vector3.new(6.8, 5, 0)), Color3.fromRGB(108, 78, 48), Enum.Material.Wood, nil, nil)
end

local function createMedinaGate(parent: Instance, name: string, center: Vector3, orientationY: number, title: string, subtitle: string)
    local rotation = CFrame.Angles(0, math.rad(orientationY), 0)
    local gateFolder = BuildUtils.CreateFolder(parent, name)

    BuildUtils.CreatePart(gateFolder, "LeftColumn", Vector3.new(8, 26, 8), CFrame.new(center) * rotation * CFrame.new(-14, 13, 0), MEDINA_STONE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(gateFolder, "RightColumn", Vector3.new(8, 26, 8), CFrame.new(center) * rotation * CFrame.new(14, 13, 0), MEDINA_STONE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(gateFolder, "Beam", Vector3.new(36, 8, 9), CFrame.new(center) * rotation * CFrame.new(0, 24, 0), MEDINA_STONE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(gateFolder, "Threshold", Vector3.new(38, 1, 14), CFrame.new(center) * rotation * CFrame.new(0, 0.5, 0), Color3.fromRGB(218, 214, 202), Enum.Material.Marble, nil, nil)

    local signOffset = Vector3.new(0, 0, 14)
    local signPosition = (CFrame.new(center) * rotation * CFrame.new(signOffset)).Position
    createWallPanel(gateFolder, "GateSign", signPosition, Vector3.new(40, 10, 2), title, subtitle, Color3.fromRGB(58, 90, 63), orientationY + 180, nil)
end

local function makeCamelPart(part: BasePart)
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = true
end

local function createRideableCamel(parent: Instance, name: string, position: Vector3, orientationY: number)
    local camel = Instance.new("Model")
    camel.Name = name
    camel:SetAttribute("CamelSpeed", 46)
    camel:SetAttribute("CamelTurnRate", 2.2)
    camel:SetAttribute("StridePhase", (position.X + position.Z) * 0.013)
    camel.Parent = parent

    local baseCFrame = CFrame.new(position + Vector3.new(0, 13.5, 0)) * CFrame.Angles(0, math.rad(orientationY), 0)
    local bodyColor = Color3.fromRGB(171, 125, 76)
    local shadowColor = Color3.fromRGB(122, 82, 48)
    local clothColor = Color3.fromRGB(98, 87, 65)
    local saddleColor = Color3.fromRGB(73, 56, 41)

    local root = BuildUtils.CreatePart(camel, "CamelRoot", Vector3.new(2, 2, 2), baseCFrame, Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    root.CanCollide = false
    root.CanTouch = false
    root.CanQuery = false
    camel.PrimaryPart = root

    for _, part in ipairs({
        BuildUtils.CreatePart(camel, "Body", Vector3.new(16, 6, 6), baseCFrame * CFrame.new(0, 1.2, 0), bodyColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreateWedge(camel, "Hump", Vector3.new(8, 5, 7), baseCFrame * CFrame.new(-1.6, 5.2, 0) * CFrame.Angles(0, math.rad(180), 0), Color3.fromRGB(149, 102, 61), Enum.Material.Fabric, nil),
        BuildUtils.CreatePart(camel, "Chest", Vector3.new(5.5, 5.5, 5.8), baseCFrame * CFrame.new(-7.2, 1.4, 0), bodyColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "Neck", Vector3.new(3.2, 9, 3), baseCFrame * CFrame.new(-10, 6.6, 0) * CFrame.Angles(0, 0, math.rad(-18)), bodyColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "Head", Vector3.new(5.6, 3.2, 3), baseCFrame * CFrame.new(-11.9, 10.8, 0), bodyColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "Muzzle", Vector3.new(2.8, 2, 2.4), baseCFrame * CFrame.new(-15.4, 10.3, 0), shadowColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "LeftEar", Vector3.new(0.8, 2.2, 0.7), baseCFrame * CFrame.new(-11.7, 13.1, -1.15) * CFrame.Angles(math.rad(12), 0, math.rad(-10)), shadowColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "RightEar", Vector3.new(0.8, 2.2, 0.7), baseCFrame * CFrame.new(-11.7, 13.1, 1.15) * CFrame.Angles(math.rad(-12), 0, math.rad(-10)), shadowColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "Tail", Vector3.new(1, 7, 1), baseCFrame * CFrame.new(8.8, 2.7, 0) * CFrame.Angles(0, 0, math.rad(34)), shadowColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "SaddleBlanket", Vector3.new(8.5, 0.7, 7.4), baseCFrame * CFrame.new(1.2, 5, 0), clothColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "SaddleBack", Vector3.new(1.2, 2.4, 6.2), baseCFrame * CFrame.new(4.2, 6.1, 0), saddleColor, Enum.Material.Wood, nil, nil),
        BuildUtils.CreatePart(camel, "SaddleFront", Vector3.new(1.2, 2.1, 6.2), baseCFrame * CFrame.new(-2.4, 5.95, 0), saddleColor, Enum.Material.Wood, nil, nil),
    }) do
        makeCamelPart(part)
    end

    for index, localOffset in ipairs({
        Vector3.new(-5.2, -3.2, -2.1),
        Vector3.new(-5.2, -3.2, 2.1),
        Vector3.new(5.2, -3.2, -2.1),
        Vector3.new(5.2, -3.2, 2.1),
    }) do
        local leg = BuildUtils.CreatePart(camel, string.format("Leg_%d", index), Vector3.new(1.4, 9, 1.4), baseCFrame * CFrame.new(localOffset), shadowColor, Enum.Material.Fabric, nil, nil)
        local hoof = BuildUtils.CreatePart(camel, string.format("Hoof_%d", index), Vector3.new(2.4, 0.8, 2.2), baseCFrame * CFrame.new(localOffset + Vector3.new(0, -4.9, 0)), Color3.fromRGB(79, 58, 42), Enum.Material.Slate, nil, nil)
        makeCamelPart(leg)
        makeCamelPart(hoof)
    end

    local seat = Instance.new("VehicleSeat")
    seat.Name = "CamelSeat"
    seat.Anchored = true
    seat.CanCollide = false
    seat.CanTouch = true
    seat.CanQuery = true
    seat.Transparency = 1
    seat.Size = Vector3.new(5.8, 1.2, 4.8)
    seat.CFrame = baseCFrame * CFrame.new(1.1, 6.2, 0)
    seat.Parent = camel
    seat:SetAttribute("PromptAction", "RideCamel")

    local marker = BuildUtils.CreatePart(camel, "PromptMarker", Vector3.new(5.6, 0.5, 5.6), baseCFrame * CFrame.new(1.1, -2.8, 0), Color3.fromRGB(214, 178, 99), Enum.Material.Metal, nil, 0.18)
    makeCamelPart(marker)
    BuildUtils.AttachPrompt(marker, "Ride Camel", "Travel Mount", {
        PromptAction = "RideCamel",
    })

    CollectionService:AddTag(camel, "RideableCamel")

    return camel
end

local function buildDesertRoute(parent: Instance, startPosition: Vector3, stopPosition: Vector3, endPosition: Vector3)
    local district = BuildUtils.CreateFolder(parent, "DesertRoute")
    local routeEntryPosition = Vector3.new(startPosition.X, startPosition.Y, startPosition.Z + 820)
    local routeCenter = (routeEntryPosition + endPosition) * 0.5
    local routeLength = math.abs(endPosition.Z - routeEntryPosition.Z) + 220

    BuildUtils.CreatePart(district, "SafetyPlate", Vector3.new(1020, 10, routeLength + 260), CFrame.new(routeCenter + Vector3.new(0, -9, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(district, "DesertBase", Vector3.new(860, 4, routeLength), CFrame.new(routeCenter + Vector3.new(0, 2, 0)), DESERT_SAND, Enum.Material.Sand, nil, nil)
    BuildUtils.CreateDune(district, "RouteLongWestDune", routeCenter + Vector3.new(-220, 0, -120), Vector3.new(420, 62, routeLength * 0.42), Color3.fromRGB(204, 179, 132))
    BuildUtils.CreateDune(district, "RouteLongEastDune", routeCenter + Vector3.new(226, 0, 160), Vector3.new(440, 66, routeLength * 0.45), Color3.fromRGB(199, 175, 129))
    BuildUtils.CreatePart(district, "TravelPath", Vector3.new(102, 1, routeLength - 140), CFrame.new(routeCenter + Vector3.new(0, 4.55, 0)), Color3.fromRGB(182, 154, 110), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(district, "TravelPathCenterInlay", Vector3.new(7, 0.24, routeLength - 180), CFrame.new(routeCenter + Vector3.new(0, 5.16, 0)), Color3.fromRGB(232, 212, 168), Enum.Material.Marble, nil, nil).CanCollide = false
    BuildUtils.CreatePart(district, "TravelPathWestEdge", Vector3.new(3, 0.24, routeLength - 180), CFrame.new(routeCenter + Vector3.new(-51, 5.18, 0)), Color3.fromRGB(133, 108, 76), Enum.Material.Slate, nil, nil).CanCollide = false
    BuildUtils.CreatePart(district, "TravelPathEastEdge", Vector3.new(3, 0.24, routeLength - 180), CFrame.new(routeCenter + Vector3.new(51, 5.18, 0)), Color3.fromRGB(133, 108, 76), Enum.Material.Slate, nil, nil).CanCollide = false

    local camelFolder = BuildUtils.CreateFolder(district, "RouteCamels")
    createRideableCamel(camelFolder, "MakkahRouteCamel", routeEntryPosition + Vector3.new(-78, 0, 186), 0)
    createRideableCamel(camelFolder, "DesertRouteCamel", stopPosition + Vector3.new(98, 0, -96), 180)
    createRideableCamel(camelFolder, "MedinaRouteCamel", endPosition + Vector3.new(82, 0, -206), 180)

    local mountainFolder = BuildUtils.CreateFolder(district, "RouteMountainWalls")
    local mountainIndex = 0

    for z = routeEntryPosition.Z + 220, endPosition.Z - 260, 460 do
        mountainIndex += 1
        local heightOffset = (mountainIndex % 3) * 12
        createStylizedRidge(mountainFolder, string.format("WestRouteMountain_%d", mountainIndex), Vector3.new(-356, 0, z), 22, 238 + heightOffset * 1.8, 98 + heightOffset, 98, DESERT_ROCK)
        createStylizedRidge(mountainFolder, string.format("EastRouteMountain_%d", mountainIndex), Vector3.new(356, 0, z + 88), -24, 252 + heightOffset * 1.8, 104 + heightOffset, 102, Color3.fromRGB(157, 126, 88))
        createStylizedRidge(mountainFolder, string.format("RouteMidRidge_%d", mountainIndex), Vector3.new(((mountainIndex % 2 == 0) and -1 or 1) * 252, 0, z - 128), (mountainIndex % 2 == 0) and -10 or 10, 170 + heightOffset, 54 + heightOffset * 0.45, 74, Color3.fromRGB(145, 117, 85))
    end

    local lampIndex = 0

    for z = routeEntryPosition.Z + 170, endPosition.Z - 210, 280 do
        lampIndex += 1
        createLowBollard(district, string.format("RouteGuideLampWest_%d", lampIndex), Vector3.new(-66, 0, z), Color3.fromRGB(255, 229, 170))
        createLowBollard(district, string.format("RouteGuideLampEast_%d", lampIndex), Vector3.new(66, 0, z), Color3.fromRGB(255, 229, 170))
    end

    local stepIndex = 0
    for z = routeEntryPosition.Z + 160, endPosition.Z - 160, 220 do
        stepIndex += 1
        local xShift = (stepIndex % 2 == 0) and 190 or -190
        BuildUtils.CreateDune(district, string.format("RouteDuneA_%d", stepIndex), Vector3.new(xShift, 0, z), Vector3.new(180, 40, 90), Color3.fromRGB(219, 190, 136))
        BuildUtils.CreateDune(district, string.format("RouteDuneB_%d", stepIndex), Vector3.new(xShift * -0.65, 0, z + 60), Vector3.new(130, 34, 82), Color3.fromRGB(211, 181, 129))
        makeDecorativePart(BuildUtils.CreatePart(
            district,
            string.format("RouteShoulder_%d", stepIndex),
            Vector3.new(78, 12, 34),
            CFrame.new(Vector3.new(xShift * 0.58, 8, z - 28)) * CFrame.Angles(0, math.rad((stepIndex % 2 == 0) and -18 or 18), 0),
            Color3.fromRGB(165, 136, 96),
            Enum.Material.Sandstone,
            nil,
            nil
        ))
    end

    BuildUtils.CreatePart(district, "CampCourt", Vector3.new(210, 3, 170), CFrame.new(stopPosition + Vector3.new(0, 1.5, 0)), Color3.fromRGB(196, 173, 130), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(district, "CampPath", Vector3.new(82, 1, 120), CFrame.new(stopPosition + Vector3.new(0, 3.55, -6)), Color3.fromRGB(222, 212, 190), Enum.Material.Sandstone, nil, nil)
    createTent(district, "CampTentWest", stopPosition + Vector3.new(-56, 0, 28), Color3.fromRGB(120, 88, 54))
    createTent(district, "CampTentEast", stopPosition + Vector3.new(56, 0, 28), Color3.fromRGB(135, 98, 59))
    BuildUtils.CreatePlanter(district, "OasisPlanter", stopPosition + Vector3.new(0, 0, -42), Vector3.new(56, 3, 46))
    BuildUtils.CreatePalmTree(district, "OasisPalmWest", stopPosition + Vector3.new(-18, 0, -44))
    BuildUtils.CreatePalmTree(district, "OasisPalmEast", stopPosition + Vector3.new(18, 0, -40))
    createLightPost(district, "CampLightWest", stopPosition + Vector3.new(-78, 0, -28))
    createLightPost(district, "CampLightEast", stopPosition + Vector3.new(78, 0, -28))
    createWallPanel(district, "MakkahRouteStartSign", routeEntryPosition + Vector3.new(0, 0, 96), Vector3.new(76, 12, 2.5), "Makkah To Medina Route", "Ride a camel or follow the lamp markers. This long path teaches distance and migration without depicting the Prophet.", Color3.fromRGB(105, 83, 55), 0, nil)
    createWallPanel(district, "CampSign", stopPosition + Vector3.new(0, 0, -76), Vector3.new(72, 12, 2.5), "Desert Route Camp", "A longer travel stretch now separates Makkah and Medina, with a mid-route camp for reflection and story stops.", Color3.fromRGB(111, 88, 58), 0, nil)
    createWallPanel(district, "MedinaRouteArrivalSign", endPosition + Vector3.new(0, 0, -132), Vector3.new(76, 12, 2.5), "Medina Approach", "The route ends at a green-and-white Medina district with gates, courtyard markers, and a respectful visitation path.", Color3.fromRGB(58, 91, 66), 180, nil)
end

