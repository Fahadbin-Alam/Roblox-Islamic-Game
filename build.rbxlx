        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">CampaignRules</string>
            <string name="Source"><![CDATA[--!strict

-- Pure rules for the Seerah campaign. The server keeps one run per player and moves it
-- through the stages below. No Roblox services are used, so the rules are unit tested.
--
-- Stages: Travel (walk to the chapter's site) -> Story (read the narration) -> Activity
-- (collect items or finish the battle mission, if the chapter has one) -> Decision (answer the
-- question about what was decided) -> Done.

local SeerahCampaign = require(script.Parent.Parent.Data.SeerahCampaign)

local CampaignRules = {}

export type Run = {
    ChapterId: string,
    Stage: string,
    Collected: { [number]: boolean },
    WrongAnswers: number,
}

local chapterById = {}

for index, chapter in ipairs(SeerahCampaign.Chapters) do
    chapterById[chapter.Id] = { Chapter = chapter, Index = index }
end

function CampaignRules.GetChapter(id: string): SeerahCampaign.Chapter?
    local entry = chapterById[id]

    return entry and entry.Chapter
end

function CampaignRules.IndexOf(id: string): number?
    local entry = chapterById[id]

    return entry and entry.Index
end

-- Chapters open one at a time, in order. `completed` is the saved set of finished chapter ids.
function CampaignRules.IsUnlocked(completed: { [string]: boolean }, id: string): boolean
    local index = CampaignRules.IndexOf(id)

    if not index then
        return false
    end

    if index == 1 then
        return true
    end

    return completed[SeerahCampaign.Chapters[index - 1].Id] == true
end

function CampaignRules.NextChapter(completed: { [string]: boolean }): SeerahCampaign.Chapter?
    for _, chapter in ipairs(SeerahCampaign.Chapters) do
        if completed[chapter.Id] ~= true then
            return chapter
        end
    end

    return nil
end

function CampaignRules.Checklist(completed: { [string]: boolean })
    local list = {}

    for _, chapter in ipairs(SeerahCampaign.Chapters) do
        table.insert(list, {
            Id = chapter.Id,
            Number = chapter.Number,
            Title = chapter.Title,
            When = chapter.When,
            Era = chapter.Era,
            Done = completed[chapter.Id] == true,
            Unlocked = CampaignRules.IsUnlocked(completed, chapter.Id),
        })
    end

    return list
end

function CampaignRules.CountDone(completed: { [string]: boolean }): number
    local count = 0

    for _, chapter in ipairs(SeerahCampaign.Chapters) do
        if completed[chapter.Id] == true then
            count += 1
        end
    end

    return count
end

function CampaignRules.NewRun(id: string): Run?
    if not chapterById[id] then
        return nil
    end

    return {
        ChapterId = id,
        Stage = "Travel",
        Collected = {},
        WrongAnswers = 0,
    }
end

local function afterStory(chapter: SeerahCampaign.Chapter): string
    return if chapter.Activity then "Activity" else "Decision"
end

function CampaignRules.Arrive(run: Run): boolean
    if run.Stage ~= "Travel" then
        return false
    end

    run.Stage = "Story"

    return true
end

function CampaignRules.FinishStory(run: Run): boolean
    if run.Stage ~= "Story" then
        return false
    end

    run.Stage = afterStory(chapterById[run.ChapterId].Chapter)

    return true
end

function CampaignRules.CollectCount(run: Run): number
    local count = 0

    for _ in pairs(run.Collected) do
        count += 1
    end

    return count
end

-- Records one collected item. Returns true when the item counted.
function CampaignRules.Collect(run: Run, itemIndex: number): boolean
    local chapter = chapterById[run.ChapterId].Chapter
    local activity = chapter.Activity

    if run.Stage ~= "Activity" or not activity or activity.Kind ~= "Collect" then
        return false
    end

    local count = activity.Count or 0

    if type(itemIndex) ~= "number" or itemIndex % 1 ~= 0 or itemIndex < 1 or itemIndex > count or run.Collected[itemIndex] then
        return false
    end

    run.Collected[itemIndex] = true

    if CampaignRules.CollectCount(run) >= count then
        run.Stage = "Decision"
    end

    return true
end

-- For Battle activities: the server calls this once the player has finished the mission.
function CampaignRules.BattleDone(run: Run, battleCompleted: boolean): boolean
    local activity = chapterById[run.ChapterId].Chapter.Activity

    if run.Stage ~= "Activity" or not activity or activity.Kind ~= "Battle" or not battleCompleted then
        return false
    end

    run.Stage = "Decision"

    return true
end

-- Grades the decision. A wrong answer explains nothing yet and lets the player try again.
function CampaignRules.Answer(run: Run, optionIndex: number): (boolean, string?)
    if run.Stage ~= "Decision" then
        return false, nil
    end

    local decision = chapterById[run.ChapterId].Chapter.Decision

    if optionIndex == decision.CorrectIndex then
        run.Stage = "Done"

        return true, decision.Explanation
    end

    run.WrongAnswers += 1

    return false, nil
end

-- Where item `index` of a Collect chapter lies, as an offset from the site's arrival point.
-- Items ring the site at two distances; on mountain ledges they stay close to the cave.
function CampaignRules.ItemOffset(chapter: SeerahCampaign.Chapter, index: number, onLedge: boolean): Vector3
    local count = (chapter.Activity and chapter.Activity.Count) or 1
    local angle = (index - 1) * (2 * math.pi / count) + chapter.Number * 0.7
    local near, far = if onLedge then 10 else 24, if onLedge then 18 else 44
    local radius = if index % 2 == 0 then far else near

    return Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

return CampaignRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">ContentIndex</string>
            <string name="Source"><![CDATA[--!strict

local GameConfig = require(script.Parent.Parent.Config.GameConfig)
local BattleScenarios = require(script.Parent.Parent.Data.BattleScenarios)
local CompanionStories = require(script.Parent.Parent.Data.CompanionStories)
local HaramLearningTrail = require(script.Parent.Parent.Data.HaramLearningTrail)
local IslamicStudies = require(script.Parent.Parent.Data.IslamicStudies)
local MannersLessons = require(script.Parent.Parent.Data.MannersLessons)
local ShopCatalog = require(script.Parent.Parent.Data.ShopCatalog)
local TravelRoute = require(script.Parent.Parent.Data.TravelRoute)
local TriviaQuestions = require(script.Parent.Parent.Data.TriviaQuestions)

local ContentIndex = {}

function ContentIndex.GetStartupPayload()
    return {
        Config = GameConfig,
        Battles = BattleScenarios,
        Stories = CompanionStories,
        HaramLearningTrail = HaramLearningTrail,
        IslamicStudies = IslamicStudies,
        Manners = MannersLessons,
        Shop = ShopCatalog,
        TravelRoute = TravelRoute,
        Trivia = TriviaQuestions,
    }
end

return ContentIndex
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Daily</string>
            <string name="Source"><![CDATA[--!strict

-- Pure rules for the daily return loop: one reflection and one review question per day, plus
-- a visit streak. Days are counted in UTC so every server agrees on when a new day starts.

local DailyReflections = require(script.Parent.Parent.Data.DailyReflections)
local IslamicStudies = require(script.Parent.Parent.Data.IslamicStudies)

local Daily = {}

local SECONDS_PER_DAY = 86400

Daily.Rewards = {
    VisitBase = 20,
    -- Each consecutive day adds this much, up to a week of growth.
    VisitPerStreakDay = 5,
    VisitStreakCap = 7,
    Question = 30,
}

type Stats = { [string]: number }

local allQuestions = {}

for _, unit in ipairs(IslamicStudies.Units) do
    for _, lesson in ipairs(unit.Lessons) do
        for index, question in ipairs(lesson.Quiz) do
            table.insert(allQuestions, {
                LessonId = lesson.Id,
                LessonName = lesson.DisplayName,
                QuestionIndex = index,
                Question = question,
            })
        end
    end
end

function Daily.DayNumber(unixTime: number): number
    return math.floor(unixTime / SECONDS_PER_DAY)
end

function Daily.GetReflection(day: number)
    return DailyReflections[(day % #DailyReflections) + 1]
end

local function gcd(a: number, b: number): number
    while b ~= 0 do
        a, b = b, a % b
    end

    return a
end

-- Stepping by a number coprime with the question count spreads consecutive days across
-- different lessons and still reaches every question before repeating.
local questionStep = 1

for _, candidate in ipairs({ 7, 11, 13, 17, 19, 23 }) do
    if gcd(candidate, #allQuestions) == 1 then
        questionStep = candidate
        break
    end
end

function Daily.GetQuestion(day: number)
    local index = ((day * questionStep) % #allQuestions) + 1
    return allQuestions[index]
end

function Daily.QuestionCount(): number
    return #allQuestions
end

function Daily.VisitReward(streak: number): number
    local growth = math.min(math.max(streak, 1), Daily.Rewards.VisitStreakCap) - 1
    return Daily.Rewards.VisitBase + growth * Daily.Rewards.VisitPerStreakDay
end

-- Records a visit on `day`. Returns the new streak and whether this is the first visit today.
-- Missing a day resets the streak to 1.
function Daily.RecordVisit(stats: Stats, day: number): (number, boolean)
    local lastDay = stats.DailyLastDay

    if lastDay == day then
        return stats.DailyStreak or 1, false
    end

    local streak = if lastDay == day - 1 then (stats.DailyStreak or 0) + 1 else 1
    stats.DailyLastDay = day
    stats.DailyStreak = streak
    stats.DailyBestStreak = math.max(stats.DailyBestStreak or 0, streak)

    return streak, true
end

function Daily.HasAnsweredQuestion(stats: Stats, day: number): boolean
    return stats.DailyQuestionDay == day
end

-- What the client is shown for today. The correct answer is left out on purpose.
function Daily.BuildPayload(stats: Stats, day: number)
    local reflection = Daily.GetReflection(day)
    local entry = Daily.GetQuestion(day)

    return {
        Day = day,
        Streak = stats.DailyStreak or 0,
        BestStreak = stats.DailyBestStreak or 0,
        Reflection = {
            Text = reflection.Text,
            Source = reflection.Source,
            Thought = reflection.Thought,
        },
        Question = {
            LessonName = entry.LessonName,
            Prompt = entry.Question.Prompt,
            Options = entry.Question.Options,
        },
        QuestionAnswered = Daily.HasAnsweredQuestion(stats, day),
        QuestionReward = Daily.Rewards.Question,
    }
end

return Daily
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">MissionRules</string>
            <string name="Source"><![CDATA[--!strict

-- Pure rules for the battle story missions, shared by the server (which runs the mission)
-- and the client (which shows it). No Roblox services, so it can be unit tested.

local MissionRules = {}

MissionRules.StarBonusXP = 40
MissionRules.MaxAliveEnemiesBase = 10
MissionRules.MaxAliveEnemiesPerPlayer = 3
MissionRules.MaxAliveEnemiesCap = 26

-- Opponent count for one spawn entry, grown for each player beyond the first.
function MissionRules.ScaleCount(spawn: { Count: number, PerExtraPlayer: number? }, playerCount: number): number
    local extraPlayers = math.max(0, math.floor(playerCount) - 1)
    local count = spawn.Count + (spawn.PerExtraPlayer or 0) * extraPlayers

    return math.max(0, math.floor(count + 0.5))
end

-- Opponents get a little tougher as more players join, so co-op stays a challenge.
function MissionRules.HealthMultiplier(playerCount: number): number
    return math.min(2.2, 1 + 0.18 * math.max(0, playerCount - 1))
end

function MissionRules.MaxAliveEnemies(playerCount: number): number
    return math.min(
        MissionRules.MaxAliveEnemiesCap,
        MissionRules.MaxAliveEnemiesBase + MissionRules.MaxAliveEnemiesPerPlayer * math.max(1, playerCount)
    )
end

-- Advances a hold timer. Holding needs at least one player in the ring, and pauses while the
-- ring is contested by more than twice as many opponents as players.
function MissionRules.StepHold(progress: number, deltaSeconds: number, required: number, playersInZone: number, enemiesInZone: number): (number, string)
    if playersInZone <= 0 then
        return progress, "Empty"
    end

    if enemiesInZone > playersInZone * 2 then
        return progress, "Contested"
    end

    return math.min(required, progress + deltaSeconds), "Holding"
end

export type MissionResult = {
    Completed: boolean,
    Falls: number,
    PlayerCount: number,
    SteadfastKept: boolean,
}

-- Three stars: finish the mission, keep the mission's steadfast condition, and fall no more
-- than once per player.
function MissionRules.ComputeStars(mission: any, result: MissionResult): (number, { { Label: string, Earned: boolean } })
    local details = {
        { Label = "Complete the mission", Earned = result.Completed },
        { Label = (mission.Steadfast and mission.Steadfast.Label) or "Stay steadfast", Earned = result.Completed and result.SteadfastKept },
        { Label = "No more than one fall per player", Earned = result.Completed and result.Falls <= math.max(1, result.PlayerCount) },
    }
    local stars = 0

    for _, detail in ipairs(details) do
        if detail.Earned then
            stars += 1
        end
    end

    return stars, details
end

-- XP for beating a previous best star count. Replays only pay for new stars.
function MissionRules.StarBonus(previousBest: number, stars: number): number
    return math.max(0, stars - math.max(0, previousBest)) * MissionRules.StarBonusXP
end

-- Grades reflection answers. `answers[i]` is the chosen index for question i.
function MissionRules.GradeReflection(mission: any, answers: any)
    local results = {}
    local correct = 0
    local questions = mission.Reflection or {}

    for index, question in ipairs(questions) do
        local chosen = type(answers) == "table" and answers[index] or nil
        local isCorrect = type(chosen) == "number" and chosen == question.Answer

        if isCorrect then
            correct += 1
        end

        table.insert(results, {
            Id = question.Id,
            Correct = isCorrect,
            Answer = question.Answer,
            Explanation = question.Explanation,
        })
    end

    return {
        Correct = correct,
        Total = #questions,
        Results = results,
    }
end

-- Questions as the client sees them: no answers.
function MissionRules.ReflectionForClient(mission: any)
    local questions = {}

    for _, question in ipairs(mission.Reflection or {}) do
        table.insert(questions, {
            Id = question.Id,
            Prompt = question.Prompt,
            Choices = question.Choices,
        })
    end

    return questions
end

return MissionRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">MysteryRules</string>
            <string name="Source"><![CDATA[--!strict

-- Pure rules for the Sahabi mysteries. One run is shared by everyone in a room, so clues,
-- hints, and episode stations found by one player count for the whole group.

local SahabiMysteries = require(script.Parent.Parent.Data.SahabiMysteries)

local MysteryRules = {}

export type Run = {
    MysteryId: string,
    Found: { [string]: boolean },
    HintsUsed: number,
    WrongTries: number,
    LockOpen: boolean,
    StationsDone: { [number]: boolean },
    Done: boolean,
}

local byId = {}

for _, mystery in ipairs(SahabiMysteries.Mysteries) do
    byId[mystery.Id] = mystery
end

function MysteryRules.Get(id: string): SahabiMysteries.Mystery?
    return byId[id]
end

function MysteryRules.NewRun(id: string): Run?
    if not byId[id] then
        return nil
    end

    return {
        MysteryId = id,
        Found = {},
        HintsUsed = 0,
        WrongTries = 0,
        LockOpen = false,
        StationsDone = {},
        Done = false,
    }
end

function MysteryRules.FoundCount(run: Run): number
    local count = 0

    for _ in pairs(run.Found) do
        count += 1
    end

    return count
end

-- Returns the clue when it was newly found.
function MysteryRules.FindClue(run: Run, clueId: string): SahabiMysteries.Clue?
    if run.Found[clueId] then
        return nil
    end

    for _, clue in ipairs(byId[run.MysteryId].Clues) do
        if clue.Id == clueId then
            run.Found[clueId] = true
            return clue
        end
    end

    return nil
end

function MysteryRules.AllCluesFound(run: Run): boolean
    return MysteryRules.FoundCount(run) >= #byId[run.MysteryId].Clues
end

-- Hints are given in order. Returns nil when none are left.
function MysteryRules.TakeHint(run: Run): string?
    local hints = byId[run.MysteryId].Hints

    if run.HintsUsed >= #hints then
        return nil
    end

    run.HintsUsed += 1

    return hints[run.HintsUsed]
end

-- `answers` holds one option index per lock question. All must be right to open the door.
function MysteryRules.TryLock(run: Run, answers: { number }): boolean
    if run.LockOpen then
        return true
    end

    if type(answers) ~= "table" then
        return false
    end

    for index, question in ipairs(byId[run.MysteryId].Lock) do
        if answers[index] ~= question.CorrectIndex then
            run.WrongTries += 1
            return false
        end
    end

    run.LockOpen = true

    return true
end

function MysteryRules.NextStation(run: Run): number?
    for index in ipairs(byId[run.MysteryId].Episode.Stations) do
        if not run.StationsDone[index] then
            return index
        end
    end

    return nil
end

-- Returns (counted, finished). Stations open only after the lock; ordered episodes take
-- stations one after another.
function MysteryRules.VisitStation(run: Run, index: number): (boolean, boolean)
    local episode = byId[run.MysteryId].Episode

    if not run.LockOpen or run.Done or type(index) ~= "number" or not episode.Stations[index] or run.StationsDone[index] then
        return false, run.Done
    end

    if episode.Ordered and MysteryRules.NextStation(run) ~= index then
        return false, false
    end

    run.StationsDone[index] = true

    if MysteryRules.NextStation(run) == nil then
        run.Done = true
    end

    return true, run.Done
end

-- Three stars, minus one for leaning on hints (two or more) and one for guessing at the lock
-- (two or more wrong tries). Never below one.
function MysteryRules.Stars(run: Run): number
    local stars = SahabiMysteries.MaxStars

    if run.HintsUsed >= 2 then
        stars -= 1
    end

    if run.WrongTries >= 2 then
        stars -= 1
    end

    return math.max(1, stars)
end

return MysteryRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ParkourRules</string>
            <string name="Source"><![CDATA[--!strict

-- Pure rules for timed parkour runs: checkpoints must be touched in order, the finish is the
-- last checkpoint, and a run faster than the course's minimum time is rejected as impossible
-- (teleport or exploit), so the best-time board stays honest.

local ParkourRules = {}

export type Course = {
    Id: string,
    Checkpoints: number,
    MinSeconds: number,
}

export type Run = {
    CourseId: string,
    Last: number,
    StartedAt: number?,
    FinishedSeconds: number?,
}

function ParkourRules.NewRun(course: Course): Run
    return { CourseId = course.Id, Last = 0, StartedAt = nil, FinishedSeconds = nil }
end

-- Checkpoint 1 is the start pad. Touching it again restarts the timer.
-- Returns "start", "checkpoint", "finish", "rejected", or "ignored".
function ParkourRules.Touch(course: Course, run: Run, index: number, now: number): string
    if index == 1 then
        run.Last = 1
        run.StartedAt = now
        run.FinishedSeconds = nil
        return "start"
    end

    if run.StartedAt == nil or run.FinishedSeconds ~= nil or index ~= run.Last + 1 then
        return "ignored"
    end

    run.Last = index

    if index < course.Checkpoints then
        return "checkpoint"
    end

    local elapsed = now - (run.StartedAt :: number)

    if elapsed < course.MinSeconds then
        run.StartedAt = nil
        run.Last = 0
        return "rejected"
    end

    run.FinishedSeconds = elapsed

    return "finish"
end

-- Where a fallen player goes back to: the last checkpoint reached (1 = start).
function ParkourRules.RespawnIndex(run: Run): number
    return math.max(1, run.Last)
end

function ParkourRules.IsBetter(previousBest: number?, seconds: number): boolean
    return previousBest == nil or previousBest <= 0 or seconds < previousBest
end

function ParkourRules.FormatTime(seconds: number): string
    local whole = math.floor(seconds)

    return string.format("%d:%02d.%d", whole // 60, whole % 60, math.floor((seconds - whole) * 10))
end

return ParkourRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--!strict

-- Pure progression rules shared by the server (which owns the saved profile) and the
-- client (which only displays it). Nothing here touches Roblox services, so the rules
-- can be unit tested outside Studio.

local BattleMissions = require(script.Parent.Parent.Data.BattleMissions)
local BattleScenarios = require(script.Parent.Parent.Data.BattleScenarios)
local CompanionStories = require(script.Parent.Parent.Data.CompanionStories)
local IslamicStudies = require(script.Parent.Parent.Data.IslamicStudies)
local MannersLessons = require(script.Parent.Parent.Data.MannersLessons)
local SahabiMysteries = require(script.Parent.Parent.Data.SahabiMysteries)
local SeerahCampaign = require(script.Parent.Parent.Data.SeerahCampaign)

export type Profile = {
    Version: number,
    XP: number,
    Completed: { [string]: { [string]: boolean } },
    Badges: { [string]: number },
    Stats: { [string]: number },
}

export type Badge = {
    Id: string,
    DisplayName: string,
    Description: string,
    -- Optional Roblox badge to award alongside the in-game one. 0 = not configured yet.
    RobloxBadgeId: number,
    IsEarned: (profile: Profile) -> boolean,
}

local Progression = {}

Progression.ProfileVersion = 1

-- Activity categories a profile tracks completion for.
Progression.Categories = {
    Lesson = "lesson",
    Story = "story",
    Battle = "battle",
    Trail = "trail",
    Manners = "manners",
    Path = "path",
    Order = "order",
    Reflection = "reflection",
    Seerah = "seerah",
    Mystery = "mystery",
    Parkour = "parkour",
    Coop = "coop",
}

-- XP for the first completion of each kind of activity. Repeats give RepeatMultiplier of it,
-- so replaying is still rewarded without making grinding the fastest path.
Progression.Rewards = {
    lesson = 60,
    story = 120,
    battle = 150,
    trail = 90,
    manners = 25,
    TriviaCorrect = 4,
    StudyCircle = 40,
    path = 25,
    order = 30,
    reflection = 15,
    seerah = 80,
    mystery = 140,
    parkour = 70,
    coop = 90,
    PvpRoundWin = 10,
    PvpMatchWin = 40,
    RepeatMultiplier = 0.25,
}

Progression.RankTitles = {
    { MinLevel = 1, Title = "Seeker" },
    { MinLevel = 3, Title = "Student" },
    { MinLevel = 6, Title = "Student Of Knowledge" },
    { MinLevel = 10, Title = "Scholar's Companion" },
    { MinLevel = 15, Title = "Guardian Of Knowledge" },
}

function Progression.NewProfile(): Profile
    local completed = {}

    for _, category in pairs(Progression.Categories) do
        completed[category] = {}
    end

    return {
        Version = Progression.ProfileVersion,
        XP = 0,
        Completed = completed,
        Badges = {},
        Stats = {},
    }
end

-- Accepts whatever came back from the DataStore and returns a well-formed profile,
-- keeping every valid field and dropping anything malformed.
function Progression.Sanitize(raw: any): Profile
    local profile = Progression.NewProfile()

    if type(raw) ~= "table" then
        return profile
    end

    if type(raw.XP) == "number" and raw.XP >= 0 then
        profile.XP = math.floor(raw.XP)
    end

    if type(raw.Completed) == "table" then
        for category, entries in pairs(raw.Completed) do
            if type(category) == "string" and type(entries) == "table" then
                local target = profile.Completed[category] or {}

                for id, done in pairs(entries) do
                    if type(id) == "string" and done == true then
                        target[id] = true
                    end
                end

                profile.Completed[category] = target
            end
        end
    end

    if type(raw.Badges) == "table" then
        for id, earnedAt in pairs(raw.Badges) do
            if type(id) == "string" and type(earnedAt) == "number" then
                profile.Badges[id] = earnedAt
            end
        end
    end

    if type(raw.Stats) == "table" then
        for stat, value in pairs(raw.Stats) do
            if type(stat) == "string" and type(value) == "number" then
                profile.Stats[stat] = value
            end
        end
    end

    return profile
end

-- XP needed to go from `level` to `level + 1`.
function Progression.XPForNextLevel(level: number): number
    return 100 + (level - 1) * 60
end

function Progression.GetLevelInfo(totalXP: number): { Level: number, XPIntoLevel: number, XPForNext: number }
    local level = 1
    local remaining = math.max(0, math.floor(totalXP))

    while remaining >= Progression.XPForNextLevel(level) do
        remaining -= Progression.XPForNextLevel(level)
        level += 1
    end

    return {
        Level = level,
        XPIntoLevel = remaining,
        XPForNext = Progression.XPForNextLevel(level),
    }
end

function Progression.GetRankTitle(level: number): string
    local title = Progression.RankTitles[1].Title

    for _, rank in ipairs(Progression.RankTitles) do
        if level >= rank.MinLevel then
            title = rank.Title
        end
    end

    return title
end

function Progression.GetCompletionReward(category: string, firstTime: boolean): number
    local base = (Progression.Rewards :: any)[category]

    if type(base) ~= "number" then
        return 0
    end

    if firstTime then
        return base
    end

    return math.floor(base * Progression.Rewards.RepeatMultiplier)
end

local function countCompleted(profile: Profile, category: string, ids: { string }): number
    local entries = profile.Completed[category] or {}
    local count = 0

    for _, id in ipairs(ids) do
        if entries[id] then
            count += 1
        end
    end

    return count
end

local function allCompleted(category: string, ids: { string }): (profile: Profile) -> boolean
    return function(profile: Profile): boolean
        return #ids > 0 and countCompleted(profile, category, ids) == #ids
    end
end

local function idsOf(list: { any }): { string }
    local ids = {}

    for _, item in ipairs(list) do
        table.insert(ids, item.Id)
    end

    return ids
end

local function totalCompleted(profile: Profile, category: string): number
    local count = 0

    for _ in pairs(profile.Completed[category] or {}) do
        count += 1
    end

    return count
end

local function buildBadges(): { Badge }
    local badges: { Badge } = {
        {
            Id = "first_lesson",
            DisplayName = "First Step",
            Description = "Complete your first Islamic Studies lesson.",
            RobloxBadgeId = 0,
            IsEarned = function(profile)
                return totalCompleted(profile, Progression.Categories.Lesson) >= 1
            end,
        },
    }

    for _, unit in ipairs(IslamicStudies.Units) do
        table.insert(badges, {
            Id = string.format("unit_%s", unit.Id),
            DisplayName = string.format("%s Complete", unit.DisplayName),
            Description = string.format("Pass every lesson in %s.", unit.DisplayName),
            RobloxBadgeId = 0,
            IsEarned = allCompleted(Progression.Categories.Lesson, idsOf(unit.Lessons)),
        })
    end

    local orderLessonIds = {}

    for _, unit in ipairs(IslamicStudies.Units) do
        for _, lesson in ipairs(unit.Lessons) do
            if lesson.Order then
                table.insert(orderLessonIds, lesson.Id)
            end
        end
    end

    table.insert(badges, {
        Id = "puzzle_master",
        DisplayName = "In The Right Order",
        Description = "Solve every order puzzle in the Islamic Studies hall.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Order, orderLessonIds),
    })

    table.insert(badges, {
        Id = "companion_friend",
        DisplayName = "Friend Of The Sahabah",
        Description = "Finish every companion story.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Story, idsOf(CompanionStories)),
    })

    table.insert(badges, {
        Id = "adab_keeper",
        DisplayName = "Keeper Of Adab",
        Description = "Read every lesson in the Manners Court.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Manners, idsOf(MannersLessons)),
    })

    table.insert(badges, {
        Id = "haram_walker",
        DisplayName = "Haram Learning Walk",
        Description = "Finish the learning walk around the Haram.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return totalCompleted(profile, Progression.Categories.Trail) >= 1
        end,
    })

    for _, scenario in ipairs(BattleScenarios) do
        table.insert(badges, {
            Id = string.format("battle_%s", scenario.Id),
            DisplayName = string.format("%s Complete", scenario.DisplayName),
            Description = string.format("Complete the %s experience.", scenario.DisplayName),
            RobloxBadgeId = 0,
            IsEarned = allCompleted(Progression.Categories.Battle, { scenario.Id }),
        })
    end

    table.insert(badges, {
        Id = "badr_three_stars",
        DisplayName = "Defender Of The Wells",
        Description = "Earn all three stars in the Battle of Badr story mission.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return (profile.Stats.BestStars_badr or 0) >= 3
        end,
    })

    table.insert(badges, {
        Id = "uhud_kept_post",
        DisplayName = "Kept The Post",
        Description = "Stay on the Archers' Hill through the test of the spoils at Uhud.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return (profile.Stats.UhudPostKept or 0) >= 1
        end,
    })

    table.insert(badges, {
        Id = "uhud_three_stars",
        DisplayName = "Steadfast At Uhud",
        Description = "Earn all three stars in the Battle of Uhud story mission.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return (profile.Stats.BestStars_uhud or 0) >= 3
        end,
    })

    local reflectionIds = {}

    for _, missionId in ipairs(BattleMissions.Order) do
        for _, question in ipairs(BattleMissions.Get(missionId).Reflection) do
            table.insert(reflectionIds, question.Id)
        end
    end

    table.insert(badges, {
        Id = "battle_lessons",
        DisplayName = "Lessons Of The Battles",
        Description = "Answer every after-battle reflection question correctly.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Reflection, reflectionIds),
    })

    table.insert(badges, {
        Id = "battle_veteran",
        DisplayName = "Steady In Every Step",
        Description = "Complete 40 battle mission objectives.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return (profile.Stats.BattleObjectives or 0) >= 40
        end,
    })

    local makkahChapters, allChapters = {}, {}

    for _, chapter in ipairs(SeerahCampaign.Chapters) do
        table.insert(allChapters, chapter.Id)

        if chapter.Era == "Makkah" then
            table.insert(makkahChapters, chapter.Id)
        end
    end

    table.insert(badges, {
        Id = "seerah_makkah",
        DisplayName = "The Makkan Years",
        Description = "Finish every Makkah chapter of the Seerah campaign.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Seerah, makkahChapters),
    })

    table.insert(badges, {
        Id = "seerah_complete",
        DisplayName = "Walked The Seerah",
        Description = "Finish all 30 chapters of the Seerah campaign.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Seerah, allChapters),
    })

    table.insert(badges, {
        Id = "mystery_first",
        DisplayName = "Clue Finder",
        Description = "Solve your first Sahabi mystery.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return totalCompleted(profile, Progression.Categories.Mystery) >= 1
        end,
    })

    table.insert(badges, {
        Id = "mystery_all",
        DisplayName = "Companion Detective",
        Description = "Solve every Sahabi mystery.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Mystery, idsOf(SahabiMysteries.Mysteries)),
    })

    table.insert(badges, {
        Id = "parkour_tower",
        DisplayName = "Top Of The Tower",
        Description = "Finish a timed run of the Lobby Parkour Tower.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Parkour, { "lobby_tower" }),
    })

    table.insert(badges, {
        Id = "coop_trials",
        DisplayName = "Stronger Together",
        Description = "Finish the co-op Trials of Brotherhood with a partner.",
        RobloxBadgeId = 0,
        IsEarned = allCompleted(Progression.Categories.Coop, { "brotherhood_trials" }),
    })

    table.insert(badges, {
        Id = "pvp_match",
        DisplayName = "Fair Sparring",
        Description = "Win a Training Grounds sparring match.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return (profile.Stats.PvpMatchWins or 0) >= 1
        end,
    })

    table.insert(badges, {
        Id = "study_circle",
        DisplayName = "Halaqah Member",
        Description = "Pass a study circle with other players.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return (profile.Stats.StudyCircles or 0) >= 1
        end,
    })

    table.insert(badges, {
        Id = "trivia_25",
        DisplayName = "Quick Thinker",
        Description = "Answer 25 trivia questions correctly.",
        RobloxBadgeId = 0,
        IsEarned = function(profile)
            return (profile.Stats.TriviaCorrect or 0) >= 25
        end,
    })

    for _, milestone in ipairs({ 5, 10 }) do
        table.insert(badges, {
            Id = string.format("level_%d", milestone),
            DisplayName = string.format("Level %d", milestone),
            Description = string.format("Reach level %d.", milestone),
            RobloxBadgeId = 0,
            IsEarned = function(profile)
                return Progression.GetLevelInfo(profile.XP).Level >= milestone
            end,
        })
    end

    return badges
end

Progression.Badges = buildBadges()

local function lessonIdsOfUnit(unitId: string): { string }
    for _, unit in ipairs(IslamicStudies.Units) do
        if unit.Id == unitId then
            return idsOf(unit.Lessons)
        end
    end

    return {}
end

local function allLessonIds(): { string }
    local ids = {}

    for _, unit in ipairs(IslamicStudies.Units) do
        for _, lesson in ipairs(unit.Lessons) do
            table.insert(ids, lesson.Id)
        end
    end

    return ids
end

export type PathStep = {
    Id: string,
    Title: string,
    Hint: string,
    -- Where a guide can send the player for this step: a TravelRoute destination to
    -- teleport to, or an Islamic Studies unit to open.
    Destination: string?,
    HallUnitId: string?,
    IsDone: (profile: Profile) -> boolean,
}

-- The suggested order through the game. Players can do anything at any time; this only
-- powers the "Next" hint and the journal checklist so nobody wonders what to do next.
Progression.Path = {
    {
        Id = "haram_walk",
        Destination = "kaaba_courtyard",
        Title = "Take the Haram Learning Walk",
        Hint = "Start at the gold marker on the north side of the mataf, near where you arrive.",
        IsDone = function(profile)
            return totalCompleted(profile, Progression.Categories.Trail) >= 1
        end,
    },
    {
        Id = "pillars",
        HallUnitId = "pillars",
        Title = "Learn the Five Pillars",
        Hint = "Press Learn and open The Five Pillars.",
        IsDone = allCompleted(Progression.Categories.Lesson, lessonIdsOfUnit("pillars")),
    },
    {
        Id = "first_story",
        Destination = "story_court",
        Title = "Finish a companion story",
        Hint = "Open the Menu, choose Learn About Sahabis, and pick a companion.",
        IsDone = function(profile)
            return totalCompleted(profile, Progression.Categories.Story) >= 1
        end,
    },
    {
        Id = "badr",
        Destination = "badr_gate",
        Title = "Complete the Battle of Badr",
        Hint = "Open the Menu and choose Battle of Badr.",
        IsDone = allCompleted(Progression.Categories.Battle, { "badr" }),
    },
    {
        Id = "prayer",
        HallUnitId = "prayer",
        Title = "Learn how to pray",
        Hint = "Press Learn and open How To Pray.",
        IsDone = allCompleted(Progression.Categories.Lesson, lessonIdsOfUnit("prayer")),
    },
    {
        Id = "manners",
        Destination = "manners_court",
        Title = "Read every Manners Court lesson",
        Hint = "Walk to the Manners Court and read each board.",
        IsDone = allCompleted(Progression.Categories.Manners, idsOf(MannersLessons)),
    },
    {
        Id = "uhud",
        Destination = "uhud_gate",
        Title = "Complete the Battle of Uhud",
        Hint = "Open the Menu and choose Battle of Uhud.",
        IsDone = allCompleted(Progression.Categories.Battle, { "uhud" }),
    },
    {
        Id = "study_circle",
        Destination = "trivia_court",
        Title = "Pass a study circle with a friend",
        Hint = "Stand by the Islamic Studies podium in the Trivia Court with a friend and start a circle.",
        IsDone = function(profile)
            return (profile.Stats.StudyCircles or 0) >= 1
        end,
    },
    {
        Id = "seerah_start",
        Destination = "seerah_campaign",
        Title = "Begin the Seerah campaign",
        Hint = "Press Journeys and start chapter 1, The Year of the Elephant.",
        IsDone = function(profile)
            return totalCompleted(profile, Progression.Categories.Seerah) >= 1
        end,
    },
    {
        Id = "mystery_start",
        Destination = "mystery_wing",
        Title = "Solve a Sahabi mystery",
        Hint = "Press Journeys, open Mysteries, and pick a locked room.",
        IsDone = function(profile)
            return totalCompleted(profile, Progression.Categories.Mystery) >= 1
        end,
    },
    {
        Id = "all_lessons",
        Title = "Finish every Islamic Studies lesson",
        Hint = "Press Learn and complete the lessons you have left.",
        IsDone = allCompleted(Progression.Categories.Lesson, allLessonIds()),
    },
} :: { PathStep }

-- Path steps the profile has finished but not yet been rewarded for.
function Progression.FindNewlyCompletedSteps(profile: Profile): { PathStep }
    local rewarded = profile.Completed[Progression.Categories.Path] or {}
    local steps = {}

    for _, step in ipairs(Progression.Path) do
        if not rewarded[step.Id] and step.IsDone(profile) then
            table.insert(steps, step)
        end
    end

    return steps
end

-- The first unfinished step, or nil when the whole path is done.
function Progression.GetNextStep(profile: Profile): PathStep?
    for _, step in ipairs(Progression.Path) do
        if not step.IsDone(profile) then
            return step
        end
    end

    return nil
end

-- Returns why a battle is still locked for this profile, or nil when the player may join.
-- A missing profile (still loading, or the DataStore is down) never locks anyone out.
function Progression.GetBattleLockReason(profile: Profile?, scenarioId: string): string?
    local scenario = nil

    for _, candidate in ipairs(BattleScenarios) do
        if candidate.Id == scenarioId then
            scenario = candidate
        end
    end

    local unlock = scenario and (scenario :: any).Unlock

    if not profile or not unlock then
        return nil
    end

    local battlesDone = profile.Completed[Progression.Categories.Battle] or {}

    if unlock.AfterBattleId and battlesDone[unlock.AfterBattleId] then
        return nil
    end

    if unlock.OrLevel and Progression.GetLevelInfo(profile.XP).Level >= unlock.OrLevel then
        return nil
    end

    local requiredName = unlock.AfterBattleId

    for _, candidate in ipairs(BattleScenarios) do
        if candidate.Id == unlock.AfterBattleId then
            requiredName = candidate.DisplayName
        end
    end

    if unlock.OrLevel then
        return string.format("%s unlocks after you complete the %s or reach level %d.", scenario.DisplayName, requiredName, unlock.OrLevel)
    end

    return string.format("%s unlocks after you complete the %s.", scenario.DisplayName, requiredName)
end

-- Returns the badges the profile now qualifies for but has not been given yet.
function Progression.FindNewBadges(profile: Profile): { Badge }
    local earned = {}

    for _, badge in ipairs(Progression.Badges) do
        if not profile.Badges[badge.Id] and badge.IsEarned(profile) then
            table.insert(earned, badge)
        end
    end

    return earned
end

-- What the client is sent: plain data only, no functions.
function Progression.BuildSnapshot(profile: Profile)
    local levelInfo = Progression.GetLevelInfo(profile.XP)
    local badges = {}

    for _, badge in ipairs(Progression.Badges) do
        table.insert(badges, {
            Id = badge.Id,
            DisplayName = badge.DisplayName,
            Description = badge.Description,
            Earned = profile.Badges[badge.Id] ~= nil,
        })
    end

    local completed = {}

    for category, entries in pairs(profile.Completed) do
        local ids = {}

        for id in pairs(entries) do
            table.insert(ids, id)
        end

        table.sort(ids)
        completed[category] = ids
    end

    local path = {}

    for _, step in ipairs(Progression.Path) do
        table.insert(path, {
            Id = step.Id,
            Title = step.Title,
            Hint = step.Hint,
            Destination = step.Destination,
            HallUnitId = step.HallUnitId,
            Done = step.IsDone(profile),
        })
    end

    local nextStep = Progression.GetNextStep(profile)

    return {
        XP = profile.XP,
        Path = path,
        NextStep = if nextStep
            then { Id = nextStep.Id, Title = nextStep.Title, Hint = nextStep.Hint, Destination = nextStep.Destination, HallUnitId = nextStep.HallUnitId }
            else nil,
        Level = levelInfo.Level,
        XPIntoLevel = levelInfo.XPIntoLevel,
        XPForNext = levelInfo.XPForNext,
        RankTitle = Progression.GetRankTitle(levelInfo.Level),
        Badges = badges,
        Completed = completed,
        Stats = table.clone(profile.Stats),
    }
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PvpMatch</string>
            <string name="Source"><![CDATA[--!strict

-- Pure state machine for the Training Grounds PvP arena (free-for-all sparring, 2-8 players).
-- The Roblox service applies real damage through the battle tools and reports knockouts and
-- timeouts here; this module decides rounds, match winners, and rematches. It is unit tested
-- with two and more players.

local PvpMatch = {}

export type Config = {
    MinPlayers: number,
    MaxPlayers: number,
    RoundsToWin: number,
    RoundSeconds: number,
}

export type Match = {
    Config: Config,
    Players: { number },
    Alive: { [number]: boolean },
    Wins: { [number]: number },
    Knockouts: { [number]: number },
    Phase: string, -- "Waiting", "Round", "Intermission", "Over"
    Round: number,
    RoundWinner: number?,
    MatchWinner: number?,
    Rematch: { [number]: boolean },
}

PvpMatch.DefaultConfig = table.freeze({
    MinPlayers = 2,
    MaxPlayers = 8,
    RoundsToWin = 3,
    RoundSeconds = 90,
})

function PvpMatch.New(config: Config?): Match
    return {
        Config = config or PvpMatch.DefaultConfig,
        Players = {},
        Alive = {},
        Wins = {},
        Knockouts = {},
        Phase = "Waiting",
        Round = 0,
        RoundWinner = nil,
        MatchWinner = nil,
        Rematch = {},
    }
end

function PvpMatch.Has(match: Match, id: number): boolean
    return table.find(match.Players, id) ~= nil
end

-- Players can only join between rounds, so nobody drops into a fight halfway.
function PvpMatch.AddPlayer(match: Match, id: number): boolean
    if PvpMatch.Has(match, id) or #match.Players >= match.Config.MaxPlayers or match.Phase == "Round" then
        return false
    end

    table.insert(match.Players, id)
    match.Wins[id] = match.Wins[id] or 0
    match.Knockouts[id] = match.Knockouts[id] or 0

    return true
end

local function aliveList(match: Match): { number }
    local list = {}

    for _, id in ipairs(match.Players) do
        if match.Alive[id] then
            table.insert(list, id)
        end
    end

    return list
end

local function finishRound(match: Match, winner: number?)
    match.RoundWinner = winner
    match.Alive = {}

    if winner then
        match.Wins[winner] = (match.Wins[winner] or 0) + 1

        if match.Wins[winner] >= match.Config.RoundsToWin then
            match.Phase = "Over"
            match.MatchWinner = winner
            return
        end
    end

    match.Phase = if #match.Players >= match.Config.MinPlayers then "Intermission" else "Waiting"
end

-- After a removal mid-round, the last player standing wins it.
local function checkRoundEnd(match: Match)
    if match.Phase ~= "Round" then
        return
    end

    local alive = aliveList(match)

    if #alive <= 1 then
        finishRound(match, alive[1])
    end
end

function PvpMatch.RemovePlayer(match: Match, id: number)
    local index = table.find(match.Players, id)

    if not index then
        return
    end

    table.remove(match.Players, index)
    match.Alive[id] = nil
    match.Rematch[id] = nil
    checkRoundEnd(match)

    if match.Phase ~= "Round" and match.Phase ~= "Over" and #match.Players < match.Config.MinPlayers then
        match.Phase = "Waiting"
    end
end

function PvpMatch.CanStartRound(match: Match): boolean
    return (match.Phase == "Waiting" or match.Phase == "Intermission") and #match.Players >= match.Config.MinPlayers
end

function PvpMatch.StartRound(match: Match): boolean
    if not PvpMatch.CanStartRound(match) then
        return false
    end

    match.Phase = "Round"
    match.Round += 1
    match.RoundWinner = nil
    match.Alive = {}

    for _, id in ipairs(match.Players) do
        match.Alive[id] = true
    end

    return true
end

-- A player was knocked out. `attacker` gets the knockout if they are another living fighter.
function PvpMatch.Knockout(match: Match, target: number, attacker: number?): boolean
    if match.Phase ~= "Round" or not match.Alive[target] then
        return false
    end

    match.Alive[target] = nil

    if attacker and attacker ~= target and PvpMatch.Has(match, attacker) then
        match.Knockouts[attacker] = (match.Knockouts[attacker] or 0) + 1
    end

    checkRoundEnd(match)

    return true
end

-- Time ran out: the living player with the most health wins the round; a tie is a draw.
function PvpMatch.Timeout(match: Match, healthById: { [number]: number })
    if match.Phase ~= "Round" then
        return
    end

    local best, bestHealth, tie = nil, -1, false

    for _, id in ipairs(aliveList(match)) do
        local health = healthById[id] or 0

        if health > bestHealth then
            best, bestHealth, tie = id, health, false
        elseif health == bestHealth then
            tie = true
        end
    end

    finishRound(match, if tie then nil else best)
end

-- Once the match is over, every remaining player must vote to play again (at least the
-- minimum). Returns true when the rematch begins: scores reset and the next round can start.
function PvpMatch.VoteRematch(match: Match, id: number): boolean
    if match.Phase ~= "Over" or not PvpMatch.Has(match, id) then
        return false
    end

    match.Rematch[id] = true

    for _, playerId in ipairs(match.Players) do
        if not match.Rematch[playerId] then
            return false
        end
    end

    if #match.Players < match.Config.MinPlayers then
        return false
    end

    for _, playerId in ipairs(match.Players) do
        match.Wins[playerId] = 0
        match.Knockouts[playerId] = 0
    end

    match.Rematch = {}
    match.Round = 0
    match.MatchWinner = nil
    match.RoundWinner = nil
    match.Phase = "Intermission"

    return true
end

function PvpMatch.Snapshot(match: Match)
    local rows = {}

    for _, id in ipairs(match.Players) do
        table.insert(rows, {
            UserId = id,
            Wins = match.Wins[id] or 0,
            Knockouts = match.Knockouts[id] or 0,
            Alive = match.Alive[id] == true,
            Rematch = match.Rematch[id] == true,
        })
    end

    return {
        Phase = match.Phase,
        Round = match.Round,
        RoundsToWin = match.Config.RoundsToWin,
        RoundWinner = match.RoundWinner,
        MatchWinner = match.MatchWinner,
        Players = rows,
    }
end

return PvpMatch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Retention</string>
            <string name="Source"><![CDATA[--!strict

-- Pure retention bookkeeping, kept apart from the DataStore code so it can be unit tested.
-- Days are whole UTC days (os.time() // 86400). A player counts as returning when they join
-- on a different day from their last join; D1/D7/D30 count returns exactly that many days
-- after their first visit.

local Retention = {}

function Retention.Fields(firstDay: number?, lastDay: number?, day: number): { [string]: number }
    local fields: { [string]: number } = { Joins = 1 }

    if firstDay == nil then
        fields.NewPlayers = 1
        return fields
    end

    if lastDay ~= day then
        fields.ReturningPlayers = 1

        if day - firstDay == 1 then
            fields.D1Returns = 1
        elseif day - firstDay == 7 then
            fields.D7Returns = 1
        elseif day - firstDay == 30 then
            fields.D30Returns = 1
        end
    end

    return fields
end

return Retention
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
