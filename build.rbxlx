dialogueSpeaker.TextColor3 = Color3.fromRGB(160, 194, 164)
dialogueSpeaker.TextSize = 15
dialogueSpeaker.TextXAlignment = Enum.TextXAlignment.Left
dialogueSpeaker.Parent = dialogueFrame

local dialogueBody = Instance.new("TextLabel")
dialogueBody.BackgroundTransparency = 1
dialogueBody.Position = UDim2.fromOffset(20, 66)
dialogueBody.Size = UDim2.new(1, -40, 1, -86)
dialogueBody.Font = Enum.Font.Gotham
dialogueBody.Text = ""
dialogueBody.TextColor3 = Color3.fromRGB(240, 236, 226)
dialogueBody.TextSize = 19
dialogueBody.TextWrapped = true
dialogueBody.TextXAlignment = Enum.TextXAlignment.Left
dialogueBody.TextYAlignment = Enum.TextYAlignment.Top
dialogueBody.Parent = dialogueFrame

local dialogueToken = 0
local MIN_LINE_DURATION_SECONDS = 2.7
local MAX_LINE_DURATION_SECONDS = 7.2
local REFERENCE_SPEAKER_COLOR = Color3.fromRGB(215, 189, 126)
local DEFAULT_SPEAKER_COLOR = Color3.fromRGB(160, 194, 164)

local function normalizeDialogueLine(rawLine)
    if typeof(rawLine) == "table" then
        return rawLine.Speaker or "", rawLine.Text or ""
    end

    return "", tostring(rawLine)
end

local function getLineDuration(body: string): number
    local characters = string.len(body)
    return math.clamp(2.1 + characters * 0.028, MIN_LINE_DURATION_SECONDS, MAX_LINE_DURATION_SECONDS)
end

showStoryDialogue.OnClientEvent:Connect(function(payload)
    dialogueToken += 1
    local currentToken = dialogueToken
    local lines = payload.Lines or {}

    dialogueFrame.Visible = true
    dialogueTitle.Text = payload.Title or payload.StoryName or "Story"

    for _, rawLine in ipairs(lines) do
        if currentToken ~= dialogueToken then
            return
        end

        local speaker, body = normalizeDialogueLine(rawLine)
        dialogueSpeaker.Text = speaker
        dialogueSpeaker.TextColor3 = string.find(string.lower(speaker), "reference", 1, true) and REFERENCE_SPEAKER_COLOR or DEFAULT_SPEAKER_COLOR
        dialogueBody.Text = body
        task.wait(getLineDuration(body))
    end

    if currentToken == dialogueToken then
        dialogueFrame.Visible = false
    end
end)

updateStoryMission.OnClientEvent:Connect(function(payload)
    missionFrame.Visible = true
    storyNameLabel.Text = payload.StoryName or ""
    stepLabel.Text = payload.StepLabel or ""
    objectiveLabel.Text = payload.Objective or ""
    locationLabel.Text = payload.LocationName or ""
end)

clearStoryMission.OnClientEvent:Connect(function()
    missionFrame.Visible = false
    dialogueFrame.Visible = false
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="93">
        <Properties>
          <string name="Name">StudyCircleHud</string>
          <string name="Source"><![CDATA[--!strict

-- Shows the shared study circle quiz: gathering countdown, each question, the group's result
-- for it, and the final pass or fail for the whole circle.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local learningFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Learning")
local circleUpdate = learningFolder:WaitForChild("StudyCircleUpdate") :: RemoteEvent
local circleAnswer = learningFolder:WaitForChild("StudyCircleAnswer") :: RemoteEvent

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local COLORS = {
    Panel = Color3.fromRGB(246, 238, 218),
    Ink = Color3.fromRGB(42, 38, 30),
    SoftInk = Color3.fromRGB(88, 78, 62),
    Option = Color3.fromRGB(63, 98, 88),
    Selected = Color3.fromRGB(176, 140, 62),
    Correct = Color3.fromRGB(63, 120, 78),
    Wrong = Color3.fromRGB(150, 74, 60),
    Muted = Color3.fromRGB(150, 142, 126),
    Light = Color3.fromRGB(250, 246, 234),
}

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "StudyCircleHud"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 29
screenGui.Parent = playerGui

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 20)
panel.Size = UDim2.new(0.9, 0, 0, 330)
panel.BackgroundColor3 = COLORS.Panel
panel.Visible = false
panel.Parent = screenGui

local sizeLimit = Instance.new("UISizeConstraint")
sizeLimit.MaxSize = Vector2.new(620, 330)
sizeLimit.Parent = panel

local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 16)
panelCorner.Parent = panel

local panelStroke = Instance.new("UIStroke")
panelStroke.Color = Color3.fromRGB(101, 83, 55)
panelStroke.Thickness = 2
panelStroke.Parent = panel

local function makeLabel(position: UDim2, size: UDim2, textSize: number, font: Enum.Font, color: Color3): TextLabel
    local textLabel = Instance.new("TextLabel")
    textLabel.BackgroundTransparency = 1
    textLabel.Position = position
    textLabel.Size = size
    textLabel.Font = font
    textLabel.Text = ""
    textLabel.TextColor3 = color
    textLabel.TextSize = textSize
    textLabel.TextWrapped = true
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.TextYAlignment = Enum.TextYAlignment.Top
    textLabel.Parent = panel

    return textLabel
end

local titleLabel = makeLabel(UDim2.fromOffset(18, 14), UDim2.new(1, -36, 0, 26), 20, Enum.Font.GothamBold, COLORS.Ink)
local metaLabel = makeLabel(UDim2.fromOffset(18, 42), UDim2.new(1, -36, 0, 20), 14, Enum.Font.GothamMedium, COLORS.SoftInk)
local bodyLabel = makeLabel(UDim2.fromOffset(18, 68), UDim2.new(1, -36, 0, 62), 18, Enum.Font.GothamBold, COLORS.Ink)
local footerLabel = makeLabel(UDim2.new(0, 18, 1, -48), UDim2.new(1, -36, 0, 40), 14, Enum.Font.Gotham, COLORS.SoftInk)

local optionsFrame = Instance.new("Frame")
optionsFrame.BackgroundTransparency = 1
optionsFrame.Position = UDim2.fromOffset(18, 136)
optionsFrame.Size = UDim2.new(1, -36, 0, 140)
optionsFrame.Parent = panel

local optionsLayout = Instance.new("UIGridLayout")
optionsLayout.CellPadding = UDim2.fromOffset(10, 10)
optionsLayout.CellSize = UDim2.new(0.5, -5, 0, 62)
optionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
optionsLayout.Parent = optionsFrame

local optionButtons: { TextButton } = {}
local currentQuestion = 0
local selectedIndex: number? = nil
local hideToken = 0

for index = 1, 4 do
    local optionButton = Instance.new("TextButton")
    optionButton.AutoButtonColor = true
    optionButton.BackgroundColor3 = COLORS.Option
    optionButton.BorderSizePixel = 0
    optionButton.Font = Enum.Font.GothamBold
    optionButton.LayoutOrder = index
    optionButton.Text = ""
    optionButton.TextColor3 = COLORS.Light
    optionButton.TextSize = 15
    optionButton.TextWrapped = true
    optionButton.Visible = false
    optionButton.Parent = optionsFrame

    local optionCorner = Instance.new("UICorner")
    optionCorner.CornerRadius = UDim.new(0, 8)
    optionCorner.Parent = optionButton

    optionButton.Activated:Connect(function()
        if selectedIndex ~= nil or currentQuestion == 0 then
            return
        end

        selectedIndex = index

        for otherIndex, other in ipairs(optionButtons) do
            other.BackgroundColor3 = if otherIndex == index then COLORS.Selected else COLORS.Muted
        end

        footerLabel.Text = "Answer locked in. Waiting for the rest of the circle..."
        circleAnswer:FireServer(currentQuestion, index)
    end)

    optionButtons[index] = optionButton
end

local function showOptions(options: { string }?)
    for index, optionButton in ipairs(optionButtons) do
        local text = options and options[index]
        optionButton.Visible = text ~= nil
        optionButton.Text = text or ""
        optionButton.BackgroundColor3 = COLORS.Option
    end
end

local function hideLater(seconds: number)
    hideToken += 1
    local token = hideToken

    task.delay(seconds, function()
        if token == hideToken then
            panel.Visible = false
        end
    end)
end

local function show()
    hideToken += 1
    panel.Visible = true
end

circleUpdate.OnClientEvent:Connect(function(payload: any)
    if type(payload) ~= "table" then
        return
    end

    local phase = payload.Phase

    if phase == "notice" then
        show()
        titleLabel.Text = "Study Circle"
        metaLabel.Text = ""
        bodyLabel.Text = tostring(payload.Text or "")
        footerLabel.Text = ""
        showOptions(nil)
        hideLater(4)
    elseif phase == "gathering" then
        show()
        currentQuestion = 0
        titleLabel.Text = "Study Circle Gathering"
        metaLabel.Text = string.format("Starting in %d seconds", payload.Seconds or 0)
        bodyLabel.Text = tostring(payload.Text or "")
        footerLabel.Text = "Answer together. The whole circle passes or fails as a group."
        showOptions(nil)
    elseif phase == "question" then
        show()
        currentQuestion = payload.Index
        selectedIndex = nil
        titleLabel.Text = string.format("Study Circle: %s", tostring(payload.LessonName))
        metaLabel.Text = string.format("Question %d of %d  ·  %d in the circle  ·  %d seconds", payload.Index, payload.Total, payload.Participants or 1, payload.TimeLimit or 0)
        bodyLabel.Text = tostring(payload.Prompt)
        footerLabel.Text = "Choose an answer. Talk it through with your circle in chat!"
        showOptions(payload.Options)
    elseif phase == "reveal" then
        show()
        currentQuestion = 0

        for index, optionButton in ipairs(optionButtons) do
            if index == payload.CorrectIndex then
                optionButton.BackgroundColor3 = COLORS.Correct
            elseif index == selectedIndex then
                optionButton.BackgroundColor3 = COLORS.Wrong
            else
                optionButton.BackgroundColor3 = COLORS.Muted
            end
        end

        footerLabel.Text = string.format("%d of %d answered correctly. %s", payload.CorrectCount or 0, payload.Participants or 1, tostring(payload.Explanation or ""))
    elseif phase == "finished" then
        show()
        currentQuestion = 0
        titleLabel.Text = if payload.Passed then "Study circle passed!" else "Study circle complete"
        metaLabel.Text = string.format("%s  ·  The circle scored %d%%", tostring(payload.LessonName), payload.Percent or 0)

        if payload.Passed then
            bodyLabel.Text = string.format("Everyone in the circle earns %d XP.", payload.XP or 0)
        else
            bodyLabel.Text = "Review the lesson in the Islamic Studies hall and try another circle together."
        end

        footerLabel.Text = if payload.IsGroup then "" else "Study with at least one other player to earn the Halaqah Member badge."
        showOptions(nil)
        hideLater(7)
    end
end)

-- Joining a battle or story removes the player from the circle, so close the panel too.
local function hideIfBusy()
    if player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true then
        currentQuestion = 0
        panel.Visible = false
    end
end

player:GetAttributeChangedSignal("InBattle"):Connect(hideIfBusy)
player:GetAttributeChangedSignal("InStory"):Connect(hideIfBusy)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="94">
        <Properties>
          <string name="Name">TawafAmbience</string>
          <string name="Source"><![CDATA[--!strict

-- Walks the pilgrim figures built by MasjidAlHaram around the Kaaba, anticlockwise as in
-- tawaf. Movement is local to each client (the server only places them), so it costs no
-- network traffic, and it pauses when the player is far from the mataf.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local FOLDER_NAME = "TawafPilgrims"
local ACTIVE_DISTANCE = 700
local UPDATE_INTERVAL = 1 / 30

type Pilgrim = {
    Parts: { BasePart },
    Offsets: { CFrame },
    Radius: number,
    StartAngle: number,
    AngularSpeed: number,
    Phase: number,
}

local player = Players.LocalPlayer

local function numberAttribute(instance: Instance, name: string, fallback: number): number
    local value = instance:GetAttribute(name)
    return if type(value) == "number" then value else fallback
end

local function findFolder(): Instance?
    local hub = Workspace:WaitForChild("GeneratedHub", 60)
    if not hub then
        return nil
    end

    for _ = 1, 120 do
        local folder = hub:FindFirstChild(FOLDER_NAME, true)
        if folder then
            return folder
        end
        task.wait(0.5)
    end

    return nil
end

local folder = findFolder()
if not folder then
    return
end

local centerValue = folder:GetAttribute("Center")
local center: Vector3 = if typeof(centerValue) == "Vector3" then centerValue else Vector3.zero
local floorY = numberAttribute(folder, "FloorY", center.Y)

local pilgrims: { Pilgrim } = {}
local allParts: { BasePart } = {}

for _, figure in ipairs(folder:GetChildren()) do
    local entry: Pilgrim = {
        Parts = {},
        Offsets = {},
        Radius = numberAttribute(figure, "Radius", 100),
        StartAngle = numberAttribute(figure, "StartAngle", 0),
        AngularSpeed = numberAttribute(figure, "AngularSpeed", 0.04),
        Phase = numberAttribute(figure, "Phase", 0),
    }

    for _, piece in ipairs(figure:GetChildren()) do
        local offset = piece:GetAttribute("Offset")
        if piece:IsA("BasePart") and typeof(offset) == "CFrame" then
            table.insert(entry.Parts, piece)
            table.insert(entry.Offsets, offset)
        end
    end

    if #entry.Parts > 0 then
        table.insert(pilgrims, entry)
    end
end

local function nearMataf(): boolean
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then
        return (root.Position - center).Magnitude < ACTIVE_DISTANCE
    end
    return false
end

local elapsed = 0
local startClock = os.clock()

RunService.Heartbeat:Connect(function(dt: number)
    elapsed += dt
    if elapsed < UPDATE_INTERVAL then
        return
    end
    elapsed = 0

    if not nearMataf() then
        return
    end

    local t = os.clock() - startClock
    local targets: { CFrame } = {}
    local parts = allParts
    table.clear(parts)

    for _, pilgrim in ipairs(pilgrims) do
        -- Decreasing angle with +Z north and +X west reads as anticlockwise from above.
        local angle = pilgrim.StartAngle - pilgrim.AngularSpeed * t
        local stride = t * pilgrim.AngularSpeed * pilgrim.Radius * 1.6 + pilgrim.Phase
        local bob = math.abs(math.sin(stride)) * 0.18
        local position = center + Vector3.new(math.cos(angle) * pilgrim.Radius, 0, math.sin(angle) * pilgrim.Radius)
        position = Vector3.new(position.X, floorY + bob, position.Z)
        local heading = Vector3.new(math.sin(angle), 0, -math.cos(angle))
        local root = CFrame.lookAt(position, position + heading)
        local swing = math.sin(stride) * 0.35

        for index, piece in ipairs(pilgrim.Parts) do
            local offset = pilgrim.Offsets[index]
            if piece.Name == "ArmLeft" then
                offset = offset * CFrame.new(0, 0.9, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -0.9, 0)
            elseif piece.Name == "ArmRight" then
                offset = offset * CFrame.new(0, 0.9, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -0.9, 0)
            end
            table.insert(parts, piece)
            table.insert(targets, root * offset)
        end
    end

    Workspace:BulkMoveTo(parts, targets, Enum.BulkMoveMode.FireCFrameChanged)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="95">
        <Properties>
          <string name="Name">TriviaHud</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local triviaFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Trivia")
local submitTriviaAnswer = triviaFolder:WaitForChild("SubmitTriviaAnswer") :: RemoteEvent
local showTriviaQuestion = triviaFolder:WaitForChild("ShowTriviaQuestion") :: RemoteEvent
local showTriviaResult = triviaFolder:WaitForChild("ShowTriviaResult") :: RemoteEvent
local updateTriviaScores = triviaFolder:WaitForChild("UpdateTriviaScores") :: RemoteEvent
local clearTrivia = triviaFolder:WaitForChild("ClearTrivia") :: RemoteEvent

local selectedThisRound = false
local questionEndsAt = 0
local answerButtons: { TextButton } = {}
local scoreRows: { TextLabel } = {}

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TriviaHud"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 28
screenGui.Parent = playerGui

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 20)
panel.Size = UDim2.fromOffset(660, 408)
panel.BackgroundColor3 = Color3.fromRGB(245, 239, 224)
panel.Visible = false
panel.Parent = screenGui

local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 8)
panelCorner.Parent = panel

local panelStroke = Instance.new("UIStroke")
panelStroke.Color = Color3.fromRGB(75, 67, 51)
panelStroke.Thickness = 2
panelStroke.Parent = panel

local titleLabel = Instance.new("TextLabel")
titleLabel.BackgroundTransparency = 1
titleLabel.Position = UDim2.fromOffset(18, 14)
titleLabel.Size = UDim2.new(1, -36, 0, 30)
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Text = "Islamic Trivia Challenge"
titleLabel.TextColor3 = Color3.fromRGB(38, 35, 28)
titleLabel.TextSize = 23
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Parent = panel

local metaLabel = Instance.new("TextLabel")
metaLabel.BackgroundTransparency = 1
metaLabel.Position = UDim2.fromOffset(18, 48)
metaLabel.Size = UDim2.new(1, -36, 0, 24)
metaLabel.Font = Enum.Font.GothamMedium
metaLabel.Text = "Round 1"
metaLabel.TextColor3 = Color3.fromRGB(93, 80, 54)
metaLabel.TextSize = 14
metaLabel.TextXAlignment = Enum.TextXAlignment.Left
metaLabel.Parent = panel

local timerLabel = Instance.new("TextLabel")
timerLabel.AnchorPoint = Vector2.new(1, 0)
timerLabel.BackgroundTransparency = 1
timerLabel.Position = UDim2.new(1, -18, 0, 48)
timerLabel.Size = UDim2.fromOffset(120, 24)
timerLabel.Font = Enum.Font.GothamBold
timerLabel.Text = ""
timerLabel.TextColor3 = Color3.fromRGB(87, 99, 67)
timerLabel.TextSize = 14
timerLabel.TextXAlignment = Enum.TextXAlignment.Right
timerLabel.Parent = panel

local questionLabel = Instance.new("TextLabel")
questionLabel.BackgroundTransparency = 1
questionLabel.Position = UDim2.fromOffset(18, 82)
questionLabel.Size = UDim2.new(1, -36, 0, 74)
questionLabel.Font = Enum.Font.GothamBold
questionLabel.Text = ""
questionLabel.TextColor3 = Color3.fromRGB(43, 39, 31)
questionLabel.TextSize = 20
questionLabel.TextWrapped = true
questionLabel.TextXAlignment = Enum.TextXAlignment.Left
questionLabel.TextYAlignment = Enum.TextYAlignment.Top
questionLabel.Parent = panel

local answersFrame = Instance.new("Frame")
answersFrame.BackgroundTransparency = 1
answersFrame.Position = UDim2.fromOffset(18, 166)
answersFrame.Size = UDim2.new(0.62, -22, 0, 208)
answersFrame.Parent = panel

local answerLayout = Instance.new("UIListLayout")
answerLayout.Padding = UDim.new(0, 8)
answerLayout.Parent = answersFrame

local scoreboardFrame = Instance.new("Frame")
scoreboardFrame.Position = UDim2.new(0.62, 6, 0, 166)
scoreboardFrame.Size = UDim2.new(0.38, -24, 0, 208)
scoreboardFrame.BackgroundColor3 = Color3.fromRGB(232, 225, 209)
scoreboardFrame.Parent = panel

local scoreboardCorner = Instance.new("UICorner")
scoreboardCorner.CornerRadius = UDim.new(0, 8)
scoreboardCorner.Parent = scoreboardFrame

local scoreboardTitle = Instance.new("TextLabel")
scoreboardTitle.BackgroundTransparency = 1
scoreboardTitle.Position = UDim2.fromOffset(12, 10)
scoreboardTitle.Size = UDim2.new(1, -24, 0, 22)
scoreboardTitle.Font = Enum.Font.GothamBold
scoreboardTitle.Text = "Leaderboard"
scoreboardTitle.TextColor3 = Color3.fromRGB(46, 42, 34)
scoreboardTitle.TextSize = 15
scoreboardTitle.TextXAlignment = Enum.TextXAlignment.Left
scoreboardTitle.Parent = scoreboardFrame

local feedbackLabel = Instance.new("TextLabel")
feedbackLabel.BackgroundTransparency = 1
feedbackLabel.Position = UDim2.fromOffset(18, 372)
feedbackLabel.Size = UDim2.new(1, -36, 0, 26)
feedbackLabel.Font = Enum.Font.GothamMedium
feedbackLabel.Text = "Pick one answer before time runs out."
feedbackLabel.TextColor3 = Color3.fromRGB(66, 91, 67)
feedbackLabel.TextSize = 14
feedbackLabel.TextWrapped = true
feedbackLabel.TextXAlignment = Enum.TextXAlignment.Left
feedbackLabel.Parent = panel

local function setAnswerButtonsEnabled(enabled: boolean)
    for _, button in ipairs(answerButtons) do
        button.Active = enabled
        button.AutoButtonColor = enabled
        button.BackgroundTransparency = enabled and 0 or 0.18
    end
end

local function clearAnswers()
    for _, button in ipairs(answerButtons) do
        button:Destroy()
    end

    answerButtons = {}
end

local function buildAnswerButton(optionText: string, index: number)
    local button = Instance.new("TextButton")
    button.Name = string.format("Answer_%d", index)
    button.Size = UDim2.new(1, 0, 0, 46)
    button.BackgroundColor3 = Color3.fromRGB(76, 96, 73)
    button.Font = Enum.Font.GothamBold
    button.Text = string.format("%d. %s", index, optionText)
    button.TextColor3 = Color3.fromRGB(250, 246, 234)
    button.TextSize = 15
    button.TextWrapped = true
    button.Parent = answersFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button

    button.Activated:Connect(function()
        if selectedThisRound then
            return
        end

        selectedThisRound = true
        feedbackLabel.Text = "Answer sent. Waiting for the round result."
        setAnswerButtonsEnabled(false)
        submitTriviaAnswer:FireServer(index)
    end)

    table.insert(answerButtons, button)
end

local function updateScoreboard(rows)
    for _, row in ipairs(scoreRows) do
        row:Destroy()
    end

    scoreRows = {}

    for index = 1, 5 do
        local rowData = rows and rows[index]
        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Position = UDim2.fromOffset(12, 36 + (index - 1) * 31)
        label.Size = UDim2.new(1, -24, 0, 28)
        label.Font = Enum.Font.GothamMedium
        label.TextColor3 = Color3.fromRGB(55, 49, 38)
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = rowData and string.format("%d. %s - %d", index, rowData.PlayerName, rowData.Score) or string.format("%d. Waiting...", index)
        label.Parent = scoreboardFrame
        table.insert(scoreRows, label)
    end
end

showTriviaQuestion.OnClientEvent:Connect(function(payload)
    panel.Visible = true
    selectedThisRound = false
    questionEndsAt = os.clock() + (payload.TimeLimit or 16)
    titleLabel.Text = payload.DisplayName or "Islamic Trivia Challenge"
    metaLabel.Text = string.format("Round %d of %d | Difficulty %d", payload.Round or 1, payload.TotalRounds or 1, payload.Difficulty or 1)
    questionLabel.Text = payload.Prompt or ""
    feedbackLabel.Text = "Pick one answer before time runs out."
    clearAnswers()

    for index, optionText in ipairs(payload.Options or {}) do
        buildAnswerButton(optionText, index)
    end
end)

showTriviaResult.OnClientEvent:Connect(function(payload)
    panel.Visible = true

    if payload.Personal then
        feedbackLabel.Text = payload.Correct and "Correct. Nice streak." or string.format("Not this time. Correct answer: %s", payload.CorrectText or "")
    else
        feedbackLabel.Text = string.format("Correct answer: %s. %s", payload.CorrectText or "", payload.Explanation or "")
        setAnswerButtonsEnabled(false)
    end

    if payload.Scoreboard then
        updateScoreboard(payload.Scoreboard)
    end
end)

updateTriviaScores.OnClientEvent:Connect(function(payload)
    if payload.Scoreboard then
        updateScoreboard(payload.Scoreboard)
    end
end)

clearTrivia.OnClientEvent:Connect(function(payload)
    panel.Visible = true
    selectedThisRound = true
    questionEndsAt = 0
    clearAnswers()
    titleLabel.Text = "Trivia Complete"
    metaLabel.Text = "Final scoreboard"
    timerLabel.Text = ""
    questionLabel.Text = payload.Message or "Trivia finished."
    feedbackLabel.Text = "Start again from the trivia court or the menu."

    if payload.Scoreboard then
        updateScoreboard(payload.Scoreboard)
    end
end)

RunService.RenderStepped:Connect(function()
    if not panel.Visible or questionEndsAt <= 0 then
        return
    end

    local remaining = math.max(0, math.ceil(questionEndsAt - os.clock()))
    timerLabel.Text = string.format("%ds", remaining)

    if remaining <= 0 and not selectedThisRound then
        selectedThisRound = true
        feedbackLabel.Text = "Time is up. Waiting for the answer."
        setAnswerButtonsEnabled(false)
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">UiKit</string>
          <string name="Source"><![CDATA[--!strict

-- Small helpers shared by the Journeys book and HUD: consistent colours, rounded frames,
-- labels and buttons that work with mouse, touch, and gamepad.

local UiKit = {}

UiKit.Colors = {
    Panel = Color3.fromRGB(28, 34, 30),
    PanelLight = Color3.fromRGB(44, 52, 46),
    Text = Color3.fromRGB(246, 240, 224),
    Muted = Color3.fromRGB(196, 190, 172),
    Gold = Color3.fromRGB(226, 186, 96),
    Green = Color3.fromRGB(73, 112, 74),
    Red = Color3.fromRGB(150, 70, 60),
    Blue = Color3.fromRGB(62, 96, 128),
    Purple = Color3.fromRGB(96, 76, 112),
}

function UiKit.Round(instance: GuiObject, radius: number?)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 10)
    corner.Parent = instance
end

function UiKit.Frame(parent: Instance, name: string, size: UDim2, position: UDim2, anchor: Vector2?, color: Color3?): Frame
    local frame = Instance.new("Frame")
    frame.Name = name
    frame.Size = size
    frame.Position = position
    frame.AnchorPoint = anchor or Vector2.zero
    frame.BackgroundColor3 = color or UiKit.Colors.Panel
    frame.BackgroundTransparency = 0.06
    frame.BorderSizePixel = 0
    frame.Parent = parent
    UiKit.Round(frame, 12)

    local stroke = Instance.new("UIStroke")
    stroke.Color = UiKit.Colors.Gold
    stroke.Transparency = 0.55
    stroke.Thickness = 1
    stroke.Parent = frame

    return frame
end

function UiKit.Label(parent: Instance, text: string, size: UDim2, position: UDim2, textSize: number?, bold: boolean?, color: Color3?): TextLabel
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = size
    label.Position = position
    label.Font = if bold then Enum.Font.GothamBold else Enum.Font.Gotham
    label.Text = text
    label.TextColor3 = color or UiKit.Colors.Text
    label.TextSize = textSize or 16
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.RichText = true
    label.Parent = parent

    return label
end

-- A label that grows to fit its text inside a list layout.
function UiKit.Paragraph(parent: Instance, text: string, textSize: number?, bold: boolean?, color: Color3?): TextLabel
    local label = UiKit.Label(parent, text, UDim2.new(1, -8, 0, 0), UDim2.new(), textSize, bold, color)
    label.AutomaticSize = Enum.AutomaticSize.Y

    return label
end

function UiKit.Button(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3?, onClick: () -> ()): TextButton
    local button = Instance.new("TextButton")
    button.Size = size
    button.Position = position
    button.BackgroundColor3 = color or UiKit.Colors.Green
    button.AutoButtonColor = true
    button.Font = Enum.Font.GothamBold
    button.Text = text
    button.TextColor3 = UiKit.Colors.Text
    button.TextSize = 15
    button.TextWrapped = true
    button.Selectable = true
    button.Parent = parent
    UiKit.Round(button, 8)

    local last = 0

    button.Activated:Connect(function()
        local now = os.clock()

        if now - last < 0.25 then
            return
        end

        last = now
        onClick()
    end)

    return button
end

function UiKit.Clear(container: Instance)
    for _, child in ipairs(container:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UIGridLayout") then
            child:Destroy()
        end
    end
end

function UiKit.Scroller(parent: Instance, size: UDim2, position: UDim2): ScrollingFrame
    local scroller = Instance.new("ScrollingFrame")
    scroller.BackgroundTransparency = 1
    scroller.BorderSizePixel = 0
    scroller.Size = size
    scroller.Position = position
    scroller.CanvasSize = UDim2.new()
    scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroller.ScrollBarThickness = 6
    scroller.Parent = parent

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scroller

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 6)
    padding.PaddingRight = UDim.new(0, 10)
    padding.PaddingTop = UDim.new(0, 4)
    padding.Parent = scroller

    return scroller
end

-- A full-width row with a title, a description, and up to two buttons on the right.
function UiKit.Row(parent: Instance, order: number, title: string, body: string, buttons: { { Text: string, Color: Color3?, OnClick: () -> () } }?): Frame
    local row = Instance.new("Frame")
    row.BackgroundColor3 = UiKit.Colors.PanelLight
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, 64)
    row.LayoutOrder = order
    row.Parent = parent
    UiKit.Round(row, 8)

    local buttonCount = if buttons then #buttons else 0
    local textWidth = -16 - buttonCount * 116
    UiKit.Label(row, title, UDim2.new(1, textWidth, 0, 22), UDim2.fromOffset(10, 6), 16, true)
    UiKit.Label(row, body, UDim2.new(1, textWidth, 0, 32), UDim2.fromOffset(10, 28), 13, false, UiKit.Colors.Muted)

    if buttons then
        for index, spec in ipairs(buttons) do
            UiKit.Button(row, spec.Text, UDim2.fromOffset(108, 40), UDim2.new(1, -(116 * (buttonCount - index + 1)), 0, 12), spec.Color, spec.OnClick)
        end
    end

    return row
end

return UiKit
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
