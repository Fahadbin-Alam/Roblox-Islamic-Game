        district,
        "DesertTravelPanel",
        center + Vector3.new(72, 0, 126),
        Vector3.new(54, 13, 2.5),
        "Desert Route",
        "Jump to the mid-route desert camp or walk the road to experience more space between Makkah and Medina.",
