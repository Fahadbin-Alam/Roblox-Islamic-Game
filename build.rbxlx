            { Name = "Sa'd ibn Mu'adh", Role = "Leader of the Aws, wounded in the siege" },
        },
        Story = {
            "An alliance of about ten thousand marched on Madinah. Salman al-Farisi suggested digging a trench, as was done in Persia, across the open northern side of the city.",
            "Everyone dug in cold and hunger, the Prophet ﷺ among them. The confederates were stopped at the trench and laid siege for about a month.",
            "The Banu Qurayzah, one of Madinah's Jewish tribes, broke their treaty during the siege. Then a fierce cold wind tore through the enemy camp and the confederates went home.",
            "Afterwards the Banu Qurayzah were besieged and judged by Sa'd ibn Mu'adh, whom they had accepted as judge. It is one of the most discussed events of the seerah; ask a teacher if you want to learn more.",
        },
        Activity = { Kind = "Collect", Item = "trench section", Count = 5 },
        Decision = {
            Prompt = "Whose idea was the trench?",
            Options = { "Umar ibn al-Khattab", "Salman al-Farisi", "Khalid ibn al-Walid", "Abu Sufyan" },
            CorrectIndex = 2,
            Explanation = "Salman knew the defence from Persia, and his advice was taken.",
        },
        Consequence = "It was the last time Quraysh marched on Madinah. The balance had shifted.",
        Lesson = "Good ideas can come from anyone. Salman was a newcomer from Persia.",
        Sources = { "Qur'an 33:9-27 (Surah al-Ahzab)", IBN_HISHAM, MUBARAKPURI },
        GameplayNote = "Fictional: digging trench sections. No fighting is shown in this chapter.",
    },
    {
        Id = "hudaybiyyah",
        Number = 25,
        Era = "Madinah",
        When = "Dhu al-Qa'dah 6 AH (628 CE)",
        Title = "The Treaty of Hudaybiyyah",
        Site = "hudaybiyyah",
        People = {
            { Name = "About 1,400 Muslims", Role = "Travelling in ihram for Umrah" },
            { Name = "Uthman ibn Affan", Role = "Sent as envoy to Quraysh" },
            { Name = "Suhayl ibn Amr", Role = "Negotiated for Quraysh" },
        },
        Story = {
            "The Prophet ﷺ set out with about 1,400 companions in ihram to perform Umrah, with no intention to fight. Quraysh blocked them at al-Hudaybiyyah.",
            "Uthman was sent to negotiate. When a rumour spread that he had been killed, the companions pledged under a tree to stand firm: the Pledge of Ridwan.",
            "Suhayl ibn Amr agreed a treaty. The Muslims would go back this year and return for Umrah the next; there would be ten years of peace; and Makkans who fled to Madinah without permission would be returned. Many companions found the terms hard.",
            "On the way home, Surah al-Fath was revealed, calling it a clear victory.",
        },
        Decision = {
            Prompt = "Why did Surah al-Fath call this treaty a clear victory?",
            Options = { "The Muslims won a battle", "The peace let people meet Islam freely and many accepted it", "Quraysh gave up Makkah", "The Muslims got rich" },
            CorrectIndex = 2,
            Explanation = "In the two years of peace, more people entered Islam than in all the years before.",
        },
        Consequence = "The truce opened Arabia to the message. When Quraysh's allies broke it, the way to Makkah was open.",
        Lesson = "Patience and peace can achieve more than force. What looks like a loss may be a victory.",
        Sources = { "Qur'an 48:1, 48:18 (Surah al-Fath)", "Sahih al-Bukhari 2731-2732", IBN_HISHAM },
        GameplayNote = "Narration and signs at the well and tree. No negotiation is acted out.",
    },
    {
        Id = "letters",
        Number = 26,
        Era = "Madinah",
        When = "About 6-7 AH (628 CE)",
        Title = "Letters to the Kings",
        Site = "letters_house",
        People = {
            { Name = "Heraclius", Role = "Emperor of Byzantium" },
            { Name = "Khosrow II", Role = "Emperor of Persia" },
            { Name = "Al-Muqawqis", Role = "Ruler of Egypt" },
            { Name = "Dihyah al-Kalbi", Role = "Carried the letter to Heraclius" },
        },
        Story = {
            "In the peace after Hudaybiyyah, letters were sent to rulers inviting them to Islam. They were sealed with a silver ring engraved \"Muhammad Rasul Allah\".",
            "Heraclius questioned Abu Sufyan, then a trader in Syria and still an opponent, about the Prophet ﷺ. Abu Sufyan admitted he had never known him to lie.",
            "Khosrow tore his letter. Al-Muqawqis replied politely and sent gifts.",
        },
        Activity = { Kind = "Collect", Item = "sealed letter", Count = 3 },
        Decision = {
            Prompt = "What did Abu Sufyan admit to Heraclius?",
            Options = { "That he had never known the Prophet ﷺ to lie", "That the Muslims were weak", "That he wanted war", "That he had become Muslim" },
            CorrectIndex = 1,
            Explanation = "Even an opponent, questioned by an emperor, could not accuse him of lying.",
        },
        Consequence = "The message reached far beyond Arabia.",
        Lesson = "Share good words with wisdom and respect, even with the powerful.",
        Sources = { "Sahih al-Bukhari 7 (Abu Sufyan before Heraclius)", IBN_HISHAM, MUBARAKPURI },
        GameplayNote = "Fictional: you seal and hand over letters. The seal wording and the conversation with Heraclius are documented.",
    },
    {
        Id = "conquest_makkah",
        Number = 27,
        Era = "Madinah",
        When = "Ramadan 8 AH (630 CE)",
        Title = "Return to Makkah",
        Site = "kaaba_old",
        People = {
            { Name = "About 10,000 Muslims", Role = "Marched to Makkah" },
            { Name = "Abu Sufyan ibn Harb", Role = "Leader of Quraysh, accepted Islam" },
            { Name = "Bilal ibn Rabah", Role = "Called the adhan from the Kaaba" },
        },
        Story = {
            "Quraysh's allies attacked a tribe allied with the Muslims, breaking the treaty of Hudaybiyyah. The Prophet ﷺ marched with about ten thousand.",
            "Abu Sufyan accepted Islam. It was announced that whoever stayed in his home, in the Kaaba's precinct, or in Abu Sufyan's house would be safe. Makkah was entered almost without fighting.",
            "The idols around the Kaaba were broken while the verse was recited: \"Truth has come and falsehood has vanished.\" Bilal, once tortured in Makkah, called the adhan from the roof of the Kaaba.",
            "The people who had persecuted the Muslims for years were forgiven and told they were free to go.",
        },
        Decision = {
            Prompt = "How were the people of Makkah treated after the conquest?",
            Options = { "They were punished for the years of persecution", "They were forgiven and set free", "They were sent away from Arabia", "They had to pay a heavy tax" },
            CorrectIndex = 2,
            Explanation = "A general amnesty was given. Mercy, not revenge, marked the return to Makkah.",
        },
        Consequence = "Makkah and most of Arabia entered Islam, and the Kaaba was again a house for the worship of Allah alone.",
        Lesson = "Forgive when you are strong. That is the mercy that changes hearts.",
        Sources = { "Qur'an 17:81", "Qur'an 110 (Surah al-Nasr)", "Sahih al-Bukhari 4287 (the idols broken)", IBN_HISHAM },
        GameplayNote = "No army or idols are shown. Players read the account at the reconstructed Kaaba.",
    },
    {
        Id = "tabuk",
        Number = 28,
        Era = "Madinah",
        When = "Rajab 9 AH (630 CE)",
        Title = "Tabuk and the Truth of Ka'b",
        Site = "tabuk_camp",
        People = {
            { Name = "Ka'b ibn Malik", Role = "A companion who stayed behind" },
            { Name = "Uthman ibn Affan", Role = "Equipped a large part of the army" },
        },
        Story = {
            "In the heat of summer an army set out for Tabuk, far to the north, to face a Byzantine threat. Uthman paid for a large part of the army's equipment.",
            "Ka'b ibn Malik kept delaying and stayed behind with no excuse. When the army returned, many hypocrites made up excuses. Ka'b told the plain truth.",
            "The Muslims stopped speaking to Ka'b and two others for fifty days, until verses were revealed accepting their repentance. Ka'b later said that honesty had saved him.",
        },
        Activity = { Kind = "Collect", Item = "water skin", Count = 4 },
        Decision = {
            Prompt = "What did Ka'b ibn Malik do when the army returned?",
            Options = { "He invented a good excuse", "He told the truth that he had no excuse", "He left Madinah", "He blamed others" },
            CorrectIndex = 2,
            Explanation = "He chose honesty though it was hard, and Allah accepted his repentance.",
        },
        Consequence = "In the following year, tribes from all over Arabia sent delegations to Madinah to accept Islam.",
        Lesson = "Tell the truth even when it costs you. Honesty leads to good.",
        Sources = { "Qur'an 9:117-119", "Sahih al-Bukhari 4418 (narrated by Ka'b ibn Malik)", IBN_HISHAM },
        GameplayNote = "Fictional: filling water skins for the march.",
    },
    {
        Id = "farewell_hajj",
        Number = 29,
        Era = "Madinah",
        When = "Dhu al-Hijjah 10 AH (632 CE)",
        Title = "The Farewell Pilgrimage",
        Site = "arafat_plain",
        People = {
            { Name = "More than 100,000 pilgrims", Role = "As commonly reported" },
        },
        Story = {
            "The Prophet ﷺ performed Hajj with a huge gathering. On the Day of Arafah he gave a sermon.",
            "He taught that lives and property are sacred, that people must be just and fear Allah in how they treat women, that the debts of usury were cancelled, and that he left them the Book of Allah, which would keep them from going astray if they held to it.",
            "In a related narration he taught that no Arab is better than a non-Arab, and no white person better than a black person, except by piety.",
            "The verse was revealed: \"This day I have perfected your religion for you.\"",
        },
        Decision = {
            Prompt = "According to the sermon, what makes one person better than another?",
            Options = { "Their tribe", "Their wealth", "Their piety (taqwa)", "Their language" },
            CorrectIndex = 3,
            Explanation = "Only piety, which Allah alone can fully judge, makes one person better than another.",
        },
        Consequence = "The sermon summed up the message: justice, equality, and holding to the Qur'an.",
        Lesson = "All people are equal before Allah. Treat everyone with justice.",
        Sources = { "Qur'an 5:3", "Sahih Muslim 1218 (narrated by Jabir)", "Musnad Ahmad (sermon of the days of Tashriq)" },
        GameplayNote = "The sermon is shown as written text only. No one speaks in the Prophet's ﷺ voice.",
    },
    {
        Id = "passing",
        Number = 30,
        Era = "Madinah",
        When = "Rabi' al-Awwal 11 AH (632 CE)",
        Title = "The Passing and the Message that Remains",
        Site = "masjid_early",
        People = {
            { Name = "Aisha bint Abi Bakr", Role = "His wife, in whose room he passed away" },
            { Name = "Abu Bakr al-Siddiq", Role = "Calmed the community and became the first caliph" },
            { Name = "Umar ibn al-Khattab", Role = "Could not at first accept the news" },
        },
        Story = {
            "After returning from Hajj the Prophet ﷺ fell ill. When he could no longer lead the prayer, he asked Abu Bakr to lead it.",
            "He passed away in the room of Aisha, at about sixty-three years of age.",
            "The companions were stunned, and Umar could not accept it. Abu Bakr said that whoever worshipped Muhammad, Muhammad has died; and whoever worships Allah, Allah is Ever-Living and never dies. Then he recited: \"Muhammad is no more than a messenger; messengers have passed away before him.\"",
            "Abu Bakr was chosen as the first caliph, and the message continued.",
        },
        Decision = {
            Prompt = "What did Abu Bakr remind the people of?",
            Options = { "That the Prophet ﷺ would return soon", "That Allah is Ever-Living and the message continues", "That they should leave Madinah", "That the Qur'an was now complete, so nothing else mattered" },
            CorrectIndex = 2,
            Explanation = "Abu Bakr steadied the community by pointing them to Allah, who never dies, and to Qur'an 3:144.",
        },
        Consequence = "The Qur'an and the Sunnah were carried by the companions to the whole world.",
        Lesson = "Our worship is for Allah alone. We honour the Prophet ﷺ by following his example.",
        Sources = { "Qur'an 3:144", "Sahih al-Bukhari, Book of the Virtues of the Companions (Abu Bakr's address)", IBN_HISHAM },
        GameplayNote = "Narration only, at the reconstructed early mosque. Nothing of his illness or passing is shown.",
    },
}

return {
    Chapters = chapters,
    -- Where a player stands to begin a chapter, in studs from the chapter's site.
    StartRadius = 30,
    -- Items for Collect activities are scattered within this radius of the site.
    CollectRadius = 70,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ShopCatalog</string>
            <string name="Source"><![CDATA[--!strict

-- Replace placeholder ProductId values after creating the real Roblox products.
local MonetizationConfig = require(script.Parent.Parent.Config.MonetizationConfig)

local ShopCatalog = {
    GamePasses = {
        {
            Key = "founder_support",
            DisplayName = "Founder Support Pack",
            ProductId = 0,
            Type = "Supporter",
            Benefit = "Founder tag, premium battle banner trim, and support recognition.",
        },
        {
            Key = "vip_courtyard",
            DisplayName = "VIP Courtyard Access",
            ProductId = 0,
            Type = "Convenience",
            Benefit = "Access to a VIP social area and extra profile flair.",
        },
        {
            Key = "desert_commander_skin",
            DisplayName = "Desert Commander Skin",
            ProductId = 0,
            Type = "Cosmetic",
