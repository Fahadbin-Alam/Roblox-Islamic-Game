            CorrectIndex = 2,
            Explanation = "She reassured him by naming his good character and sought advice from a wise relative.",
        },
        Consequence = "Khadijah became the first believer. The revelation of the Qur'an continued for about twenty-three years.",
        Lesson = "Islam begins with learning: the first word revealed was \"Read\". And a good friend comforts you with the truth.",
        Sources = { "Qur'an 96:1-5", "Sahih al-Bukhari 3 (narrated by Aisha)", IBN_HISHAM },
        GameplayNote = "Climbing the mountain is part of the game. The angel and the Prophet ﷺ are never shown: the scene is told in narration only.",
    },
    {
        Id = "first_believers",
        Number = 7,
        Era = "Makkah",
        When = "610-613 CE",
        Title = "The First Believers",
        Site = "dar_al_arqam",
        People = {
            { Name = "Ali ibn Abi Talib", Role = "His young cousin, raised in his house" },
            { Name = "Zayd ibn Harithah", Role = "Freed slave whom he raised as a son" },
