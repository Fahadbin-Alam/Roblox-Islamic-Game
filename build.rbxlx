                AllyPoint = "Line",
                Narration = {
                    Title = "Rain Before The Battle",
                    Body = "Allah sent rest over the believers and rain from the sky to purify them and make their footing firm.",
                    Reference = "Qur'an 8:11",
                },
            },
            {
                Id = "line",
                Type = "Defend",
                Title = "Hold The Line",
