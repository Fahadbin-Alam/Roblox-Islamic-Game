            { Name = "Al-Arqam ibn Abi al-Arqam", Role = "Opened his house to the believers" },
        },
        Story = {
            "For about three years the call to Islam was quiet and personal. After Khadijah, among the first to believe were Ali ibn Abi Talib, Zayd ibn Harithah, and Abu Bakr.",
            "Abu Bakr spoke to his friends, and Uthman ibn Affan, al-Zubayr ibn al-Awwam, Abd al-Rahman ibn Awf, Sa'd ibn Abi Waqqas, and Talhah ibn Ubaydullah accepted Islam.",
            "The believers met in the house of al-Arqam near Safa to learn the Qur'an and pray away from hostile eyes.",
        },
        Activity = { Kind = "Collect", Item = "oil lamp", Count = 3 },
        Decision = {
