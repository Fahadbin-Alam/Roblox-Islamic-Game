                            Prompt = "What did the Prophet choose at Hudaybiyyah?",
                            Options = { "A battle", "A peace treaty", "Going home angry", "Breaking the Kaaba's door" },
                            CorrectIndex = 2,
                            Explanation = "He agreed to a treaty of peace.",
                        },
                        {
                            Prompt = "What did the Qur'an call the treaty?",
                            Options = { "A defeat", "A clear victory", "A mistake", "A delay" },
                            CorrectIndex = 2,
                            Explanation = "Qur'an 48:1: We have given you a clear victory.",
                        },
                    },
                },
                {
                    Id = "seerah_conquest_makkah",
                    DisplayName = "The Return To Makkah",
                    Summary = "Forgiveness at the moment of victory.",
                    Pages = {
                        "In 8 AH, after the Quraysh broke the treaty, the Prophet, peace be upon him, returned to Makkah with a large army. The city opened with almost no fighting.",
                        "He removed the idols from around the Kaaba, reciting: 'Truth has come and falsehood has vanished' (Qur'an 17:81; Sahih al-Bukhari 4287).",
                        "Many of the people who had persecuted the Muslims for years were forgiven, and many of them embraced Islam.",
                        "Lesson: true strength is forgiving people when you finally have the power to punish them.",
                    },
                    Quiz = {
                        {
                            Prompt = "What did the Prophet recite while removing the idols?",
                            Options = { "Truth has come and falsehood has vanished", "Allah is the Greatest", "Peace be upon you", "In the name of Allah" },
                            CorrectIndex = 1,
                            Explanation = "Qur'an 17:81, as narrated in Sahih al-Bukhari 4287.",
                        },
                        {
                            Prompt = "How did the Prophet treat the people of Makkah?",
                            Options = { "He took revenge", "He forgave many of them", "He expelled everyone", "He ignored them" },
                            CorrectIndex = 2,
                            Explanation = "His forgiveness led many to embrace Islam.",
                        },
                    },
                },
                {
                    Id = "seerah_farewell",
                    DisplayName = "The Farewell Hajj",
                    Summary = "The final message to the ummah.",
                    Pages = {
                        "In 10 AH, the Prophet, peace be upon him, performed his only Hajj, with a huge number of Muslims. It is called the Farewell Hajj.",
                        "At Arafah, Allah revealed: 'This day I have perfected for you your religion' (Qur'an 5:3; Sahih al-Bukhari 45).",
                        "In his sermon he reminded the people that their lives, property, and honour are sacred, told them to treat women kindly, and asked them to convey the message to those who were absent.",
                        "He passed away in Madinah in 11 AH (632 CE). His message lives on in the Qur'an and his Sunnah.",
                        "Lesson: every Muslim helps carry the message forward by learning it and living it.",
                    },
                    Order = {
                        Prompt = "Put these events from the Seerah in order, earliest first.",
                        Steps = {
                            "Birth in Makkah, in the Year of the Elephant",
                            "First revelation in the cave of Hira",
                            "The Hijrah to Madinah",
                            "The Battle of Badr",
                            "The Battle of Uhud",
                            "The Treaty of Hudaybiyyah",
                            "The Conquest of Makkah",
                            "The Farewell Hajj",
                        },
                        Explanation = "Birth around 570 CE, first revelation at age 40, Hijrah in 1 AH, Badr in 2 AH, Uhud in 3 AH, Hudaybiyyah in 6 AH, the Conquest in 8 AH, and the Farewell Hajj in 10 AH.",
                    },
                    Quiz = {
                        {
                            Prompt = "How many times did the Prophet perform Hajj?",
                            Options = { "Once", "Twice", "Every year", "Never" },
                            CorrectIndex = 1,
                            Explanation = "His only Hajj was the Farewell Hajj in 10 AH.",
                        },
                        {
                            Prompt = "Which verse was revealed at Arafah during the Farewell Hajj?",
                            Options = { "This day I have perfected for you your religion", "Read in the name of your Lord", "Indeed, with hardship comes ease", "Say, He is Allah, the One" },
                            CorrectIndex = 1,
                            Explanation = "Qur'an 5:3, as Sahih al-Bukhari 45 reports.",
                        },
                        {
                            Prompt = "Where did the Prophet pass away?",
                            Options = { "Makkah", "Madinah", "Ta'if", "Jerusalem" },
                            CorrectIndex = 2,
                            Explanation = "He passed away in Madinah in 11 AH.",
                        },
                    },
                },
            },
        },
        {
            Id = "calendar",
            DisplayName = "Eids And Special Days",
            Summary = "Celebrations and blessed times in the Islamic year.",
            AccentRGB = { 176, 140, 62 },
            Lessons = {
                {
                    Id = "eid_two",
                    DisplayName = "The Two Eids",
                    Summary = "Celebrations given to the Muslims.",
                    Pages = {
                        "Muslims have two yearly celebrations, Eid al-Fitr and Eid al-Adha.",
                        "Eid al-Fitr comes on 1 Shawwal, right after Ramadan. Before the Eid prayer, families give Zakat al-Fitr, a small charity so that everyone can celebrate.",
                        "Eid al-Adha comes on 10 Dhul-Hijjah, during the days of Hajj. It remembers Prophet Ibrahim's readiness to sacrifice his son for Allah, and Allah's mercy in replacing him with a ram (Qur'an 37:102-107).",
                        "On Eid, Muslims pray the Eid prayer together, wear their best clothes, say takbir (Allahu Akbar), visit family, and share food and gifts.",
                    },
                    Quiz = {
                        {
                            Prompt = "Which Eid comes right after Ramadan?",
                            Options = { "Eid al-Adha", "Eid al-Fitr", "Mawlid", "Ashura" },
                            CorrectIndex = 2,
                            Explanation = "Eid al-Fitr is on 1 Shawwal, ending Ramadan.",
                        },
                        {
                            Prompt = "Which Prophet's story is remembered on Eid al-Adha?",
                            Options = { "Musa", "Ibrahim", "Yusuf", "Nuh" },
                            CorrectIndex = 2,
                            Explanation = "Ibrahim's readiness to sacrifice, and Allah's mercy (Qur'an 37:102-107).",
                        },
                        {
                            Prompt = "What charity is given before the Eid al-Fitr prayer?",
                            Options = { "Zakat al-Fitr", "Hajj fee", "Waqf", "Jizyah" },
                            CorrectIndex = 1,
                            Explanation = "Zakat al-Fitr helps everyone enjoy Eid.",
                        },
                    },
                },
                {
                    Id = "special_days",
                    DisplayName = "Special Days And Nights",
                    Summary = "Jumu'ah, Laylat al-Qadr, and Arafah.",
                    Pages = {
                        "Every Friday is Jumu'ah. Muslims gather for the Friday prayer and sermon at midday; Allah commands the believers to hurry to it (Qur'an 62:9).",
                        "Laylat al-Qadr, the Night of Decree, is in the last ten nights of Ramadan. It is better than a thousand months (Qur'an 97:3).",
                        "The Day of Arafah, 9 Dhul-Hijjah, is the greatest day of Hajj. For those not on Hajj, fasting it is hoped to wipe away the sins of the previous year and the coming year (Sahih Muslim 1162).",
                        "Lesson: Allah gives us special times when good deeds count for even more. Make the most of them.",
                    },
                    Quiz = {
                        {
                            Prompt = "What is the weekly gathering prayer called?",
                            Options = { "Jumu'ah", "Tarawih", "Eid", "Witr" },
                            CorrectIndex = 1,
                            Explanation = "The Friday prayer is Jumu'ah (Qur'an 62:9).",
                        },
                        {
                            Prompt = "Laylat al-Qadr is better than how many months?",
                            Options = { "Ten", "One hundred", "One thousand", "Twelve" },
                            CorrectIndex = 3,
                            Explanation = "Qur'an 97:3: better than a thousand months.",
                        },
                        {
                            Prompt = "On which date is the Day of Arafah?",
                            Options = { "1 Shawwal", "9 Dhul-Hijjah", "27 Ramadan", "10 Muharram" },
                            CorrectIndex = 2,
                            Explanation = "Arafah is on 9 Dhul-Hijjah.",
                        },
                    },
                },
            },
        },
    },
}

return IslamicStudies
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">MannersLessons</string>
            <string name="Source"><![CDATA[--!strict

local MannersLessons = {
    {
        Id = "truthfulness",
        DisplayName = "Truthfulness",
        Subtitle = "Truthfulness is a worship habit: speak truth, avoid deceit, and become someone people can trust.",
        AccentColor = Color3.fromRGB(91, 125, 83),
        Lines = {
            "Islamic character begins with sidq: honesty in speech, promises, reporting, and private actions.",
            "A truthful player does not lie for rewards, fake blame, hide harm, or trick others for a win.",
            "Qur'an: Surah At-Tawbah 9:119 commands the believers to be with the truthful.",
            "Hadith: Sahih Muslim 2607c teaches that truth leads to righteousness and a person keeps telling the truth until Allah records them as truthful.",
            "Practice: before you speak, ask three things: Is it true? Is it fair? Is it pleasing to Allah?",
        },
        LinkedStoryId = "umar_ibn_al_khattab",
    },
    {
        Id = "respect",
        DisplayName = "Respect For Parents And Elders",
        Subtitle = "Respect means gentle words, gratitude, service, and humility with parents, family, teachers, and elders.",
        AccentColor = Color3.fromRGB(123, 101, 70),
        Lines = {
            "Respect is not just obeying orders. It includes lowering your voice, listening carefully, and helping before being asked.",
            "Qur'an: Surah Al-Isra' 17:23-24 commands believers not even to say 'uff' to parents and to speak to them with noble words.",
            "Hadith: Sahih al-Bukhari 5971 teaches that a mother is most deserving of the best companionship, then the mother, then the mother, then the father.",
            "Good respect also covers teachers, elders, and guests. Strong character shows up in tone, patience, and service.",
            "Practice: answer calmly, thank people openly, and do small acts of help without showing off.",
        },
        LinkedStoryId = "bilal_ibn_rabah",
    },
    {
        Id = "mercy",
        DisplayName = "Mercy And Kindness",
        Subtitle = "Mercy means gentleness with people, patience with mistakes, and care for anyone weak or in need.",
        AccentColor = Color3.fromRGB(82, 127, 111),
        Lines = {
            "Mercy is active. You notice hurt, weakness, fear, or embarrassment and respond with gentleness instead of cruelty.",
            "Qur'an: Surah Al-Anbiya' 21:107 describes the Prophet, peace be upon him, as a mercy to the worlds, and Surah Al-Balad 90:17 praises those who encourage mercy.",
            "Hadith: Sahih al-Bukhari 6013 teaches that the one who is not merciful to others will not be shown mercy.",
            "Even in battle scenes, the goal is learning courage and history, not enjoying harshness or mocking defeat.",
            "Practice: revive a teammate's confidence, avoid ridicule, and choose restraint when you could embarrass someone.",
        },
        LinkedStoryId = "nusaybah_bint_kaab",
    },
    {
        Id = "keeping_promises",
        DisplayName = "Keeping Promises",
        Subtitle = "Promises, appointments, and responsibilities matter because trust is built by follow-through.",
        AccentColor = Color3.fromRGB(89, 92, 125),
        Lines = {
            "When people depend on your word, breaking it casually damages trust in the whole community.",
            "Qur'an: Surah Al-Isra' 17:34 commands believers to fulfill commitments because every promise will be asked about.",
            "Hadith: Sahih al-Bukhari 2682 warns that breaking promises is one of the signs of hypocrisy.",
            "A Muslim does not make dramatic promises for attention and then disappear when effort is needed.",
            "Practice: promise less, deliver more, and if you cannot finish something, explain honestly before others are harmed.",
        },
        LinkedStoryId = "musab_ibn_umayr",
    },
    {
        Id = "good_speech",
        DisplayName = "Good Speech",
        Subtitle = "Good speech is clean, useful, truthful, and controlled even when emotions are high.",
        AccentColor = Color3.fromRGB(125, 91, 83),
        Lines = {
            "Good speech means no insults, no filthy language, no gossip, and no words meant only to humiliate.",
            "Qur'an: Surah Al-Isra' 17:53 tells believers to say what is best, because harmful speech opens the door to conflict.",
            "Hadith: Riyad as-Salihin 308 teaches that whoever believes in Allah and the Last Day should speak good or remain silent.",
            "Real strength is not loud anger. It is controlled speech when you are excited, frustrated, or tempted to show off.",
            "Practice: if a sentence does not bring truth, benefit, or kindness, let it stop before it leaves your mouth.",
        },
        LinkedStoryId = "musab_ibn_umayr",
    },
}

return table.freeze(MannersLessons)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">ParkourCourses</string>
            <string name="Source"><![CDATA[--!strict

-- Layout of the Lobby Parkour Tower, shared by the hub builder (which builds it), the
-- parkour service (which times runs), and the unit tests (which check every jump can be made
-- with Roblox's default character: about 7.2 studs of jump height at 16 walk speed).
--
-- The course spirals up around the tower core. Offsets are from the parkour district centre
-- and give the centre of each platform's top surface.

export type Platform = {
    Offset: Vector3,
    Size: Vector3,
    Yaw: number,
}

export type Checkpoint = {
    Name: string,
    Offset: Vector3,
}

local DECK_TOP = 4
local RISE = 3.5
local RADIUS = 30
local PER_TURN = 12
local COUNT = 24

local platforms: { Platform } = {}

for index = 1, COUNT do
    local angle = math.rad(180 + (index - 1) * (360 / PER_TURN))
    -- Every fourth platform is a narrow beam (5 studs deep); the rest are full steps.
    -- Local X points away from the core, local Z along the spiral.
    local width = if index % 4 == 0 then 5 else 10
    table.insert(platforms, {
        Offset = Vector3.new(math.cos(angle) * RADIUS, DECK_TOP + RISE * index, math.sin(angle) * RADIUS),
        Size = Vector3.new(width, 1.5, 10),
        Yaw = -math.deg(angle),
    })
end

local summitHeight = DECK_TOP + RISE * COUNT + 4
local startOffset = Vector3.new(-RADIUS - 2, DECK_TOP + 1, -14)

local checkpoints: { Checkpoint } = {
    { Name = "Start", Offset = startOffset },
    { Name = "Checkpoint 1", Offset = platforms[8].Offset },
    { Name = "Checkpoint 2", Offset = platforms[16].Offset },
    { Name = "Summit", Offset = Vector3.new(0, summitHeight, 0) },
}

return {
    LobbyTower = {
        Id = "lobby_tower",
        DisplayName = "Lobby Parkour Tower",
        Platforms = platforms,
        StartOffset = startOffset,
        StartSize = Vector3.new(14, 2, 14),
        SummitHeight = summitHeight,
        -- The summit is a round deck so no platform below ever passes under its edge.
        SummitRadius = 23,
        SummitThickness = 4,
        CoreSize = Vector3.new(20, summitHeight - 4, 20),
        Radius = RADIUS,
        Checkpoints = checkpoints,
        -- A real climb takes well over this; anything faster is a teleport or an exploit.
        MinSeconds = 20,
    },
    -- Default Roblox character movement the layout is designed for.
    Movement = {
        JumpHeight = 7.2,
        WalkSpeed = 16,
        -- Longest edge-to-edge gap a default jump clears at equal height, with margin.
        MaxGap = 9,
    },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">SahabiMysteries</string>
            <string name="Source"><![CDATA[--!strict

-- Sahabi discovery quests: escape-room mysteries about the companions.
--
-- Each mystery is a locked room with clue objects. Players (alone or together: clues found by
-- anyone in the room are shared) read the clues, may take hints, and open the lock by
-- answering questions that the clues answer. Behind the door is a playable episode: a short
-- task drawn from the companion's life. The conclusion explains what happened, lists the
-- sources, and says which parts were game invention.
--
-- Companions are only named in text. The episode yard has no character models of them.

export type Clue = {
    Id: string,
    Object: string,
    Text: string,
    Offset: Vector3,
}

export type LockQuestion = {
    Prompt: string,
    Options: { string },
    CorrectIndex: number,
}

export type Station = {
    Name: string,
    Offset: Vector3,
}

export type Episode = {
    Title: string,
    Description: string,
    -- Stations visited in order when Ordered, any order otherwise.
    Ordered: boolean,
    Stations: { Station },
    FinishText: string,
}

export type Mystery = {
    Id: string,
    Companion: string,
    Title: string,
    Tagline: string,
    Intro: { string },
    Clues: { Clue },
    Hints: { string },
    Lock: { LockQuestion },
    Episode: Episode,
    Conclusion: { string },
    Sources: { string },
    FictionNote: string,
}

local IBN_HISHAM = "Ibn Hisham, al-Sirah al-Nabawiyyah (trans. A. Guillaume)"
local DHAHABI = "Al-Dhahabi, Siyar A'lam al-Nubala'"

local mysteries: { Mystery } = {
    {
        Id = "bilal",
        Companion = "Bilal ibn Rabah",
        Title = "The Voice from the Rooftop",
        Tagline = "Someone left these things in a locked storeroom. Whose life do they tell?",
        Intro = {
            "You wake in a locked storeroom in old Madinah. Five objects lie around the room, each with a note.",
            "Find out whose story they tell. The door's lock asks two questions only that person's story can answer.",
        },
        Clues = {
            { Id = "chain", Object = "Broken iron chain", Text = "Links of the kind put on enslaved people in Makkah. A tag reads: \"Property of Umayyah ibn Khalaf\".", Offset = Vector3.new(-40, 0, -38) },
            { Id = "rock", Object = "Heavy flat rock", Text = "It was laid on a man's chest on the burning sand. Scratched into it, again and again, is one word: \"Ahad\" (One).", Offset = Vector3.new(38, 0, -36) },
            { Id = "receipt", Object = "Merchant's receipt", Text = "\"Paid by Abu Bakr to Umayyah ibn Khalaf: the price of an Abyssinian man's freedom.\"", Offset = Vector3.new(-44, 0, 20) },
            { Id = "dream", Object = "Folded note", Text = "\"Abdullah ibn Zayd saw the words of the adhan in a dream. He was told: teach them to this man, for his voice is stronger than yours.\"", Offset = Vector3.new(42, 0, 24) },
            { Id = "map", Object = "Map of Makkah", Text = "Marked \"8 AH\". An arrow points to the roof of the Kaaba: \"He climbed here and called the adhan on the day Makkah was opened.\"", Offset = Vector3.new(0, 0, -44) },
        },
        Hints = {
            "The chain and the rock tell you he was enslaved and tortured in Makkah.",
            "Abu Bakr bought the freedom of several believers. Which one later became famous for his voice?",
            "He was the first mu'adhdhin of Islam. His name begins with B.",
        },
        Lock = {
            { Prompt = "Whose story do these objects tell?", Options = { "Ammar ibn Yasir", "Bilal ibn Rabah", "Zayd ibn Harithah", "Salman al-Farisi" }, CorrectIndex = 2 },
            { Prompt = "Which word did he repeat while he was tortured?", Options = { "Ahad (One)", "Sabr (Patience)", "Salam (Peace)", "Haqq (Truth)" }, CorrectIndex = 1 },
        },
        Episode = {
            Title = "Up to the Rooftop",
            Description = "The time for prayer has come. Climb the stairs to the rooftop where the adhan was called. Reach each landing in order.",
            Ordered = true,
            Stations = {
                { Name = "Foot of the stairs", Offset = Vector3.new(-30, 0, -20) },
                { Name = "First landing", Offset = Vector3.new(-30, 12, 10) },
                { Name = "Second landing", Offset = Vector3.new(0, 24, 26) },
                { Name = "The rooftop", Offset = Vector3.new(26, 36, 26) },
            },
            FinishText = "From the rooftop the words of the adhan carried over Madinah: Allahu Akbar, Allah is the Greatest.",
        },
        Conclusion = {
            "Bilal ibn Rabah was an Abyssinian man enslaved in Makkah. His master, Umayyah ibn Khalaf, tortured him on the hot sand to make him give up Islam, but he only repeated \"Ahad, Ahad\".",
            "Abu Bakr bought and freed him. Umar later said: Abu Bakr is our master, and he freed our master.",
            "In Madinah he became the first mu'adhdhin. On the day Makkah was opened, he called the adhan from the roof of the Kaaba.",
        },
        Sources = { IBN_HISHAM, "Sahih al-Bukhari 3754 (Umar on Abu Bakr and Bilal)", "Sunan Abi Dawud 499 (the dream of the adhan)" },
        FictionNote = "Invented for the game: the storeroom, the notes, the receipt, and the map. The events the notes describe are documented in the sources.",
    },
    {
        Id = "salman",
        Companion = "Salman al-Farisi",
        Title = "The Long Search",
        Tagline = "A traveller's belongings, from Persia to Madinah. Follow the trail.",
        Intro = {
            "A traveller's pack has been left in a locked guest room. Its objects come from many lands.",
            "Work out who travelled this far, and why.",
        },
        Clues = {
            { Id = "lamp", Object = "Cold fire-temple lamp", Text = "From near Isfahan in Persia. A note: \"My father made me keeper of the fire that must never go out.\"", Offset = Vector3.new(-40, 0, -38) },
            { Id = "bell", Object = "Small church bell", Text = "\"I heard Christians praying and loved their worship more than ours. I left home to learn from their monks: in Syria, Mosul, Nusaybin, then Amuriyah.\"", Offset = Vector3.new(38, 0, -36) },
            { Id = "prophecy", Object = "Monk's parchment", Text = "\"A prophet will appear in a land of palm trees between two lava fields. He accepts gifts but not charity, and between his shoulders is the seal of prophethood.\"", Offset = Vector3.new(-44, 0, 20) },
            { Id = "contract", Object = "Contract of sale", Text = "\"Sold by travelling merchants of the Banu Kalb, who betrayed him, to a man of Yathrib.\"", Offset = Vector3.new(42, 0, 24) },
            { Id = "sapling", Object = "Date-palm sapling", Text = "\"His freedom was agreed for three hundred palm trees planted and forty measures of gold. The Prophet ﷺ planted the saplings with his own hands.\"", Offset = Vector3.new(0, 0, -44) },
        },
        Hints = {
            "He began in Persia and kept searching for the truth through many teachers.",
            "His name tells you where he came from: al-Farisi means \"the Persian\".",
            "His freedom was paid for in palm trees.",
        },
        Lock = {
            { Prompt = "Whose journey is this?", Options = { "Suhayb al-Rumi", "Salman al-Farisi", "Bilal ibn Rabah", "Abu Dharr al-Ghifari" }, CorrectIndex = 2 },
            { Prompt = "What was part of the price of his freedom?", Options = { "A hundred camels", "A house in Makkah", "Three hundred palm trees", "A year of service" }, CorrectIndex = 3 },
        },
        Episode = {
            Title = "Dig the Trench",
            Description = "Years later, an army of ten thousand is coming. Salman suggests a trench, as they dug in Persia. Dig all four sections. Friends can dig together.",
            Ordered = false,
            Stations = {
                { Name = "West section", Offset = Vector3.new(-36, 0, 20) },
                { Name = "West-centre section", Offset = Vector3.new(-12, 0, 20) },
                { Name = "East-centre section", Offset = Vector3.new(12, 0, 20) },
                { Name = "East section", Offset = Vector3.new(36, 0, 20) },
            },
            FinishText = "The trench is finished. The confederate army was stopped at it, and after about a month a cold wind sent them home.",
        },
        Conclusion = {
            "Salman al-Farisi grew up in Persia as keeper of a sacred fire. Searching for the truth, he left home and studied under a chain of Christian monks.",
            "The last one told him of a prophet who would appear in a land of palm trees. On the way there he was betrayed and sold into slavery in Yathrib, which became Madinah.",
            "He met the Prophet ﷺ there and accepted Islam. His freedom was bought with palm trees planted and gold, with the Prophet's ﷺ help. At the Battle of the Trench, his idea helped save Madinah.",
        },
        Sources = { "Musnad Ahmad, Salman's own account of his search", IBN_HISHAM, DHAHABI },
        FictionNote = "Invented for the game: the guest room and the objects. The journey, the price of his freedom, and the trench are reported in the sources.",
    },
    {
        Id = "uthman",
        Companion = "Uthman ibn Affan",
        Title = "The Well of Rumah",
        Tagline = "A bucket, a ledger, two rings, and a sealed box. Who gave so much?",
        Intro = {
            "You are locked in a merchant's counting room. A generous man's records are scattered about.",
            "Discover who he was and what he gave.",
        },
        Clues = {
            { Id = "bucket", Object = "Wooden bucket", Text = "From Rumah, a sweet-water well in Madinah. Its owner sold every bucket, and the poor went thirsty.", Offset = Vector3.new(-40, 0, -38) },
            { Id = "ledger", Object = "Ledger", Text = "\"Bought: the well of Rumah. Price paid in full. Its water is now free for all Muslims.\"", Offset = Vector3.new(38, 0, -36) },
            { Id = "rings", Object = "Two wedding rings", Text = "He married Ruqayyah, a daughter of the Prophet ﷺ, and after her death her sister Umm Kulthum. People called him Dhu al-Nurayn, the Possessor of the Two Lights.", Offset = Vector3.new(-44, 0, 20) },
            { Id = "saddle", Object = "Camel saddle", Text = "\"For the army of Tabuk: camels, saddles, and supplies, all paid for by one man.\"", Offset = Vector3.new(42, 0, 24) },
            { Id = "box", Object = "Sealed box", Text = "Inside, a note: \"As caliph he had copies of the Qur'an written to one standard and sent to the great cities.\"", Offset = Vector3.new(0, 0, -44) },
        },
        Hints = {
            "This man married two daughters of the Prophet ﷺ.",
            "He was the third caliph, after Abu Bakr and Umar.",
            "His title, Dhu al-Nurayn, is written on the rings' note.",
        },
        Lock = {
            { Prompt = "Who bought the well of Rumah?", Options = { "Abd al-Rahman ibn Awf", "Abu Bakr al-Siddiq", "Uthman ibn Affan", "Talhah ibn Ubaydullah" }, CorrectIndex = 3 },
            { Prompt = "What did he do with the well's water?", Options = { "Sold it at a fair price", "Made it free for everyone", "Kept it for his family", "Gave it to the army only" }, CorrectIndex = 2 },
        },
        Episode = {
            Title = "Water for Madinah",
            Description = "Fill the bucket at the well, then carry water to three houses in order.",
            Ordered = true,
            Stations = {
                { Name = "The well of Rumah", Offset = Vector3.new(0, 0, 0) },
                { Name = "First house", Offset = Vector3.new(-36, 0, 30) },
                { Name = "Second house", Offset = Vector3.new(0, 0, 40) },
                { Name = "Third house", Offset = Vector3.new(36, 0, 30) },
            },
            FinishText = "Every house has water. Uthman's gift of the well was remembered as a charity that kept on giving.",
        },
        Conclusion = {
            "Uthman ibn Affan was a wealthy, gentle, and modest merchant among the first to accept Islam.",
            "He bought the well of Rumah and made its water free, equipped a large part of the army of Tabuk, and married two daughters of the Prophet ﷺ, earning the title Dhu al-Nurayn.",
            "As the third caliph he had the Qur'an copied to one standard and sent to the main cities, so Muslims everywhere read the same text.",
        },
        Sources = { "Jami' al-Tirmidhi, Book of Virtues (Uthman and the well of Rumah)", "Sahih al-Bukhari 4987 (the copying of the Qur'an)", DHAHABI },
        FictionNote = "Invented for the game: the counting room, ledger, and carrying water house to house.",
    },
    {
        Id = "asma",
        Companion = "Asma bint Abi Bakr",
        Title = "She of the Two Belts",
        Tagline = "A torn belt and a secret night journey. Who kept the secret?",
        Intro = {
            "You are in a house in old Makkah the night after the Hijrah began. The door is barred.",
            "Search the room and find out who was trusted with the greatest secret in Makkah.",
        },
        Clues = {
            { Id = "belt", Object = "Torn belt", Text = "A woman's waist-belt torn in two. One half tied the food bundle, the other the water skin.", Offset = Vector3.new(-40, 0, -38) },
            { Id = "bundle", Object = "Empty food cloth", Text = "\"Carried at night up Mount Thawr for three nights, to the cave where my father and the Prophet ﷺ hid.\"", Offset = Vector3.new(38, 0, -36) },
            { Id = "stones", Object = "Cloth of pebbles", Text = "\"My blind grandfather feared my father had left us nothing. I put stones where the money was kept and laid his hand on them so he would feel at ease.\"", Offset = Vector3.new(-44, 0, 20) },
            { Id = "door", Object = "Note by the door", Text = "\"Abu Jahl came demanding to know where my father was. I would not tell him, and he struck me.\"", Offset = Vector3.new(42, 0, 24) },
            { Id = "cradle", Object = "Baby's cradle", Text = "\"My son Abdullah ibn al-Zubayr: the first child born to the emigrants in Madinah.\"", Offset = Vector3.new(0, 0, -44) },
        },
        Hints = {
            "Her father went on the Hijrah with the Prophet ﷺ.",
            "Her father was Abu Bakr. Her sister was Aisha.",
            "She tore her belt in two, so she was called \"She of the Two Belts\".",
        },
        Lock = {
            { Prompt = "Who is the owner of the torn belt?", Options = { "Aisha bint Abi Bakr", "Asma bint Abi Bakr", "Fatimah bint Muhammad", "Umm Salamah" }, CorrectIndex = 2 },
            { Prompt = "What would she not tell Abu Jahl?", Options = { "Where her father was", "Her own name", "Where the Kaaba key was", "Who her husband was" }, CorrectIndex = 1 },
        },
        Episode = {
            Title = "Night Run to Thawr",
            Description = "Take the food bundle and climb the path to the cave in order, staying on the path.",
            Ordered = true,
            Stations = {
                { Name = "Pick up the food bundle", Offset = Vector3.new(-36, 0, -30) },
                { Name = "Foot of Mount Thawr", Offset = Vector3.new(-20, 4, 6) },
                { Name = "Rocky switchback", Offset = Vector3.new(10, 12, 22) },
                { Name = "Mouth of the cave", Offset = Vector3.new(34, 20, 34) },
            },
            FinishText = "The food reached the cave safely. For three nights Asma kept the secret and the supplies coming.",
        },
        Conclusion = {
            "Asma bint Abi Bakr was the elder sister of Aisha. During the Hijrah she carried food to the cave of Thawr, tearing her belt in two to tie it, and was called Dhat al-Nitaqayn, She of the Two Belts.",
            "She refused to tell Abu Jahl where her father was, even when he struck her, and comforted her blind grandfather with a cloth of stones.",
            "She lived to about a hundred. Her son Abdullah ibn al-Zubayr was the first child born to the emigrants in Madinah.",
        },
        Sources = { "Sahih al-Bukhari 3905 (the two belts)", "Sahih al-Bukhari 3909 (the birth of Abdullah ibn al-Zubayr)", IBN_HISHAM },
        FictionNote = "Invented for the game: the barred house, the notes in her words, and the path stations.",
    },
    {
        Id = "musab",
        Companion = "Mus'ab ibn Umayr",
        Title = "The Ambassador",
        Tagline = "Perfume, a locked chest, and a cloak too short. Who gave up everything?",
        Intro = {
            "A once-rich young man's room has been locked from the outside.",
            "Find out who he was, what he gave up, and where he was sent.",
        },
        Clues = {
            { Id = "perfume", Object = "Perfume bottle", Text = "\"The best-dressed, best-scented young man in Makkah,\" a note says. \"His mother gave him everything.\"", Offset = Vector3.new(-40, 0, -38) },
            { Id = "chest", Object = "Locked chest", Text = "\"When his mother learned he had become Muslim, she locked him up and cut him off from her wealth.\"", Offset = Vector3.new(38, 0, -36) },
            { Id = "pledge", Object = "Letter of the pledge", Text = "\"After the First Pledge of al-Aqabah, he went back with the people of Yathrib to teach them the Qur'an.\"", Offset = Vector3.new(-44, 0, 20) },
            { Id = "spear", Object = "Spear set down", Text = "\"Usayd ibn Hudayr came at him with a spear. He said: sit and listen; if you like it, accept it, and if not, we will stop. Usayd sat, listened, and accepted Islam, and so did Sa'd ibn Mu'adh.\"", Offset = Vector3.new(42, 0, 24) },
            { Id = "cloak", Object = "Short cloak", Text = "\"Martyred at Uhud holding the banner. His only cloak could cover his head or his feet, not both.\"", Offset = Vector3.new(0, 0, -44) },
        },
        Hints = {
            "He was rich in Makkah and gave it all up for Islam.",
            "He was the first teacher sent to Yathrib.",
            "His name begins with M and he carried the banner at Uhud.",
        },
        Lock = {
            { Prompt = "Who was this young man?", Options = { "Mus'ab ibn Umayr", "Sa'd ibn Abi Waqqas", "Usayd ibn Hudayr", "Khalid ibn al-Walid" }, CorrectIndex = 1 },
            { Prompt = "What was he sent to Yathrib to do?", Options = { "Trade", "Lead an army", "Teach the Qur'an", "Collect taxes" }, CorrectIndex = 3 },
        },
        Episode = {
            Title = "Teach Yathrib",
            Description = "Take Qur'an lessons to four households of Yathrib. Visit them in any order. Friends can split the houses.",
            Ordered = false,
            Stations = {
                { Name = "House of the Banu Abd al-Ashhal", Offset = Vector3.new(-36, 0, -24) },
                { Name = "House by the palm grove", Offset = Vector3.new(36, 0, -24) },
                { Name = "House by the well", Offset = Vector3.new(-36, 0, 30) },
                { Name = "House at the market", Offset = Vector3.new(36, 0, 30) },
            },
            FinishText = "By the next pilgrimage season, there was hardly a house in Yathrib without someone who had accepted Islam.",
        },
        Conclusion = {
            "Mus'ab ibn Umayr gave up wealth and comfort in Makkah when he accepted Islam, and his mother cut him off.",
            "He was sent to Yathrib as its first teacher. Through his patience and gentle words, leaders like Usayd ibn Hudayr and Sa'd ibn Mu'adh accepted Islam, and the city was ready for the Hijrah.",
            "He was martyred at Uhud carrying the banner. His cloak was too short to cover him fully, so his feet were covered with grass.",
        },
        Sources = { IBN_HISHAM, "Sahih al-Bukhari 1276 (narrated by Khabbab, on Mus'ab's shroud)", DHAHABI },
        FictionNote = "Invented for the game: the locked room, the notes, and delivering lessons house to house.",
    },
}

return {
    Mysteries = mysteries,
    -- Fewer hints and fewer wrong lock tries earn more stars.
    MaxStars = 3,
    -- Size of each room and its episode yard, in studs.
    RoomSize = 120,
    -- How close a player must be to a station to activate it.
    StationRadius = 10,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">SeerahCampaign</string>
            <string name="Source"><![CDATA[--!strict

-- The Seerah campaign: the life of the Prophet Muhammad ﷺ in chronological chapters.
--
-- Rules every chapter follows:
-- * The Prophet ﷺ is never shown, voiced, or played. He is named only in written narration,
--   always with ﷺ. No character model stands for him and no line is spoken in his voice;
--   his words appear only as quoted narration.
-- * Companions are named in narration. Where a scene needs figures, they are generic,
--   unnamed townspeople with blank faces.
-- * Each chapter lists its sources and a GameplayNote that separates what players do in the
--   game (fictional) from what is documented.
-- * Dates follow the common reckoning in the sirah works cited below. Where reports differ,
--   the text says "about" or "reported".
--
-- Source keys used in Sources lists are explained in docs/sources.md.

export type Person = { Name: string, Role: string }

export type Activity = {
    -- "Collect": find Count items around the site. "Battle": finish the battle mission.
    Kind: string,
    Item: string?,
    Count: number?,
    ScenarioId: string?,
}

export type Decision = {
    Prompt: string,
    Options: { string },
    CorrectIndex: number,
    Explanation: string,
}

export type Chapter = {
    Id: string,
    Number: number,
    Era: string,
    When: string,
    Title: string,
    Site: string,
    People: { Person },
    Story: { string },
    Activity: Activity?,
    Decision: Decision,
    Consequence: string,
    Lesson: string,
    Sources: { string },
    GameplayNote: string,
}

local IBN_HISHAM = "Ibn Hisham, al-Sirah al-Nabawiyyah (trans. A. Guillaume, The Life of Muhammad, 1955)"
local MUBARAKPURI = "Safiur-Rahman al-Mubarakpuri, Ar-Raheeq al-Makhtum (The Sealed Nectar)"
local LINGS = "Martin Lings, Muhammad: His Life Based on the Earliest Sources (1983)"

local chapters: { Chapter } = {
    {
        Id = "year_of_elephant",
        Number = 1,
        Era = "Makkah",
        When = "About 570 CE",
        Title = "The Year of the Elephant",
        Site = "kaaba_old",
        People = {
            { Name = "Abd al-Muttalib", Role = "Grandfather of the Prophet ﷺ and a chief of Quraysh" },
            { Name = "Aminah bint Wahb", Role = "Mother of the Prophet ﷺ" },
            { Name = "Abrahah", Role = "Abyssinian ruler of Yemen who marched on Makkah" },
        },
        Story = {
            "Abrahah, who ruled Yemen for the king of Abyssinia, built a great church and wanted the Arabs to visit it instead of the Kaaba. He marched on Makkah with an army and at least one elephant.",
            "His soldiers seized camels belonging to Abd al-Muttalib. When Abd al-Muttalib came to him, he asked only for his camels. Surprised, Abrahah asked why he did not plead for the Kaaba. He answered that he was the owner of the camels, and the House had a Lord who would protect it.",
            "Quraysh left the town for the hills. The army was destroyed before it could reach the Kaaba, as Surah al-Fil describes: birds pelting them with stones of baked clay.",
            "In that same year the Prophet Muhammad ﷺ was born in Makkah to Aminah bint Wahb. His father, Abdullah, had died before he was born.",
        },
        Decision = {
            Prompt = "What did Abd al-Muttalib ask Abrahah for?",
            Options = { "To spare the Kaaba", "The return of his camels", "Gold for Quraysh", "A seat in Abrahah's army" },
            CorrectIndex = 2,
            Explanation = "He asked for his camels and trusted that the House had a Lord who would protect it.",
        },
        Consequence = "The Arabs called it the Year of the Elephant and dated events from it. Quraysh gained great respect as the people of the protected House.",
        Lesson = "Allah protects what He wills. Trust in Allah while doing what is in your own hands.",
        Sources = { "Qur'an 105:1-5 (Surah al-Fil)", IBN_HISHAM, MUBARAKPURI },
        GameplayNote = "Documented: the march, the camels exchange, and the birth in that year. The town and townspeople you see are a reconstruction.",
    },
    {
        Id = "orphan_years",
        Number = 2,
        Era = "Makkah",
        When = "About 570-578 CE",
        Title = "An Orphan in the Desert",
        Site = "banu_sad_camp",
        People = {
            { Name = "Halimah al-Sa'diyyah", Role = "His foster mother from the Banu Sa'd" },
            { Name = "Abd al-Muttalib", Role = "His grandfather and guardian" },
            { Name = "Abu Talib", Role = "His uncle and guardian" },
        },
        Story = {
            "Families of Makkah sent babies to be nursed in the open desert, where the air was clean and the Arabic was pure. The Prophet ﷺ was nursed by Halimah of the Banu Sa'd, and her household found blessing in their animals and milk while he was with them.",
            "He returned to his mother, Aminah. When he was about six, she died at al-Abwa on the way back from visiting Yathrib.",
            "His grandfather Abd al-Muttalib cared for him until he died, when the boy was about eight. Then his uncle Abu Talib took him in and cared for him for the rest of his life.",
        },
        Activity = { Kind = "Collect", Item = "water skin", Count = 3 },
        Decision = {
            Prompt = "Who looked after him after his grandfather died?",
            Options = { "Halimah al-Sa'diyyah", "Abu Lahab", "His uncle Abu Talib", "Waraqah ibn Nawfal" },
            CorrectIndex = 3,
            Explanation = "Abu Talib took him in when he was about eight and protected him for decades.",
        },
        Consequence = "Growing up an orphan, he knew loss early. The Qur'an later reminded him: \"Did He not find you an orphan and give you shelter?\"",
        Lesson = "Care for orphans and people who have lost family. Allah sees and shelters them.",
        Sources = { "Qur'an 93:6-9 (Surah al-Duha)", IBN_HISHAM, MUBARAKPURI },
        GameplayNote = "Fictional: carrying water skins for the camp is a game task. Documented: his nursing with the Banu Sa'd and the deaths of his mother and grandfather.",
    },
    {
        Id = "al_amin",
        Number = 3,
        Era = "Makkah",
        When = "About 585-595 CE",
        Title = "The Trustworthy One",
        Site = "makkah_market",
        People = {
            { Name = "Quraysh", Role = "The tribe of Makkah" },
        },
        Story = {
            "As a youth the Prophet ﷺ herded sheep for the people of Makkah. He later said that every prophet had herded sheep.",
            "When a visiting trader was cheated in Makkah, leading men of Quraysh met at the house of Abdullah ibn Jud'an and swore to stand with anyone wronged until his right was returned. This was Hilf al-Fudul, the Pact of the Virtuous. The Prophet ﷺ took part and later said he would answer such a call even in Islam.",
            "He became known across Makkah as al-Amin, the trustworthy, and people left their valuables with him for safekeeping.",
        },
        Decision = {
            Prompt = "What was Hilf al-Fudul?",
            Options = { "A trade caravan to Syria", "A pact to defend anyone who was wronged", "A war between two clans", "A poetry contest" },
            CorrectIndex = 2,
            Explanation = "Quraysh leaders swore to support the oppressed until justice was done, whoever they were.",
        },
        Consequence = "His honesty was so well known that even people who later opposed him still trusted him with their belongings.",
        Lesson = "Be honest in small things, and stand up for people who are treated unfairly.",
        Sources = { "Sahih al-Bukhari 2262 (every prophet herded sheep)", IBN_HISHAM, MUBARAKPURI },
        GameplayNote = "The market stalls are a reconstruction. The pact and the title al-Amin are documented.",
    },
    {
        Id = "khadijah",
        Number = 4,
        Era = "Makkah",
        When = "About 595 CE",
        Title = "Khadijah's Caravan",
        Site = "khadijah_house",
        People = {
            { Name = "Khadijah bint Khuwaylid", Role = "A respected merchant of Makkah, later his wife" },
            { Name = "Maysarah", Role = "Khadijah's servant who travelled with the caravan" },
        },
        Story = {
            "Khadijah bint Khuwaylid was a wealthy, respected merchant who hired men to trade with her goods. Hearing of his honesty, she asked the Prophet ﷺ to take her goods to Syria, with her servant Maysarah.",
            "The trade went well, and Maysarah told her of his good character on the journey.",
            "Khadijah proposed marriage through a friend. The Prophet ﷺ, then about twenty-five, accepted. Most reports say she was about forty. Their marriage lasted about twenty-five years, and she was the mother of most of his children.",
        },
        Activity = { Kind = "Collect", Item = "trade bundle", Count = 4 },
        Decision = {
            Prompt = "Why did Khadijah first choose him to lead her caravan?",
            Options = { "He was her cousin", "He was the richest man in Makkah", "He was known for his honesty", "He had been to Syria many times" },
            CorrectIndex = 3,
            Explanation = "His reputation for honesty led her to trust him with her goods.",
        },
        Consequence = "Khadijah became his closest support. She was the first person to believe in his message.",
        Lesson = "Good character opens doors. Khadijah valued honesty above everything else.",
        Sources = { IBN_HISHAM, MUBARAKPURI, LINGS },
        GameplayNote = "Fictional: loading trade bundles. Documented: the trade journey, Maysarah, and the marriage. Ages are as most reports give them.",
    },
    {
        Id = "black_stone",
        Number = 5,
        Era = "Makkah",
        When = "About 605 CE",
        Title = "The Cloak and the Black Stone",
        Site = "kaaba_old",
        People = {
            { Name = "The clans of Quraysh", Role = "Rebuilt the Kaaba together" },
        },
        Story = {
            "After a flood damaged the Kaaba, Quraysh rebuilt it together. When the walls were high enough, the clans argued over who would have the honour of setting the Black Stone in place. The argument nearly became a fight.",
            "They agreed that the first man to enter the sanctuary would judge between them. The first to enter was the Prophet ﷺ, then about thirty-five, and they said: this is al-Amin, we accept him.",
            "He spread a cloak on the ground and placed the stone on it. A leader from each clan held an edge and together they lifted it, and he set the stone in its place.",
        },
        Activity = { Kind = "Collect", Item = "building stone", Count = 4 },
        Decision = {
            Prompt = "How did he settle the argument over the Black Stone?",
            Options = { "He gave the honour to his own clan", "He told them to draw lots", "Every clan carried it together on a cloak", "He left it for another year" },
            CorrectIndex = 3,
            Explanation = "Every clan shared the honour, so no one was left out and no blood was shed.",
        },
        Consequence = "A fight that could have lasted years was ended in minutes. His fairness was respected by all of Quraysh.",
        Lesson = "Look for solutions that let everyone share the good, instead of winners and losers.",
        Sources = { IBN_HISHAM, MUBARAKPURI },
        GameplayNote = "Fictional: carrying building stones. Documented: the rebuilding, the dispute, and the cloak.",
    },
    {
        Id = "first_revelation",
        Number = 6,
        Era = "Makkah",
        When = "610 CE, Ramadan",
        Title = "Read! The Cave of Hira",
        Site = "jabal_nour",
        People = {
            { Name = "Jibril", Role = "The angel who brought revelation" },
            { Name = "Khadijah bint Khuwaylid", Role = "His wife" },
            { Name = "Waraqah ibn Nawfal", Role = "Khadijah's cousin, an elderly Christian scholar" },
        },
        Story = {
            "The Prophet ﷺ began to spend nights alone in worship in the Cave of Hira on a mountain outside Makkah.",
            "When he was about forty, the angel Jibril came to him there and said: \"Read!\" He answered that he could not read. Then came the first verses of the Qur'an: \"Read in the name of your Lord who created.\"",
            "He returned home trembling and said: \"Cover me.\" Khadijah comforted him: Allah would never disgrace him, for he kept ties with family, helped the weak, honoured guests, and stood by people in hardship.",
            "She took him to her cousin Waraqah ibn Nawfal, who said this was the same angel who had come to Musa (Moses).",
        },
        Decision = {
