                Zone = "Wells",
                Radius = 34,
                AllyPoint = "Line",
                Narration = {
                    Title = "The Small Army",
                    Body = "About three hundred and thirteen believers came to Badr, facing a Quraysh army roughly three times larger.",
                    Reference = "Sahih al-Bukhari 3959",
                },
            },
            {
                Id = "wells",
                Type = "Hold",
