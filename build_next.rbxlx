      <Item class="LocalScript" referent="36">
        <Properties>
          <string name="Name">BattleCamera</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local function applyBattleCameraMode()
    if player:GetAttribute("InBattle") == true then
        player.CameraMode = Enum.CameraMode.LockFirstPerson

        local camera = Workspace.CurrentCamera

        if camera then
            camera.FieldOfView = 74
        end
    else
        player.CameraMode = Enum.CameraMode.Classic

        local camera = Workspace.CurrentCamera

        if camera and camera.CameraType ~= Enum.CameraType.Scriptable then
            camera.FieldOfView = 70
        end
    end
end

player:GetAttributeChangedSignal("InBattle"):Connect(applyBattleCameraMode)
applyBattleCameraMode()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="37">
        <Properties>
          <string name="Name">BattleControls</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local battleFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Battle")
local requestBlock = battleFolder:WaitForChild("RequestBlock") :: RemoteEvent

local player = Players.LocalPlayer
local localCooldown = false

local function requestSwordBlock()
    if localCooldown or player:GetAttribute("InBattle") ~= true then
        return
    end

    local character = player.Character
    local equippedTool = character and character:FindFirstChildOfClass("Tool")

    if not equippedTool or (equippedTool.Name ~= "Training Sword" and equippedTool.Name ~= "Bow") then
        return
    end

    localCooldown = true
    requestBlock:FireServer()

    task.delay(0.35, function()
        localCooldown = false
    end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        requestSwordBlock()
        return
    end

    if input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.Q then
        requestSwordBlock()
    end
end)
]]></string>
        </Properties>
      </Item>
