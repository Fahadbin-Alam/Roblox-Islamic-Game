        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">HaramLearningTrail</string>
            <string name="Source"><![CDATA[--!strict

local HaramLearningTrail = {
    Id = "haram_learning_walk",
    DisplayName = "Haram Learning Walk",
    RewardTokens = 35,
    AccentColor = Color3.fromRGB(193, 162, 86),
    StartObjective = "Begin at the gold learning marker on the south side of the Kaaba courtyard.",
    Steps = {
        {
            Title = "Enter With Respect",
            LocationName = "Orientation Marker",
            Objective = "Begin at the gold learning marker on the south side of the courtyard.",
            Lines = {
                { Speaker = "Guide", Text = "Start by slowing down and looking around. This hub is for learning and respectful exploration." },
                { Speaker = "Guide", Text = "Follow the gold trail lights. Each stop teaches one landmark or idea without turning worship into a game objective." },
            },
        },
        {
            Title = "The Kaaba As A Direction",
            LocationName = "Kaaba View Stop",
            Objective = "Walk to the Kaaba view stop near the front-right side of the courtyard.",
            Lines = {
                { Speaker = "Guide", Text = "The Kaaba is the central landmark of Masjid al-Haram and the direction Muslims face in prayer." },
                { Speaker = "Guide", Text = "This build uses a respectful learning model, not a perfect replica of the real sacred site." },
            },
        },
        {
            Title = "The Tawaf Flow",
            LocationName = "Tawaf Path Stop",
            Objective = "Follow the gold trail to the circular path marker on the west side.",
            Lines = {
                { Speaker = "Guide", Text = "The circular guide lights help you understand movement around the Kaaba." },
                { Speaker = "Guide", Text = "In real life, tawaf is worship. Here, the path is only a learning and navigation guide." },
            },
        },
        {
            Title = "Maqam Ibrahim Marker",
            LocationName = "Maqam Stop",
            Objective = "Study the Maqam Ibrahim marker near the gold-and-glass station.",
            Lines = {
                { Speaker = "Guide", Text = "This marker points players toward Maqam Ibrahim as an important Kaaba-side landmark." },
                { Speaker = "Guide", Text = "The game keeps it symbolic so players can recognize the idea without pretending it is the real place." },
            },
        },
        {
            Title = "Hijr / Hateem Marker",
            LocationName = "Curved Boundary Stop",
            Objective = "Walk to the curved low boundary marker near the north side of the Kaaba.",
            Lines = {
                { Speaker = "Guide", Text = "The curved boundary helps you notice another landmark connected to the Kaaba area." },
                { Speaker = "Guide", Text = "Small markers like this make the courtyard easier to learn without crowding the center." },
            },
        },
        {
            Title = "Arcades, Gates, And Scale",
            LocationName = "North Arcade Stop",
            Objective = "Finish at the north arcade stop and look back over the whole courtyard.",
            Lines = {
                { Speaker = "Guide", Text = "The surrounding arcades, gates, towers, and minarets help the place feel large and alive." },
                { Speaker = "Guide", Text = "A good learning hub gives you orientation first, then lets stories, battles, and manners lessons branch out naturally." },
            },
        },
    },
    Completion = {
        Title = "Learning Walk Complete",
        Lines = {
            { Speaker = "Guide", Text = "You finished the Haram Learning Walk. Now you know the main landmarks this hub is trying to teach." },
            { Speaker = "Guide", Text = "Next, try a sahabi story, manners lesson, or battle scenario to keep learning through play." },
        },
    },
}

return table.freeze(HaramLearningTrail)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">MannersLessons</string>
            <string name="Source"><![CDATA[--!strict

local MannersLessons = {
    {
        Id = "truthfulness",
        DisplayName = "Truthfulness",
        Subtitle = "Truthfulness is a worship habit: speak truth, avoid deceit, and become someone people can trust.",
        AccentColor = Color3.fromRGB(91, 125, 83),
        Lines = {
            "Islamic character begins with sidq: honesty in speech, promises, reporting, and private actions.",
            "A truthful player does not lie for rewards, fake blame, hide harm, or trick others for a win.",
            "Qur'an: Surah At-Tawbah 9:119 commands the believers to be with the truthful.",
            "Hadith: Sahih Muslim 2607c teaches that truth leads to righteousness and a person keeps telling the truth until Allah records them as truthful.",
            "Practice: before you speak, ask three things: Is it true? Is it fair? Is it pleasing to Allah?",
        },
        LinkedStoryId = "umar_ibn_al_khattab",
    },
    {
        Id = "respect",
        DisplayName = "Respect For Parents And Elders",
        Subtitle = "Respect means gentle words, gratitude, service, and humility with parents, family, teachers, and elders.",
        AccentColor = Color3.fromRGB(123, 101, 70),
        Lines = {
            "Respect is not just obeying orders. It includes lowering your voice, listening carefully, and helping before being asked.",
            "Qur'an: Surah Al-Isra' 17:23-24 commands believers not even to say 'uff' to parents and to speak to them with noble words.",
            "Hadith: Sahih al-Bukhari 5971 teaches that a mother is most deserving of the best companionship, then the mother, then the mother, then the father.",
            "Good respect also covers teachers, elders, and guests. Strong character shows up in tone, patience, and service.",
            "Practice: answer calmly, thank people openly, and do small acts of help without showing off.",
        },
        LinkedStoryId = "bilal_ibn_rabah",
    },
    {
        Id = "mercy",
        DisplayName = "Mercy And Kindness",
        Subtitle = "Mercy means gentleness with people, patience with mistakes, and care for anyone weak or in need.",
        AccentColor = Color3.fromRGB(82, 127, 111),
        Lines = {
            "Mercy is active. You notice hurt, weakness, fear, or embarrassment and respond with gentleness instead of cruelty.",
            "Qur'an: Surah Al-Anbiya' 21:107 describes the Prophet, peace be upon him, as a mercy to the worlds, and Surah Al-Balad 90:17 praises those who encourage mercy.",
            "Hadith: Sahih al-Bukhari 6013 teaches that the one who is not merciful to others will not be shown mercy.",
            "Even in battle scenes, the goal is learning courage and history, not enjoying harshness or mocking defeat.",
            "Practice: revive a teammate's confidence, avoid ridicule, and choose restraint when you could embarrass someone.",
        },
        LinkedStoryId = "nusaybah_bint_kaab",
    },
    {
        Id = "keeping_promises",
        DisplayName = "Keeping Promises",
        Subtitle = "Promises, appointments, and responsibilities matter because trust is built by follow-through.",
        AccentColor = Color3.fromRGB(89, 92, 125),
        Lines = {
            "When people depend on your word, breaking it casually damages trust in the whole community.",
            "Qur'an: Surah Al-Isra' 17:34 commands believers to fulfill commitments because every promise will be asked about.",
            "Hadith: Sahih al-Bukhari 2682 warns that breaking promises is one of the signs of hypocrisy.",
            "A Muslim does not make dramatic promises for attention and then disappear when effort is needed.",
            "Practice: promise less, deliver more, and if you cannot finish something, explain honestly before others are harmed.",
        },
        LinkedStoryId = "musab_ibn_umayr",
    },
    {
        Id = "good_speech",
        DisplayName = "Good Speech",
        Subtitle = "Good speech is clean, useful, truthful, and controlled even when emotions are high.",
        AccentColor = Color3.fromRGB(125, 91, 83),
        Lines = {
            "Good speech means no insults, no filthy language, no gossip, and no words meant only to humiliate.",
            "Qur'an: Surah Al-Isra' 17:53 tells believers to say what is best, because harmful speech opens the door to conflict.",
            "Hadith: Riyad as-Salihin 308 teaches that whoever believes in Allah and the Last Day should speak good or remain silent.",
            "Real strength is not loud anger. It is controlled speech when you are excited, frustrated, or tempted to show off.",
            "Practice: if a sentence does not bring truth, benefit, or kindness, let it stop before it leaves your mouth.",
        },
        LinkedStoryId = "musab_ibn_umayr",
    },
}

return table.freeze(MannersLessons)
]]></string>
          </Properties>
        </Item>
