    <Item class="Script" referent="17">
      <Properties>
        <string name="Name">BattleService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BattleScenarios = require(Shared.Data.BattleScenarios)
local TravelRoute = require(Shared.Data.TravelRoute)
local BattleLoadout = require(script.Parent.Modules.BattleLoadout)
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local battleFolder = remotesFolder:WaitForChild("Battle")
local shopFolder = remotesFolder:WaitForChild("Shop")
local showBattleMessage = battleFolder:WaitForChild("ShowBattleMessage") :: RemoteEvent
local showBattleSummary = battleFolder:WaitForChild("ShowBattleSummary") :: RemoteEvent
local playReenactment = battleFolder:WaitForChild("PlayReenactment") :: RemoteEvent
local requestJoinBattle = battleFolder:WaitForChild("RequestJoinBattle") :: RemoteEvent

local scenarioById = {}
local queues = {}
local queueCountdowns = {}
local activeSessions = {}
local playerToSession = {}
local promptConnections = {}
local startSession
local startFinalBossPhase
local COMBATANT_TAG = "BattleCombatant"

for _, scenario in ipairs(BattleScenarios) do
    scenarioById[scenario.Id] = scenario
    queues[scenario.Id] = {}
end

local function sendMessage(playersList, text: string, duration: number?)
    for _, player in ipairs(playersList) do
        showBattleMessage:FireClient(player, {
            Text = text,
            Duration = duration or 4,
        })
    end
end

local function awardKnowledgeTokens(player: Player, amount: number, reason: string)
    if amount <= 0 then
        return
    end

    local bindable = shopFolder:FindFirstChild("GrantCurrency")

    if bindable and bindable:IsA("BindableEvent") then
        bindable:Fire(player, amount, reason)
        return
    end

    local currentTokens = player:GetAttribute("KnowledgeTokens")

    if type(currentTokens) ~= "number" then
        currentTokens = 0
    end

    player:SetAttribute("KnowledgeTokens", currentTokens + amount)
end

local function removePlayerFromQueues(player: Player)
    for _, queuedPlayers in pairs(queues) do
        for index = #queuedPlayers, 1, -1 do
            if queuedPlayers[index] == player then
                table.remove(queuedPlayers, index)
            end
        end
    end
end

local function startQueueCountdown(scenarioId: string)
    if queueCountdowns[scenarioId] then
        return
    end

    local scenario = scenarioById[scenarioId]

    if not scenario then
        return
    end

    queueCountdowns[scenarioId] = true

    task.spawn(function()
        task.wait(scenario.CountdownSeconds)
        queueCountdowns[scenarioId] = nil

        if not activeSessions[scenarioId] then
            startSession(scenarioId)
        end
    end)
end

local function getArenaFolder(scenarioId: string): Folder?
    local arenasFolder = Workspace:FindFirstChild("GeneratedBattles")

    if not arenasFolder then
        return nil
    end

    local arenaFolder = arenasFolder:FindFirstChild(scenarioId)

    if arenaFolder and arenaFolder:IsA("Folder") then
        return arenaFolder
    end

    return nil
end

local function getAnchors(container: Instance, childName: string): { BasePart }
    local results = {}
    local child = container:FindFirstChild(childName)

    if not child then
        return results
    end

    for _, descendant in ipairs(child:GetChildren()) do
        if descendant:IsA("BasePart") then
            table.insert(results, descendant)
        end
    end

    table.sort(results, function(a, b)
        return a.Name < b.Name
    end)

    return results
end

local function getAveragePosition(parts: { BasePart }): Vector3?
    if #parts == 0 then
        return nil
    end

    local total = Vector3.zero

    for _, part in ipairs(parts) do
        total += part.Position
    end

    return total / #parts
end

local function getAverageVector(values: { Vector3 }): Vector3?
    if #values == 0 then
        return nil
    end

    local total = Vector3.zero

    for _, value in ipairs(values) do
        total += value
    end

    return total / #values
end

local function getTeamAdvanceVector(scenario, teamId: string): Vector3
    return scenario.Teams[1].Id == teamId and Vector3.new(1, 0, 0) or Vector3.new(-1, 0, 0)
end

local function buildFormationPositions(scenario, teamId: string, count: number, dummyAnchors: { BasePart }, spawnAnchors: { BasePart }): { Vector3 }
    local results = {}
    local basePosition = getAveragePosition(dummyAnchors) or getAveragePosition(spawnAnchors)

    if not basePosition and scenario.SpawnPositions and scenario.SpawnPositions[teamId] and #scenario.SpawnPositions[teamId] > 0 then
        basePosition = getAverageVector(scenario.SpawnPositions[teamId])
    end

    if not basePosition then
        basePosition = Vector3.zero
    end

    local advance = getTeamAdvanceVector(scenario, teamId)
    local sideways = Vector3.new(0, 0, 1)
    local columnOffsets = { 0, -1, 1, -2, 2, -3 }
    local rowSpacing = 9.5
    local columnSpacing = 10.5

    for index = 1, count do
        local row = math.floor((index - 1) / #columnOffsets)
        local column = columnOffsets[((index - 1) % #columnOffsets) + 1]
        local lateralOffset = sideways * (column * columnSpacing)
        local depthOffset = advance * (-row * rowSpacing)
        local stagger = advance * (((index % 2 == 0) and 1 or -1) * 0.8)
        table.insert(results, basePosition + lateralOffset + depthOffset + stagger)
    end

    return results
end

local function getDummyBotStyle(formationIndex: number, teamSize: number): string
    local row = math.floor((formationIndex - 1) / 6)

    if row >= 2 and (formationIndex % 2 == 0 or formationIndex > math.floor(teamSize * 0.6)) then
        return "Archer"
    end

    return "Melee"
end

local function getCharacter(player: Player): Model?
    if player.Character then
        return player.Character
    end

    local ok, character = pcall(function()
        return player.CharacterAdded:Wait()
    end)

    if ok then
        return character
    end

    return nil
end

local function getReadyCharacter(player: Player, timeoutSeconds: number): Model?
    local deadline = os.clock() + timeoutSeconds

    while os.clock() < deadline do
        local character = player.Character

        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local root = character:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
                return character
            end
        end

        task.wait(0.15)
    end

    return nil
end

local function teleportCharacterToAnchor(character: Model, anchor: BasePart)
    character:PivotTo(anchor.CFrame * CFrame.new(0, 4, 0))
end

local function createDummy(parent: Instance, name: string, teamId: string, scenarioId: string, position: Vector3, accentColor: Color3, isCommander: boolean?, commanderHealth: number?, botStyle: string?): Model
    local scale = isCommander and 1.45 or 1
    local model = Instance.new("Model")
    model.Name = name
    model:SetAttribute("BattleTeam", teamId)
    model:SetAttribute("ScenarioId", scenarioId)
    model:SetAttribute("BattleCommander", isCommander == true)
    model:SetAttribute("BotStyle", botStyle or "Melee")
    model.Parent = parent

    local limbs = {}

    local function createVisualPart(partName: string, size: Vector3, color: Color3, material: Enum.Material, cframe: CFrame): Part
        local part = Instance.new("Part")
        part.Name = partName
        part.Size = size
        part.Color = color
        part.Material = material
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CFrame = cframe
        part.Parent = model

        return part
    end

    local root = Instance.new("Part")
    root.Name = "HumanoidRootPart"
    root.Size = Vector3.new(2, 2, 1) * scale
    root.Transparency = 1
    root.Anchored = true
    root.CanCollide = false
    root.CFrame = CFrame.new(position + Vector3.new(0, 3 * scale, 0))
    root.Parent = model

    local torso = Instance.new("Part")
    torso.Name = "Torso"
    torso.Size = Vector3.new(2.4, 2.8, 1.35) * scale
    torso.Anchored = true
    torso.Color = accentColor
    torso.Material = Enum.Material.Fabric
    torso.CFrame = CFrame.new(position + Vector3.new(0, 3.1 * scale, 0))
    torso.Parent = model

    local head = Instance.new("Part")
    head.Name = "Head"
    head.Shape = Enum.PartType.Ball
    head.Size = Vector3.new(2, 2, 2) * scale
    head.Anchored = true
    head.Color = Color3.fromRGB(232, 201, 167)
    head.CFrame = CFrame.new(position + Vector3.new(0, 5.2 * scale, 0))
    head.Parent = model

    local wrap = Instance.new("Part")
    wrap.Name = "HeadWrap"
    wrap.Shape = Enum.PartType.Ball
    wrap.Size = Vector3.new(2.15, 0.9, 2.15) * scale
    wrap.Anchored = true
    wrap.Color = isCommander and Color3.fromRGB(106, 58, 35) or accentColor
    wrap.Material = Enum.Material.Fabric
    wrap.CFrame = CFrame.new(position + Vector3.new(0, 5.88 * scale, 0))
    wrap.Parent = model

    createVisualPart("ShoulderMantle", Vector3.new(3.2, 0.55, 1.8) * scale, isCommander and Color3.fromRGB(132, 78, 52) or Color3.fromRGB(
        math.clamp(math.floor(accentColor.R * 255) + 24, 0, 255),
        math.clamp(math.floor(accentColor.G * 255) + 20, 0, 255),
        math.clamp(math.floor(accentColor.B * 255) + 18, 0, 255)
    ), Enum.Material.Fabric, CFrame.new(position + Vector3.new(0, 4.1 * scale, 0)))
    createVisualPart("WaistBelt", Vector3.new(2.7, 0.32, 1.5) * scale, Color3.fromRGB(114, 79, 48), Enum.Material.Fabric, CFrame.new(position + Vector3.new(0, 2.25 * scale, 0)))
    createVisualPart("RobeSkirt", Vector3.new(2.9, 2.2, 1.8) * scale, accentColor, Enum.Material.Fabric, CFrame.new(position + Vector3.new(0, 1.42 * scale, 0)))
    createVisualPart("TurbanTail", Vector3.new(0.35, 1.7, 0.75) * scale, wrap.Color, Enum.Material.Fabric, CFrame.new(position + Vector3.new(-0.5, 4.85, 0.85) * scale) * CFrame.Angles(math.rad(18), 0, math.rad(10)))
    createVisualPart("SandalLeft", Vector3.new(0.72, 0.22, 1.18) * scale, Color3.fromRGB(96, 67, 43), Enum.Material.Fabric, CFrame.new(position + Vector3.new(-0.5, 0.05, 0.1) * scale))
    createVisualPart("SandalRight", Vector3.new(0.72, 0.22, 1.18) * scale, Color3.fromRGB(96, 67, 43), Enum.Material.Fabric, CFrame.new(position + Vector3.new(0.5, 0.05, 0.1) * scale))

    for partName, offset in pairs({
        ["Left Arm"] = Vector3.new(-1.5, 3, 0),
        ["Right Arm"] = Vector3.new(1.5, 3, 0),
        ["Left Leg"] = Vector3.new(-0.5, 1, 0),
        ["Right Leg"] = Vector3.new(0.5, 1, 0),
    }) do
        local part = Instance.new("Part")
        part.Name = partName
        part.Shape = Enum.PartType.Cylinder
        part.Size = Vector3.new(1, 2, 1) * scale
        part.Anchored = true
        part.Color = accentColor
        part.Material = Enum.Material.Fabric
        part.CFrame = CFrame.new(position + offset * scale) * CFrame.Angles(0, 0, math.rad(90))
        part.Parent = model
        limbs[partName] = part
    end

    createVisualPart("ArmCuffLeft", Vector3.new(0.9, 0.24, 0.9) * scale, GOLD_ACCENT, Enum.Material.Metal, CFrame.new(position + Vector3.new(-1.5, 3.95, 0) * scale) * CFrame.Angles(0, 0, math.rad(90)))
    createVisualPart("ArmCuffRight", Vector3.new(0.9, 0.24, 0.9) * scale, GOLD_ACCENT, Enum.Material.Metal, CFrame.new(position + Vector3.new(1.5, 3.95, 0) * scale) * CFrame.Angles(0, 0, math.rad(90)))
    createVisualPart("LegWrapLeft", Vector3.new(0.8, 0.2, 0.8) * scale, Color3.fromRGB(214, 205, 183), Enum.Material.Fabric, CFrame.new(position + Vector3.new(-0.5, 0.85, 0) * scale) * CFrame.Angles(0, 0, math.rad(90)))
    createVisualPart("LegWrapRight", Vector3.new(0.8, 0.2, 0.8) * scale, Color3.fromRGB(214, 205, 183), Enum.Material.Fabric, CFrame.new(position + Vector3.new(0.5, 0.85, 0) * scale) * CFrame.Angles(0, 0, math.rad(90)))

    if (botStyle or "Melee") == "Archer" then
        createVisualPart("BowGrip", Vector3.new(0.16, 1.8, 0.16) * scale, Color3.fromRGB(112, 76, 46), Enum.Material.Wood, CFrame.new(position + Vector3.new(1.58, 3.05, -0.35) * scale))
        createVisualPart("BowUpper", Vector3.new(0.14, 2.2, 0.14) * scale, Color3.fromRGB(129, 90, 56), Enum.Material.Wood, CFrame.new(position + Vector3.new(1.94, 4.05, -0.35) * scale) * CFrame.Angles(0, 0, math.rad(24)))
        createVisualPart("BowLower", Vector3.new(0.14, 2.2, 0.14) * scale, Color3.fromRGB(129, 90, 56), Enum.Material.Wood, CFrame.new(position + Vector3.new(1.94, 2.05, -0.35) * scale) * CFrame.Angles(0, 0, math.rad(-24)))
        createVisualPart("BowString", Vector3.new(0.06, 4.2, 0.06) * scale, Color3.fromRGB(230, 223, 202), Enum.Material.SmoothPlastic, CFrame.new(position + Vector3.new(2.24, 3.05, -0.35) * scale))
        createVisualPart("QuiverBody", Vector3.new(0.82, 2.3, 0.82) * scale, Color3.fromRGB(110, 73, 44), Enum.Material.Fabric, CFrame.new(position + Vector3.new(-0.95, 3.2, 0.72) * scale) * CFrame.Angles(math.rad(24), 0, math.rad(24)))

        for arrowIndex, yOffset in ipairs({ 0.7, 1.0, 1.3 }) do
            createVisualPart(string.format("QuiverArrow_%d", arrowIndex), Vector3.new(0.1, 1.45, 0.1) * scale, Color3.fromRGB(205, 200, 191), Enum.Material.Metal, CFrame.new(position + Vector3.new(-0.95, 3.6 + yOffset, 0.72) * scale) * CFrame.Angles(math.rad(24), 0, math.rad(24)))
        end
    else
        createVisualPart("SwordHandle", Vector3.new(0.24, 1.2, 0.24) * scale, Color3.fromRGB(98, 66, 38), Enum.Material.Wood, CFrame.new(position + Vector3.new(1.62, 2.62, -0.2) * scale))
        createVisualPart("SwordGuard", Vector3.new(1.35, 0.16, 0.24) * scale, Color3.fromRGB(179, 149, 87), Enum.Material.Metal, CFrame.new(position + Vector3.new(1.62, 3.18, -0.2) * scale))
        createVisualPart("SwordBlade", Vector3.new(0.16, 2.8, 0.24) * scale, Color3.fromRGB(216, 216, 216), Enum.Material.Metal, CFrame.new(position + Vector3.new(1.62, 4.62, -0.2) * scale))

        if limbs["Left Arm"] then
            createVisualPart("ShieldPlate", Vector3.new(0.2, 2.4, 1.9) * scale, Color3.fromRGB(95, 72, 46), Enum.Material.WoodPlanks, CFrame.new(position + Vector3.new(-2.15, 3.05, 0) * scale) * CFrame.Angles(0, 0, math.rad(90)))
            createVisualPart("ShieldBoss", Vector3.new(0.36, 0.66, 0.66) * scale, Color3.fromRGB(192, 160, 90), Enum.Material.Metal, CFrame.new(position + Vector3.new(-2.3, 3.05, 0) * scale) * CFrame.Angles(0, 0, math.rad(90)))
        end
    end

    if isCommander then
        createVisualPart("CommanderShoulderLeft", Vector3.new(1.25, 0.5, 1.5) * scale, Color3.fromRGB(205, 165, 91), Enum.Material.Metal, CFrame.new(position + Vector3.new(-1.42, 4.2, 0) * scale))
        createVisualPart("CommanderShoulderRight", Vector3.new(1.25, 0.5, 1.5) * scale, Color3.fromRGB(205, 165, 91), Enum.Material.Metal, CFrame.new(position + Vector3.new(1.42, 4.2, 0) * scale))
        local cape = Instance.new("Part")
        cape.Name = "CommanderCape"
        cape.Size = Vector3.new(3.4, 4.2, 0.4) * scale
        cape.Anchored = true
        cape.CanCollide = false
        cape.Color = Color3.fromRGB(119, 60, 36)
        cape.Material = Enum.Material.Fabric
        cape.CFrame = CFrame.new(position + Vector3.new(0, 2.75 * scale, 0.95 * scale))
        cape.Parent = model

        local crest = Instance.new("Part")
        crest.Name = "CommanderCrest"
        crest.Size = Vector3.new(0.8, 1.6, 1.8) * scale
        crest.Anchored = true
        crest.Color = Color3.fromRGB(218, 173, 86)
        crest.Material = Enum.Material.Metal
        crest.CFrame = CFrame.new(position + Vector3.new(0, 6.45 * scale, 0))
        crest.Parent = model
    end

    local humanoid = Instance.new("Humanoid")
    humanoid.MaxHealth = commanderHealth or (isCommander and 240 or 90)
    humanoid.Health = humanoid.MaxHealth
    humanoid.DisplayName = name
    humanoid.Parent = model

    model.PrimaryPart = root

    return model
end

local function getHubReturnAnchor(): BasePart?
    local worldFolder = Workspace:FindFirstChild(TravelRoute.WorldFolderName)

    if not worldFolder then
        return nil
    end

    local teleportFolder = worldFolder:FindFirstChild("TeleportPoints")

    if not teleportFolder then
        return nil
    end

    local anchor = teleportFolder:FindFirstChild(TravelRoute.StartDestinationId)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function getSpectatorAnchor(arenaFolder: Folder): BasePart?
    local anchor = arenaFolder:FindFirstChild("SpectatorAnchor")

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function setCharacterAttributes(character: Model, scenarioId: string?, teamId: string?)
    character:SetAttribute("ScenarioId", scenarioId)
    character:SetAttribute("BattleTeam", teamId)
end

local function clearCommanderVisuals(character: Model)
    local existingHighlight = character:FindFirstChild("CommanderHighlight")

    if existingHighlight then
        existingHighlight:Destroy()
    end

    local existingBadge = character:FindFirstChild("CommanderBadge")

    if existingBadge then
        existingBadge:Destroy()
    end
end

local function clearCombatantTag(character: Model)
    if CollectionService:HasTag(character, COMBATANT_TAG) then
        CollectionService:RemoveTag(character, COMBATANT_TAG)
    end

    character:SetAttribute("BattleCommander", nil)
    character:SetAttribute("BattleCommanderName", nil)
    clearCommanderVisuals(character)
end

local function applyCommanderVisuals(character: Model, label: string, color: Color3)
    clearCommanderVisuals(character)

    local highlight = Instance.new("Highlight")
    highlight.Name = "CommanderHighlight"
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 219, 128)
    highlight.FillTransparency = 0.72
    highlight.OutlineTransparency = 0.08
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root or not root:IsA("BasePart") then
        return
    end

    local badge = Instance.new("BillboardGui")
    badge.Name = "CommanderBadge"
    badge.AlwaysOnTop = true
    badge.Size = UDim2.fromOffset(210, 54)
    badge.StudsOffset = Vector3.new(0, 7, 0)
    badge.Parent = character
    badge.Adornee = root

    local labelGui = Instance.new("TextLabel")
    labelGui.BackgroundColor3 = Color3.fromRGB(38, 28, 22)
    labelGui.BackgroundTransparency = 0.12
    labelGui.Size = UDim2.fromScale(1, 1)
    labelGui.Font = Enum.Font.GothamBold
    labelGui.Text = label
    labelGui.TextColor3 = Color3.fromRGB(255, 235, 185)
    labelGui.TextScaled = true
    labelGui.TextWrapped = true
    labelGui.Parent = badge

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = labelGui
end

local function tagCombatant(character: Model, isCommander: boolean?, commanderLabel: string?, color: Color3?)
    if not CollectionService:HasTag(character, COMBATANT_TAG) then
        CollectionService:AddTag(character, COMBATANT_TAG)
    end

    character:SetAttribute("BattleCommander", isCommander == true)
    character:SetAttribute("BattleCommanderName", isCommander and commanderLabel or nil)

    if isCommander then
        applyCommanderVisuals(character, commanderLabel or "Commander", color or Color3.fromRGB(180, 114, 64))
    else
        clearCommanderVisuals(character)
    end
end

local function clearPlayerBattleState(player: Player)
    playerToSession[player] = nil
    BattleLoadout.ClearForPlayer(player)
    player:SetAttribute("InBattle", false)
    player:SetAttribute("CurrentScenarioId", nil)
    player:SetAttribute("CurrentBattleTeam", nil)

    if player.Character then
        clearCombatantTag(player.Character)
        setCharacterAttributes(player.Character, nil, nil)
    end
end

local function returnPlayerToHub(player: Player, delaySeconds: number)
    task.delay(delaySeconds, function()
        if not player.Parent then
            return
        end

        local returnAnchor = getHubReturnAnchor()

        if not returnAnchor then
            return
        end

        local success = pcall(function()
            player:LoadCharacter()
        end)

        if not success then
            return
        end

        local readyCharacter = getReadyCharacter(player, 10)

        if readyCharacter then
            teleportCharacterToAnchor(readyCharacter, returnAnchor)
        end
    end)
end

local function getTeamDisplayName(session, teamId: string): string
    for _, team in ipairs(session.Scenario.Teams) do
        if team.Id == teamId then
            return team.DisplayName
        end
    end

    return teamId
end

local function getTeamAccentColor(session, teamId: string): Color3
    for _, team in ipairs(session.Scenario.Teams) do
        if team.Id == teamId then
            return team.AccentColor
        end
    end

    return Color3.fromRGB(180, 114, 64)
end

local function getHumanLivingCount(session, teamId: string): number
    local living = 0

    for _, entry in ipairs(session.Teams[teamId]) do
        if entry.Alive and entry.Kind == "Player" then
            living += 1
        end
    end

    return living
end

local function cleanupSession(session)
    for _, connection in ipairs(session.Connections) do
        connection:Disconnect()
    end

    for _, dummy in ipairs(session.Dummies) do
        if dummy.Parent then
            clearCombatantTag(dummy)
            dummy:Destroy()
        end
    end
end

local function sendSummary(player: Player, scenario, winnerText: string)
    showBattleSummary:FireClient(player, {
        ScenarioName = scenario.DisplayName,
        WinnerText = winnerText,
        SummaryTitle = scenario.StorySummary.Title,
        SummaryLines = scenario.StorySummary.Lines,
    })
end

local function smoothStep(alpha: number): number
    local clamped = math.clamp(alpha, 0, 1)

    return clamped * clamped * (3 - 2 * clamped)
end

local function tweenModelTo(model: Model, targetCFrame: CFrame, duration: number)
    local startCFrame = model:GetPivot()
    local elapsed = 0

    while elapsed < duration and model.Parent do
        elapsed += RunService.Heartbeat:Wait()
        local alpha = smoothStep(elapsed / duration)
        model:PivotTo(startCFrame:Lerp(targetCFrame, alpha))
    end

    if model.Parent then
        model:PivotTo(targetCFrame)
    end
end

local function playCinematicArrow(origin: Vector3, target: Vector3, color: Color3, duration: number)
    local arrow = Instance.new("Part")
    arrow.Name = "CinematicArrow"
    arrow.Size = Vector3.new(0.18, 0.18, 3.8)
    arrow.Color = Color3.fromRGB(118, 79, 45)
    arrow.Material = Enum.Material.Wood
    arrow.Anchored = true
    arrow.CanCollide = false
    arrow.CanTouch = false
    arrow.CanQuery = false
    arrow.CFrame = CFrame.lookAt(origin, target)
    arrow.Parent = Workspace

    local headAttachment = Instance.new("Attachment")
    headAttachment.Position = Vector3.new(0, 0, -1.9)
    headAttachment.Parent = arrow

    local tailAttachment = Instance.new("Attachment")
    tailAttachment.Position = Vector3.new(0, 0, 1.9)
    tailAttachment.Parent = arrow

    local trail = Instance.new("Trail")
    trail.Attachment0 = headAttachment
    trail.Attachment1 = tailAttachment
    trail.Color = ColorSequence.new(color, Color3.fromRGB(236, 214, 164))
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.08),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.Lifetime = 0.14
    trail.MinLength = 0.12
    trail.Parent = arrow

    Debris:AddItem(arrow, duration + 0.5)

    task.spawn(function()
        local elapsed = 0

        while elapsed < duration and arrow.Parent do
            elapsed += RunService.Heartbeat:Wait()
            local alpha = smoothStep(elapsed / duration)
            local position = origin:Lerp(target, alpha)
            local nextAlpha = math.min(alpha + 0.02, 1)
            local lookTarget = origin:Lerp(target, nextAlpha)
            arrow.CFrame = CFrame.lookAt(position, lookTarget)
        end

        if arrow.Parent then
            arrow:Destroy()
        end
    end)
end

local function getReenactmentPart(arenaFolder: Folder, folderName: string, partName: string): BasePart?
    local reenactmentFolder = arenaFolder:FindFirstChild("Reenactment")
    local innerFolder = reenactmentFolder and reenactmentFolder:FindFirstChild(folderName)
    local part = innerFolder and innerFolder:FindFirstChild(partName)

    if part and part:IsA("BasePart") then
        return part
    end

    return nil
end

local function getBriefingPart(arenaFolder: Folder, folderName: string, partName: string): BasePart?
    local briefingFolder = arenaFolder:FindFirstChild("Briefing")
    local innerFolder = briefingFolder and briefingFolder:FindFirstChild(folderName)
    local part = innerFolder and innerFolder:FindFirstChild(partName)

    if part and part:IsA("BasePart") then
        return part
    end

    return nil
end

local function getBriefingActor(arenaFolder: Folder, actorName: string): Model?
    local briefingFolder = arenaFolder:FindFirstChild("Briefing")
    local actorsFolder = briefingFolder and briefingFolder:FindFirstChild("Actors")
    local actor = actorsFolder and actorsFolder:FindFirstChild(actorName)

    if actor and actor:IsA("Model") then
        return actor
    end

    return nil
end

local function getBriefingActorsWithPrefix(arenaFolder: Folder, prefix: string): { Model }
    local results = {}
    local briefingFolder = arenaFolder:FindFirstChild("Briefing")
    local actorsFolder = briefingFolder and briefingFolder:FindFirstChild("Actors")

    if not actorsFolder then
        return results
    end

    for _, child in ipairs(actorsFolder:GetChildren()) do
        if child:IsA("Model") and string.sub(child.Name, 1, #prefix) == prefix then
            table.insert(results, child)
        end
    end

    table.sort(results, function(a, b)
        return a.Name < b.Name
    end)

    return results
end

local function getReenactmentActor(arenaFolder: Folder, actorName: string): Model?
    local reenactmentFolder = arenaFolder:FindFirstChild("Reenactment")
    local actorsFolder = reenactmentFolder and reenactmentFolder:FindFirstChild("Actors")
    local actor = actorsFolder and actorsFolder:FindFirstChild(actorName)

    if actor and actor:IsA("Model") then
        return actor
    end

    return nil
end

local function getReenactmentActorsWithPrefix(arenaFolder: Folder, prefix: string): { Model }
    local results = {}
    local reenactmentFolder = arenaFolder:FindFirstChild("Reenactment")
    local actorsFolder = reenactmentFolder and reenactmentFolder:FindFirstChild("Actors")

    if not actorsFolder then
        return results
    end

    for _, child in ipairs(actorsFolder:GetChildren()) do
        if child:IsA("Model") and string.sub(child.Name, 1, #prefix) == prefix then
            table.insert(results, child)
        end
    end

    table.sort(results, function(a, b)
        return a.Name < b.Name
    end)

    return results
end

local function tweenPartTo(part: BasePart, targetCFrame: CFrame, duration: number)
    local startCFrame = part.CFrame
    local elapsed = 0

    while elapsed < duration and part.Parent do
        elapsed += RunService.Heartbeat:Wait()
        local alpha = smoothStep(elapsed / duration)
        part.CFrame = startCFrame:Lerp(targetCFrame, alpha)
    end

    if part.Parent then
        part.CFrame = targetCFrame
    end
end

local function animateBriefing(session)
    if session.Scenario.Id == "uhud" then
        local medinaLead = getBriefingActor(session.Arena, "BriefingMedinaLead")
        local medinaSupport = getBriefingActor(session.Arena, "BriefingMedinaSupport")
        local makkahLead = getBriefingActor(session.Arena, "BriefingMakkahLead")
        local makkahSupport = getBriefingActor(session.Arena, "BriefingMakkahSupport")
        local medinaLeadStart = getBriefingPart(session.Arena, "Markers", "BriefingMedinaLeadStart")
        local medinaLeadAdvance = getBriefingPart(session.Arena, "Markers", "BriefingMedinaLeadAdvance")
        local medinaSupportStart = getBriefingPart(session.Arena, "Markers", "BriefingMedinaSupportStart")
        local medinaSupportAdvance = getBriefingPart(session.Arena, "Markers", "BriefingMedinaSupportAdvance")
        local makkahLeadStart = getBriefingPart(session.Arena, "Markers", "BriefingMakkahLeadStart")
        local makkahLeadAdvance = getBriefingPart(session.Arena, "Markers", "BriefingMakkahLeadAdvance")
        local makkahSupportStart = getBriefingPart(session.Arena, "Markers", "BriefingMakkahSupportStart")
        local makkahSupportAdvance = getBriefingPart(session.Arena, "Markers", "BriefingMakkahSupportAdvance")
        local medinaRanks = getBriefingActorsWithPrefix(session.Arena, "BriefingMedinaRank")
        local makkahRanks = getBriefingActorsWithPrefix(session.Arena, "BriefingMakkahRank")
        local briefingArchers = getBriefingActorsWithPrefix(session.Arena, "BriefingArcher")

        if medinaLead and medinaSupport and makkahLead and makkahSupport and medinaLeadStart and medinaLeadAdvance and medinaSupportStart and medinaSupportAdvance and makkahLeadStart and makkahLeadAdvance and makkahSupportStart and makkahSupportAdvance then
            medinaLead:PivotTo(medinaLeadStart.CFrame)
            medinaSupport:PivotTo(medinaSupportStart.CFrame)
            makkahLead:PivotTo(makkahLeadStart.CFrame)
            makkahSupport:PivotTo(makkahSupportStart.CFrame)

            for index, actor in ipairs(medinaRanks) do
                local startCFrame = actor:GetPivot()
                actor:PivotTo(startCFrame)

                task.spawn(function()
                    task.wait(0.8 + index * 0.15)
                    tweenModelTo(actor, startCFrame * CFrame.new(16, 0, (index % 2 == 0) and -4 or 4), 2.1)
                end)
            end

            for index, actor in ipairs(makkahRanks) do
                local startCFrame = actor:GetPivot()
                actor:PivotTo(startCFrame)

                task.spawn(function()
                    task.wait(4.1 + index * 0.14)
                    tweenModelTo(actor, startCFrame * CFrame.new(-20, -8, (index % 2 == 0) and 3 or -3), 2.2)
                end)
            end

            for index, actor in ipairs(briefingArchers) do
                local startCFrame = actor:GetPivot()
                actor:PivotTo(startCFrame)

                task.spawn(function()
                    task.wait(2.4 + index * 0.14)
                    tweenModelTo(actor, startCFrame * CFrame.new(1.2, 0, 0), 0.24)
                    task.wait(0.12)
                    local arrowOrigin = (actor:GetPivot() * CFrame.new(0, 5.8, -2.2)).Position
                    local baseTarget = ((index % 2 == 0) and makkahLeadAdvance or makkahSupportAdvance).Position
                    local arrowTarget = baseTarget + Vector3.new(index * 2, 4, (index % 2 == 0) and 6 or -6)
                    playCinematicArrow(arrowOrigin, arrowTarget, Color3.fromRGB(96, 151, 108), 0.48)
                    task.wait(0.18)
                    tweenModelTo(actor, startCFrame, 0.22)
                end)
            end

            task.spawn(function()
                task.wait(1.1)
                tweenModelTo(medinaLead, medinaLeadAdvance.CFrame, 2.2)
            end)

            task.spawn(function()
                task.wait(1.4)
                tweenModelTo(medinaSupport, medinaSupportAdvance.CFrame, 2.4)
            end)

            task.spawn(function()
                task.wait(4.2)
                tweenModelTo(makkahLead, makkahLeadAdvance.CFrame, 2.3)
            end)

            task.spawn(function()
                task.wait(4.5)
                tweenModelTo(makkahSupport, makkahSupportAdvance.CFrame, 2.5)
            end)

            return
        end
    end

    local medinaMarker = getBriefingPart(session.Arena, "Markers", "MedinaMapMarker")
    local makkahMarker = getBriefingPart(session.Arena, "Markers", "MakkahMapMarker")
    local medinaTarget = getBriefingPart(session.Arena, "Markers", "MedinaMapTarget")
    local makkahTarget = getBriefingPart(session.Arena, "Markers", "MakkahMapTarget")

    if not medinaMarker or not makkahMarker or not medinaTarget or not makkahTarget then
        return
    end

    local medinaStart = medinaMarker.CFrame
    local makkahStart = makkahMarker.CFrame

    medinaMarker.CFrame = medinaStart
    makkahMarker.CFrame = makkahStart

    task.spawn(function()
        task.wait(3)
        tweenPartTo(medinaMarker, medinaTarget.CFrame, 4)
        task.wait(3)
        tweenPartTo(medinaMarker, medinaStart, 1.2)
    end)

    task.spawn(function()
        task.wait(3.7)
        tweenPartTo(makkahMarker, makkahTarget.CFrame, 4.2)
        task.wait(2.2)
        tweenPartTo(makkahMarker, makkahStart, 1.2)
    end)
end

local function animateReenactment(session)
    local scenarioId = session.Scenario.Id
    local medinaLead = getReenactmentActor(session.Arena, "MedinaLead")
    local medinaSupport = getReenactmentActor(session.Arena, "MedinaSupport")
    local makkahLead = getReenactmentActor(session.Arena, "MakkahLead")
    local makkahSupport = getReenactmentActor(session.Arena, "MakkahSupport")
    local makkahCommander = getReenactmentActor(session.Arena, "MakkahCommander")

    if not medinaLead or not medinaSupport or not makkahLead or not makkahSupport then
        return
    end

    local medinaLeadStart = getReenactmentPart(session.Arena, "Marks", "MedinaLeadStart")
    local medinaSupportStart = getReenactmentPart(session.Arena, "Marks", "MedinaSupportStart")
    local medinaLeadAdvance = getReenactmentPart(session.Arena, "Marks", "MedinaLeadAdvance")
    local medinaSupportAdvance = getReenactmentPart(session.Arena, "Marks", "MedinaSupportAdvance")
    local makkahLeadStart = getReenactmentPart(session.Arena, "Marks", "MakkahLeadStart")
    local makkahSupportStart = getReenactmentPart(session.Arena, "Marks", "MakkahSupportStart")
    local makkahLeadRetreat = getReenactmentPart(session.Arena, "Marks", "MakkahLeadRetreat")
    local makkahSupportRetreat = getReenactmentPart(session.Arena, "Marks", "MakkahSupportRetreat")
    local makkahCommanderStart = getReenactmentPart(session.Arena, "Marks", "MakkahCommanderStart")
    local makkahCommanderAdvance = getReenactmentPart(session.Arena, "Marks", "MakkahCommanderAdvance")
    local makkahCommanderDefeat = getReenactmentPart(session.Arena, "Marks", "MakkahCommanderDefeat")

    if not medinaLeadStart or not medinaSupportStart or not medinaLeadAdvance or not medinaSupportAdvance or not makkahLeadStart or not makkahSupportStart or not makkahLeadRetreat or not makkahSupportRetreat then
        return
    end

    medinaLead:PivotTo(medinaLeadStart.CFrame)
    medinaSupport:PivotTo(medinaSupportStart.CFrame)
    makkahLead:PivotTo(makkahLeadStart.CFrame)
    makkahSupport:PivotTo(makkahSupportStart.CFrame)

    if makkahCommander and makkahCommanderStart then
        makkahCommander:PivotTo(makkahCommanderStart.CFrame)
    end

    local medinaRanks = getReenactmentActorsWithPrefix(session.Arena, "MedinaRank")
    local makkahRanks = getReenactmentActorsWithPrefix(session.Arena, "MakkahRank")
    local uhudArchers = (scenarioId == "uhud") and getReenactmentActorsWithPrefix(session.Arena, "UhudArcher") or {}

    for index, actor in ipairs(medinaRanks) do
        local startCFrame = actor:GetPivot()
        actor:PivotTo(startCFrame)
        task.spawn(function()
            task.wait(1.5 + index * 0.25)
            if scenarioId == "uhud" then
                tweenModelTo(actor, startCFrame * CFrame.new(14, 0, index % 2 == 0 and -5 or 5), 1.8)
                task.wait(1.7)
                tweenModelTo(actor, startCFrame * CFrame.new(-6, 0, index % 2 == 0 and -16 or 16), 1.5)
                task.wait(1.7)
            else
                tweenModelTo(actor, startCFrame * CFrame.new(22, 0, index % 2 == 0 and -3 or 3), 2.2)
                task.wait(4)
            end

            tweenModelTo(actor, startCFrame, 1.2)
        end)
    end

    for index, actor in ipairs(makkahRanks) do
        local startCFrame = actor:GetPivot()
        actor:PivotTo(startCFrame)
        task.spawn(function()
            task.wait(3 + index * 0.18)
            if scenarioId == "uhud" then
                tweenModelTo(actor, startCFrame * CFrame.new(-22, 0, index % 2 == 0 and 14 or -14), 2)
                task.wait(1.4)
                tweenModelTo(actor, startCFrame * CFrame.new(-8, 0, index % 2 == 0 and 20 or -20), 1.3)
                task.wait(1.2)
            else
                local retreatX = 24
                tweenModelTo(actor, startCFrame * CFrame.new(retreatX, 0, index % 2 == 0 and 8 or -8), 2.4)
                task.wait(3)
            end

            tweenModelTo(actor, startCFrame, 1.2)
        end)
    end

    if scenarioId == "uhud" then
        for index, actor in ipairs(uhudArchers) do
            local startCFrame = actor:GetPivot()
            actor:PivotTo(startCFrame)

            task.spawn(function()
                task.wait(1.2 + index * 0.16)
                tweenModelTo(actor, startCFrame * CFrame.new(1.8, 0, (index % 2 == 0) and -0.6 or 0.6), 0.35)
                task.wait(0.18)

                local arrowOrigin = (actor:GetPivot() * CFrame.new(0, 5.8, -2.4)).Position
                local arrowTarget = ((index % 2 == 0) and makkahLeadRetreat or makkahSupportRetreat).Position + Vector3.new(index * 2, 4, (index % 2 == 0) and 8 or -8)
                playCinematicArrow(arrowOrigin, arrowTarget, Color3.fromRGB(96, 151, 108), 0.52)

                task.wait(0.26)
                tweenModelTo(actor, startCFrame, 0.28)
                task.wait(1.2)

                local secondTarget = ((index % 2 == 0) and makkahLeadStart or makkahSupportStart).Position + Vector3.new(index * 2, 5, (index % 2 == 0) and 3 or -3)
                playCinematicArrow((actor:GetPivot() * CFrame.new(0, 5.8, -2.4)).Position, secondTarget, Color3.fromRGB(96, 151, 108), 0.5)
            end)
        end
    end

    task.spawn(function()
        task.wait(1)
        tweenModelTo(medinaLead, medinaLeadAdvance.CFrame, 1.6)
    end)

    task.spawn(function()
        task.wait(1.2)
        tweenModelTo(medinaSupport, medinaSupportAdvance.CFrame, 1.8)
    end)

    if scenarioId == "badr" then
        task.spawn(function()
            task.wait(3.6)
            tweenModelTo(makkahLead, makkahLeadRetreat.CFrame, 1.5)
        end)

        task.spawn(function()
            task.wait(3.9)
            tweenModelTo(makkahSupport, makkahSupportRetreat.CFrame, 1.7)
        end)
    else
        task.spawn(function()
            task.wait(3)
            tweenModelTo(makkahLead, makkahLeadRetreat.CFrame, 1.4)
        end)

        task.spawn(function()
            task.wait(3.3)
            tweenModelTo(makkahSupport, makkahSupportRetreat.CFrame, 1.6)
        end)
    end

    if makkahCommander and makkahCommanderAdvance and makkahCommanderDefeat then
        task.spawn(function()
            task.wait(2.2)
            tweenModelTo(makkahCommander, makkahCommanderAdvance.CFrame, 2)
            task.wait(2.8)
            if scenarioId == "uhud" then
                tweenModelTo(makkahCommander, makkahCommanderDefeat.CFrame, 1.8)
            else
                tweenModelTo(makkahCommander, makkahCommanderDefeat.CFrame * CFrame.Angles(0, 0, math.rad(68)), 1.8)
            end
        end)
    end
end

local function buildReenactmentPayload(session, winnerText: string)
    local scenario = session.Scenario
    local scenePayloads = {}

    if not scenario.Reenactment or not scenario.Reenactment.Scenes then
        return nil
    end

    for _, scene in ipairs(scenario.Reenactment.Scenes) do
        local cameraPart = getReenactmentPart(session.Arena, "Cameras", scene.CameraName)

        if cameraPart then
            table.insert(scenePayloads, {
                Title = scene.Title,
                Body = scene.Body,
                Reference = scene.Reference,
                DurationSeconds = scene.DurationSeconds,
                CameraCFrame = cameraPart.CFrame,
                CameraDrift = scene.CameraDrift,
                FieldOfView = scene.FieldOfView,
            })
        end
    end

    if #scenePayloads == 0 then
        return nil
    end

    return {
        Kind = "Reenactment",
        ScenarioName = scenario.DisplayName,
        WinnerText = winnerText,
        IntroTitle = scenario.Reenactment.IntroTitle,
        Scenes = scenePayloads,
    }
end

local function buildBriefingPayload(session)
    local scenario = session.Scenario
    local scenePayloads = {}

    if not scenario.Briefing or not scenario.Briefing.Scenes then
        return nil
    end

    for _, scene in ipairs(scenario.Briefing.Scenes) do
        local cameraPart = getBriefingPart(session.Arena, "Cameras", scene.CameraName)

        if cameraPart then
            table.insert(scenePayloads, {
                Title = scene.Title,
                Body = scene.Body,
                Reference = scene.Reference,
                DurationSeconds = scene.DurationSeconds,
                CameraCFrame = cameraPart.CFrame,
                CameraDrift = scene.CameraDrift,
                FieldOfView = scene.FieldOfView,
            })
        end
    end

    if #scenePayloads == 0 then
        return nil
    end

    return {
        Kind = "Briefing",
        ScenarioName = scenario.DisplayName,
        WinnerText = "",
        IntroTitle = scenario.Briefing.IntroTitle,
        Scenes = scenePayloads,
    }
end

local function freezePlayersForCutscene(playersList)
    for _, player in ipairs(playersList) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            humanoid.AutoRotate = false
        end
    end
end

local function unfreezePlayersForBattle(playersList)
    for _, player in ipairs(playersList) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if humanoid and humanoid.Health > 0 then
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
            humanoid.AutoRotate = true
        end
    end
end

local function respawnPlayerToSpectator(player: Player, session)
    if session.Ended or not player.Parent then
        return
    end

    local spectatorAnchor = getSpectatorAnchor(session.Arena)

    if not spectatorAnchor then
        return
    end

    BattleLoadout.ClearForPlayer(player)
    player:SetAttribute("InBattle", false)
    player:SetAttribute("CurrentBattleTeam", nil)

    local success = pcall(function()
        player:LoadCharacter()
    end)

    if not success then
        return
    end

    local character = getReadyCharacter(player, 10)

    if not character then
        return
    end

    setCharacterAttributes(character, nil, nil)
    character:PivotTo(spectatorAnchor.CFrame)
end

local function endSession(session, winnerTeamId: string?, reason: string)
    if session.Ended then
        return
    end

    session.Ended = true
    activeSessions[session.Scenario.Id] = nil

    local winnerText = "Round complete."

    if winnerTeamId and reason ~= "" then
        winnerText = reason
    elseif winnerTeamId then
        for _, team in ipairs(session.Scenario.Teams) do
            if team.Id == winnerTeamId then
                winnerText = string.format("%s wins the round.", team.DisplayName)
                break
            end
        end
    elseif reason ~= "" then
        winnerText = reason
    end

    task.spawn(function()
        freezePlayersForCutscene(session.Players)

        local payload = buildReenactmentPayload(session, winnerText)
        local totalDuration = 0

        if payload then
            animateReenactment(session)

            for _, scene in ipairs(payload.Scenes) do
                totalDuration += scene.DurationSeconds or 5
            end

            for _, player in ipairs(session.Players) do
                playReenactment:FireClient(player, payload)
            end
        else
            totalDuration = 6

            for _, player in ipairs(session.Players) do
                sendSummary(player, session.Scenario, winnerText)
            end
        end

        task.wait(totalDuration + 0.4)

        for _, player in ipairs(session.Players) do
            awardKnowledgeTokens(player, session.Scenario.Rewards.KnowledgeTokens or 0, string.format("%s complete", session.Scenario.DisplayName))
            clearPlayerBattleState(player)
            returnPlayerToHub(player, 0.15)
        end

        cleanupSession(session)

        if #queues[session.Scenario.Id] > 0 then
            startQueueCountdown(session.Scenario.Id)
        end
    end)
end

local function evaluateVictory(session)
    local firstTeamId = session.Scenario.Teams[1].Id
    local secondTeamId = session.Scenario.Teams[2].Id
    local firstStartedHumans = session.InitialHumanCounts[firstTeamId] or 0
    local secondStartedHumans = session.InitialHumanCounts[secondTeamId] or 0
    local finalBossConfig = getFinalBossConfig(session)

    local firstLivingHumans = getHumanLivingCount(session, firstTeamId)
    local secondLivingHumans = getHumanLivingCount(session, secondTeamId)

    if finalBossConfig and session.FinalBossPhaseStarted then
        local winningTeamId = session.FinalBossWinningTeamId
        local defeatedTeamId = session.FinalBossDefeatedTeamId

        if winningTeamId and getHumanLivingCount(session, winningTeamId) <= 0 then
            endSession(
                session,
                defeatedTeamId,
                string.format("%s lost the final push before defeating the boss.", getTeamDisplayName(session, winningTeamId))
            )
        end

        return
    end

    if finalBossConfig then
        if firstLivingHumans <= 0 and secondLivingHumans <= 0 then
            endSession(session, nil, "Both player teams fell before the final stand.")
        elseif firstLivingHumans > 0 and secondLivingHumans <= 0 then
            startFinalBossPhase(session, firstTeamId, secondTeamId)
        elseif secondLivingHumans > 0 and firstLivingHumans <= 0 then
            startFinalBossPhase(session, secondTeamId, firstTeamId)
        end

        return
    end

    if firstStartedHumans > 0 and secondStartedHumans > 0 then
        if firstLivingHumans <= 0 and secondLivingHumans <= 0 then
            endSession(session, nil, "Both player teams fell. The round ended in a draw.")
        elseif firstLivingHumans <= 0 then
            endSession(session, secondTeamId, string.format("%s players held the field after the opposing players fell.", getTeamDisplayName(session, secondTeamId)))
        elseif secondLivingHumans <= 0 then
            endSession(session, firstTeamId, string.format("%s players held the field after the opposing players fell.", getTeamDisplayName(session, firstTeamId)))
        end

        return
    end

    if firstStartedHumans > 0 and firstLivingHumans <= 0 then
        endSession(session, secondTeamId, string.format("%s players were defeated before finishing the objective.", getTeamDisplayName(session, firstTeamId)))
        return
    end

    if secondStartedHumans > 0 and secondLivingHumans <= 0 then
        endSession(session, firstTeamId, string.format("%s players were defeated before finishing the objective.", getTeamDisplayName(session, secondTeamId)))
    end
end

local function getCommanderConfig(session)
    return session.Scenario.Commander
end

local function getFinalBossConfig(session)
    local finalBossPhase = session.Scenario.FinalBossPhase

    if not finalBossPhase or finalBossPhase.Enabled ~= true then
        return nil
    end

    return finalBossPhase
end

local function shouldAssignCommander(session, teamId: string): boolean
    if getFinalBossConfig(session) then
        return false
    end

    local commander = getCommanderConfig(session)

    if not commander then
        return false
    end

    return commander.TeamId == teamId and not session.CommanderEntry
end

local function configureCommanderEntry(session, entry, teamAccentColor: Color3)
    local commander = getCommanderConfig(session)

    if not entry.IsCommander then
        return
    end

    session.CommanderEntry = entry
    local displayName = entry.BossName or (commander and commander.DisplayName) or "Commander"
    local bossHealth = entry.BossHealth or (commander and commander.Health) or nil

    if entry.Humanoid then
        entry.Humanoid.MaxHealth = bossHealth or entry.Humanoid.MaxHealth
        entry.Humanoid.Health = entry.Humanoid.MaxHealth
        entry.Humanoid.DisplayName = displayName
    end

    local character = entry.Model or (entry.Player and entry.Player.Character)

    if character and character:IsA("Model") then
        tagCombatant(character, true, displayName, teamAccentColor)
    end

    if entry.Player then
        sendMessage({ entry.Player }, string.format("You are the %s boss. If you fall, the scenario ends.", displayName), 6)
    end
end

local function registerEntry(session, teamId: string, entry)
    entry.TeamId = teamId
    table.insert(session.Teams[teamId], entry)
    local teamAccentColor = getTeamAccentColor(session, teamId)

    local character = entry.Model or (entry.Player and entry.Player.Character)

    if character and character:IsA("Model") and not entry.IsCommander then
        tagCombatant(character, false, nil, nil)
    end

    configureCommanderEntry(session, entry, teamAccentColor)

    local diedConnection = entry.Humanoid.Died:Connect(function()
        entry.Alive = false

        if entry.IsCommander then
            local commander = getCommanderConfig(session)
            local winnerTeamId = entry.DefeatedWinnerTeamId or (commander and commander.DefeatedWinnerTeamId) or nil
            local message = entry.DefeatedMessage or (commander and commander.DefeatedMessage) or "The commander was defeated. The scenario is complete."

            endSession(session, winnerTeamId, message)
            return
        end

        if entry.Kind == "Player" and entry.Player then
            sendMessage({ entry.Player }, "You fell in battle. You will watch the reenactment from the ridge.", 4)
            task.spawn(function()
                task.wait(1.25)
                respawnPlayerToSpectator(entry.Player, session)
            end)
        end

        evaluateVictory(session)
    end)

    table.insert(session.Connections, diedConnection)
end

startFinalBossPhase = function(session, winningTeamId: string, defeatedTeamId: string)
    if session.Ended or session.FinalBossPhaseStarted then
        return
    end

    local finalBossConfig = getFinalBossConfig(session)

    if not finalBossConfig then
        return
    end

    local bossDisplayName = (finalBossConfig.DisplayNames and finalBossConfig.DisplayNames[defeatedTeamId]) or finalBossConfig.DisplayName or "Final Commander"
    local dummyAnchors = session.DummyAnchors[defeatedTeamId] or {}
    local spawnAnchors = session.SpawnAnchors[defeatedTeamId] or {}
    local spawnPart = dummyAnchors[1] or spawnAnchors[1]

    if not spawnPart then
        return
    end

    local bossPosition = spawnPart.Position + Vector3.new(0, 0, 0)
    local boss = createDummy(
        session.Arena,
        bossDisplayName,
        defeatedTeamId,
        session.Scenario.Id,
        bossPosition,
        getTeamAccentColor(session, defeatedTeamId),
        true,
        finalBossConfig.Health or 420,
        "Melee"
    )
    local humanoid = boss:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        boss:Destroy()
        return
    end

    session.FinalBossPhaseStarted = true
    session.FinalBossWinningTeamId = winningTeamId
    session.FinalBossDefeatedTeamId = defeatedTeamId

    local winningTeamName = getTeamDisplayName(session, winningTeamId)
    local defeatedMessage = string.format(finalBossConfig.DefeatedMessageTemplate or "%s defeated the %s.", winningTeamName, bossDisplayName)
    local entry = {
        Kind = "Dummy",
        Model = boss,
        Humanoid = humanoid,
        Alive = true,
        IsCommander = true,
        BotStyle = "Melee",
        FormationIndex = 1,
        LastAttackAt = 0,
        BossName = bossDisplayName,
        BossHealth = finalBossConfig.Health or 420,
        DefeatedWinnerTeamId = winningTeamId,
        DefeatedMessage = defeatedMessage,
    }

    registerEntry(session, defeatedTeamId, entry)
    table.insert(session.Dummies, boss)
    session.FinalBossEntry = entry

    sendMessage(session.Players, string.format(finalBossConfig.StartMessageTemplate or "Final phase: defeat the %s.", bossDisplayName), 6)
end

startSession = function(scenarioId: string)
    if activeSessions[scenarioId] then
        return
    end

    local scenario = scenarioById[scenarioId]
    local arenaFolder = getArenaFolder(scenarioId)

    if not scenario or not arenaFolder then
        return
    end

    local queuedPlayers = {}
    local maxHumans = scenario.PlayersPerTeam * 2

    while #queues[scenarioId] > 0 and #queuedPlayers < maxHumans do
        table.insert(queuedPlayers, table.remove(queues[scenarioId], 1))
    end

    if #queuedPlayers < scenario.MinPlayersToLaunch then
        return
    end

    local session = {
        Scenario = scenario,
        Arena = arenaFolder,
        Players = queuedPlayers,
        Teams = {
            [scenario.Teams[1].Id] = {},
            [scenario.Teams[2].Id] = {},
        },
        InitialHumanCounts = {
            [scenario.Teams[1].Id] = 0,
            [scenario.Teams[2].Id] = 0,
        },
        SpawnAnchors = {},
        DummyAnchors = {},
        Dummies = {},
        Connections = {},
        Ended = false,
        CommanderEntry = nil,
        FinalBossPhaseStarted = false,
        FinalBossWinningTeamId = nil,
        FinalBossDefeatedTeamId = nil,
        FinalBossEntry = nil,
    }

    activeSessions[scenarioId] = session

    local spawnFolder = arenaFolder:FindFirstChild("Spawns")
    local dummySpawnFolder = arenaFolder:FindFirstChild("DummySpawns")

    if not spawnFolder then
        endSession(session, nil, "The arena is missing spawn points.")
        return
    end

    local teamSpawnAnchors = {
        [scenario.Teams[1].Id] = getAnchors(spawnFolder, scenario.Teams[1].Id),
        [scenario.Teams[2].Id] = getAnchors(spawnFolder, scenario.Teams[2].Id),
    }
    local teamDummyAnchors = {
        [scenario.Teams[1].Id] = dummySpawnFolder and getAnchors(dummySpawnFolder, scenario.Teams[1].Id) or {},
        [scenario.Teams[2].Id] = dummySpawnFolder and getAnchors(dummySpawnFolder, scenario.Teams[2].Id) or {},
    }

    session.SpawnAnchors = teamSpawnAnchors
    session.DummyAnchors = teamDummyAnchors

    for index, player in ipairs(queuedPlayers) do
        local team = scenario.Teams[((index - 1) % #scenario.Teams) + 1]
        local anchors = teamSpawnAnchors[team.Id]
        local anchor = nil

        if #anchors > 0 then
            anchor = anchors[((#session.Teams[team.Id]) % #anchors) + 1]
        end

        local character = getCharacter(player)

        if character and anchor then
            teleportCharacterToAnchor(character, anchor)
            setCharacterAttributes(character, scenario.Id, team.Id)
            player:SetAttribute("InBattle", true)
            player:SetAttribute("CurrentScenarioId", scenario.Id)
            player:SetAttribute("CurrentBattleTeam", team.Id)
            BattleLoadout.GiveToPlayer(player)

            local humanoid = character:FindFirstChildOfClass("Humanoid")

            if humanoid then
                humanoid.WalkSpeed = 16
                humanoid.JumpPower = 50
                humanoid.AutoRotate = true

                registerEntry(session, team.Id, {
                    Kind = "Player",
                    Player = player,
                    Model = character,
                    Humanoid = humanoid,
                    Alive = true,
                    IsCommander = shouldAssignCommander(session, team.Id),
                })
                session.InitialHumanCounts[team.Id] += 1
                playerToSession[player] = session
            end
        end
    end

    for _, team in ipairs(scenario.Teams) do
        local dummyAnchors = teamDummyAnchors[team.Id]
        local formationPositions = buildFormationPositions(scenario, team.Id, scenario.PlayersPerTeam, dummyAnchors, teamSpawnAnchors[team.Id])

        while scenario.FillEmptySlotsWithBots ~= false and #session.Teams[team.Id] < scenario.PlayersPerTeam do
            local formationIndex = #session.Teams[team.Id] + 1
            local dummyPosition = formationPositions[formationIndex]

            if not dummyPosition then
                break
            end

            local isCommander = shouldAssignCommander(session, team.Id)
            local commander = getCommanderConfig(session)
            local botStyle = isCommander and "Melee" or getDummyBotStyle(formationIndex, scenario.PlayersPerTeam)
            local dummyName = (isCommander and commander and commander.DisplayName) or string.format("%s %s %d", team.DisplayName, botStyle, formationIndex)
            local dummy = createDummy(arenaFolder, dummyName, team.Id, scenario.Id, dummyPosition, team.AccentColor, isCommander, commander and commander.Health or nil, botStyle)
            local humanoid = dummy:FindFirstChildOfClass("Humanoid")

            if humanoid then
                registerEntry(session, team.Id, {
                    Kind = "Dummy",
                    Model = dummy,
                    Humanoid = humanoid,
                    Alive = true,
                    IsCommander = isCommander,
                    BotStyle = botStyle,
                    FormationIndex = formationIndex,
                    LastAttackAt = 0,
                })
                table.insert(session.Dummies, dummy)
            end
        end
    end

    freezePlayersForCutscene(queuedPlayers)

    local briefingPayload = buildBriefingPayload(session)
    local briefingDuration = 0

    if briefingPayload then
        animateBriefing(session)

        for _, scene in ipairs(briefingPayload.Scenes) do
            briefingDuration += scene.DurationSeconds or 5
        end

        for _, player in ipairs(queuedPlayers) do
            playReenactment:FireClient(player, briefingPayload)
        end
    end

    task.delay(briefingDuration + 0.4, function()
        if session.Ended then
            return
        end

        unfreezePlayersForBattle(queuedPlayers)
        sendMessage(queuedPlayers, string.format("%s begins now. Fight in first person with your sword and bow, then watch the reenactment at the end.", scenario.DisplayName), 6)

        if getFinalBossConfig(session) then
            sendMessage(queuedPlayers, "Win the player fight first. Then the mode shifts into one final boss stand.", 6)
        end

        sendMessage(queuedPlayers, string.format("%s now runs as a player-only battle. No filler bots spawn into the round.", scenario.DisplayName), 6)
        sendMessage(queuedPlayers, "Combat tips: left click to attack, hold and release the bow to fire, and right click to raise your shield block.", 6)
        evaluateVictory(session)

        task.delay(scenario.RoundDurationSeconds, function()
            if not session.Ended then
                endSession(session, nil, "Time is up. The round has ended.")
            end
        end)
    end)
end

local function joinQueue(player: Player, scenarioId: string)
    local scenario = scenarioById[scenarioId]

    if not scenario then
        return
    end

    if player:GetAttribute("InStory") == true then
        sendMessage({ player }, "Finish your sahabi playthrough before joining a battle.", 3)
        return
    end

    if playerToSession[player] then
        sendMessage({ player }, "You are already inside a battle round.", 3)
        return
    end

    if activeSessions[scenarioId] then
        sendMessage({ player }, string.format("%s is already running. You are queued for the next round.", scenario.DisplayName), 4)
    end

    for _, queuedPlayer in ipairs(queues[scenarioId]) do
        if queuedPlayer == player then
            sendMessage({ player }, string.format("You are already queued for %s.", scenario.DisplayName), 3)
            return
        end
    end

    removePlayerFromQueues(player)
    table.insert(queues[scenarioId], player)
    sendMessage({ player }, string.format("Queued for %s. The round will begin soon.", scenario.DisplayName), 4)
    startQueueCountdown(scenarioId)
end

requestJoinBattle.OnServerEvent:Connect(function(player: Player, scenarioId: string)
    if typeof(scenarioId) == "string" then
        joinQueue(player, scenarioId)
    end
end)

local function connectBattlePrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local scenarioId = prompt:GetAttribute("ScenarioId")

        if typeof(scenarioId) == "string" then
            joinQueue(player, scenarioId)
        end
    end)
end

task.spawn(function()
    local worldFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if not worldFolder then
        return
    end

    for _, descendant in ipairs(worldFolder:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant:GetAttribute("PromptAction") == "JoinBattle" then
            connectBattlePrompt(descendant)
        end
    end

    worldFolder.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") and descendant:GetAttribute("PromptAction") == "JoinBattle" then
            connectBattlePrompt(descendant)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    removePlayerFromQueues(player)

    local session = playerToSession[player]

    if session then
        for _, team in ipairs(session.Scenario.Teams) do
            for _, entry in ipairs(session.Teams[team.Id]) do
                if entry.Player == player then
                    entry.Alive = false
                end
            end
        end

        evaluateVictory(session)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="18">
      <Properties>
        <string name="Name">CamelMountService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CAMEL_TAG = "RideableCamel"

type CamelState = {
    Seat: VehicleSeat?,
    PromptConnections: { RBXScriptConnection },
    CurrentThrottle: number,
    CurrentSteer: number,
}

local camelStates: { [Model]: CamelState } = {}
local promptConnections: { [ProximityPrompt]: RBXScriptConnection } = {}

local function getCamelFromInstance(instance: Instance): Model?
    local current: Instance? = instance

    while current do
        if current:IsA("Model") and CollectionService:HasTag(current, CAMEL_TAG) then
            return current
        end

        current = current.Parent
    end

    return nil
end

local function getSeat(camel: Model): VehicleSeat?
    local existing = camel:FindFirstChild("CamelSeat", true)

    if existing and existing:IsA("VehicleSeat") then
        return existing
    end

    return nil
end

local function getRoot(camel: Model): BasePart?
    if camel.PrimaryPart then
        return camel.PrimaryPart
    end

    local root = camel:FindFirstChild("CamelRoot", true)

    if root and root:IsA("BasePart") then
        camel.PrimaryPart = root
        return root
    end

    return nil
end

local function setCamelPromptEnabled(camel: Model, enabled: boolean)
    for _, descendant in ipairs(camel:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant:GetAttribute("PromptAction") == "RideCamel" then
            descendant.Enabled = enabled
        end
    end
end

local function seatPlayerOnCamel(player: Player, camel: Model)
    local seat = getSeat(camel)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not seat or not humanoid or humanoid.Health <= 0 then
        return
    end

    if seat.Occupant and seat.Occupant ~= humanoid then
        return
    end

    seat:Sit(humanoid)
    setCamelPromptEnabled(camel, false)
end

local function connectPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    if prompt:GetAttribute("PromptAction") ~= "RideCamel" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local camel = getCamelFromInstance(prompt)

        if camel then
            seatPlayerOnCamel(player, camel)
        end
    end)
end

local function setupCamel(camel: Model)
    if camelStates[camel] then
        return
    end

    local seat = getSeat(camel)

    if not seat then
        return
    end

    local promptState = {
        Seat = seat,
        PromptConnections = {},
        CurrentThrottle = 0,
        CurrentSteer = 0,
    }
    camelStates[camel] = promptState

    for _, descendant in ipairs(camel:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end

    table.insert(promptState.PromptConnections, camel.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end))

    table.insert(promptState.PromptConnections, seat:GetPropertyChangedSignal("Occupant"):Connect(function()
        setCamelPromptEnabled(camel, seat.Occupant == nil)
    end))
end

local function cleanupCamel(camel: Model)
    local state = camelStates[camel]

    if not state then
        return
    end

    for _, connection in ipairs(state.PromptConnections) do
        connection:Disconnect()
    end

    camelStates[camel] = nil
end

local function getCamelControls(seat: VehicleSeat): (number?, number?)
    local occupant = seat.Occupant

    if not occupant or occupant.Health <= 0 then
        return nil, nil
    end

    local player = Players:GetPlayerFromCharacter(occupant.Parent)

    if not player or player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true then
        occupant.Sit = false
        return nil, nil
    end

    local throttle = seat.ThrottleFloat
    local steer = seat.SteerFloat

    return throttle, steer
end

RunService.Heartbeat:Connect(function(deltaTime)
    for camel, state in pairs(camelStates) do
        local seat = state.Seat
        local root = getRoot(camel)

        if not camel.Parent or not seat or not root then
            cleanupCamel(camel)
            continue
        end

        local throttle, steer = getCamelControls(seat)
        local inputAlpha = math.min(1, deltaTime * 4.8)
        state.CurrentThrottle += ((throttle or 0) - state.CurrentThrottle) * inputAlpha
        state.CurrentSteer += ((steer or 0) - state.CurrentSteer) * inputAlpha

        if math.abs(state.CurrentThrottle) > 0.015 or math.abs(state.CurrentSteer) > 0.015 then
            local speed = camel:GetAttribute("CamelSpeed")

            if type(speed) ~= "number" then
                speed = 46
            end

            local currentCFrame = camel:GetPivot()
            local turnRate = camel:GetAttribute("CamelTurnRate")

            if type(turnRate) ~= "number" then
                turnRate = 2.2
            end

            local steeredCFrame = currentCFrame * CFrame.Angles(0, -state.CurrentSteer * turnRate * deltaTime, 0)
            local forward = -steeredCFrame.RightVector
            local flatForward = Vector3.new(forward.X, 0, forward.Z)

            if flatForward.Magnitude > 0.01 then
                local nextPosition = steeredCFrame.Position + flatForward.Unit * state.CurrentThrottle * speed * deltaTime
                camel:PivotTo(CFrame.new(nextPosition) * (steeredCFrame - steeredCFrame.Position))
            else
                camel:PivotTo(steeredCFrame)
            end
        end
    end
end)

for _, camel in ipairs(CollectionService:GetTagged(CAMEL_TAG)) do
    if camel:IsA("Model") then
        setupCamel(camel)
    end
end

CollectionService:GetInstanceAddedSignal(CAMEL_TAG):Connect(function(instance)
    if instance:IsA("Model") then
        setupCamel(instance)
    end
end)

CollectionService:GetInstanceRemovedSignal(CAMEL_TAG):Connect(function(instance)
    if instance:IsA("Model") then
        cleanupCamel(instance)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="19">
      <Properties>
        <string name="Name">FallGuard</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TravelRoute = require(Shared.Data.TravelRoute)

local FALL_LIMIT_Y = -20

local function findFirstBasePart(parent: Instance?): BasePart?
    if not parent then
        return nil
    end

    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("BasePart") then
            return child
        end
    end

    return nil
end

local function getHubAnchor(): BasePart?
    local hubFolder = Workspace:FindFirstChild(TravelRoute.WorldFolderName)

    if not hubFolder then
        return nil
    end

    local teleportFolder = hubFolder:FindFirstChild("TeleportPoints")

    if not teleportFolder then
        return nil
    end

    local anchor = teleportFolder:FindFirstChild(TravelRoute.StartDestinationId)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function getBattleAnchor(character: Model): BasePart?
    local scenarioId = character:GetAttribute("ScenarioId")
    local teamId = character:GetAttribute("BattleTeam")

    if typeof(scenarioId) ~= "string" or typeof(teamId) ~= "string" then
        return nil
    end

    local battlesFolder = Workspace:FindFirstChild("GeneratedBattles")
    local scenarioFolder = battlesFolder and battlesFolder:FindFirstChild(scenarioId)
    local spawns = scenarioFolder and scenarioFolder:FindFirstChild("Spawns")
    local teamFolder = spawns and spawns:FindFirstChild(teamId)

    return findFirstBasePart(teamFolder)
end

local function getStoryAnchor(player: Player): BasePart?
    local storyId = player:GetAttribute("CurrentStoryId")

    if typeof(storyId) ~= "string" then
        return nil
    end

    local storiesFolder = Workspace:FindFirstChild("GeneratedStories")
    local zoneFolder = storiesFolder and storiesFolder:FindFirstChild(storyId)
    local anchors = zoneFolder and zoneFolder:FindFirstChild("Anchors")
    local stepIndex = player:GetAttribute("CurrentStoryStepIndex")
    local preferredName = nil

    if type(stepIndex) == "number" then
        preferredName = string.format("Step_%d", stepIndex)
    end

    local preferredAnchor = preferredName and anchors and anchors:FindFirstChild(preferredName)

    if preferredAnchor and preferredAnchor:IsA("BasePart") then
        return preferredAnchor
    end

    local entryAnchor = anchors and anchors:FindFirstChild("Entry")

    if entryAnchor and entryAnchor:IsA("BasePart") then
        return entryAnchor
    end

    return nil
end

local function moveCharacterToAnchor(character: Model, anchor: BasePart)
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
        return
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    character:PivotTo(anchor.CFrame + Vector3.new(0, 5, 0))
end

task.spawn(function()
    while true do
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character

            if character then
                local root = character:FindFirstChild("HumanoidRootPart")

                if root and root:IsA("BasePart") and root.Position.Y < FALL_LIMIT_Y then
                    local anchor = getBattleAnchor(character) or getStoryAnchor(player) or getHubAnchor()

                    if anchor then
                        moveCharacterToAnchor(character, anchor)
                    end
                end
            end
        end

        task.wait(0.35)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="20">
      <Properties>
        <string name="Name">GameBootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ContentIndex = require(Shared.Modules.ContentIndex)

local function ensureFolder(parent: Instance, name: string): Folder
    local existing = parent:FindFirstChild(name)

    if existing then
        if existing:IsA("Folder") then
            return existing
        end

        error(string.format("Expected Folder named %s under %s, found %s", name, parent:GetFullName(), existing.ClassName))
    end

    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent

    return folder
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
    local existing = parent:FindFirstChild(name)

    if existing then
        if existing:IsA("RemoteEvent") then
            return existing
        end

        error(string.format("Expected RemoteEvent named %s under %s, found %s", name, parent:GetFullName(), existing.ClassName))
    end

    local remoteEvent = Instance.new("RemoteEvent")
    remoteEvent.Name = name
    remoteEvent.Parent = parent

    return remoteEvent
end

local content = ContentIndex.GetStartupPayload()
local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")

local storyFolder = ensureFolder(remotesFolder, "Story")
local battleFolder = ensureFolder(remotesFolder, "Battle")
local shopFolder = ensureFolder(remotesFolder, "Shop")
local hubFolder = ensureFolder(remotesFolder, "Hub")
local mannersFolder = ensureFolder(remotesFolder, "Manners")
local triviaFolder = ensureFolder(remotesFolder, "Trivia")

ensureRemoteEvent(hubFolder, "RequestTeleport")
ensureRemoteEvent(hubFolder, "RequestHaramTrail")
ensureRemoteEvent(hubFolder, "ShowLearningTrail")
ensureRemoteEvent(hubFolder, "UpdateLearningTrail")
ensureRemoteEvent(hubFolder, "ClearLearningTrail")
ensureRemoteEvent(battleFolder, "ShowBattleMessage")
ensureRemoteEvent(battleFolder, "ShowBattleSummary")
ensureRemoteEvent(battleFolder, "PlayReenactment")
ensureRemoteEvent(battleFolder, "RequestJoinBattle")
ensureRemoteEvent(battleFolder, "RequestBlock")
ensureRemoteEvent(storyFolder, "ShowStoryDialogue")
ensureRemoteEvent(storyFolder, "UpdateStoryMission")
ensureRemoteEvent(storyFolder, "ClearStoryMission")
ensureRemoteEvent(storyFolder, "RequestStartStory")
ensureRemoteEvent(mannersFolder, "RequestLesson")
ensureRemoteEvent(mannersFolder, "ShowMannersLesson")
ensureRemoteEvent(triviaFolder, "RequestStartTrivia")
ensureRemoteEvent(triviaFolder, "SubmitTriviaAnswer")
ensureRemoteEvent(triviaFolder, "ShowTriviaQuestion")
ensureRemoteEvent(triviaFolder, "ShowTriviaResult")
ensureRemoteEvent(triviaFolder, "UpdateTriviaScores")
ensureRemoteEvent(triviaFolder, "ClearTrivia")
ensureRemoteEvent(shopFolder, "RequestShopState")
ensureRemoteEvent(shopFolder, "PromptGamePassPurchase")
ensureRemoteEvent(shopFolder, "PromptDeveloperProductPurchase")
ensureRemoteEvent(shopFolder, "EquipSkin")
ensureRemoteEvent(shopFolder, "UseUltimate")
ensureRemoteEvent(shopFolder, "ShopState")
ensureRemoteEvent(shopFolder, "PurchaseFeedback")

print(string.format(
    "[GameBootstrap] %s loaded with %d stories, %d battle scenarios, %d travel landmarks, and %d premium products.",
    content.Config.GameName,
    #content.Stories,
    #content.Battles,
    #content.TravelRoute.Destinations,
    #content.Shop.GamePasses + #content.Shop.DeveloperProducts
))
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="21">
      <Properties>
        <string name="Name">HaramLearningTrailService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HaramLearningTrail = require(Shared.Data.HaramLearningTrail)
local TravelRoute = require(Shared.Data.TravelRoute)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local hubFolder = remotesFolder:WaitForChild("Hub")
local shopFolder = remotesFolder:WaitForChild("Shop")
local requestHaramTrail = hubFolder:WaitForChild("RequestHaramTrail") :: RemoteEvent
local showLearningTrail = hubFolder:WaitForChild("ShowLearningTrail") :: RemoteEvent
local updateLearningTrail = hubFolder:WaitForChild("UpdateLearningTrail") :: RemoteEvent
local clearLearningTrail = hubFolder:WaitForChild("ClearLearningTrail") :: RemoteEvent

local LINE_DURATION_SECONDS = 2.45
local activeTrails = {}
local rewardedPlayers = {}
local promptConnections = {}

local function getGrantCurrencyBindable(): BindableEvent?
    local bindable = shopFolder:FindFirstChild("GrantCurrency")

    if bindable and bindable:IsA("BindableEvent") then
        return bindable
    end

    return nil
end

local function awardKnowledgeTokens(player: Player, amount: number, reason: string)
    if amount <= 0 or rewardedPlayers[player] == true then
        return
    end

    rewardedPlayers[player] = true

    local bindable = getGrantCurrencyBindable()

    if bindable then
        bindable:Fire(player, amount, reason)
        return
    end

    local currentTokens = player:GetAttribute("KnowledgeTokens")

    if type(currentTokens) ~= "number" then
        currentTokens = 0
    end

    player:SetAttribute("KnowledgeTokens", currentTokens + amount)
end

local function canUseTrail(player: Player): boolean
    return player:GetAttribute("InBattle") ~= true and player:GetAttribute("InStory") ~= true
end

local function showTrailMessage(player: Player, title: string, lines)
    showLearningTrail:FireClient(player, {
        TrailName = HaramLearningTrail.DisplayName,
        Title = title,
        Lines = lines,
        AccentColor = HaramLearningTrail.AccentColor,
    })
end

local function updateTrailMission(player: Player)
    local state = activeTrails[player]

    if not state then
        clearLearningTrail:FireClient(player)
        return
    end

    local step = HaramLearningTrail.Steps[state.StepIndex]

    if not step then
        clearLearningTrail:FireClient(player)
        return
    end

    updateLearningTrail:FireClient(player, {
        TrailName = HaramLearningTrail.DisplayName,
        StepLabel = string.format("Stop %d of %d", state.StepIndex, #HaramLearningTrail.Steps),
        Objective = step.Objective,
        LocationName = step.LocationName,
        AccentColor = HaramLearningTrail.AccentColor,
    })
end

local function startTrail(player: Player)
    if not canUseTrail(player) then
        return
    end

    local existingState = activeTrails[player]

    if existingState then
        updateTrailMission(player)
        return
    end

    activeTrails[player] = {
        StepIndex = 1,
        StepLocked = false,
    }

    player:SetAttribute("CurrentLearningTrailId", HaramLearningTrail.Id)
    player:SetAttribute("CurrentLearningTrailStep", 1)
    updateTrailMission(player)
    showTrailMessage(player, "Learning Walk Started", {
        { Speaker = "Guide", Text = HaramLearningTrail.StartObjective },
    })
end

local function completeTrail(player: Player, state)
    showTrailMessage(player, HaramLearningTrail.Completion.Title, HaramLearningTrail.Completion.Lines)
    awardKnowledgeTokens(player, HaramLearningTrail.RewardTokens or 0, HaramLearningTrail.DisplayName)

    task.delay(math.max(5, #HaramLearningTrail.Completion.Lines * LINE_DURATION_SECONDS + 0.8), function()
        if activeTrails[player] ~= state then
            return
        end

        activeTrails[player] = nil
        player:SetAttribute("CurrentLearningTrailId", nil)
        player:SetAttribute("CurrentLearningTrailStep", nil)
        clearLearningTrail:FireClient(player)
    end)
end

local function triggerTrailStep(player: Player, stepIndex: number)
    if not canUseTrail(player) then
        return
    end

    if not activeTrails[player] and stepIndex == 1 then
        startTrail(player)
    elseif not activeTrails[player] then
        showTrailMessage(player, "Start The Walk First", {
            { Speaker = "Guide", Text = HaramLearningTrail.StartObjective },
        })
        return
    end

    local state = activeTrails[player]

    if not state or state.StepLocked == true then
        return
    end

    if state.StepIndex ~= stepIndex then
        local currentStep = HaramLearningTrail.Steps[state.StepIndex]

        if currentStep then
            showTrailMessage(player, "Follow The Gold Trail", {
                { Speaker = "Guide", Text = currentStep.Objective },
            })
        end

        return
    end

    local step = HaramLearningTrail.Steps[stepIndex]

    if not step then
        return
    end

    state.StepLocked = true
    showTrailMessage(player, step.Title, step.Lines)

    local holdDuration = math.max(3.2, #step.Lines * LINE_DURATION_SECONDS + 0.75)

    task.delay(holdDuration, function()
        if activeTrails[player] ~= state then
            return
        end

        if state.StepIndex ~= stepIndex then
            return
        end

        if stepIndex >= #HaramLearningTrail.Steps then
            state.StepLocked = false
            completeTrail(player, state)
            return
        end

        state.StepIndex += 1
        state.StepLocked = false
        player:SetAttribute("CurrentLearningTrailStep", state.StepIndex)
        updateTrailMission(player)
    end)
end

local function connectPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    if prompt:GetAttribute("PromptAction") ~= "HaramTrailStep" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local stepIndex = prompt:GetAttribute("StepIndex")

        if type(stepIndex) == "number" then
            triggerTrailStep(player, stepIndex)
        end
    end)
end

local function connectPromptsIn(instance: Instance)
    for _, descendant in ipairs(instance:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end

    instance.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end)
end

requestHaramTrail.OnServerEvent:Connect(function(player: Player)
    startTrail(player)
end)

task.spawn(function()
    local worldFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if worldFolder then
        connectPromptsIn(worldFolder)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    activeTrails[player] = nil
    rewardedPlayers[player] = nil
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="22">
      <Properties>
        <string name="Name">HubAtmosphere</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")
local Workspace = game:GetService("Workspace")

local START_CLOCK_TIME = 10.3
local FULL_CYCLE_SECONDS = 780
local MIN_NIGHT_BRIGHTNESS = 1.38
local MAX_DAY_BRIGHTNESS = 2.08

local function ensureAtmosphere(): Atmosphere
    local existing = Lighting:FindFirstChild("JourneyAtmosphere")

    if existing then
        if existing:IsA("Atmosphere") then
            return existing
        end

        existing:Destroy()
    end

    local atmosphere = Instance.new("Atmosphere")
    atmosphere.Name = "JourneyAtmosphere"
    atmosphere.Parent = Lighting

    return atmosphere
end

local function ensureBloom(): BloomEffect
    local existing = Lighting:FindFirstChild("JourneyBloom")

    if existing then
        if existing:IsA("BloomEffect") then
            return existing
        end

        existing:Destroy()
    end

    local bloom = Instance.new("BloomEffect")
    bloom.Name = "JourneyBloom"
    bloom.Parent = Lighting

    return bloom
end

local function ensureColorCorrection(): ColorCorrectionEffect
    local existing = Lighting:FindFirstChild("JourneyColor")

    if existing then
        if existing:IsA("ColorCorrectionEffect") then
            return existing
        end

        existing:Destroy()
    end

    local colorCorrection = Instance.new("ColorCorrectionEffect")
    colorCorrection.Name = "JourneyColor"
    colorCorrection.Parent = Lighting

    return colorCorrection
end

local function ensureSunRays(): SunRaysEffect
    local existing = Lighting:FindFirstChild("JourneySunRays")

    if existing then
        if existing:IsA("SunRaysEffect") then
            return existing
        end

        existing:Destroy()
    end

    local sunRays = Instance.new("SunRaysEffect")
    sunRays.Name = "JourneySunRays"
    sunRays.Parent = Lighting

    return sunRays
end

local function ensureDepthOfField(): DepthOfFieldEffect
    local existing = Lighting:FindFirstChild("JourneyDepthOfField")

    if existing then
        if existing:IsA("DepthOfFieldEffect") then
            return existing
        end

        existing:Destroy()
    end

    local depthOfField = Instance.new("DepthOfFieldEffect")
    depthOfField.Name = "JourneyDepthOfField"
    depthOfField.Parent = Lighting

    return depthOfField
end

local function ensureSky(): Sky
    local existing = Lighting:FindFirstChild("JourneySky")

    if existing then
        if existing:IsA("Sky") then
            return existing
        end

        existing:Destroy()
    end

    local fallback = Lighting:FindFirstChildOfClass("Sky")

    if fallback then
        fallback.Name = "JourneySky"
        return fallback
    end

    local sky = Instance.new("Sky")
    sky.Name = "JourneySky"
    sky.Parent = Lighting

    return sky
end

local function ensureClouds(): Clouds
    local existing = Workspace.Terrain:FindFirstChild("JourneyClouds")

    if existing then
        if existing:IsA("Clouds") then
            return existing
        end

        existing:Destroy()
    end

    local clouds = Instance.new("Clouds")
    clouds.Name = "JourneyClouds"
    clouds.Parent = Workspace.Terrain

    return clouds
end

local function lerpNumber(a: number, b: number, alpha: number): number
    return a + (b - a) * alpha
end

local function lerpColor(a: Color3, b: Color3, alpha: number): Color3
    return Color3.new(
        lerpNumber(a.R, b.R, alpha),
        lerpNumber(a.G, b.G, alpha),
        lerpNumber(a.B, b.B, alpha)
    )
end

local function getDaylightAlpha(clockTime: number): number
    local angular = ((clockTime - 12) / 12) * math.pi
    local cosine = math.cos(angular)

    -- Keep dawn/dusk softer so the switch from day to night feels natural.
    return math.clamp((cosine + 0.25) / 1.25, 0, 1)
end

pcall(function()
    Lighting.Technology = Enum.Technology.Future
end)
pcall(function()
    MaterialService.Use2022Materials = true
end)
pcall(function()
    Workspace.Terrain.Decoration = true
end)
pcall(function()
    Workspace.Terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(198, 176, 129))
    Workspace.Terrain:SetMaterialColor(Enum.Material.Sandstone, Color3.fromRGB(172, 145, 104))
    Workspace.Terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(120, 108, 96))
end)

local atmosphere = ensureAtmosphere()
local bloom = ensureBloom()
local colorCorrection = ensureColorCorrection()
local sunRays = ensureSunRays()
local depthOfField = ensureDepthOfField()
local sky = ensureSky()
local clouds = ensureClouds()

sky.CelestialBodiesShown = true
pcall(function()
    sky.MoonAngularSize = 18
end)
pcall(function()
    sky.SunAngularSize = 20
end)

local function applyCycleLighting(clockTime: number)
    local dayAlpha = getDaylightAlpha(clockTime)
    local nightAlpha = 1 - dayAlpha

    Lighting.ClockTime = clockTime
    Lighting.Brightness = lerpNumber(MIN_NIGHT_BRIGHTNESS, MAX_DAY_BRIGHTNESS, dayAlpha)
    Lighting.EnvironmentDiffuseScale = lerpNumber(0.42, 0.58, dayAlpha)
    Lighting.EnvironmentSpecularScale = lerpNumber(0.2, 0.34, dayAlpha)
    Lighting.OutdoorAmbient = lerpColor(Color3.fromRGB(78, 85, 104), Color3.fromRGB(176, 168, 152), dayAlpha)
    Lighting.Ambient = lerpColor(Color3.fromRGB(56, 62, 79), Color3.fromRGB(132, 124, 110), dayAlpha)
    Lighting.ColorShift_Top = lerpColor(Color3.fromRGB(118, 132, 174), Color3.fromRGB(233, 219, 198), dayAlpha)
    Lighting.ColorShift_Bottom = lerpColor(Color3.fromRGB(84, 96, 132), Color3.fromRGB(194, 181, 156), dayAlpha)
    Lighting.ShadowSoftness = lerpNumber(0.68, 0.48, dayAlpha)

    pcall(function()
        Lighting.ExposureCompensation = lerpNumber(0.03, -0.06, dayAlpha)
    end)

    atmosphere.Color = lerpColor(Color3.fromRGB(104, 123, 166), Color3.fromRGB(221, 206, 182), dayAlpha)
    atmosphere.Decay = lerpColor(Color3.fromRGB(81, 98, 138), Color3.fromRGB(191, 170, 138), dayAlpha)
    atmosphere.Density = lerpNumber(0.31, 0.22, dayAlpha)
    atmosphere.Glare = lerpNumber(0.03, 0.1, dayAlpha)
    atmosphere.Haze = lerpNumber(1.08, 0.88, dayAlpha)
    atmosphere.Offset = lerpNumber(0.08, 0.02, dayAlpha)

    bloom.Intensity = lerpNumber(0.05, 0.12, dayAlpha)
    bloom.Size = lerpNumber(18, 25, dayAlpha)
    bloom.Threshold = lerpNumber(1.28, 1.18, dayAlpha)

    colorCorrection.Brightness = lerpNumber(-0.03, 0.02, dayAlpha)
    colorCorrection.Contrast = lerpNumber(0.16, 0.14, dayAlpha)
    colorCorrection.Saturation = lerpNumber(-0.04, 0.02, dayAlpha)
    colorCorrection.TintColor = lerpColor(Color3.fromRGB(190, 202, 231), Color3.fromRGB(236, 223, 200), dayAlpha)

    sunRays.Intensity = lerpNumber(0.003, 0.048, dayAlpha)
    sunRays.Spread = lerpNumber(0.28, 0.72, dayAlpha)

    depthOfField.FarIntensity = lerpNumber(0.2, 0.12, dayAlpha)
    depthOfField.FocusDistance = lerpNumber(90, 120, dayAlpha)
    depthOfField.InFocusRadius = lerpNumber(65, 86, dayAlpha)
    depthOfField.NearIntensity = lerpNumber(0.03, 0.02, dayAlpha)

    -- Keep stars and moon much clearer at night.
    sky.StarCount = math.floor(lerpNumber(2900, 260, dayAlpha))
    sky.SunAngularSize = lerpNumber(12, 20, dayAlpha)
    pcall(function()
        sky.MoonAngularSize = lerpNumber(20, 14, dayAlpha)
    end)

    pcall(function()
        Lighting.GlobalShadows = true
        Lighting.FogEnd = lerpNumber(12000, 132000, dayAlpha)
        Lighting.FogStart = 0
        Lighting.FogColor = lerpColor(Color3.fromRGB(72, 82, 112), Color3.fromRGB(195, 184, 164), dayAlpha)
    end)

    -- Tiny nudge to moon visibility on darker moments.
    if nightAlpha > 0.7 then
        sky.CelestialBodiesShown = true
    end

    -- Terrain clouds help break up the flat Roblox sky look.
    clouds.Cover = lerpNumber(0.42, 0.28, dayAlpha)
    clouds.Density = lerpNumber(0.86, 0.62, dayAlpha)
    clouds.Color = lerpColor(Color3.fromRGB(168, 179, 208), Color3.fromRGB(246, 241, 231), dayAlpha)
    clouds.Enabled = true
end

local cycleStart = os.clock()

applyCycleLighting(START_CLOCK_TIME)

task.spawn(function()
    while true do
        local elapsed = os.clock() - cycleStart
        local clockTime = (START_CLOCK_TIME + (elapsed / FULL_CYCLE_SECONDS) * 24) % 24
        applyCycleLighting(clockTime)
        task.wait(0.2)
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="23">
      <Properties>
        <string name="Name">HubTeleportService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TravelRoute = require(Shared.Data.TravelRoute)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local hubFolder = remotesFolder:WaitForChild("Hub")
local requestTeleport = hubFolder:WaitForChild("RequestTeleport") :: RemoteEvent

local cooldowns = {}
local promptConnections = {}

local function getTeleportAnchor(destinationId: string): BasePart?
    local worldFolder = Workspace:FindFirstChild(TravelRoute.WorldFolderName)

    if not worldFolder then
        return nil
    end

    local teleportFolder = worldFolder:FindFirstChild("TeleportPoints")

    if not teleportFolder then
        return nil
    end

    local anchor = teleportFolder:FindFirstChild(destinationId)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function teleportPlayerToDestination(player: Player, destinationId: string)
    if typeof(destinationId) ~= "string" then
        return
    end

    if not TravelRoute.GetDestinationById(destinationId) then
        return
    end

    if player:GetAttribute("InBattle") == true or player:GetAttribute("InStory") == true then
        return
    end

    local now = os.clock()
    local lastTeleport = cooldowns[player]

    if lastTeleport and now - lastTeleport < 1 then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return
    end

    local anchor = getTeleportAnchor(destinationId)

    if not anchor then
        return
    end

    cooldowns[player] = now
    character:PivotTo(anchor.CFrame * CFrame.new(0, 4, 0))
end

requestTeleport.OnServerEvent:Connect(function(player: Player, destinationId: string)
    teleportPlayerToDestination(player, destinationId)
end)

local function connectTeleportPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    if prompt:GetAttribute("PromptAction") ~= "Teleport" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local destinationId = prompt:GetAttribute("DestinationId")

        if typeof(destinationId) == "string" then
            teleportPlayerToDestination(player, destinationId)
        end
    end)
end

task.spawn(function()
    local worldFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if not worldFolder then
        return
    end

    for _, descendant in ipairs(worldFolder:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectTeleportPrompt(descendant)
        end
    end

    worldFolder.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectTeleportPrompt(descendant)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player: Player)
    cooldowns[player] = nil
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="24">
      <Properties>
        <string name="Name">HubWorldBuilder</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CompanionStories = require(Shared.Data.CompanionStories)
local HaramLearningTrail = require(Shared.Data.HaramLearningTrail)
local MannersLessons = require(Shared.Data.MannersLessons)
local TravelRoute = require(Shared.Data.TravelRoute)
local BuildUtils = require(script.Parent.Modules.BuildUtils)

local MECCA_STONE = Color3.fromRGB(196, 186, 168)
local MECCA_MARBLE = Color3.fromRGB(214, 208, 196)
local MECCA_DARK = Color3.fromRGB(124, 106, 80)
local DESERT_SAND = Color3.fromRGB(188, 166, 121)
local DESERT_ROCK = Color3.fromRGB(138, 110, 80)
local MEDINA_WHITE = Color3.fromRGB(232, 231, 224)
local MEDINA_GREEN = Color3.fromRGB(77, 128, 88)
local MEDINA_STONE = Color3.fromRGB(214, 210, 198)
local GOLD_ACCENT = Color3.fromRGB(193, 162, 86)
local GLASS_TINT = Color3.fromRGB(108, 119, 132)
local DARK_PANEL = Color3.fromRGB(42, 45, 49)

local function createSafetyBounds(parent: Instance, namePrefix: string, center: Vector3, footprint: Vector3)
    local barrierHeight = 110
    local thickness = 12
    local barrierYOffset = 28

    BuildUtils.CreatePart(parent, string.format("%s_NorthBarrier", namePrefix), Vector3.new(footprint.X, barrierHeight, thickness), CFrame.new(center + Vector3.new(0, barrierYOffset, footprint.Z * -0.5)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(parent, string.format("%s_SouthBarrier", namePrefix), Vector3.new(footprint.X, barrierHeight, thickness), CFrame.new(center + Vector3.new(0, barrierYOffset, footprint.Z * 0.5)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(parent, string.format("%s_WestBarrier", namePrefix), Vector3.new(thickness, barrierHeight, footprint.Z), CFrame.new(center + Vector3.new(footprint.X * -0.5, barrierYOffset, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(parent, string.format("%s_EastBarrier", namePrefix), Vector3.new(thickness, barrierHeight, footprint.Z), CFrame.new(center + Vector3.new(footprint.X * 0.5, barrierYOffset, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
end

local function createLightPost(parent: Instance, name: string, position: Vector3, poleColor: Color3?)
    BuildUtils.CreateVerticalCylinder(parent, string.format("%s_Pole", name), 13, 0.6, position + Vector3.new(0, 6.5, 0), poleColor or Color3.fromRGB(124, 107, 84), Enum.Material.Metal, nil)
    BuildUtils.CreateSphere(parent, string.format("%s_Light", name), 3.2, position + Vector3.new(0, 13.4, 0), Color3.fromRGB(255, 242, 206), Enum.Material.Neon, nil)
end

local function createWallPanel(
    parent: Instance,
    name: string,
    position: Vector3,
    size: Vector3,
    title: string,
    subtitle: string,
    wallColor: Color3,
    orientationY: number,
    promptData
)
    local sign = BuildUtils.CreateWallSign(parent, name, position, size, title, subtitle, wallColor, promptData)
    sign.Orientation = Vector3.new(0, orientationY, 0)

    return sign
end

local function createDigitalScreen(parent: Instance, name: string, position: Vector3, size: Vector3, title: string, subtitle: string)
    local screen = BuildUtils.CreatePart(parent, name, size, CFrame.new(position + Vector3.new(0, size.Y * 0.5, 0)), Color3.fromRGB(39, 44, 50), Enum.Material.Metal, nil, nil)
    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Face = Enum.NormalId.Front
    surfaceGui.CanvasSize = Vector2.new(760, 360)
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surfaceGui.PixelsPerStud = 48
    surfaceGui.Parent = screen

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.fromOffset(30, 24)
    titleLabel.Size = UDim2.new(1, -60, 0, 92)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(246, 240, 220)
    titleLabel.TextScaled = true
    titleLabel.TextWrapped = true
    titleLabel.Parent = surfaceGui

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.fromOffset(30, 130)
    subtitleLabel.Size = UDim2.new(1, -60, 0, 150)
    subtitleLabel.Font = Enum.Font.Gotham
    subtitleLabel.Text = subtitle
    subtitleLabel.TextColor3 = Color3.fromRGB(203, 212, 224)
    subtitleLabel.TextScaled = true
    subtitleLabel.TextWrapped = true
    subtitleLabel.Parent = surfaceGui

    return screen
end

local function createFloorPlaque(
    parent: Instance,
    name: string,
    cframe: CFrame,
    size: Vector3,
    title: string,
    subtitle: string,
    plaqueColor: Color3,
    promptData
): BasePart
    local plaque = BuildUtils.CreatePart(parent, name, size, cframe, plaqueColor, Enum.Material.Slate, nil, nil)
    plaque.CanCollide = false

    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Face = Enum.NormalId.Top
    surfaceGui.CanvasSize = Vector2.new(760, 260)
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surfaceGui.PixelsPerStud = 46
    surfaceGui.Parent = plaque

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.fromOffset(24, 18)
    titleLabel.Size = UDim2.new(1, -48, 0, 92)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(250, 245, 230)
    titleLabel.TextScaled = true
    titleLabel.TextWrapped = true
    titleLabel.Parent = surfaceGui

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.fromOffset(28, 120)
    subtitleLabel.Size = UDim2.new(1, -56, 0, 112)
    subtitleLabel.Font = Enum.Font.Gotham
    subtitleLabel.Text = subtitle
    subtitleLabel.TextColor3 = Color3.fromRGB(222, 215, 196)
    subtitleLabel.TextScaled = true
    subtitleLabel.TextWrapped = true
    subtitleLabel.Parent = surfaceGui

    if promptData then
        BuildUtils.AttachPrompt(plaque, promptData.ActionText, promptData.ObjectText, promptData.Attributes)
    end

    return plaque
end

local function createFloorInlayGrid(parent: Instance, namePrefix: string, center: Vector3, extent: number, spacing: number, color: Color3, yOffset: number)
    local lineIndex = 0

    for x = -extent, extent, spacing do
        lineIndex += 1
        BuildUtils.CreatePart(
            parent,
            string.format("%s_X_%d", namePrefix, lineIndex),
            Vector3.new(1.1, 0.18, extent * 2),
            CFrame.new(center + Vector3.new(x, yOffset, 0)),
            color,
            Enum.Material.Marble,
            nil,
            nil
        )
    end

    for z = -extent, extent, spacing do
        lineIndex += 1
        BuildUtils.CreatePart(
            parent,
            string.format("%s_Z_%d", namePrefix, lineIndex),
            Vector3.new(extent * 2, 0.18, 1.1),
            CFrame.new(center + Vector3.new(0, yOffset, z)),
            color,
            Enum.Material.Marble,
            nil,
            nil
        )
    end
end

local function createRingTiles(parent: Instance, namePrefix: string, center: Vector3, radius: number, count: number, color: Color3, yOffset: number)
    for index = 1, count do
        local angle = (math.pi * 2) * (index / count)
        local position = center + Vector3.new(math.cos(angle) * radius, yOffset, math.sin(angle) * radius)
        BuildUtils.CreatePart(
            parent,
            string.format("%s_%d", namePrefix, index),
            Vector3.new(13, 0.22, 2.2),
            CFrame.new(position) * CFrame.Angles(0, -angle, 0),
            color,
            Enum.Material.Marble,
            nil,
            nil
        )
    end
end

local function createRadialFloorRays(parent: Instance, namePrefix: string, center: Vector3, innerRadius: number, outerRadius: number, count: number, color: Color3, yOffset: number)
    local length = outerRadius - innerRadius
    local midpointRadius = innerRadius + length * 0.5

    for index = 1, count do
        local angle = (math.pi * 2) * (index / count)
        local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
        local position = center + direction * midpointRadius
        local ray = BuildUtils.CreatePart(
            parent,
            string.format("%s_%d", namePrefix, index),
            Vector3.new(1.35, 0.18, length),
            CFrame.new(position) * CFrame.Angles(0, math.pi * 0.5 - angle, 0),
            color,
            Enum.Material.Marble,
            nil,
            nil
        )
        ray.CanCollide = false
    end
end

local function createLowBollard(parent: Instance, name: string, position: Vector3, accentColor: Color3)
    BuildUtils.CreateVerticalCylinder(parent, string.format("%s_Post", name), 5.5, 0.45, position + Vector3.new(0, 2.75, 0), Color3.fromRGB(117, 102, 77), Enum.Material.Metal, nil)
    BuildUtils.CreateSphere(parent, string.format("%s_Glow", name), 1.7, position + Vector3.new(0, 5.8, 0), accentColor, Enum.Material.Neon, nil)
end

local function createDistrictTerrainBand(parent: Instance, namePrefix: string, center: Vector3, radiusX: number, radiusZ: number, rockColor: Color3)
    local band = BuildUtils.CreateFolder(parent, string.format("%sTerrainBand", namePrefix))

    for index, offset in ipairs({
        Vector3.new(-radiusX, 0, -radiusZ * 0.6),
        Vector3.new(radiusX, 0, -radiusZ * 0.52),
        Vector3.new(-radiusX * 0.94, 0, radiusZ * 0.58),
        Vector3.new(radiusX * 0.98, 0, radiusZ * 0.62),
        Vector3.new(-radiusX * 0.58, 0, -radiusZ),
        Vector3.new(radiusX * 0.54, 0, -radiusZ * 1.04),
        Vector3.new(-radiusX * 0.46, 0, radiusZ),
        Vector3.new(radiusX * 0.5, 0, radiusZ * 1.02),
    }) do
        local scale = 1 + (index % 3) * 0.16
        BuildUtils.CreateMountain(
            band,
            string.format("%sMass_%d", namePrefix, index),
            center + offset,
            180 * scale,
            84 * scale,
            110 * scale,
            rockColor,
            (index % 2 == 0) and 18 or -22
        )
    end

    for index, offset in ipairs({
        Vector3.new(-radiusX * 0.72, 0, -radiusZ * 0.18),
        Vector3.new(radiusX * 0.68, 0, -radiusZ * 0.14),
        Vector3.new(-radiusX * 0.64, 0, radiusZ * 0.24),
        Vector3.new(radiusX * 0.62, 0, radiusZ * 0.2),
        Vector3.new(0, 0, -radiusZ * 0.92),
        Vector3.new(0, 0, radiusZ * 0.96),
    }) do
        BuildUtils.CreateDune(
            band,
            string.format("%sDune_%d", namePrefix, index),
            center + offset,
            Vector3.new(170 + index * 12, 34 + (index % 2) * 8, 84 + (index % 3) * 10),
            Color3.fromRGB(205, 181, 133)
        )
    end

    for index, offset in ipairs({
        Vector3.new(-radiusX * 0.78, 0, -radiusZ * 0.34),
        Vector3.new(radiusX * 0.76, 0, -radiusZ * 0.28),
        Vector3.new(-radiusX * 0.8, 0, radiusZ * 0.36),
        Vector3.new(radiusX * 0.74, 0, radiusZ * 0.32),
        Vector3.new(-radiusX * 0.22, 0, -radiusZ * 0.96),
        Vector3.new(radiusX * 0.24, 0, radiusZ * 0.98),
    }) do
        BuildUtils.CreateRockCluster(band, string.format("%sRockCluster_%d", namePrefix, index), center + offset)
    end
end

local function createWorldBackdrop(parent: Instance, center: Vector3)
    local backdrop = BuildUtils.CreateFolder(parent, "WorldBackdrop")

    for index, mountain in ipairs({
        { Name = "FarNorthWest", Position = center + Vector3.new(-980, 0, -1120), Width = 420, Height = 176, Depth = 210, Yaw = 12, Color = DESERT_ROCK },
        { Name = "FarNorth", Position = center + Vector3.new(0, 0, -1280), Width = 540, Height = 214, Depth = 230, Yaw = -4, Color = Color3.fromRGB(142, 114, 83) },
        { Name = "FarNorthEast", Position = center + Vector3.new(1020, 0, -1100), Width = 436, Height = 182, Depth = 214, Yaw = -18, Color = DESERT_ROCK },
        { Name = "FarWest", Position = center + Vector3.new(-1240, 0, 160), Width = 368, Height = 152, Depth = 206, Yaw = 26, Color = Color3.fromRGB(136, 108, 79) },
        { Name = "FarEast", Position = center + Vector3.new(1260, 0, 180), Width = 392, Height = 158, Depth = 214, Yaw = -24, Color = Color3.fromRGB(140, 112, 81) },
        { Name = "FarSouthWest", Position = center + Vector3.new(-1040, 0, 1480), Width = 404, Height = 164, Depth = 224, Yaw = 20, Color = DESERT_ROCK },
        { Name = "FarSouth", Position = center + Vector3.new(40, 0, 1600), Width = 576, Height = 226, Depth = 244, Yaw = 0, Color = Color3.fromRGB(146, 118, 86) },
        { Name = "FarSouthEast", Position = center + Vector3.new(1100, 0, 1460), Width = 424, Height = 170, Depth = 228, Yaw = -16, Color = DESERT_ROCK },
    }) do
        BuildUtils.CreateMountain(backdrop, string.format("%sBackdrop_%d", mountain.Name, index), mountain.Position, mountain.Width, mountain.Height, mountain.Depth, mountain.Color, mountain.Yaw)
    end

    for index, offset in ipairs({
        Vector3.new(-820, 0, -760),
        Vector3.new(860, 0, -820),
        Vector3.new(-940, 0, 1120),
        Vector3.new(980, 0, 1180),
        Vector3.new(0, 0, -980),
        Vector3.new(-220, 0, 1360),
    }) do
        BuildUtils.CreateDune(backdrop, string.format("BackdropDune_%d", index), center + offset, Vector3.new(260, 52, 122), Color3.fromRGB(203, 179, 130))
    end
end

local function createPrayerMatRows(parent: Instance, namePrefix: string, origin: Vector3, rowCount: number, columnCount: number, facingRadians: number, matColor: Color3)
    local spacingX = 10
    local spacingZ = 15

    for row = 1, rowCount do
        for column = 1, columnCount do
            local localX = (column - (columnCount + 1) * 0.5) * spacingX
            local localZ = (row - 1) * spacingZ
            local cframe = CFrame.new(origin) * CFrame.Angles(0, facingRadians, 0) * CFrame.new(localX, 0, localZ)

            BuildUtils.CreatePart(
                parent,
                string.format("%s_%d_%d", namePrefix, row, column),
                Vector3.new(7, 0.18, 12),
                cframe,
                matColor,
                Enum.Material.Fabric,
                nil,
                nil
            )
        end
    end
end

local function createMaqamIbrahimMarker(parent: Instance, center: Vector3)
    local markerFolder = BuildUtils.CreateFolder(parent, "MaqamIbrahimMarker")
    local markerCenter = center + Vector3.new(48, 0, -54)

    BuildUtils.CreateVerticalCylinder(markerFolder, "GoldBase", 2.2, 8, markerCenter + Vector3.new(0, 6.1, 0), GOLD_ACCENT, Enum.Material.Metal, nil)
    BuildUtils.CreateVerticalCylinder(markerFolder, "GlassCover", 9, 5.4, markerCenter + Vector3.new(0, 12, 0), Color3.fromRGB(194, 217, 225), Enum.Material.Glass, 0.42)
    BuildUtils.CreateSphere(markerFolder, "GoldDome", 11, markerCenter + Vector3.new(0, 17.8, 0), GOLD_ACCENT, Enum.Material.Metal, nil)
    BuildUtils.CreatePart(markerFolder, "StoneInside", Vector3.new(5.2, 2.4, 5.2), CFrame.new(markerCenter + Vector3.new(0, 8.3, 0)), Color3.fromRGB(169, 150, 120), Enum.Material.Slate, nil, nil)
    BuildUtils.CreatePart(markerFolder, "FootprintA", Vector3.new(1.2, 0.25, 2), CFrame.new(markerCenter + Vector3.new(-1, 9.62, 0)), Color3.fromRGB(103, 91, 73), Enum.Material.Slate, Enum.PartType.Ball, nil)
    BuildUtils.CreatePart(markerFolder, "FootprintB", Vector3.new(1.2, 0.25, 2), CFrame.new(markerCenter + Vector3.new(1, 9.62, 0)), Color3.fromRGB(103, 91, 73), Enum.Material.Slate, Enum.PartType.Ball, nil)
    createFloorPlaque(
        markerFolder,
        "MaqamPlaque",
        CFrame.new(markerCenter + Vector3.new(0, 7.1, -20)) * CFrame.Angles(0, math.rad(180), 0),
        Vector3.new(30, 0.45, 10),
        "Maqam Ibrahim",
        "Small marker, not a 1:1 replica.",
        Color3.fromRGB(92, 78, 56),
        nil
    )
end

local function createHijrIsmailMarker(parent: Instance, center: Vector3)
    local markerFolder = BuildUtils.CreateFolder(parent, "HijrIsmailMarker")
    local arcCenter = center + Vector3.new(0, 0, 42)

    for index = 1, 18 do
        local angle = math.rad(180 + (index - 1) * 10)
        local position = arcCenter + Vector3.new(math.cos(angle) * 38, 0, math.sin(angle) * 38)
        BuildUtils.CreatePart(
            markerFolder,
            string.format("LowArcWall_%d", index),
            Vector3.new(9, 3.2, 3.2),
            CFrame.new(position + Vector3.new(0, 7.2, 0)) * CFrame.Angles(0, -angle, 0),
            Color3.fromRGB(235, 230, 218),
            Enum.Material.Marble,
            nil,
            nil
        )
    end

    createFloorPlaque(
        markerFolder,
        "HijrPlaque",
        CFrame.new(arcCenter + Vector3.new(0, 7.1, 58)),
        Vector3.new(30, 0.45, 10),
        "Hijr / Hateem",
        "Low landmark marker.",
        Color3.fromRGB(82, 75, 61),
        nil
    )
end

local function createArcadeBlock(parent: Instance, namePrefix: string, center: Vector3, width: number, depth: number, floorColor: Color3, wallColor: Color3, roofColor: Color3)
    BuildUtils.CreatePart(parent, string.format("%s_Floor", namePrefix), Vector3.new(width, 1, depth), CFrame.new(center + Vector3.new(0, 4.55, 0)), floorColor, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Roof", namePrefix), Vector3.new(width, 4, depth), CFrame.new(center + Vector3.new(0, 22, 0)), roofColor, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_GlassFront", namePrefix), Vector3.new(width - 20, 3, 1.2), CFrame.new(center + Vector3.new(0, 15.5, depth * -0.5 + 3)), GLASS_TINT, Enum.Material.Glass, nil, 0.18)
    BuildUtils.CreatePart(parent, string.format("%s_GlassBack", namePrefix), Vector3.new(width - 20, 3, 1.2), CFrame.new(center + Vector3.new(0, 15.5, depth * 0.5 - 3)), GLASS_TINT, Enum.Material.Glass, nil, 0.18)

    local xCount = math.max(2, math.floor((width - 24) / 32))
    local zCount = math.max(1, math.floor((depth - 24) / 32))

    for index = 0, xCount do
        local alpha = index / xCount
        local x = -width * 0.5 + 12 + alpha * (width - 24)
        BuildUtils.CreatePart(parent, string.format("%s_ColumnFront_%d", namePrefix, index + 1), Vector3.new(4.5, 18, 4.5), CFrame.new(center + Vector3.new(x, 13, depth * -0.5 + 10)), wallColor, Enum.Material.Marble, nil, nil)
        BuildUtils.CreatePart(parent, string.format("%s_ColumnBack_%d", namePrefix, index + 1), Vector3.new(4.5, 18, 4.5), CFrame.new(center + Vector3.new(x, 13, depth * 0.5 - 10)), wallColor, Enum.Material.Marble, nil, nil)
    end

    for index = 1, zCount - 1 do
        local alpha = index / zCount
        local z = -depth * 0.5 + 12 + alpha * (depth - 24)
        BuildUtils.CreatePart(parent, string.format("%s_ColumnLeft_%d", namePrefix, index), Vector3.new(4.5, 18, 4.5), CFrame.new(center + Vector3.new(width * -0.5 + 10, 13, z)), wallColor, Enum.Material.Marble, nil, nil)
        BuildUtils.CreatePart(parent, string.format("%s_ColumnRight_%d", namePrefix, index), Vector3.new(4.5, 18, 4.5), CFrame.new(center + Vector3.new(width * 0.5 - 10, 13, z)), wallColor, Enum.Material.Marble, nil, nil)
    end
end

local function createTent(parent: Instance, name: string, position: Vector3, clothColor: Color3)
    local floor = BuildUtils.CreatePart(parent, string.format("%s_Floor", name), Vector3.new(22, 1, 18), CFrame.new(position + Vector3.new(0, 0.5, 0)), Color3.fromRGB(176, 152, 111), Enum.Material.Sandstone, nil, nil)
    floor.CanCollide = true

    local leftRoof = BuildUtils.CreatePart(parent, string.format("%s_LeftRoof", name), Vector3.new(12, 1, 18), CFrame.new(position + Vector3.new(-5.8, 7.5, 0)) * CFrame.Angles(0, 0, math.rad(24)), clothColor, Enum.Material.Fabric, nil, nil)
    local rightRoof = BuildUtils.CreatePart(parent, string.format("%s_RightRoof", name), Vector3.new(12, 1, 18), CFrame.new(position + Vector3.new(5.8, 7.5, 0)) * CFrame.Angles(0, 0, math.rad(-24)), clothColor, Enum.Material.Fabric, nil, nil)
    leftRoof.CanCollide = true
    rightRoof.CanCollide = true

    BuildUtils.CreatePart(parent, string.format("%s_Back", name), Vector3.new(18, 8, 1), CFrame.new(position + Vector3.new(0, 4, 8.5)), Color3.fromRGB(121, 94, 62), Enum.Material.WoodPlanks, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_PoleA", name), Vector3.new(1, 10, 1), CFrame.new(position + Vector3.new(-6.8, 5, 0)), Color3.fromRGB(108, 78, 48), Enum.Material.Wood, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_PoleB", name), Vector3.new(1, 10, 1), CFrame.new(position + Vector3.new(6.8, 5, 0)), Color3.fromRGB(108, 78, 48), Enum.Material.Wood, nil, nil)
end

local function createMedinaGate(parent: Instance, name: string, center: Vector3, orientationY: number, title: string, subtitle: string)
    local rotation = CFrame.Angles(0, math.rad(orientationY), 0)
    local gateFolder = BuildUtils.CreateFolder(parent, name)

    BuildUtils.CreatePart(gateFolder, "LeftColumn", Vector3.new(8, 26, 8), CFrame.new(center) * rotation * CFrame.new(-14, 13, 0), MEDINA_STONE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(gateFolder, "RightColumn", Vector3.new(8, 26, 8), CFrame.new(center) * rotation * CFrame.new(14, 13, 0), MEDINA_STONE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(gateFolder, "Beam", Vector3.new(36, 8, 9), CFrame.new(center) * rotation * CFrame.new(0, 24, 0), MEDINA_STONE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(gateFolder, "Threshold", Vector3.new(38, 1, 14), CFrame.new(center) * rotation * CFrame.new(0, 0.5, 0), Color3.fromRGB(218, 214, 202), Enum.Material.Marble, nil, nil)

    local signOffset = Vector3.new(0, 0, 14)
    local signPosition = (CFrame.new(center) * rotation * CFrame.new(signOffset)).Position
    createWallPanel(gateFolder, "GateSign", signPosition, Vector3.new(40, 10, 2), title, subtitle, Color3.fromRGB(58, 90, 63), orientationY + 180, nil)
end

local function makeCamelPart(part: BasePart)
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = true
end

local function createRideableCamel(parent: Instance, name: string, position: Vector3, orientationY: number)
    local camel = Instance.new("Model")
    camel.Name = name
    camel:SetAttribute("CamelSpeed", 46)
    camel:SetAttribute("CamelTurnRate", 2.2)
    camel:SetAttribute("StridePhase", (position.X + position.Z) * 0.013)
    camel.Parent = parent

    local baseCFrame = CFrame.new(position + Vector3.new(0, 13.5, 0)) * CFrame.Angles(0, math.rad(orientationY), 0)
    local bodyColor = Color3.fromRGB(171, 125, 76)
    local shadowColor = Color3.fromRGB(122, 82, 48)
    local clothColor = Color3.fromRGB(98, 87, 65)
    local saddleColor = Color3.fromRGB(73, 56, 41)

    local root = BuildUtils.CreatePart(camel, "CamelRoot", Vector3.new(2, 2, 2), baseCFrame, Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    root.CanCollide = false
    root.CanTouch = false
    root.CanQuery = false
    camel.PrimaryPart = root

    for _, part in ipairs({
        BuildUtils.CreatePart(camel, "Body", Vector3.new(16, 6, 6), baseCFrame * CFrame.new(0, 1.2, 0), bodyColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreateWedge(camel, "Hump", Vector3.new(8, 5, 7), baseCFrame * CFrame.new(-1.6, 5.2, 0) * CFrame.Angles(0, math.rad(180), 0), Color3.fromRGB(149, 102, 61), Enum.Material.Fabric, nil),
        BuildUtils.CreatePart(camel, "Chest", Vector3.new(5.5, 5.5, 5.8), baseCFrame * CFrame.new(-7.2, 1.4, 0), bodyColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "Neck", Vector3.new(3.2, 9, 3), baseCFrame * CFrame.new(-10, 6.6, 0) * CFrame.Angles(0, 0, math.rad(-18)), bodyColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "Head", Vector3.new(5.6, 3.2, 3), baseCFrame * CFrame.new(-11.9, 10.8, 0), bodyColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "Muzzle", Vector3.new(2.8, 2, 2.4), baseCFrame * CFrame.new(-15.4, 10.3, 0), shadowColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "LeftEar", Vector3.new(0.8, 2.2, 0.7), baseCFrame * CFrame.new(-11.7, 13.1, -1.15) * CFrame.Angles(math.rad(12), 0, math.rad(-10)), shadowColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "RightEar", Vector3.new(0.8, 2.2, 0.7), baseCFrame * CFrame.new(-11.7, 13.1, 1.15) * CFrame.Angles(math.rad(-12), 0, math.rad(-10)), shadowColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "Tail", Vector3.new(1, 7, 1), baseCFrame * CFrame.new(8.8, 2.7, 0) * CFrame.Angles(0, 0, math.rad(34)), shadowColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "SaddleBlanket", Vector3.new(8.5, 0.7, 7.4), baseCFrame * CFrame.new(1.2, 5, 0), clothColor, Enum.Material.Fabric, nil, nil),
        BuildUtils.CreatePart(camel, "SaddleBack", Vector3.new(1.2, 2.4, 6.2), baseCFrame * CFrame.new(4.2, 6.1, 0), saddleColor, Enum.Material.Wood, nil, nil),
        BuildUtils.CreatePart(camel, "SaddleFront", Vector3.new(1.2, 2.1, 6.2), baseCFrame * CFrame.new(-2.4, 5.95, 0), saddleColor, Enum.Material.Wood, nil, nil),
    }) do
        makeCamelPart(part)
    end

    for index, localOffset in ipairs({
        Vector3.new(-5.2, -3.2, -2.1),
        Vector3.new(-5.2, -3.2, 2.1),
        Vector3.new(5.2, -3.2, -2.1),
        Vector3.new(5.2, -3.2, 2.1),
    }) do
        local leg = BuildUtils.CreatePart(camel, string.format("Leg_%d", index), Vector3.new(1.4, 9, 1.4), baseCFrame * CFrame.new(localOffset), shadowColor, Enum.Material.Fabric, nil, nil)
        local hoof = BuildUtils.CreatePart(camel, string.format("Hoof_%d", index), Vector3.new(2.4, 0.8, 2.2), baseCFrame * CFrame.new(localOffset + Vector3.new(0, -4.9, 0)), Color3.fromRGB(79, 58, 42), Enum.Material.Slate, nil, nil)
        makeCamelPart(leg)
        makeCamelPart(hoof)
    end

    local seat = Instance.new("VehicleSeat")
    seat.Name = "CamelSeat"
    seat.Anchored = true
    seat.CanCollide = false
    seat.CanTouch = true
    seat.CanQuery = true
    seat.Transparency = 1
    seat.Size = Vector3.new(5.8, 1.2, 4.8)
    seat.CFrame = baseCFrame * CFrame.new(1.1, 6.2, 0)
    seat.Parent = camel
    seat:SetAttribute("PromptAction", "RideCamel")

    local marker = BuildUtils.CreatePart(camel, "PromptMarker", Vector3.new(5.6, 0.5, 5.6), baseCFrame * CFrame.new(1.1, -2.8, 0), Color3.fromRGB(214, 178, 99), Enum.Material.Metal, nil, 0.18)
    makeCamelPart(marker)
    BuildUtils.AttachPrompt(marker, "Ride Camel", "Travel Mount", {
        PromptAction = "RideCamel",
    })

    CollectionService:AddTag(camel, "RideableCamel")

    return camel
end

local function buildDesertRoute(parent: Instance, startPosition: Vector3, stopPosition: Vector3, endPosition: Vector3)
    local district = BuildUtils.CreateFolder(parent, "DesertRoute")
    local routeCenter = (startPosition + endPosition) * 0.5
    local routeLength = math.abs(endPosition.Z - startPosition.Z) + 420

    BuildUtils.CreatePart(district, "SafetyPlate", Vector3.new(1020, 10, routeLength + 260), CFrame.new(routeCenter + Vector3.new(0, -9, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(district, "DesertBase", Vector3.new(860, 4, routeLength), CFrame.new(routeCenter + Vector3.new(0, 2, 0)), DESERT_SAND, Enum.Material.Sand, nil, nil)
    BuildUtils.CreateDune(district, "RouteLongWestDune", routeCenter + Vector3.new(-220, 0, -120), Vector3.new(420, 62, routeLength * 0.42), Color3.fromRGB(204, 179, 132))
    BuildUtils.CreateDune(district, "RouteLongEastDune", routeCenter + Vector3.new(226, 0, 160), Vector3.new(440, 66, routeLength * 0.45), Color3.fromRGB(199, 175, 129))
    BuildUtils.CreatePart(district, "TravelPath", Vector3.new(102, 1, routeLength - 140), CFrame.new(routeCenter + Vector3.new(0, 4.55, 0)), Color3.fromRGB(182, 154, 110), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(district, "TravelPathCenterInlay", Vector3.new(7, 0.24, routeLength - 180), CFrame.new(routeCenter + Vector3.new(0, 5.16, 0)), Color3.fromRGB(232, 212, 168), Enum.Material.Marble, nil, nil).CanCollide = false
    BuildUtils.CreatePart(district, "TravelPathWestEdge", Vector3.new(3, 0.24, routeLength - 180), CFrame.new(routeCenter + Vector3.new(-51, 5.18, 0)), Color3.fromRGB(133, 108, 76), Enum.Material.Slate, nil, nil).CanCollide = false
    BuildUtils.CreatePart(district, "TravelPathEastEdge", Vector3.new(3, 0.24, routeLength - 180), CFrame.new(routeCenter + Vector3.new(51, 5.18, 0)), Color3.fromRGB(133, 108, 76), Enum.Material.Slate, nil, nil).CanCollide = false

    local camelFolder = BuildUtils.CreateFolder(district, "RouteCamels")
    createRideableCamel(camelFolder, "MakkahRouteCamel", startPosition + Vector3.new(-78, 0, 226), 0)
    createRideableCamel(camelFolder, "DesertRouteCamel", stopPosition + Vector3.new(98, 0, -96), 180)
    createRideableCamel(camelFolder, "MedinaRouteCamel", endPosition + Vector3.new(82, 0, -206), 180)

    local mountainFolder = BuildUtils.CreateFolder(district, "RouteMountainWalls")
    local mountainIndex = 0

    for z = startPosition.Z + 260, endPosition.Z - 260, 420 do
        mountainIndex += 1
        local heightOffset = (mountainIndex % 3) * 12
        BuildUtils.CreateMountain(mountainFolder, string.format("WestRouteMountain_%d", mountainIndex), Vector3.new(-350, 0, z), 170 + heightOffset, 82 + heightOffset, 82, DESERT_ROCK, 24)
        BuildUtils.CreateMountain(mountainFolder, string.format("EastRouteMountain_%d", mountainIndex), Vector3.new(350, 0, z + 90), 190 + heightOffset, 92 + heightOffset, 90, Color3.fromRGB(157, 126, 88), -28)
        BuildUtils.CreateMountain(mountainFolder, string.format("RouteMidRidge_%d", mountainIndex), Vector3.new(((mountainIndex % 2 == 0) and -1 or 1) * 248, 0, z - 120), 126 + heightOffset, 58 + heightOffset * 0.5, 76, Color3.fromRGB(145, 117, 85), (mountainIndex % 2 == 0) and -10 or 10)
    end

    local lampIndex = 0

    for z = startPosition.Z + 210, endPosition.Z - 210, 280 do
        lampIndex += 1
        createLowBollard(district, string.format("RouteGuideLampWest_%d", lampIndex), Vector3.new(-66, 0, z), Color3.fromRGB(255, 229, 170))
        createLowBollard(district, string.format("RouteGuideLampEast_%d", lampIndex), Vector3.new(66, 0, z), Color3.fromRGB(255, 229, 170))
    end

    local stepIndex = 0
    for z = startPosition.Z + 180, endPosition.Z - 160, 180 do
        stepIndex += 1
        local xShift = (stepIndex % 2 == 0) and 190 or -190
        BuildUtils.CreateDune(district, string.format("RouteDuneA_%d", stepIndex), Vector3.new(xShift, 0, z), Vector3.new(180, 40, 90), Color3.fromRGB(219, 190, 136))
        BuildUtils.CreateDune(district, string.format("RouteDuneB_%d", stepIndex), Vector3.new(xShift * -0.65, 0, z + 60), Vector3.new(130, 34, 82), Color3.fromRGB(211, 181, 129))
        BuildUtils.CreateRockCluster(district, string.format("RouteRocks_%d", stepIndex), Vector3.new(xShift * 0.58, 0, z - 32))
    end

    BuildUtils.CreatePart(district, "CampCourt", Vector3.new(210, 3, 170), CFrame.new(stopPosition + Vector3.new(0, 1.5, 0)), Color3.fromRGB(196, 173, 130), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(district, "CampPath", Vector3.new(82, 1, 120), CFrame.new(stopPosition + Vector3.new(0, 3.55, -6)), Color3.fromRGB(222, 212, 190), Enum.Material.Sandstone, nil, nil)
    createTent(district, "CampTentWest", stopPosition + Vector3.new(-56, 0, 28), Color3.fromRGB(120, 88, 54))
    createTent(district, "CampTentEast", stopPosition + Vector3.new(56, 0, 28), Color3.fromRGB(135, 98, 59))
    BuildUtils.CreatePlanter(district, "OasisPlanter", stopPosition + Vector3.new(0, 0, -42), Vector3.new(56, 3, 46))
    BuildUtils.CreatePalmTree(district, "OasisPalmWest", stopPosition + Vector3.new(-18, 0, -44))
    BuildUtils.CreatePalmTree(district, "OasisPalmEast", stopPosition + Vector3.new(18, 0, -40))
    createLightPost(district, "CampLightWest", stopPosition + Vector3.new(-78, 0, -28))
    createLightPost(district, "CampLightEast", stopPosition + Vector3.new(78, 0, -28))
    createWallPanel(district, "MakkahRouteStartSign", startPosition + Vector3.new(0, 0, 132), Vector3.new(76, 12, 2.5), "Makkah To Medina Route", "Ride a camel or follow the lamp markers. This long path teaches distance and migration without depicting the Prophet.", Color3.fromRGB(105, 83, 55), 0, nil)
    createWallPanel(district, "CampSign", stopPosition + Vector3.new(0, 0, -76), Vector3.new(72, 12, 2.5), "Desert Route Camp", "A longer travel stretch now separates Makkah and Medina, with a mid-route camp for reflection and story stops.", Color3.fromRGB(111, 88, 58), 0, nil)
    createWallPanel(district, "MedinaRouteArrivalSign", endPosition + Vector3.new(0, 0, -132), Vector3.new(76, 12, 2.5), "Medina Approach", "The route ends at a green-and-white Medina district with gates, courtyard markers, and a respectful visitation path.", Color3.fromRGB(58, 91, 66), 180, nil)
end

local function buildSupportLounge(parent: Instance, center: Vector3)
    local district = BuildUtils.CreateFolder(parent, "SupportLounge")

    BuildUtils.CreatePart(district, "Floor", Vector3.new(130, 4, 90), CFrame.new(center + Vector3.new(0, 2, 0)), MECCA_MARBLE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "Counter", Vector3.new(60, 10, 16), CFrame.new(center + Vector3.new(0, 5, -25)), MECCA_STONE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "BackWall", Vector3.new(118, 28, 8), CFrame.new(center + Vector3.new(0, 14, -40)), MECCA_DARK, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "Roof", Vector3.new(138, 3, 96), CFrame.new(center + Vector3.new(0, 24, 0)), MECCA_STONE, Enum.Material.Marble, nil, nil)

    local leftScreen = createDigitalScreen(district, "SupportScreenLeft", center + Vector3.new(-28, 0, -34.8), Vector3.new(34, 18, 1.4), "Creator Ads", "Keep ad-ready screens and monetization boards in this outer lounge instead of the Kaaba center.")
    leftScreen.Orientation = Vector3.new(0, 180, 0)

    local rightScreen = createDigitalScreen(district, "SupportScreenRight", center + Vector3.new(28, 0, -34.8), Vector3.new(34, 18, 1.4), "Rewarded Video", "Use rewarded video here for battle ultimates or token bonuses once Creator Hub setup is complete.")
    rightScreen.Orientation = Vector3.new(0, 180, 0)

    createWallPanel(district, "SupportSign", center + Vector3.new(0, 0, 36), Vector3.new(74, 12, 2.5), "Creator Support Lounge", "Skins, support products, and ad screens live on the edge of the Makkah hub so the sacred center stays cleaner.", Color3.fromRGB(58, 91, 73), 0, nil)
    createLightPost(district, "SupportLightLeft", center + Vector3.new(-46, 0, 22))
    createLightPost(district, "SupportLightRight", center + Vector3.new(46, 0, 22))
end

local function buildStoryCourt(parent: Instance, center: Vector3)
    local district = BuildUtils.CreateFolder(parent, "StoryCourt")

    BuildUtils.CreatePart(district, "Floor", Vector3.new(220, 4, 150), CFrame.new(center + Vector3.new(0, 2, 0)), MECCA_MARBLE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "InnerFloor", Vector3.new(180, 1, 112), CFrame.new(center + Vector3.new(0, 4.55, 0)), Color3.fromRGB(250, 244, 233), Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "BackWall", Vector3.new(212, 22, 8), CFrame.new(center + Vector3.new(0, 11, -72)), MECCA_STONE, Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "RoofBand", Vector3.new(216, 4, 14), CFrame.new(center + Vector3.new(0, 22, -72)), MECCA_DARK, Enum.Material.Marble, nil, nil)

    createWallPanel(
        district,
        "StoryCourtSign",
        center + Vector3.new(0, 0, -66),
        Vector3.new(98, 12, 2.5),
        "Sahabi Story Playthroughs",
        "Choose a sahabi board, teleport into their scenario, and learn through guided NPC moments.",
        Color3.fromRGB(73, 96, 77),
        180,
        nil
    )

    local boardPositions = {
        center + Vector3.new(-72, 0, -14),
        center + Vector3.new(0, 0, -14),
        center + Vector3.new(72, 0, -14),
        center + Vector3.new(-36, 0, 56),
        center + Vector3.new(36, 0, 56),
    }

    for index, story in ipairs(CompanionStories) do
        local boardPosition = boardPositions[index] or (center + Vector3.new(-72 + ((index - 1) % 3) * 72, 0, 56 + math.floor((index - 1) / 3) * 70))
        local board = BuildUtils.CreateBoardSign(
            district,
            string.format("StoryBoard_%s", story.Id),
            boardPosition,
            story.DisplayName,
            story.Theme,
            story.AccentColor,
            {
                ActionText = "Play Story",
                ObjectText = "Story Board",
                Attributes = {
                    PromptAction = "StartStory",
                    StoryId = story.Id,
                },
            }
        )
        board.Orientation = Vector3.new(0, 180, 0)
    end

    createLightPost(district, "StoryCourtLightWest", center + Vector3.new(-92, 0, 40), Color3.fromRGB(132, 112, 88))
    createLightPost(district, "StoryCourtLightEast", center + Vector3.new(92, 0, 40), Color3.fromRGB(132, 112, 88))
    BuildUtils.CreatePlanter(district, "StoryCourtPlanterWest", center + Vector3.new(-94, 0, -24), Vector3.new(26, 3, 18))
    BuildUtils.CreatePlanter(district, "StoryCourtPlanterEast", center + Vector3.new(94, 0, -24), Vector3.new(26, 3, 18))
    BuildUtils.CreatePalmTree(district, "StoryCourtPalmWest", center + Vector3.new(-94, 0, -24))
    BuildUtils.CreatePalmTree(district, "StoryCourtPalmEast", center + Vector3.new(94, 0, -24))
end

local function buildMannersCourt(parent: Instance, center: Vector3)
    local district = BuildUtils.CreateFolder(parent, "MannersCourt")

    BuildUtils.CreatePart(district, "Floor", Vector3.new(230, 4, 162), CFrame.new(center + Vector3.new(0, 2, 0)), Color3.fromRGB(222, 213, 193), Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "LearningCarpet", Vector3.new(176, 1, 106), CFrame.new(center + Vector3.new(0, 4.6, 0)), Color3.fromRGB(90, 119, 83), Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(district, "BackWall", Vector3.new(218, 23, 8), CFrame.new(center + Vector3.new(0, 11.5, -78)), Color3.fromRGB(206, 195, 171), Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "RoofBand", Vector3.new(224, 4, 14), CFrame.new(center + Vector3.new(0, 24, -78)), Color3.fromRGB(98, 119, 76), Enum.Material.Marble, nil, nil)

    createWallPanel(
        district,
        "MannersCourtSign",
        center + Vector3.new(0, 0, -72),
        Vector3.new(108, 12, 2.5),
        "Manners Court",
        "Learn adab through short kid-friendly lessons. This section can grow into more playable scenarios later.",
        Color3.fromRGB(98, 119, 76),
        180,
        nil
    )

    local boardPositions = {
        center + Vector3.new(-72, 0, -18),
        center + Vector3.new(0, 0, -18),
        center + Vector3.new(72, 0, -18),
        center + Vector3.new(-36, 0, 50),
        center + Vector3.new(36, 0, 50),
    }

    for index, lesson in ipairs(MannersLessons) do
        local board = BuildUtils.CreateBoardSign(
            district,
            string.format("MannersBoard_%s", lesson.Id),
            boardPositions[index],
            lesson.DisplayName,
            lesson.Subtitle,
            lesson.AccentColor,
            {
                ActionText = "Learn",
                ObjectText = "Manners Lesson",
                Attributes = {
                    PromptAction = "OpenManners",
                    LessonId = lesson.Id,
                },
            }
        )
        board.Orientation = Vector3.new(0, 180, 0)
    end

    for _, offset in ipairs({
        Vector3.new(-92, 0, 52),
        Vector3.new(92, 0, 52),
        Vector3.new(-92, 0, -42),
        Vector3.new(92, 0, -42),
    }) do
        BuildUtils.CreatePlanter(district, string.format("MannersPlanter_%d_%d", offset.X, offset.Z), center + offset, Vector3.new(24, 3, 18))
        BuildUtils.CreatePalmTree(district, string.format("MannersPalm_%d_%d", offset.X, offset.Z), center + offset)
    end

    createLightPost(district, "MannersLightWest", center + Vector3.new(-108, 0, 18), Color3.fromRGB(128, 112, 89))
    createLightPost(district, "MannersLightEast", center + Vector3.new(108, 0, 18), Color3.fromRGB(128, 112, 89))
end

local function buildTriviaCourt(parent: Instance, center: Vector3)
    local district = BuildUtils.CreateFolder(parent, "TriviaCourt")

    BuildUtils.CreatePart(district, "Floor", Vector3.new(238, 4, 168), CFrame.new(center + Vector3.new(0, 2, 0)), Color3.fromRGB(224, 216, 198), Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "CenterCarpet", Vector3.new(174, 1, 106), CFrame.new(center + Vector3.new(0, 4.6, 8)), Color3.fromRGB(63, 98, 88), Enum.Material.Fabric, nil, nil)
    BuildUtils.CreatePart(district, "QuizLineGold", Vector3.new(166, 0.35, 3), CFrame.new(center + Vector3.new(0, 5.22, -30)), GOLD_ACCENT, Enum.Material.Metal, nil, nil).CanCollide = false
    BuildUtils.CreatePart(district, "QuizLineGreen", Vector3.new(166, 0.35, 3), CFrame.new(center + Vector3.new(0, 5.24, 46)), Color3.fromRGB(93, 130, 102), Enum.Material.Metal, nil, nil).CanCollide = false
    BuildUtils.CreatePart(district, "BackWall", Vector3.new(226, 24, 8), CFrame.new(center + Vector3.new(0, 12, -82)), Color3.fromRGB(206, 195, 171), Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "RoofBand", Vector3.new(232, 4, 14), CFrame.new(center + Vector3.new(0, 24, -82)), Color3.fromRGB(63, 98, 88), Enum.Material.Marble, nil, nil)

    createWallPanel(
        district,
        "TriviaStartPanel",
        center + Vector3.new(0, 0, -76),
        Vector3.new(118, 13, 2.5),
        "Islamic Trivia Challenge",
        "Compete with everyone on the server. Questions start easy, then get harder each round.",
        Color3.fromRGB(63, 98, 88),
        180,
        {
            ActionText = "Start Trivia",
            ObjectText = "Trivia Court",
            Attributes = {
                PromptAction = "StartTrivia",
            },
        }
    )

    local podiums = {
        { Name = "BasicsPodium", Offset = Vector3.new(-68, 0, 12), Color = Color3.fromRGB(92, 119, 82), Title = "Basics", Body = "Prayer, Ramadan, and daily words." },
        { Name = "SeerahPodium", Offset = Vector3.new(0, 0, 22), Color = Color3.fromRGB(121, 94, 63), Title = "Seerah", Body = "Hijrah, Badr, Uhud, and Medina." },
        { Name = "SahabiPodium", Offset = Vector3.new(68, 0, 12), Color = Color3.fromRGB(112, 98, 64), Title = "Sahabi", Body = "Companions and big story moments." },
    }

    for _, podium in ipairs(podiums) do
        BuildUtils.CreatePart(district, string.format("%s_Base", podium.Name), Vector3.new(48, 6, 30), CFrame.new(center + podium.Offset + Vector3.new(0, 3, 0)), podium.Color, Enum.Material.Sandstone, nil, nil)
        BuildUtils.CreatePart(district, string.format("%s_Glow", podium.Name), Vector3.new(42, 0.5, 24), CFrame.new(center + podium.Offset + Vector3.new(0, 6.35, 0)), Color3.fromRGB(245, 217, 153), Enum.Material.Neon, nil, 0.28).CanCollide = false
        local board = BuildUtils.CreateBoardSign(district, podium.Name, center + podium.Offset + Vector3.new(0, 0, 28), podium.Title, podium.Body, podium.Color, nil)
        board.Orientation = Vector3.new(0, 180, 0)
    end

    createLightPost(district, "TriviaLightWest", center + Vector3.new(-104, 0, -28), Color3.fromRGB(118, 105, 84))
    createLightPost(district, "TriviaLightEast", center + Vector3.new(104, 0, -28), Color3.fromRGB(118, 105, 84))
    BuildUtils.CreatePlanter(district, "TriviaPlanterWest", center + Vector3.new(-104, 0, 50), Vector3.new(28, 3, 20))
    BuildUtils.CreatePlanter(district, "TriviaPlanterEast", center + Vector3.new(104, 0, 50), Vector3.new(28, 3, 20))
    BuildUtils.CreatePalmTree(district, "TriviaPalmWest", center + Vector3.new(-104, 0, 50))
    BuildUtils.CreatePalmTree(district, "TriviaPalmEast", center + Vector3.new(104, 0, 50))
end

