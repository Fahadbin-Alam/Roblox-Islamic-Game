        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">BattleAnimationLibrary</string>
            <string name="Source"><![CDATA[--!strict

local BattleAnimationLibrary = {
    Sword = {
        Idle = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Idle,
            FadeTime = 0.18,
            Speed = 1,
            Looped = true,
        },
        Equip = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.08,
            Speed = 1,
            Looped = false,
        },
        Slash = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.06,
            Speed = 1.08,
            Looped = false,
        },
    },
    Bow = {
        Idle = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Idle,
            FadeTime = 0.18,
            Speed = 1,
            Looped = true,
        },
        Equip = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.08,
            Speed = 1,
            Looped = false,
        },
        DrawLoop = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.08,
            Speed = 1,
            Looped = true,
        },
        Release = {
            AnimationId = "",
            Priority = Enum.AnimationPriority.Action,
            FadeTime = 0.06,
            Speed = 1.04,
            Looped = false,
        },
    },
}

function BattleAnimationLibrary.HasAnimation(entry): boolean
    if typeof(entry) ~= "table" then
        return false
    end

    local animationId = entry.AnimationId

    return typeof(animationId) == "string" and animationId ~= "" and animationId ~= "rbxassetid://0"
end

return table.freeze(BattleAnimationLibrary)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict

local GameConfig = {
    GameName = "Path of the Sahabah",
    Genre = "Educational Adventure",
    Engine = "Luau",
    TargetAudience = "Ages 9-17",
    HubName = "Makkah Courtyard",
    TravelRouteName = "Main Menu",
    StartingStoryId = "bilal_ibn_rabah",
    StartingBattleId = "badr",
    StartingDestinationId = "kaaba_courtyard",
    DefaultCurrency = "Knowledge Tokens",
    TeleportMenuEnabled = true,
    CorePillars = {
        "StoryDrivenLearning",
        "ObjectiveBasedBattles",
        "HubBasedExploration",
        "RespectfulPresentation",
        "CosmeticFirstMonetization",
    },
    ContentRules = {
        AvoidDepictingProphets = true,
        UseNarrationForHistoricalContext = true,
        KeepCombatAgeAppropriate = true,
        RewardLearningAsMuchAsCombat = true,
        TreatSacredSpacesWithRespect = true,
    },
}

return table.freeze(GameConfig)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="5">
