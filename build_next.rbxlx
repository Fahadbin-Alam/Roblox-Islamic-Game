ultimateHint.TextColor3 = Color3.fromRGB(192, 198, 180)
ultimateHint.TextSize = 12
ultimateHint.TextWrapped = true
ultimateHint.TextXAlignment = Enum.TextXAlignment.Left
ultimateHint.TextYAlignment = Enum.TextYAlignment.Top
ultimateHint.Parent = ultimatePanel

local ultimateButton = Instance.new("TextButton")
ultimateButton.AnchorPoint = Vector2.new(1, 0.5)
ultimateButton.Position = UDim2.new(1, -12, 0.5, 8)
ultimateButton.Size = UDim2.fromOffset(92, 40)
ultimateButton.BackgroundColor3 = Color3.fromRGB(180, 149, 78)
ultimateButton.Font = Enum.Font.GothamBold
ultimateButton.Text = "Use"
ultimateButton.TextColor3 = Color3.fromRGB(255, 249, 237)
ultimateButton.TextSize = 18
ultimateButton.Parent = ultimatePanel

local ultimateButtonCorner = Instance.new("UICorner")
ultimateButtonCorner.CornerRadius = UDim.new(0, 10)
ultimateButtonCorner.Parent = ultimateButton

local function createSectionTitle(text: string)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -10, 0, 26)
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(52, 49, 43)
    label.TextSize = 18
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = scrollingFrame
end

local function createCard(title: string, subtitle: string, buttonText: string, buttonColor: Color3, onClick)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -10, 0, 104)
    card.BackgroundColor3 = Color3.fromRGB(255, 250, 239)
    card.Parent = scrollingFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = card

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(189, 175, 145)
    stroke.Thickness = 1.2
    stroke.Parent = card

    local titleLabelInner = Instance.new("TextLabel")
    titleLabelInner.BackgroundTransparency = 1
    titleLabelInner.Position = UDim2.fromOffset(14, 12)
    titleLabelInner.Size = UDim2.new(1, -108, 0, 22)
    titleLabelInner.Font = Enum.Font.GothamBold
    titleLabelInner.Text = title
    titleLabelInner.TextColor3 = Color3.fromRGB(40, 37, 31)
    titleLabelInner.TextSize = 16
    titleLabelInner.TextXAlignment = Enum.TextXAlignment.Left
    titleLabelInner.Parent = card

    local subtitleLabelInner = Instance.new("TextLabel")
    subtitleLabelInner.BackgroundTransparency = 1
    subtitleLabelInner.Position = UDim2.fromOffset(14, 38)
    subtitleLabelInner.Size = UDim2.new(1, -128, 0, 54)
    subtitleLabelInner.Font = Enum.Font.Gotham
    subtitleLabelInner.Text = subtitle
    subtitleLabelInner.TextColor3 = Color3.fromRGB(86, 78, 64)
    subtitleLabelInner.TextSize = 13
    subtitleLabelInner.TextWrapped = true
    subtitleLabelInner.TextXAlignment = Enum.TextXAlignment.Left
    subtitleLabelInner.TextYAlignment = Enum.TextYAlignment.Top
    subtitleLabelInner.Parent = card

    local button = Instance.new("TextButton")
    button.AnchorPoint = Vector2.new(1, 0.5)
    button.Position = UDim2.new(1, -12, 0.5, 0)
    button.Size = UDim2.fromOffset(86, 34)
    button.BackgroundColor3 = buttonColor
    button.Font = Enum.Font.GothamBold
    button.Text = buttonText
    button.TextColor3 = Color3.fromRGB(250, 246, 236)
    button.TextSize = 15
    button.Parent = card

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 10)
    buttonCorner.Parent = button

    button.MouseButton1Click:Connect(onClick)
end

local function rebuildCatalog()
    for _, child in ipairs(scrollingFrame:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local ultimateCharges = player:GetAttribute("UltimateCharges") or 0
    local knowledgeTokens = player:GetAttribute("KnowledgeTokens") or 0
    statLabel.Text = string.format("Knowledge Tokens: %d | Ultimate Charges: %d", knowledgeTokens, ultimateCharges)

    createSectionTitle("Support & Passes")

    for _, item in ipairs(shopCatalog.GamePasses) do
        local owned = state.ownedPasses[item.Key] == true
        local buttonText = owned and "Owned" or "Buy"
        local buttonColor = owned and Color3.fromRGB(74, 118, 76) or Color3.fromRGB(126, 94, 57)

        createCard(item.DisplayName, item.Benefit, buttonText, buttonColor, function()
            if not owned then
                promptGamePassPurchase:FireServer(item.Key)
            end
        end)
    end

    createSectionTitle("Battle Products")

    for _, item in ipairs(shopCatalog.DeveloperProducts) do
        createCard(item.DisplayName, item.Benefit, "Buy", Color3.fromRGB(96, 84, 133), function()
            promptDeveloperProductPurchase:FireServer(item.Key)
        end)
    end

    createSectionTitle("Skins")

    for skinId, skinDefinition in pairs(shopCatalog.SkinDefinitions) do
        local owned = state.ownedSkins[skinId] == true
        local equipped = state.equippedSkinId == skinId
        local buttonText = equipped and "Equipped" or (owned and "Equip" or "Locked")
        local buttonColor = equipped and Color3.fromRGB(70, 122, 78) or (owned and Color3.fromRGB(110, 118, 64) or Color3.fromRGB(138, 131, 121))
        local unlockText = "Included by default."

        if skinDefinition.UnlockType == "GamePass" then
            unlockText = owned and "Unlocked from the shop." or "Unlock this skin through its matching pass above."
        end

        createCard(skinDefinition.DisplayName, unlockText, buttonText, buttonColor, function()
            if owned and not equipped then
                equipSkinRemote:FireServer(skinId)
            end
        end)
    end

    createSectionTitle("Ad Revenue Setup")
    createCard(
        shopCatalog.RewardedAds.DisplayName,
        shopCatalog.RewardedAds.Benefit .. " " .. shopCatalog.RewardedAds.Disclosure,
        "Ad-Ready",
        Color3.fromRGB(70, 103, 122),
        function()
            statusLabel.Text = "Rewarded ads need Creator Hub setup, eligibility, and a real placement ID."
        end
    )

    createSectionTitle("Store Rules")

    for _, rule in ipairs(shopCatalog.Rules) do
        local ruleLabel = Instance.new("TextLabel")
        ruleLabel.BackgroundTransparency = 1
        ruleLabel.Size = UDim2.new(1, -12, 0, 42)
        ruleLabel.Font = Enum.Font.Gotham
        ruleLabel.Text = "- " .. rule
        ruleLabel.TextColor3 = Color3.fromRGB(86, 78, 64)
        ruleLabel.TextSize = 13
        ruleLabel.TextWrapped = true
        ruleLabel.TextXAlignment = Enum.TextXAlignment.Left
        ruleLabel.TextYAlignment = Enum.TextYAlignment.Top
        ruleLabel.Parent = scrollingFrame
    end

    statusLabel.Text = state.statusText
end

local function updateCanvas()
    scrollingFrame.CanvasSize = UDim2.fromOffset(0, listLayout.AbsoluteContentSize.Y + 10)
end

local function updateUltimatePanel()
    local charges = player:GetAttribute("UltimateCharges") or 0
    local inBattle = player:GetAttribute("InBattle") == true

    ultimatePanel.Visible = inBattle
    ultimateCount.Text = string.format("Charges: %d", charges)
    ultimateButton.Text = charges > 0 and "Use" or "Buy More"
end

shopStateEvent.OnClientEvent:Connect(function(payload)
    state.ownedPasses = arrayToLookup(payload.OwnedPassKeys or {})
    state.ownedSkins = arrayToLookup(payload.OwnedSkinIds or {})
    state.equippedSkinId = payload.EquippedSkinId or "default"

    if type(payload.StatusText) == "string" and payload.StatusText ~= "" then
        state.statusText = payload.StatusText
    end

    rebuildCatalog()
    updateCanvas()
    updateUltimatePanel()
end)

purchaseFeedback.OnClientEvent:Connect(function(payload)
    if typeof(payload) == "table" and type(payload.Text) == "string" then
        state.statusText = payload.Text
        statusLabel.Text = payload.Text
    end
end)

toggleButton.MouseButton1Click:Connect(function()
    panel.Visible = not panel.Visible

    if panel.Visible then
        requestShopState:FireServer()
    end
end)

closeButton.MouseButton1Click:Connect(function()
    panel.Visible = false
end)

ultimateButton.MouseButton1Click:Connect(function()
    if (player:GetAttribute("UltimateCharges") or 0) > 0 then
        useUltimateRemote:FireServer()
    else
        promptDeveloperProductPurchase:FireServer("ultimate_charge_single")
    end
end)

listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
player:GetAttributeChangedSignal("UltimateCharges"):Connect(function()
    rebuildCatalog()
    updateCanvas()
    updateUltimatePanel()
end)
player:GetAttributeChangedSignal("KnowledgeTokens"):Connect(function()
    rebuildCatalog()
    updateCanvas()
end)
player:GetAttributeChangedSignal("InBattle"):Connect(updateUltimatePanel)

local function updateToggleAvailability()
    local inStory = player:GetAttribute("InStory") == true
    local inBattle = player:GetAttribute("InBattle") == true

    toggleButton.Visible = false

    if inStory or inBattle then
        panel.Visible = false
    end
end

player:GetAttributeChangedSignal("InStory"):Connect(updateToggleAvailability)
player:GetAttributeChangedSignal("InBattle"):Connect(updateToggleAvailability)

rebuildCatalog()
updateCanvas()
updateUltimatePanel()
updateToggleAvailability()
requestShopState:FireServer()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="47">
        <Properties>
          <string name="Name">StoryHud</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local storyFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Story")
local showStoryDialogue = storyFolder:WaitForChild("ShowStoryDialogue") :: RemoteEvent
local updateStoryMission = storyFolder:WaitForChild("UpdateStoryMission") :: RemoteEvent
local clearStoryMission = storyFolder:WaitForChild("ClearStoryMission") :: RemoteEvent

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "StoryHud"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 18
screenGui.Parent = playerGui

local missionFrame = Instance.new("Frame")
missionFrame.AnchorPoint = Vector2.new(0, 0)
missionFrame.Position = UDim2.fromOffset(22, 22)
missionFrame.Size = UDim2.fromOffset(360, 116)
missionFrame.BackgroundColor3 = Color3.fromRGB(248, 240, 220)
missionFrame.Visible = false
missionFrame.Parent = screenGui

local missionCorner = Instance.new("UICorner")
missionCorner.CornerRadius = UDim.new(0, 16)
missionCorner.Parent = missionFrame

local missionStroke = Instance.new("UIStroke")
missionStroke.Color = Color3.fromRGB(111, 92, 61)
missionStroke.Thickness = 1.6
missionStroke.Parent = missionFrame

local storyNameLabel = Instance.new("TextLabel")
storyNameLabel.BackgroundTransparency = 1
storyNameLabel.Position = UDim2.fromOffset(16, 14)
storyNameLabel.Size = UDim2.new(1, -32, 0, 22)
storyNameLabel.Font = Enum.Font.GothamBold
storyNameLabel.Text = ""
storyNameLabel.TextColor3 = Color3.fromRGB(63, 57, 45)
storyNameLabel.TextSize = 18
storyNameLabel.TextXAlignment = Enum.TextXAlignment.Left
storyNameLabel.Parent = missionFrame

local stepLabel = Instance.new("TextLabel")
stepLabel.BackgroundTransparency = 1
stepLabel.Position = UDim2.fromOffset(16, 40)
stepLabel.Size = UDim2.new(1, -32, 0, 18)
stepLabel.Font = Enum.Font.GothamMedium
stepLabel.Text = ""
stepLabel.TextColor3 = Color3.fromRGB(78, 111, 83)
stepLabel.TextSize = 14
stepLabel.TextXAlignment = Enum.TextXAlignment.Left
stepLabel.Parent = missionFrame

local objectiveLabel = Instance.new("TextLabel")
objectiveLabel.BackgroundTransparency = 1
objectiveLabel.Position = UDim2.fromOffset(16, 62)
objectiveLabel.Size = UDim2.new(1, -32, 0, 28)
objectiveLabel.Font = Enum.Font.Gotham
objectiveLabel.Text = ""
objectiveLabel.TextColor3 = Color3.fromRGB(84, 74, 59)
objectiveLabel.TextSize = 15
objectiveLabel.TextWrapped = true
objectiveLabel.TextXAlignment = Enum.TextXAlignment.Left
objectiveLabel.TextYAlignment = Enum.TextYAlignment.Top
objectiveLabel.Parent = missionFrame

local locationLabel = Instance.new("TextLabel")
locationLabel.BackgroundTransparency = 1
locationLabel.Position = UDim2.fromOffset(16, 90)
locationLabel.Size = UDim2.new(1, -32, 0, 18)
locationLabel.Font = Enum.Font.GothamMedium
locationLabel.Text = ""
locationLabel.TextColor3 = Color3.fromRGB(115, 100, 74)
locationLabel.TextSize = 13
locationLabel.TextXAlignment = Enum.TextXAlignment.Left
locationLabel.Parent = missionFrame

local dialogueFrame = Instance.new("Frame")
dialogueFrame.AnchorPoint = Vector2.new(0.5, 1)
dialogueFrame.Position = UDim2.new(0.5, 0, 1, -42)
dialogueFrame.Size = UDim2.fromOffset(840, 196)
dialogueFrame.BackgroundColor3 = Color3.fromRGB(30, 27, 24)
dialogueFrame.BackgroundTransparency = 0.08
dialogueFrame.Visible = false
dialogueFrame.Parent = screenGui

local dialogueCorner = Instance.new("UICorner")
dialogueCorner.CornerRadius = UDim.new(0, 18)
dialogueCorner.Parent = dialogueFrame

local dialogueStroke = Instance.new("UIStroke")
dialogueStroke.Color = Color3.fromRGB(174, 145, 87)
dialogueStroke.Thickness = 1.5
dialogueStroke.Parent = dialogueFrame

local dialogueTitle = Instance.new("TextLabel")
dialogueTitle.BackgroundTransparency = 1
dialogueTitle.Position = UDim2.fromOffset(20, 14)
dialogueTitle.Size = UDim2.new(1, -40, 0, 22)
dialogueTitle.Font = Enum.Font.GothamBold
dialogueTitle.Text = ""
dialogueTitle.TextColor3 = Color3.fromRGB(233, 215, 179)
dialogueTitle.TextSize = 18
dialogueTitle.TextXAlignment = Enum.TextXAlignment.Left
dialogueTitle.Parent = dialogueFrame

local dialogueSpeaker = Instance.new("TextLabel")
dialogueSpeaker.BackgroundTransparency = 1
dialogueSpeaker.Position = UDim2.fromOffset(20, 40)
dialogueSpeaker.Size = UDim2.new(1, -40, 0, 20)
dialogueSpeaker.Font = Enum.Font.GothamMedium
dialogueSpeaker.Text = ""
dialogueSpeaker.TextColor3 = Color3.fromRGB(160, 194, 164)
dialogueSpeaker.TextSize = 15
dialogueSpeaker.TextXAlignment = Enum.TextXAlignment.Left
dialogueSpeaker.Parent = dialogueFrame

local dialogueBody = Instance.new("TextLabel")
dialogueBody.BackgroundTransparency = 1
dialogueBody.Position = UDim2.fromOffset(20, 66)
dialogueBody.Size = UDim2.new(1, -40, 1, -86)
dialogueBody.Font = Enum.Font.Gotham
dialogueBody.Text = ""
dialogueBody.TextColor3 = Color3.fromRGB(240, 236, 226)
dialogueBody.TextSize = 19
dialogueBody.TextWrapped = true
dialogueBody.TextXAlignment = Enum.TextXAlignment.Left
dialogueBody.TextYAlignment = Enum.TextYAlignment.Top
dialogueBody.Parent = dialogueFrame

local dialogueToken = 0
local MIN_LINE_DURATION_SECONDS = 2.7
local MAX_LINE_DURATION_SECONDS = 7.2
local REFERENCE_SPEAKER_COLOR = Color3.fromRGB(215, 189, 126)
local DEFAULT_SPEAKER_COLOR = Color3.fromRGB(160, 194, 164)

local function normalizeDialogueLine(rawLine)
    if typeof(rawLine) == "table" then
        return rawLine.Speaker or "", rawLine.Text or ""
    end

    return "", tostring(rawLine)
end

local function getLineDuration(body: string): number
    local characters = string.len(body)
    return math.clamp(2.1 + characters * 0.028, MIN_LINE_DURATION_SECONDS, MAX_LINE_DURATION_SECONDS)
end

showStoryDialogue.OnClientEvent:Connect(function(payload)
    dialogueToken += 1
    local currentToken = dialogueToken
    local lines = payload.Lines or {}

    dialogueFrame.Visible = true
    dialogueTitle.Text = payload.Title or payload.StoryName or "Story"

    for _, rawLine in ipairs(lines) do
        if currentToken ~= dialogueToken then
            return
        end

        local speaker, body = normalizeDialogueLine(rawLine)
        dialogueSpeaker.Text = speaker
        dialogueSpeaker.TextColor3 = string.find(string.lower(speaker), "reference", 1, true) and REFERENCE_SPEAKER_COLOR or DEFAULT_SPEAKER_COLOR
        dialogueBody.Text = body
        task.wait(getLineDuration(body))
    end

    if currentToken == dialogueToken then
        dialogueFrame.Visible = false
    end
end)

updateStoryMission.OnClientEvent:Connect(function(payload)
    missionFrame.Visible = true
    storyNameLabel.Text = payload.StoryName or ""
    stepLabel.Text = payload.StepLabel or ""
    objectiveLabel.Text = payload.Objective or ""
    locationLabel.Text = payload.LocationName or ""
end)

clearStoryMission.OnClientEvent:Connect(function()
    missionFrame.Visible = false
    dialogueFrame.Visible = false
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="48">
        <Properties>
          <string name="Name">TriviaHud</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local triviaFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Trivia")
local submitTriviaAnswer = triviaFolder:WaitForChild("SubmitTriviaAnswer") :: RemoteEvent
local showTriviaQuestion = triviaFolder:WaitForChild("ShowTriviaQuestion") :: RemoteEvent
local showTriviaResult = triviaFolder:WaitForChild("ShowTriviaResult") :: RemoteEvent
local updateTriviaScores = triviaFolder:WaitForChild("UpdateTriviaScores") :: RemoteEvent
local clearTrivia = triviaFolder:WaitForChild("ClearTrivia") :: RemoteEvent

local selectedThisRound = false
local questionEndsAt = 0
local answerButtons: { TextButton } = {}
local scoreRows: { TextLabel } = {}

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TriviaHud"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 28
screenGui.Parent = playerGui

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 20)
panel.Size = UDim2.fromOffset(660, 408)
panel.BackgroundColor3 = Color3.fromRGB(245, 239, 224)
panel.Visible = false
panel.Parent = screenGui

local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 8)
panelCorner.Parent = panel

local panelStroke = Instance.new("UIStroke")
panelStroke.Color = Color3.fromRGB(75, 67, 51)
panelStroke.Thickness = 2
panelStroke.Parent = panel

local titleLabel = Instance.new("TextLabel")
titleLabel.BackgroundTransparency = 1
titleLabel.Position = UDim2.fromOffset(18, 14)
titleLabel.Size = UDim2.new(1, -36, 0, 30)
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Text = "Islamic Trivia Challenge"
titleLabel.TextColor3 = Color3.fromRGB(38, 35, 28)
titleLabel.TextSize = 23
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Parent = panel

local metaLabel = Instance.new("TextLabel")
metaLabel.BackgroundTransparency = 1
metaLabel.Position = UDim2.fromOffset(18, 48)
metaLabel.Size = UDim2.new(1, -36, 0, 24)
metaLabel.Font = Enum.Font.GothamMedium
metaLabel.Text = "Round 1"
metaLabel.TextColor3 = Color3.fromRGB(93, 80, 54)
metaLabel.TextSize = 14
metaLabel.TextXAlignment = Enum.TextXAlignment.Left
metaLabel.Parent = panel

local timerLabel = Instance.new("TextLabel")
timerLabel.AnchorPoint = Vector2.new(1, 0)
timerLabel.BackgroundTransparency = 1
timerLabel.Position = UDim2.new(1, -18, 0, 48)
timerLabel.Size = UDim2.fromOffset(120, 24)
timerLabel.Font = Enum.Font.GothamBold
timerLabel.Text = ""
timerLabel.TextColor3 = Color3.fromRGB(87, 99, 67)
timerLabel.TextSize = 14
timerLabel.TextXAlignment = Enum.TextXAlignment.Right
timerLabel.Parent = panel

local questionLabel = Instance.new("TextLabel")
questionLabel.BackgroundTransparency = 1
questionLabel.Position = UDim2.fromOffset(18, 82)
questionLabel.Size = UDim2.new(1, -36, 0, 74)
questionLabel.Font = Enum.Font.GothamBold
questionLabel.Text = ""
questionLabel.TextColor3 = Color3.fromRGB(43, 39, 31)
questionLabel.TextSize = 20
questionLabel.TextWrapped = true
questionLabel.TextXAlignment = Enum.TextXAlignment.Left
questionLabel.TextYAlignment = Enum.TextYAlignment.Top
questionLabel.Parent = panel

local answersFrame = Instance.new("Frame")
answersFrame.BackgroundTransparency = 1
answersFrame.Position = UDim2.fromOffset(18, 166)
answersFrame.Size = UDim2.new(0.62, -22, 0, 208)
answersFrame.Parent = panel

local answerLayout = Instance.new("UIListLayout")
answerLayout.Padding = UDim.new(0, 8)
answerLayout.Parent = answersFrame

local scoreboardFrame = Instance.new("Frame")
scoreboardFrame.Position = UDim2.new(0.62, 6, 0, 166)
scoreboardFrame.Size = UDim2.new(0.38, -24, 0, 208)
scoreboardFrame.BackgroundColor3 = Color3.fromRGB(232, 225, 209)
scoreboardFrame.Parent = panel

local scoreboardCorner = Instance.new("UICorner")
scoreboardCorner.CornerRadius = UDim.new(0, 8)
scoreboardCorner.Parent = scoreboardFrame

local scoreboardTitle = Instance.new("TextLabel")
scoreboardTitle.BackgroundTransparency = 1
scoreboardTitle.Position = UDim2.fromOffset(12, 10)
scoreboardTitle.Size = UDim2.new(1, -24, 0, 22)
scoreboardTitle.Font = Enum.Font.GothamBold
scoreboardTitle.Text = "Leaderboard"
scoreboardTitle.TextColor3 = Color3.fromRGB(46, 42, 34)
scoreboardTitle.TextSize = 15
scoreboardTitle.TextXAlignment = Enum.TextXAlignment.Left
scoreboardTitle.Parent = scoreboardFrame

local feedbackLabel = Instance.new("TextLabel")
feedbackLabel.BackgroundTransparency = 1
feedbackLabel.Position = UDim2.fromOffset(18, 372)
feedbackLabel.Size = UDim2.new(1, -36, 0, 26)
feedbackLabel.Font = Enum.Font.GothamMedium
feedbackLabel.Text = "Pick one answer before time runs out."
feedbackLabel.TextColor3 = Color3.fromRGB(66, 91, 67)
feedbackLabel.TextSize = 14
feedbackLabel.TextWrapped = true
feedbackLabel.TextXAlignment = Enum.TextXAlignment.Left
feedbackLabel.Parent = panel

local function setAnswerButtonsEnabled(enabled: boolean)
    for _, button in ipairs(answerButtons) do
        button.Active = enabled
        button.AutoButtonColor = enabled
        button.BackgroundTransparency = enabled and 0 or 0.18
    end
end

local function clearAnswers()
    for _, button in ipairs(answerButtons) do
        button:Destroy()
    end

    answerButtons = {}
end

local function buildAnswerButton(optionText: string, index: number)
    local button = Instance.new("TextButton")
    button.Name = string.format("Answer_%d", index)
    button.Size = UDim2.new(1, 0, 0, 46)
    button.BackgroundColor3 = Color3.fromRGB(76, 96, 73)
    button.Font = Enum.Font.GothamBold
    button.Text = string.format("%d. %s", index, optionText)
    button.TextColor3 = Color3.fromRGB(250, 246, 234)
    button.TextSize = 15
    button.TextWrapped = true
    button.Parent = answersFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button

    button.Activated:Connect(function()
        if selectedThisRound then
            return
        end

        selectedThisRound = true
        feedbackLabel.Text = "Answer sent. Waiting for the round result."
        setAnswerButtonsEnabled(false)
        submitTriviaAnswer:FireServer(index)
    end)

    table.insert(answerButtons, button)
end

local function updateScoreboard(rows)
    for _, row in ipairs(scoreRows) do
        row:Destroy()
    end

    scoreRows = {}

    for index = 1, 5 do
        local rowData = rows and rows[index]
        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Position = UDim2.fromOffset(12, 36 + (index - 1) * 31)
        label.Size = UDim2.new(1, -24, 0, 28)
        label.Font = Enum.Font.GothamMedium
        label.TextColor3 = Color3.fromRGB(55, 49, 38)
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = rowData and string.format("%d. %s - %d", index, rowData.PlayerName, rowData.Score) or string.format("%d. Waiting...", index)
        label.Parent = scoreboardFrame
        table.insert(scoreRows, label)
    end
end

showTriviaQuestion.OnClientEvent:Connect(function(payload)
    panel.Visible = true
    selectedThisRound = false
    questionEndsAt = os.clock() + (payload.TimeLimit or 16)
    titleLabel.Text = payload.DisplayName or "Islamic Trivia Challenge"
    metaLabel.Text = string.format("Round %d of %d | Difficulty %d", payload.Round or 1, payload.TotalRounds or 1, payload.Difficulty or 1)
    questionLabel.Text = payload.Prompt or ""
    feedbackLabel.Text = "Pick one answer before time runs out."
    clearAnswers()

    for index, optionText in ipairs(payload.Options or {}) do
        buildAnswerButton(optionText, index)
    end
end)

showTriviaResult.OnClientEvent:Connect(function(payload)
    panel.Visible = true

    if payload.Personal then
        feedbackLabel.Text = payload.Correct and "Correct. Nice streak." or string.format("Not this time. Correct answer: %s", payload.CorrectText or "")
    else
        feedbackLabel.Text = string.format("Correct answer: %s. %s", payload.CorrectText or "", payload.Explanation or "")
        setAnswerButtonsEnabled(false)
    end

    if payload.Scoreboard then
        updateScoreboard(payload.Scoreboard)
    end
end)

updateTriviaScores.OnClientEvent:Connect(function(payload)
    if payload.Scoreboard then
        updateScoreboard(payload.Scoreboard)
    end
end)

clearTrivia.OnClientEvent:Connect(function(payload)
    panel.Visible = true
    selectedThisRound = true
    questionEndsAt = 0
    clearAnswers()
    titleLabel.Text = "Trivia Complete"
    metaLabel.Text = "Final scoreboard"
    timerLabel.Text = ""
    questionLabel.Text = payload.Message or "Trivia finished."
    feedbackLabel.Text = "Start again from the trivia court or the menu."

    if payload.Scoreboard then
        updateScoreboard(payload.Scoreboard)
    end
end)

RunService.RenderStepped:Connect(function()
    if not panel.Visible or questionEndsAt <= 0 then
        return
    end

    local remaining = math.max(0, math.ceil(questionEndsAt - os.clock()))
    timerLabel.Text = string.format("%ds", remaining)

    if remaining <= 0 and not selectedThisRound then
        selectedThisRound = true
        feedbackLabel.Text = "Time is up. Waiting for the answer."
        setAnswerButtonsEnabled(false)
    end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>