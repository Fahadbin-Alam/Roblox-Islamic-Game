subtitleLabel.Font = Enum.Font.Gotham
subtitleLabel.Text = "Choose a battle, sahabi story, manners lesson, trivia, or Medina travel."
subtitleLabel.TextColor3 = Color3.fromRGB(76, 67, 52)
