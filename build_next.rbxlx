ultimateCount.Size = UDim2.new(1, -120, 0, 20)
ultimateCount.Font = Enum.Font.Gotham
ultimateCount.Text = "Charges: 0"
ultimateCount.TextColor3 = Color3.fromRGB(213, 220, 197)
