        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">BattleScenarios</string>
            <string name="Source"><![CDATA[--!strict

local BattleScenarios = {
    {
        Id = "badr",
        DisplayName = "Battle of Badr",
        QueuePrompt = "Join the Battle of Badr queue.",
        Format = "TeamBattleScenario",
        ArenaTheme = "DesertValley",
        RecommendedPlayers = 60,
        MinPlayersToLaunch = 2,
        PlayersPerTeam = 30,
        FillEmptySlotsWithBots = false,
        CountdownSeconds = 8,
        RoundDurationSeconds = 240,
        LearningGoal = "Teach courage, preparation, unity, and the importance of a major early turning point.",
        Teams = {
            {
                Id = "medina",
                DisplayName = "Medina Side",
                AccentColor = Color3.fromRGB(56, 123, 79),
            },
            {
                Id = "makkah",
                DisplayName = "Makkah Side",
                AccentColor = Color3.fromRGB(160, 109, 60),
            },
        },
        KeyFigures = {
            Medina = "Medina side: Prophet Muhammad, peace be upon him, led the Muslims but is never depicted. Companions connected to this period include Abu Bakr, Umar, Ali, Hamzah, and Bilal, may Allah be pleased with them.",
            Makkah = "Makkah Quraysh side: leaders remembered in the conflict include Abu Jahl, Umayyah ibn Khalaf, Utbah ibn Rabi'ah, and other chiefs of Quraysh.",
        },
        SpawnPositions = {
            medina = {
                Vector3.new(-1320, 10, 720),
                Vector3.new(-1310, 10, 752),
                Vector3.new(-1290, 10, 692),
            },
            makkah = {
                Vector3.new(-982, 10, 720),
                Vector3.new(-996, 10, 752),
                Vector3.new(-1010, 10, 692),
            },
        },
        GameplayPhases = {
            {
                Id = "briefing",
                Title = "Briefing",
                Objective = "Enter the valley, study the wells and ridges, and prepare your side for the clash.",
            },
            {
                Id = "clash",
                Title = "Main Clash",
                Objective = "Push through the valley with swords and arrows while using terrain and cover.",
            },
            {
                Id = "reenactment",
                Title = "Historical Reenactment",
                Objective = "Watch the battle aftermath play out through a short staged retelling.",
            },
        },
        Briefing = {
            IntroTitle = "Before The Battle",
            Scenes = {
                {
                    CameraName = "BriefingMap1",
                    Title = "17 Ramadan, 2 AH | 624 CE",
                    Body = "Badr happened after the Hijrah, when the Muslims had settled in Medina and conflict with the Quraysh of Makkah was still rising.",
                    DurationSeconds = 7,
                    FieldOfView = 62,
                    CameraDrift = Vector3.new(10, 1, -4),
                },
                {
                    CameraName = "BriefingMap2",
                    Title = "The Situation",
                    Body = "The young Muslim community in Medina faced pressure from Quraysh power in Makkah. Badr became the first major battle between the two sides.",
                    DurationSeconds = 8,
                    FieldOfView = 58,
                    CameraDrift = Vector3.new(0, -2, 10),
                },
                {
                    CameraName = "BriefingMap3",
                    Title = "Main People To Know",
                    Body = "Medina side: the Prophet, peace be upon him, led but is not depicted. Companions such as Abu Bakr, Umar, Ali, Hamzah, and Bilal, may Allah be pleased with them, are connected to this period.",
                    DurationSeconds = 9,
                    FieldOfView = 64,
                    CameraDrift = Vector3.new(-8, 0, 12),
                },
                {
                    CameraName = "BriefingMap4",
                    Title = "The Opposing Side",
                    Body = "Quraysh leaders remembered in this conflict include Abu Jahl, Umayyah ibn Khalaf, and Utbah ibn Rabi'ah. This mode now stays fully player-versus-player with no filler bots or boss dummy.",
                    DurationSeconds = 8,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-10, 1, -5),
                },
                {
                    CameraName = "BriefingMap5",
                    Title = "Your Objective",
                    Body = "Fight the round as a direct clash between both player teams, use the valley and wells, then watch the reenactment to connect the action to courage, preparation, unity, and gratitude.",
                    DurationSeconds = 7,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(8, 0, -8),
                },
            },
        },
        Reenactment = {
            IntroTitle = "Badr Reenactment",
            Scenes = {
                {
                    CameraName = "Scene1",
                    Title = "The Wells Of Badr",
                    Body = "17 Ramadan, 2 AH. The valley and wells mattered because preparation and position shaped what happened before the clash.",
                    DurationSeconds = 7,
                    FieldOfView = 63,
                    CameraDrift = Vector3.new(8, 0, -6),
                },
                {
                    CameraName = "Scene2",
                    Title = "Standing Together",
                    Body = "The Medina side was a small, vulnerable community under pressure. The scene keeps the Prophet, peace be upon him, out of visual depiction.",
                    DurationSeconds = 8,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(0, 1, 10),
                },
                {
                    CameraName = "Scene3",
                    Title = "The Opposing Command",
                    Body = "The Quraysh side had powerful chiefs and confidence from Makkah. In gameplay, the mode now stays focused on two player teams meeting in the valley without bot fill.",
                    DurationSeconds = 7,
                    FieldOfView = 61,
                    CameraDrift = Vector3.new(-9, 0, 8),
                },
                {
                    CameraName = "Scene4",
                    Title = "A Turning Point",
                    Body = "Badr raised morale and changed how the community was seen. The ending should feel like a lesson, not only a scoreboard.",
                    DurationSeconds = 7,
                    FieldOfView = 58,
                    CameraDrift = Vector3.new(6, 2, -10),
                },
                {
                    CameraName = "Scene5",
                    Title = "What Players Should Remember",
                    Body = "In the game you fought for fun. In the lesson, remember preparation, unity, gratitude, and responsibility after victory.",
                    DurationSeconds = 7,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-5, 0, -8),
                },
            },
        },
        StorySummary = {
            Title = "What Happened At Badr",
            Lines = {
                "Badr took place on 17 Ramadan, 2 AH / 624 CE and became a major victory for the early Muslim community.",
                "The battle strengthened morale and marked a turning point in the public standing of the community.",
                "This battle mode now stays player-only so the reenactment carries the teaching while the round itself stays focused and readable.",
            },
        },
        Rewards = {
            KnowledgeTokens = 100,
            UnlockStoryIds = {
                "bilal_ibn_rabah",
                "umar_ibn_al_khattab",
            },
        },
    },
    {
        Id = "uhud",
        DisplayName = "Battle of Uhud",
        QueuePrompt = "Join the Battle of Uhud queue.",
        Format = "TeamBattleScenario",
        ArenaTheme = "MountainPass",
        RecommendedPlayers = 60,
        MinPlayersToLaunch = 2,
        PlayersPerTeam = 30,
        FillEmptySlotsWithBots = false,
        CountdownSeconds = 8,
        RoundDurationSeconds = 250,
        LearningGoal = "Teach discipline, the cost of leaving an assigned post, sacrifice under pressure, and the emotional weight of Uhud.",
        Teams = {
            {
                Id = "medina",
                DisplayName = "Medina Side",
                AccentColor = Color3.fromRGB(63, 132, 86),
            },
            {
                Id = "makkah",
                DisplayName = "Makkah Side",
                AccentColor = Color3.fromRGB(143, 101, 68),
            },
        },
        KeyFigures = {
            Medina = "Medina side: Prophet Muhammad, peace be upon him, led the Muslims but is never depicted. Companions connected to Uhud include Hamzah ibn Abd al-Muttalib, Mus'ab ibn Umayr, and Nusaybah bint Ka'b, may Allah be pleased with them.",
            Makkah = "Makkah Quraysh side: leaders and commanders connected to Uhud include Abu Sufyan and Khalid ibn al-Walid before he accepted Islam. The game uses a generic commander role instead of making them playable.",
        },
        SpawnPositions = {
            medina = {
                Vector3.new(-1320, 10, 1180),
                Vector3.new(-1304, 10, 1210),
                Vector3.new(-1288, 10, 1148),
            },
            makkah = {
                Vector3.new(-982, 10, 1180),
                Vector3.new(-996, 10, 1210),
                Vector3.new(-1010, 10, 1148),
            },
        },
        GameplayPhases = {
            {
                Id = "briefing",
                Title = "Briefing",
                Objective = "Study the mountain pass, the archer ridge, and the approaches before the clash begins.",
            },
            {
                Id = "clash",
                Title = "Main Clash",
                Objective = "Fight through the pass with swords and arrows while using the ridge and rocky cover.",
            },
            {
                Id = "reenactment",
                Title = "Historical Reenactment",
                Objective = "Watch the mountain-side story retold through a short staged scene.",
            },
        },
        Briefing = {
            IntroTitle = "Before The Battle",
            Scenes = {
                {
                    CameraName = "BriefingMap1",
                    Title = "Dawn At Uhud | 3 AH / 625 CE",
                    Body = "Qur'an 3:121 remembers the believers being placed into battle positions. This opening view frames Mount Uhud, the approaches from Medina, and the ground where the lines were formed before the clash.",
                    DurationSeconds = 8,
                    FieldOfView = 62,
                    CameraDrift = Vector3.new(14, 2, -8),
                    Reference = "Qur'an 3:121 · Quran.com",
                },
                {
                    CameraName = "BriefingMap2",
                    Title = "The Archer Ridge Must Hold",
                    Body = "Sunan Abi Dawud 2662 reports that 'Abd Allah ibn Jubayr led fifty archers with a strict order: hold the ridge and do not leave, even if the battlefield appears won.",
                    DurationSeconds = 9,
                    FieldOfView = 58,
                    CameraDrift = Vector3.new(10, 0, 10),
                    Reference = "Sunan Abi Dawud 2662 · Sunnah.com",
                },
                {
                    CameraName = "BriefingMap3",
                    Title = "Early Pressure On Quraysh",
                    Body = "Qur'an 3:152 describes the early stage when victory seemed within reach. In the game camera pass, the Medina line pushes forward while the ridge still protects the flank.",
                    DurationSeconds = 9,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-10, 0, 12),
                    Reference = "Qur'an 3:152 · Quran.com",
                },
                {
                    CameraName = "BriefingMap4",
                    Title = "The Turn In The Field",
                    Body = "Qur'an 3:152-153 links the setback to dispute and disobedience after success. Once the ridge opened, the field broke, people ran uphill in confusion, and the battle changed in moments.",
                    DurationSeconds = 9,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-12, 1, -9),
                    Reference = "Qur'an 3:152-153 · Quran.com",
                },
                {
                    CameraName = "BriefingMap5",
                    Title = "Wounds And Protection",
                    Body = "Sahih Muslim 1790a records the injuries of that day: the Messenger of Allah, peace be upon him, was wounded, and Fatimah and 'Ali worked urgently to stop the bleeding.",
                    DurationSeconds = 8,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(8, 2, -8),
                    Reference = "Sahih Muslim 1790a · Sunnah.com",
                },
                {
                    CameraName = "BriefingMap6",
                    Title = "After The Shock",
                    Body = "Qur'an 3:172 and Sahih al-Bukhari 4077 preserve that wounded believers still answered the call after Uhud. The lesson is not surface-level victory, but obedience, endurance, and return after pain.",
                    DurationSeconds = 9,
                    FieldOfView = 57,
                    CameraDrift = Vector3.new(0, -2, 10),
                    Reference = "Qur'an 3:172 · Sahih al-Bukhari 4077",
                },
            },
        },
        Reenactment = {
            IntroTitle = "Uhud Reenactment",
            Scenes = {
                {
                    CameraName = "Scene1",
                    Title = "A Mountain With Meaning",
                    Body = "Sahih al-Bukhari 4422 preserves the line that Uhud is a mountain that loves us and is loved by us. The place itself became part of the memory of the battle.",
                    DurationSeconds = 8,
                    FieldOfView = 61,
                    CameraDrift = Vector3.new(12, 1, -8),
                    Reference = "Sahih al-Bukhari 4422 · Sunnah.com",
                },
                {
                    CameraName = "Scene2",
                    Title = "Stations For Battle",
                    Body = "Qur'an 3:121 recalls the believers being placed into battle positions. This scene turns from the mountain face to the ridge and pass so players can connect the reports to the actual terrain.",
                    DurationSeconds = 9,
                    FieldOfView = 59,
                    CameraDrift = Vector3.new(6, 2, 10),
                    Reference = "Qur'an 3:121 · Quran.com",
                },
                {
                    CameraName = "Scene3",
                    Title = "The Ridge Must Hold",
                    Body = "Sunan Abi Dawud 2662 ties Uhud to the order given to the archers not to leave their place, even when the field looked won and the temptation of booty appeared.",
                    DurationSeconds = 9,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(-12, 0, 10),
                    Reference = "Sunan Abi Dawud 2662 · Sunnah.com",
                },
                {
                    CameraName = "Scene4",
                    Title = "Confusion And The Uphill Flight",
                    Body = "Qur'an 3:153 describes the believers climbing and not looking back while the Messenger called from behind. Sahih Muslim 1789 remembers how fiercely the pressure closed in during the late battle.",
                    DurationSeconds = 9,
                    FieldOfView = 58,
                    CameraDrift = Vector3.new(-8, 3, -12),
                    Reference = "Qur'an 3:153 · Sahih Muslim 1789",
                },
                {
                    CameraName = "Scene5",
                    Title = "Wounds And Rescue",
                    Body = "Sahih Muslim 1790a records the injuries suffered that day and the urgent effort to stop the bleeding. Uhud is taught here as pain, rescue, loss, and steadfast protection under pressure.",
                    DurationSeconds = 9,
                    FieldOfView = 60,
                    CameraDrift = Vector3.new(10, 1, -6),
                    Reference = "Sahih Muslim 1790a · Sunnah.com",
                },
                {
                    CameraName = "Scene6",
                    Title = "Martyrs, Grief, And Response",
                    Body = "Sahih Muslim 940a remembers Mus'ab ibn Umayr among the martyrs of Uhud. Qur'an 3:169 and 3:172 turn the lesson toward honor, patience, and answering again after being wounded.",
                    DurationSeconds = 9,
                    FieldOfView = 57,
                    CameraDrift = Vector3.new(0, -3, 12),
                    Reference = "Qur'an 3:169-172 · Sahih Muslim 940a",
                },
            },
        },
        StorySummary = {
            Title = "What Happened At Uhud",
            Lines = {
                "Qur'an 3:121, 3:152, and 3:153 frame Uhud through placement, early success, disobedience, confusion, and the cost of a broken position.",
                "Sunan Abi Dawud 2662 preserves the command to the archers, while Sahih Muslim 1789 and 1790a preserve the pressure, wounds, and rescue of the late battle.",
                "Uhud now runs as a player-only battle with no filler bots, so the focus stays on the field, the ridge, and the lesson itself.",
            },
        },
        Rewards = {
            KnowledgeTokens = 125,
            UnlockStoryIds = {
                "musab_ibn_umayr",
                "nusaybah_bint_kaab",
            },
        },
    },
}

return table.freeze(BattleScenarios)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">CompanionStories</string>
            <string name="Source"><![CDATA[--!strict

local CompanionStories = {
    {
        Id = "abu_bakr_as_siddiq",
        DisplayName = "Abu Bakr as-Siddiq (RA)",
        Theme = "Truthfulness and leadership",
        Summary = "Learn why Abu Bakr was called as-Siddiq, how he supported the early Muslims, and how he became the first caliph.",
        Difficulty = "Beginner",
        AccentColor = Color3.fromRGB(124, 108, 67),
        KeyLessons = {
            "Truthfulness",
            "Loyal companionship",
            "Leadership after hardship",
        },
        Introduction = {
            "This story follows Abu Bakr as-Siddiq through trust, sacrifice, companionship, and leadership.",
            "Each stop teaches one major moment: his title, his support, the Hijrah, and becoming the first caliph.",
            "You will also see direct references so the lesson is tied to Qur'an and Hadith, not just a summary.",
        },
        ScenarioSteps = {
            {
                Id = "as_siddiq_title",
                Title = "Why He Was Called As-Siddiq",
                Objective = "Speak to the guide to learn why Abu Bakr was known as as-Siddiq.",
                NpcName = "Truthfulness Guide",
                PromptText = "Ask",
                LocationName = "Trust Courtyard",
                Dialogue = {
                    { Speaker = "Guide", Text = "Abu Bakr is remembered with the title as-Siddiq, meaning the truthful one or the one who strongly confirms the truth." },
                    { Speaker = "Guide", Text = "A famous reason connected to this title is that he believed the Prophet's account of the Night Journey without hesitation, showing immediate trust in revelation." },
                    { Speaker = "Reference", Text = "Related Hadith: Sahih Muslim 2607c says truth leads to righteousness and a person who keeps telling the truth is recorded with Allah as truthful." },
                    { Speaker = "Narrator", Text = "This stop teaches that trust and truthfulness were central to Abu Bakr's character." },
                },
            },
            {
                Id = "early_support",
                Title = "Supporting The Early Muslims",
                Objective = "Walk to the support station and learn what Abu Bakr did for the early community.",
                NpcName = "Community Guide",
                PromptText = "Learn",
                LocationName = "Support Station",
                Dialogue = {
                    { Speaker = "Guide", Text = "Abu Bakr was among the earliest Muslims and used his position, wealth, and courage to support the community." },
                    { Speaker = "Guide", Text = "He is remembered for helping free persecuted believers, including Bilal ibn Rabah." },
                    { Speaker = "Reference", Text = "Related Hadith: Sahih al-Bukhari 3656 describes Abu Bakr as the Prophet's close companion, showing how near he was in loyalty and support." },
                    { Speaker = "Narrator", Text = "His story shows that leadership starts with service and sacrifice." },
                },
            },
            {
                Id = "hijrah_companion",
                Title = "Companion On The Hijrah",
                Objective = "Move to the cave marker and learn about Abu Bakr's companionship during the Hijrah.",
                NpcName = "Journey Guide",
                PromptText = "Listen",
                LocationName = "Hijrah Path",
                Dialogue = {
                    { Speaker = "Guide", Text = "Abu Bakr accompanied the Prophet during the Hijrah from Makkah to Medina." },
                    { Speaker = "Guide", Text = "He is remembered as the companion who stayed close during one of the most important journeys in Islamic history." },
                    { Speaker = "Reference", Text = "Qur'an: Surah At-Tawbah 9:40 mentions the two in the cave. Hadith: Sahih al-Bukhari 3653 records Abu Bakr saying that if the pursuers looked down they would see them." },
                    { Speaker = "Narrator", Text = "This moment teaches loyalty, courage, and trust during danger." },
                },
            },
            {
                Id = "first_caliph",
                Title = "The First Caliph",
                Objective = "Reach the leadership hall and learn how Abu Bakr became the first caliph.",
                NpcName = "Leadership Guide",
                PromptText = "Reflect",
                LocationName = "Leadership Hall",
                Dialogue = {
                    { Speaker = "Guide", Text = "After the Prophet's death in 632 CE, the Muslim community needed leadership and unity." },
                    { Speaker = "Guide", Text = "Abu Bakr became the first caliph, known as the successor to the Messenger of Allah, and served from 632 to 634 CE." },
                    { Speaker = "Reference", Text = "Related Hadith: Sahih Muslim 418a records the Prophet ordering Abu Bakr to lead the people in prayer, and Sahih al-Bukhari 4986 records Abu Bakr overseeing the collection of the Qur'an after Yamamah." },
                    { Speaker = "Reflection", Text = "His final lesson in this route is steady leadership after grief and confusion." },
                },
            },
        },
        Completion = {
            Title = "Abu Bakr Story Complete",
            Lines = {
                "Abu Bakr as-Siddiq is remembered for truthfulness, loyalty, service, and leadership.",
                "Reference trail: Qur'an 9:40, Sahih Muslim 2607c, Sahih al-Bukhari 3653, Sahih Muslim 418a, and Sahih al-Bukhari 4986.",
                "You completed the Abu Bakr as-Siddiq playthrough.",
            },
        },
        LinkedBattles = {
            "badr",
        },
        RewardTokens = 45,
    },
    {
        Id = "bilal_ibn_rabah",
        DisplayName = "Bilal ibn Rabah (RA)",
        Theme = "Perseverance and faith",
        Summary = "Walk through Bilal's early faith, service to the community, and lasting resilience.",
        Difficulty = "Beginner",
        AccentColor = Color3.fromRGB(101, 78, 49),
        KeyLessons = {
            "Perseverance",
            "Faith under pressure",
            "Service to the community",
        },
        Introduction = {
            "Begin in Makkah and follow Bilal's path from hardship to honor in the Muslim community.",
            "Talk to the guides at each station to unlock the next part of the journey.",
            "This route links Bilal's story to references about dignity, worship, and sincere service.",
        },
        ScenarioSteps = {
            {
                Id = "early_faith",
                Title = "Early Faith In Makkah",
                Objective = "Speak to the market guide to learn how Bilal accepted Islam.",
                NpcName = "Makkah Story Guide",
                PromptText = "Talk",
                LocationName = "Makkah Market Court",
                Dialogue = {
                    { Speaker = "Guide", Text = "Bilal was among the early people who believed in Islam in Makkah." },
                    { Speaker = "Guide", Text = "He stayed firm even when his master punished him and tried to force him to turn away." },
                    { Speaker = "Reference", Text = "Related Qur'an: Surah Al-Hujurat 49:13 teaches that the most honored with Allah are the most righteous, not the most privileged by race or status." },
                    { Speaker = "Bilal's Story", Text = "His faith became an example of patience and trust in Allah." },
                },
            },
            {
                Id = "steadfastness",
                Title = "Steadfastness",
                Objective = "Go to the shaded courtyard and hear how Bilal stayed steadfast through hardship.",
                NpcName = "Courtyard Elder",
                PromptText = "Listen",
                LocationName = "Courtyard of Patience",
                Dialogue = {
                    { Speaker = "Elder", Text = "Bilal is remembered for repeating words of tawhid while enduring severe hardship." },
                    { Speaker = "Elder", Text = "His story teaches players that dignity and faith are not taken away by pressure." },
                    { Speaker = "Reference", Text = "Related Hadith: Jami` at-Tirmidhi 3689 later praises Bilal by mentioning the Prophet hearing Bilal's footsteps in Paradise." },
                    { Speaker = "Narrator", Text = "Steadfast hearts often change the future of a community." },
                },
            },
            {
                Id = "community_service",
                Title = "Serving The Community",
                Objective = "Walk to the masjid court and learn how Bilal served the growing Muslim community.",
                NpcName = "Masjid Caretaker",
                PromptText = "Learn",
                LocationName = "Masjid Court",
                Dialogue = {
