}

return table.freeze(ShopCatalog)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">TravelRoute</string>
            <string name="Source"><![CDATA[--!strict

local destinations = {
    {
        Id = "kaaba_courtyard",
        DisplayName = "Masjid al-Haram",
        Description = "The Makkah sanctuary hub around the Kaaba, with warmer stone, arcades, and battle boards.",
        Theme = "Mecca",
        Position = Vector3.new(0, 4, 0),
        TeleportPosition = Vector3.new(0, 4, 92),
        AccentColor = Color3.fromRGB(35, 35, 35),
    },
    {
        Id = "journey_reflection",
        DisplayName = "Desert Route Camp",
        Description = "A long desert route stop between Makkah and Medina with dunes, camp structures, and reflection signs.",
        Theme = "Reflection",
        Position = Vector3.new(0, 4, 760),
        TeleportPosition = Vector3.new(0, 4, 704),
        AccentColor = Color3.fromRGB(118, 92, 58),
    },
    {
        Id = "medina_courtyard",
        DisplayName = "Prophet's Mosque Courtyard",
        Description = "A larger Medina district inspired by Al-Masjid an-Nabawi, with gate names, a green dome, and a visitation route.",
        Theme = "Medina",
        Position = Vector3.new(0, 4, 1500),
        TeleportPosition = Vector3.new(0, 4, 1636),
        AccentColor = Color3.fromRGB(69, 121, 77),
    },
    {
        Id = "story_court",
        DisplayName = "Sahabi Story Court",
        Description = "Choose a sahabi playthrough and learn through guided NPC story scenes.",
        Theme = "Stories",
        Position = Vector3.new(346, 4, 214),
        TeleportPosition = Vector3.new(346, 4, 270),
        AccentColor = Color3.fromRGB(73, 96, 77),
    },
    {
        Id = "manners_court",
        DisplayName = "Manners Court",
        Description = "A kid-friendly learning area for adab, respect, honesty, mercy, and good speech.",
        Theme = "Manners",
        Position = Vector3.new(-346, 4, -360),
        TeleportPosition = Vector3.new(-346, 4, -302),
        AccentColor = Color3.fromRGB(98, 119, 76),
    },
    {
        Id = "trivia_court",
        DisplayName = "Trivia Court",
        Description = "A live Islamic trivia area where everyone on the server can compete through harder and harder questions.",
        Theme = "Trivia",
        Position = Vector3.new(346, 4, -438),
        TeleportPosition = Vector3.new(346, 4, -366),
        AccentColor = Color3.fromRGB(63, 98, 88),
    },
    {
        Id = "parkour_tower",
        DisplayName = "Lobby Parkour Tower",
        Description = "A climbing challenge in the lobby for players waiting between stories and battles.",
        Theme = "Parkour",
        Position = Vector3.new(-358, 4, 196),
        TeleportPosition = Vector3.new(-416, 8, 196),
        AccentColor = Color3.fromRGB(182, 152, 84),
    },
    {
        Id = "badr_gate",
        DisplayName = "Badr Gate",
        Description = "The battle gate and staging point for the Battle of Badr scenario.",
        Theme = "BattleGate",
        Position = Vector3.new(-520, 4, -140),
        TeleportPosition = Vector3.new(-520, 4, -98),
        AccentColor = Color3.fromRGB(141, 107, 58),
    },
    {
        Id = "uhud_gate",
        DisplayName = "Uhud Gate",
        Description = "The battle gate and staging point for the Battle of Uhud scenario.",
        Theme = "BattleGate",
        Position = Vector3.new(-520, 4, 120),
        TeleportPosition = Vector3.new(-520, 4, 162),
        AccentColor = Color3.fromRGB(114, 92, 71),
    },
}

local destinationById = {}

for _, destination in ipairs(destinations) do
    destinationById[destination.Id] = destination
end

local TravelRoute = {
    RouteName = "Main Menu",
    WorldFolderName = "GeneratedHub",
    StartDestinationId = "kaaba_courtyard",
    EndDestinationId = "medina_courtyard",
    WalkPrompt = "Use the main menu to jump between Makkah, the desert route, Medina, stories, manners, parkour, and battle gates.",
    Destinations = destinations,
}

function TravelRoute.GetDestinationById(destinationId: string)
    return destinationById[destinationId]
end

return table.freeze(TravelRoute)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">TriviaQuestions</string>
            <string name="Source"><![CDATA[--!strict

local TriviaQuestions = {
    DisplayName = "Islamic Trivia Challenge",
    Summary = "Answer with everyone on the server. Questions get harder each round.",
    RewardTokens = 5,
    Questions = {
        {
            Difficulty = 1,
            Points = 10,
            Prompt = "What is the name of the month when Muslims fast from dawn to sunset?",
            Options = { "Ramadan", "Shawwal", "Rajab", "Muharram" },
            CorrectIndex = 1,
            Explanation = "Ramadan is the month of fasting.",
        },
        {
            Difficulty = 1,
            Points = 10,
            Prompt = "What direction do Muslims face in prayer?",
            Options = { "The qiblah toward the Kaaba", "Any mountain", "The nearest river", "The sunrise only" },
            CorrectIndex = 1,
            Explanation = "Muslims face the qiblah, which points toward the Kaaba in Makkah.",
        },
        {
            Difficulty = 1,
            Points = 10,
            Prompt = "What is the call to prayer called?",
            Options = { "Adhan", "Sawm", "Hajj", "Sadaqah" },
            CorrectIndex = 1,
            Explanation = "The adhan is the call to prayer.",
        },
        {
            Difficulty = 1,
            Points = 10,
            Prompt = "What is a sahabi?",
            Options = { "A companion of the Prophet", "A city gate", "A type of market", "A battle shield" },
            CorrectIndex = 1,
            Explanation = "A sahabi is a companion of Prophet Muhammad, peace be upon him.",
        },
        {
            Difficulty = 2,
            Points = 18,
            Prompt = "Who became the first caliph after the Prophet, peace be upon him?",
            Options = { "Abu Bakr", "Mus'ab ibn Umayr", "Bilal ibn Rabah", "Khalid ibn al-Walid" },
            CorrectIndex = 1,
            Explanation = "Abu Bakr, may Allah be pleased with him, became the first caliph.",
        },
        {
            Difficulty = 2,
            Points = 18,
            Prompt = "What does zakat teach Muslims to care about?",
            Options = { "Giving and helping those in need", "Collecting trophies", "Winning arguments", "Building taller towers" },
            CorrectIndex = 1,
            Explanation = "Zakat is connected to giving, purification, and caring for people in need.",
        },
        {
            Difficulty = 2,
            Points = 18,
            Prompt = "What journey marks the start of the Islamic calendar?",
            Options = { "The Hijrah from Makkah to Medina", "The journey to Ta'if", "A trade journey to Syria", "A sea voyage" },
            CorrectIndex = 1,
            Explanation = "The Hijrah from Makkah to Medina marks the start of the Islamic calendar.",
        },
        {
            Difficulty = 2,
            Points = 18,
            Prompt = "Which sahabi is famous for the title as-Siddiq?",
            Options = { "Abu Bakr", "Umar", "Uthman", "Ali" },
            CorrectIndex = 1,
            Explanation = "Abu Bakr is famously known as as-Siddiq.",
        },
        {
            Difficulty = 3,
            Points = 28,
            Prompt = "The Battle of Badr happened after which major journey?",
            Options = { "The Hijrah", "The Farewell Hajj", "The first adhan", "The building of Baghdad" },
            CorrectIndex = 1,
            Explanation = "Badr happened after the Hijrah, when the Muslims had settled in Medina.",
        },
        {
            Difficulty = 3,
            Points = 28,
            Prompt = "Where did the Battle of Uhud happen?",
            Options = { "Near Mount Uhud outside Medina", "Inside the Kaaba courtyard", "At the Red Sea", "In Jerusalem" },
            CorrectIndex = 1,
            Explanation = "Uhud happened near Mount Uhud outside Medina.",
        },
        {
            Difficulty = 3,
            Points = 28,
            Prompt = "Which companion is remembered as one of the first callers to prayer?",
            Options = { "Bilal ibn Rabah", "Abu Sufyan", "Mu'awiyah", "Salman al-Farsi" },
            CorrectIndex = 1,
            Explanation = "Bilal ibn Rabah, may Allah be pleased with him, is remembered as a great mu'adhdhin.",
        },
        {
            Difficulty = 3,
            Points = 28,
            Prompt = "What should players do in this game when learning about the Prophet, peace be upon him?",
            Options = { "Learn respectfully without depicting him", "Make a boss model of him", "Use jokes about him", "Ignore the history" },
            CorrectIndex = 1,
            Explanation = "The game teaches respectfully and avoids depicting the Prophet, peace be upon him.",
        },
        {
            Difficulty = 4,
            Points = 42,
            Prompt = "Badr is commonly connected with which year in the Hijri calendar?",
            Options = { "2 AH", "5 AH", "9 AH", "13 AH" },
            CorrectIndex = 1,
            Explanation = "Badr is commonly connected with 2 AH.",
        },
        {
            Difficulty = 4,
            Points = 42,
            Prompt = "Uhud is commonly connected with which year in the Hijri calendar?",
            Options = { "3 AH", "1 AH", "8 AH", "10 AH" },
            CorrectIndex = 1,
            Explanation = "Uhud is commonly connected with 3 AH.",
        },
        {
            Difficulty = 4,
            Points = 42,
            Prompt = "Which sahabi was sent as an early teacher to Medina before the Hijrah?",
            Options = { "Mus'ab ibn Umayr", "Abu Lahab", "Ikrimah ibn Abi Jahl", "Wahshi ibn Harb" },
            CorrectIndex = 1,
            Explanation = "Mus'ab ibn Umayr, may Allah be pleased with him, taught Islam in Medina before the Hijrah.",
        },
        {
            Difficulty = 4,
            Points = 42,
            Prompt = "What does the word Hijrah mean in this learning context?",
            Options = { "Migration", "A battle shield", "A market tax", "A type of tower" },
            CorrectIndex = 1,
            Explanation = "In this context, Hijrah means the migration from Makkah to Medina.",
        },
        {
            Difficulty = 5,
            Points = 60,
            Prompt = "Which answer best describes Abu Bakr's role during the Hijrah?",
            Options = { "He accompanied the Prophet, peace be upon him", "He led the Quraysh army", "He built the first minaret", "He wrote the Constitution of Medina alone" },
            CorrectIndex = 1,
            Explanation = "Abu Bakr accompanied the Prophet, peace be upon him, during the Hijrah.",
        },
        {
            Difficulty = 5,
            Points = 60,
            Prompt = "Why should a history game include dates and people carefully?",
            Options = { "So players learn the real timeline and context", "So the story becomes random", "So facts do not matter", "So every player skips the lesson" },
            CorrectIndex = 1,
            Explanation = "Dates, people, and context help players learn the real timeline more clearly.",
        },
        {
            Difficulty = 5,
            Points = 60,
            Prompt = "Which pair is the most accurate for this game prototype's battle learning?",
            Options = { "Badr: 2 AH, Uhud: 3 AH", "Badr: 10 AH, Uhud: 1 AH", "Badr: 7 AH, Uhud: 8 AH", "Badr: 12 AH, Uhud: 13 AH" },
            CorrectIndex = 1,
            Explanation = "Badr is commonly taught as 2 AH, and Uhud as 3 AH.",
        },
    },
}

return table.freeze(TriviaQuestions)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Modules</string>
