    BuildUtils.CreatePart(district, "SacredChamberGrille", Vector3.new(34, 10, 2), CFrame.new(center + Vector3.new(39, 10, -20)), GOLD_ACCENT, Enum.Material.Metal, nil, nil)
    BuildUtils.CreatePart(district, "CompanionMarkerA", Vector3.new(6, 1, 6), CFrame.new(center + Vector3.new(56, 5.7, -26)), Color3.fromRGB(214, 204, 181), Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "CompanionMarkerB", Vector3.new(6, 1, 6), CFrame.new(center + Vector3.new(56, 5.7, -20)), Color3.fromRGB(214, 204, 181), Enum.Material.Marble, nil, nil)
    BuildUtils.CreatePart(district, "CompanionMarkerC", Vector3.new(6, 1, 6), CFrame.new(center + Vector3.new(56, 5.7, -14)), Color3.fromRGB(214, 204, 181), Enum.Material.Marble, nil, nil)

    createWallPanel(district, "VisitationSign", center + Vector3.new(-144, 0, -60), Vector3.new(74, 12, 2.5), "Bab as-Salam Visitation Route", "Enter from Bab as-Salam, follow the marked walkway, and approach the sacred chamber area respectfully and quietly.", Color3.fromRGB(52, 88, 58), 90, nil)
    createWallPanel(district, "ChamberSign", center + Vector3.new(120, 0, -64), Vector3.new(74, 12, 2.5), "Sacred Chamber Marker", "This is a respectful marker for the visitation area and route, not a 1:1 interior reconstruction.", Color3.fromRGB(86, 92, 67), 270, nil)

    createMedinaGate(district, "BabAsSalamGate", center + Vector3.new(-290, 0, -22), 90, "Bab as-Salam", "Traditional entry gate for the visitation route.")
    createMedinaGate(district, "BabAbuBakrGate", center + Vector3.new(-290, 0, 70), 90, "Bab Abu Bakr", "A west-side gate near the older visitation approach.")
    createMedinaGate(district, "BabRahmahGate", center + Vector3.new(-290, 0, -120), 90, "Bab ar-Rahmah", "A named western gate on the Medina side.")
    createMedinaGate(district, "BabJibrilGate", center + Vector3.new(290, 0, -24), 270, "Bab Jibril", "An eastern gate associated with the Jibril side of the mosque.")
    createMedinaGate(district, "BabBaqiGate", center + Vector3.new(290, 0, 72), 270, "Bab al-Baqi'", "An eastern gate toward the al-Baqi' side.")
    createMedinaGate(district, "BabNisaGate", center + Vector3.new(290, 0, 166), 270, "Bab an-Nisa", "A named gate on the eastern side of the Medina complex.")

    BuildUtils.CreatePlanter(district, "MedinaGardenWest", center + Vector3.new(-182, 0, 208), Vector3.new(64, 3, 34))
    BuildUtils.CreatePlanter(district, "MedinaGardenEast", center + Vector3.new(182, 0, 208), Vector3.new(64, 3, 34))
    BuildUtils.CreatePalmTree(district, "MedinaPalmWest", center + Vector3.new(-182, 0, 208))
    BuildUtils.CreatePalmTree(district, "MedinaPalmEast", center + Vector3.new(182, 0, 208))
end

local function buildBattleGate(parent: Instance, name: string, center: Vector3, accentColor: Color3, scenarioId: string, title: string)
    local district = BuildUtils.CreateFolder(parent, string.format("%sDistrict", name))

    BuildUtils.CreatePart(district, "SafetyPlate", Vector3.new(250, 12, 190), CFrame.new(center + Vector3.new(0, -10, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
    BuildUtils.CreatePart(district, "Floor", Vector3.new(190, 4, 150), CFrame.new(center + Vector3.new(0, 2, 0)), Color3.fromRGB(205, 182, 141), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(district, "LeftTower", Vector3.new(20, 30, 20), CFrame.new(center + Vector3.new(-58, 15, 0)), Color3.fromRGB(189, 167, 131), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(district, "RightTower", Vector3.new(20, 30, 20), CFrame.new(center + Vector3.new(58, 15, 0)), Color3.fromRGB(189, 167, 131), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(district, "GateBeam", Vector3.new(94, 9, 16), CFrame.new(center + Vector3.new(0, 25, 0)), accentColor, Enum.Material.Sandstone, nil, nil)
    createLightPost(district, string.format("%sLightLeft", name), center + Vector3.new(-20, 0, -34), Color3.fromRGB(120, 103, 80))
    createLightPost(district, string.format("%sLightRight", name), center + Vector3.new(20, 0, -34), Color3.fromRGB(120, 103, 80))

    createWallPanel(
        district,
        string.format("%sBoard", name),
        center + Vector3.new(0, 0, -54),
        Vector3.new(76, 12, 2.5),
        title,
        "Use this sign or the main menu to queue for the battle arena.",
        accentColor,
        180,
        {
            ActionText = "Join Battle",
            ObjectText = title,
            Attributes = {
                PromptAction = "JoinBattle",
                ScenarioId = scenarioId,
            },
        }
    )
end

local existingWorld = Workspace:FindFirstChild(TravelRoute.WorldFolderName)

if existingWorld and existingWorld:GetAttribute("GeneratedBy") == "HubWorldBuilder" then
    existingWorld:Destroy()
end

local worldFolder = Instance.new("Folder")
worldFolder.Name = TravelRoute.WorldFolderName
worldFolder:SetAttribute("GeneratedBy", "HubWorldBuilder")
worldFolder.Parent = Workspace

local geometryFolder = BuildUtils.CreateFolder(worldFolder, "Geometry")
local teleportFolder = BuildUtils.CreateFolder(worldFolder, "TeleportPoints")

BuildUtils.CreatePart(geometryFolder, "WorldGround", Vector3.new(2600, 2, 3080), CFrame.new(0, -1, 720), DESERT_SAND, Enum.Material.Sand, nil, nil)
BuildUtils.CreatePart(geometryFolder, "WorldSafetyPlate", Vector3.new(2800, 14, 3300), CFrame.new(0, -14, 720), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, 1)
createSafetyBounds(geometryFolder, "HubBounds", Vector3.new(0, 0, 720), Vector3.new(2360, 0, 2760))

for _, destination in ipairs(TravelRoute.Destinations) do
    BuildUtils.CreateTeleportAnchor(teleportFolder, destination.Id, destination.TeleportPosition or destination.Position)
end

local meccaCenter = TravelRoute.GetDestinationById("kaaba_courtyard").Position
local desertCenter = TravelRoute.GetDestinationById("journey_reflection").Position
local medinaCenter = TravelRoute.GetDestinationById("medina_courtyard").Position

buildDesertRoute(geometryFolder, meccaCenter, desertCenter, medinaCenter)
buildKaabaHub(geometryFolder, meccaCenter)
buildSupportLounge(geometryFolder, meccaCenter + Vector3.new(338, 0, -172))
buildStoryCourt(geometryFolder, meccaCenter + Vector3.new(346, 0, 214))
buildMannersCourt(geometryFolder, meccaCenter + Vector3.new(-346, 0, -360))
buildTriviaCourt(geometryFolder, TravelRoute.GetDestinationById("trivia_court").Position)
buildParkourCourse(geometryFolder, meccaCenter + Vector3.new(-358, 0, 196))
buildMedinaDistrict(geometryFolder, medinaCenter)
buildBattleGate(geometryFolder, "BadrGate", TravelRoute.GetDestinationById("badr_gate").Position, Color3.fromRGB(141, 107, 58), "badr", "Badr Gate")
buildBattleGate(geometryFolder, "UhudGate", TravelRoute.GetDestinationById("uhud_gate").Position, Color3.fromRGB(114, 92, 71), "uhud", "Uhud Gate")
createDistrictTerrainBand(geometryFolder, "MeccaWorld", meccaCenter, 980, 940, DESERT_ROCK)
createDistrictTerrainBand(geometryFolder, "MedinaWorld", medinaCenter, 640, 540, Color3.fromRGB(133, 110, 84))
createDistrictTerrainBand(geometryFolder, "JourneyWorld", desertCenter, 520, 720, Color3.fromRGB(141, 114, 84))
createWorldBackdrop(geometryFolder, Vector3.new(0, 0, 720))

local spawnLocation = Instance.new("SpawnLocation")
spawnLocation.Name = "JourneySpawn"
spawnLocation.Anchored = true
spawnLocation.Neutral = true
spawnLocation.Size = Vector3.new(18, 1, 18)
spawnLocation.Transparency = 1
spawnLocation.CanCollide = true
spawnLocation.CFrame = CFrame.new(meccaCenter + Vector3.new(0, 5, 92))
spawnLocation.Parent = geometryFolder
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="25">
      <Properties>
        <string name="Name">MannersService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MannersLessons = require(Shared.Data.MannersLessons)
local TravelRoute = require(Shared.Data.TravelRoute)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local mannersFolder = remotesFolder:WaitForChild("Manners")
local requestLesson = mannersFolder:WaitForChild("RequestLesson") :: RemoteEvent
local showMannersLesson = mannersFolder:WaitForChild("ShowMannersLesson") :: RemoteEvent

local lessonById = {}
local promptConnections = {}

for _, lesson in ipairs(MannersLessons) do
    lessonById[lesson.Id] = lesson
end

local function showLesson(player: Player, lessonId: string)
    local lesson = lessonById[lessonId]

    if not lesson then
        return
    end

    showMannersLesson:FireClient(player, {
        Id = lesson.Id,
        DisplayName = lesson.DisplayName,
        Subtitle = lesson.Subtitle,
        Lines = lesson.Lines,
        AccentColor = lesson.AccentColor,
        LinkedStoryId = lesson.LinkedStoryId,
    })
end

local function connectPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    if prompt:GetAttribute("PromptAction") ~= "OpenManners" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        local lessonId = prompt:GetAttribute("LessonId")

        if typeof(lessonId) == "string" then
            showLesson(player, lessonId)
        end
    end)
end

requestLesson.OnServerEvent:Connect(function(player: Player, lessonId: string)
    if typeof(lessonId) == "string" then
        showLesson(player, lessonId)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    for prompt, connection in pairs(promptConnections) do
        if not prompt.Parent then
            connection:Disconnect()
            promptConnections[prompt] = nil
        end
    end
end)

task.spawn(function()
    local worldFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if not worldFolder then
        return
    end

    for _, descendant in ipairs(worldFolder:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end

    worldFolder.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end)
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="26">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">BattleBots</string>
          <string name="Source"><![CDATA[--!nonstrict

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BattleBots = {}

local BOT_STEP_SECONDS = 0.08
local BOT_MELEE_RANGE = 8.5
local BOT_MELEE_DAMAGE = 13
local BOT_COMMANDER_DAMAGE = 20
local BOT_MELEE_ATTACK_INTERVAL = 1.18
local BOT_ARCHER_RANGE = 124
local BOT_ARCHER_MIN_RANGE = 24
local BOT_ARCHER_PREFERRED_RANGE = 52
local BOT_ARCHER_ATTACK_INTERVAL = 2.2
local BOT_MOVE_SPEED = 18
local BOT_COMMANDER_MOVE_SPEED = 15
local BOT_BLOCK_DAMAGE_MULTIPLIER = 0.42

local function getTeamColor(session, teamId)
    for _, team in ipairs(session.Scenario.Teams) do
        if team.Id == teamId then
            return team.AccentColor
        end
    end

    return Color3.fromRGB(182, 145, 88)
end

local function getEntryModel(entry)
    if entry.Kind == "Player" and entry.Player and entry.Player.Character and entry.Player.Character.Parent then
        return entry.Player.Character
    end

    if entry.Model and entry.Model.Parent then
        return entry.Model
    end

    return nil
end

local function getEntryHumanoid(entry)
    local model = getEntryModel(entry)

    if not model then
        return nil
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")

    if humanoid and humanoid.Health > 0 then
        return humanoid
    end

    return nil
end

local function getEntryRoot(entry)
    local model = getEntryModel(entry)
    local root = model and model:FindFirstChild("HumanoidRootPart")

    if root and root:IsA("BasePart") then
        return root
    end

    return nil
end

local function isBlocking(model)
    local blockingUntil = model:GetAttribute("BlockingUntil")

    return type(blockingUntil) == "number" and blockingUntil > os.clock()
end

local function spawnPulse(position, color, radius, lifetime)
    local pulse = Instance.new("Part")
    pulse.Name = "BattleBotPulse"
    pulse.Shape = Enum.PartType.Ball
    pulse.Size = Vector3.new(radius, radius, radius)
    pulse.Material = Enum.Material.Neon
    pulse.Color = color
    pulse.Transparency = 0.2
    pulse.Anchored = true
    pulse.CanCollide = false
    pulse.CanTouch = false
    pulse.CanQuery = false
    pulse.CFrame = CFrame.new(position)
    pulse.Parent = Workspace
    Debris:AddItem(pulse, lifetime)
end

local function applyDamage(session, attackerEntry, targetEntry, damage, impactPosition)
    local attackerModel = getEntryModel(attackerEntry)
    local targetModel = getEntryModel(targetEntry)
    local targetHumanoid = getEntryHumanoid(targetEntry)
    local targetRoot = getEntryRoot(targetEntry)

    if not attackerModel or not targetModel or not targetHumanoid then
        return false
    end

    if attackerModel:GetAttribute("BattleTeam") == targetModel:GetAttribute("BattleTeam") then
        return false
    end

    local finalDamage = damage
    local blocked = isBlocking(targetModel)

    if blocked then
        finalDamage = math.max(4, math.floor(damage * BOT_BLOCK_DAMAGE_MULTIPLIER))
    end

    if targetEntry.IsCommander then
        finalDamage = math.min(finalDamage, math.max(0, targetHumanoid.Health - 1))

        if finalDamage <= 0 then
            return false
        end
    end

    targetHumanoid:TakeDamage(finalDamage)

    if impactPosition or targetRoot then
        spawnPulse(impactPosition or targetRoot.Position, blocked and Color3.fromRGB(223, 198, 126) or getTeamColor(session, attackerEntry.TeamId), blocked and 2.6 or 2.1, blocked and 0.2 or 0.16)
    end

    return true
end

local function orientModel(model, fromPosition, lookAtPosition)
    local flatLookAt = Vector3.new(lookAtPosition.X, fromPosition.Y, lookAtPosition.Z)

    if (flatLookAt - fromPosition).Magnitude < 0.05 then
        return
    end

    model:PivotTo(CFrame.lookAt(fromPosition, flatLookAt))
end

local function moveModel(model, currentPosition, nextPosition, lookAtPosition)
    local blendedPosition = currentPosition:Lerp(nextPosition, 0.82)
    local flatLookAt = Vector3.new(lookAtPosition.X, blendedPosition.Y, lookAtPosition.Z)
    model:PivotTo(CFrame.lookAt(blendedPosition, flatLookAt))
end

local function createArrow(teamColor, origin, direction)
    local arrow = Instance.new("Part")
    arrow.Name = "BattleBotArrow"
    arrow.Size = Vector3.new(0.24, 0.24, 4.6)
    arrow.Color = Color3.fromRGB(114, 77, 46)
    arrow.Material = Enum.Material.Wood
    arrow.CanCollide = false
    arrow.CanTouch = true
    arrow.CanQuery = true
    arrow.CFrame = CFrame.lookAt(origin, origin + direction)
    arrow.Parent = Workspace

    local tip = Instance.new("Part")
    tip.Name = "ArrowTip"
    tip.Size = Vector3.new(0.28, 0.28, 0.52)
    tip.Color = Color3.fromRGB(191, 191, 191)
    tip.Material = Enum.Material.Metal
    tip.CanCollide = false
    tip.CanTouch = false
    tip.CanQuery = false
    tip.Massless = true
    tip.CFrame = arrow.CFrame * CFrame.new(0, 0, -2.2)
    tip.Parent = arrow

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = arrow
    weld.Part1 = tip
    weld.Parent = arrow

    local headAttachment = Instance.new("Attachment")
    headAttachment.Position = Vector3.new(0, 0, -2.2)
    headAttachment.Parent = arrow

    local tailAttachment = Instance.new("Attachment")
    tailAttachment.Position = Vector3.new(0, 0, 2.2)
    tailAttachment.Parent = arrow

    local trail = Instance.new("Trail")
    trail.Attachment0 = headAttachment
    trail.Attachment1 = tailAttachment
    trail.Color = ColorSequence.new(teamColor, Color3.fromRGB(239, 216, 171))
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.15),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.Lifetime = 0.12
    trail.MinLength = 0.1
    trail.FaceCamera = true
    trail.Parent = arrow

    return arrow
end

local function fireArrow(session, entry, targetEntry)
    local model = getEntryModel(entry)
    local root = getEntryRoot(entry)
    local targetRoot = getEntryRoot(targetEntry)

    if not model or not root or not targetRoot then
        return
    end

    local origin = root.Position + Vector3.new(0, 1.6, 0)
    local targetPoint = targetRoot.Position + Vector3.new(0, 1.6, 0)
    local direction = (targetPoint - origin).Unit
    local arrow = createArrow(getTeamColor(session, entry.TeamId), origin, direction)
    local damaged = false
    local touchConnection

    arrow.AssemblyLinearVelocity = direction * 138 + Vector3.new(0, 3.5, 0)

    touchConnection = arrow.Touched:Connect(function(hitPart)
        if damaged then
            return
        end

        local hitModel = hitPart:FindFirstAncestorOfClass("Model")

        if not hitModel or hitModel == model then
            return
        end

        for _, team in ipairs(session.Scenario.Teams) do
            for _, candidate in ipairs(session.Teams[team.Id]) do
                local candidateModel = getEntryModel(candidate)

                if candidate.Alive and candidateModel == hitModel then
                    if applyDamage(session, entry, candidate, entry.IsCommander and 26 or 18, hitPart.Position) then
                        damaged = true
                        if touchConnection then
                            touchConnection:Disconnect()
                        end
                        arrow:Destroy()
                    end

                    return
                end
            end
        end

        damaged = true

        if touchConnection then
            touchConnection:Disconnect()
        end

        spawnPulse(hitPart.Position, getTeamColor(session, entry.TeamId), 1.8, 0.14)
        arrow:Destroy()
    end)

    Debris:AddItem(arrow, 4.8)
end

local function pickTarget(session, entry)
    local root = getEntryRoot(entry)

    if not root then
        return nil
    end

    local bestEntry = nil
    local bestScore = math.huge

    for _, team in ipairs(session.Scenario.Teams) do
        if team.Id ~= entry.TeamId then
            for _, candidate in ipairs(session.Teams[team.Id]) do
                if candidate.Alive then
                    local candidateRoot = getEntryRoot(candidate)
                    local candidateHumanoid = getEntryHumanoid(candidate)

                    if candidateRoot and candidateHumanoid then
                        if candidate.IsCommander then
                            continue
                        end

                        local distance = (candidateRoot.Position - root.Position).Magnitude
                        local score = distance

                        if candidate.Kind == "Player" then
                            score -= 7
                        end

                        if score < bestScore then
                            bestScore = score
                            bestEntry = candidate
                        end
                    end
                end
            end
        end
    end

    return bestEntry
end

local function updateBot(session, entry, stepSeconds)
    local model = getEntryModel(entry)
    local root = getEntryRoot(entry)
    local humanoid = getEntryHumanoid(entry)

    if not entry.Alive or not model or not root or not humanoid then
        entry.Alive = false
        return
    end

    local targetEntry = pickTarget(session, entry)

    if not targetEntry then
        return
    end

    local targetRoot = getEntryRoot(targetEntry)

    if not targetRoot then
        return
    end

    local now = os.clock()
    local offset = targetRoot.Position - root.Position
    local flatOffset = Vector3.new(offset.X, 0, offset.Z)
    local distance = flatOffset.Magnitude
    local style = entry.BotStyle or "Melee"
    local moveSpeed = entry.IsCommander and BOT_COMMANDER_MOVE_SPEED or BOT_MOVE_SPEED

    if distance < 0.05 then
        orientModel(model, root.Position, targetRoot.Position)
        return
    end

    local direction = flatOffset.Unit

    if style == "Archer" then
        if distance > BOT_ARCHER_PREFERRED_RANGE then
            local nextPosition = root.Position + direction * math.min(moveSpeed * stepSeconds, distance - BOT_ARCHER_PREFERRED_RANGE)
            moveModel(model, root.Position, nextPosition, targetRoot.Position)
        elseif distance < BOT_ARCHER_MIN_RANGE then
            local retreatPosition = root.Position - direction * math.min((moveSpeed + 2) * stepSeconds, BOT_ARCHER_MIN_RANGE - distance + 1.5)
            moveModel(model, root.Position, retreatPosition, targetRoot.Position)
        else
            local strafeDirection = entry.StrafeDirection or (((entry.FormationIndex or 1) % 2 == 0) and 1 or -1)
            entry.StrafeDirection = strafeDirection
            local sideways = Vector3.new(-direction.Z, 0, direction.X) * strafeDirection
            local nextPosition = root.Position + sideways * math.min(4.2 * stepSeconds, 1.2)
            moveModel(model, root.Position, nextPosition, targetRoot.Position)
        end

        if distance <= BOT_ARCHER_RANGE and distance >= BOT_ARCHER_MIN_RANGE * 0.8 and now - (entry.LastAttackAt or 0) >= BOT_ARCHER_ATTACK_INTERVAL then
            entry.LastAttackAt = now
            fireArrow(session, entry, targetEntry)
        end

        return
    end

    if distance > BOT_MELEE_RANGE then
        local nextPosition = root.Position + direction * math.min(moveSpeed * stepSeconds, distance - BOT_MELEE_RANGE + 1)
        moveModel(model, root.Position, nextPosition, targetRoot.Position)
        return
    end

    orientModel(model, root.Position, targetRoot.Position)

    if now - (entry.LastAttackAt or 0) < BOT_MELEE_ATTACK_INTERVAL then
        return
    end

    entry.LastAttackAt = now
    spawnPulse(root.Position + direction * 3.8 + Vector3.new(0, 1.3, 0), getTeamColor(session, entry.TeamId), entry.IsCommander and 3.6 or 2.8, 0.12)
    applyDamage(session, entry, targetEntry, entry.IsCommander and BOT_COMMANDER_DAMAGE or BOT_MELEE_DAMAGE, targetRoot.Position + Vector3.new(0, 1.4, 0))
end

function BattleBots.Start(session)
    local accumulator = 0
    local connection

    connection = RunService.Heartbeat:Connect(function(deltaTime)
        if session.Ended then
            if connection then
                connection:Disconnect()
            end
            return
        end

        accumulator += deltaTime

        if accumulator < BOT_STEP_SECONDS then
            return
        end

        local stepSeconds = accumulator
        accumulator = 0

        for _, team in ipairs(session.Scenario.Teams) do
            for _, entry in ipairs(session.Teams[team.Id]) do
                if entry.Kind == "Dummy" then
                    updateBot(session, entry, stepSeconds)
                end
            end
        end
    end)

    table.insert(session.Connections, connection)
end

return BattleBots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">BattleLoadout</string>
          <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShopCatalog = require(Shared.Data.ShopCatalog)
local battleFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Battle")
local requestBlock = battleFolder:WaitForChild("RequestBlock") :: RemoteEvent

local BattleLoadout = {}

local SWORD_SWING_SOUND = "rbxasset://sounds/swordslash.wav"
local SWORD_HIT_SOUND = "rbxasset://sounds/swordlunge.wav"
local SWORD_DRAW_SOUND = "rbxasset://sounds/unsheath.wav"
local BOW_DRAW_SOUND = "rbxasset://sounds/unsheath.wav"
local BOW_RELEASE_SOUND = "rbxasset://sounds/swordslash.wav"
local BOW_HIT_SOUND = "rbxasset://sounds/collide.wav"
local BLOCK_SOUND = "rbxasset://sounds/collide.wav"

local BLOCK_WINDOW_SECONDS = 1.1
local BLOCK_COOLDOWN_SECONDS = 1.8
local BLOCK_DAMAGE_MULTIPLIER = 0.28
local SWORD_SWING_COOLDOWN_SECONDS = 0.36
local SWORD_SWING_RANGE = 12
local BOW_DRAW_TIME_SECONDS = 0.9
local BOW_SHOT_COOLDOWN_SECONDS = 0.32
local blockCooldowns: { [Player]: number } = {}
local COMBATANT_TAG = "BattleCombatant"

local SWORD_IDLE_GRIP = CFrame.new(0.16, -0.95, -0.12) * CFrame.Angles(math.rad(-18), math.rad(12), math.rad(-10))
local SWORD_WINDUP_GRIP = CFrame.new(0.22, -0.82, -0.08) * CFrame.Angles(math.rad(-70), math.rad(18), math.rad(18))
local SWORD_STRIKE_GRIP = CFrame.new(0.08, -1.0, -0.2) * CFrame.Angles(math.rad(18), math.rad(-8), math.rad(-42))
local SWORD_RECOVER_GRIP = CFrame.new(0.14, -0.96, -0.14) * CFrame.Angles(math.rad(-24), math.rad(6), math.rad(-12))
local BOW_IDLE_GRIP = CFrame.new(0, -0.2, 0.04) * CFrame.Angles(0, math.rad(90), 0)
local BOW_DRAW_GRIP = CFrame.new(-0.24, -0.05, 0.16) * CFrame.Angles(math.rad(-10), math.rad(96), math.rad(-6))

local function getCharacterHumanoid(model: Instance): Humanoid?
    if not model:IsA("Model") then
        return nil
    end

    return model:FindFirstChildOfClass("Humanoid")
end

local function findFirstBodyPart(character: Model, names: { string }): BasePart?
    for _, name in ipairs(names) do
        local part = character:FindFirstChild(name)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    return nil
end

local function findEnemyHumanoid(originCharacter: Model, maxDistance: number): Humanoid?
    local root = originCharacter:FindFirstChild("HumanoidRootPart")

    if not root or not root:IsA("BasePart") then
        return nil
    end

    local originTeam = originCharacter:GetAttribute("BattleTeam")
    local bestHumanoid = nil
    local bestDistance = maxDistance

    for _, candidateModel in ipairs(CollectionService:GetTagged(COMBATANT_TAG)) do
        if candidateModel:IsA("Model") and candidateModel ~= originCharacter then
            local candidate = candidateModel:FindFirstChildOfClass("Humanoid")
            local candidateRoot = candidateModel:FindFirstChild("HumanoidRootPart")

            if candidate and candidate.Health > 0 and candidateRoot and candidateRoot:IsA("BasePart") then
                local candidateTeam = candidateModel:GetAttribute("BattleTeam")

                if candidateTeam and candidateTeam ~= originTeam then
                    local distance = (candidateRoot.Position - root.Position).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        bestHumanoid = candidate
                    end
                end
            end
        end
    end

    return bestHumanoid
end

local function findSwordTarget(originCharacter: Model, maxDistance: number): Humanoid?
    local root = originCharacter:FindFirstChild("HumanoidRootPart")

    if not root or not root:IsA("BasePart") then
        return nil
    end

    local originTeam = originCharacter:GetAttribute("BattleTeam")
    local bestHumanoid = nil
    local bestScore = math.huge

    for _, candidateModel in ipairs(CollectionService:GetTagged(COMBATANT_TAG)) do
        if candidateModel:IsA("Model") and candidateModel ~= originCharacter then
            local candidateHumanoid = candidateModel:FindFirstChildOfClass("Humanoid")
            local candidateRoot = candidateModel:FindFirstChild("HumanoidRootPart")

            if candidateHumanoid and candidateHumanoid.Health > 0 and candidateRoot and candidateRoot:IsA("BasePart") then
                local candidateTeam = candidateModel:GetAttribute("BattleTeam")

                if candidateTeam and candidateTeam ~= originTeam then
                    local offset = candidateRoot.Position - root.Position
                    local distance = offset.Magnitude

                    if distance > 0.05 and distance <= maxDistance then
                        local alignment = root.CFrame.LookVector:Dot(offset.Unit)

                        if alignment > 0.18 then
                            local score = distance - alignment * 2.6

                            if score < bestScore then
                                bestScore = score
                                bestHumanoid = candidateHumanoid
                            end
                        end
                    end
                end
            end
        end
    end

    return bestHumanoid
end

local function playOneShotSound(parent: Instance, soundId: string, volume: number, playbackSpeed: number?)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = volume

    if playbackSpeed then
        sound.PlaybackSpeed = playbackSpeed
    end

    sound.Parent = parent
    sound:Play()
    Debris:AddItem(sound, 3)
end

local function attachTrail(part: BasePart, colorA: Color3, colorB: Color3, a0: Vector3, a1: Vector3): Trail
    local attachment0 = Instance.new("Attachment")
    attachment0.Position = a0
    attachment0.Parent = part

    local attachment1 = Instance.new("Attachment")
    attachment1.Position = a1
    attachment1.Parent = part

    local trail = Instance.new("Trail")
    trail.Attachment0 = attachment0
    trail.Attachment1 = attachment1
    trail.Color = ColorSequence.new(colorA, colorB)
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.08),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.Lifetime = 0.08
    trail.MinLength = 0.06
    trail.FaceCamera = true
    trail.Enabled = false
    trail.Parent = part

    return trail
end

local function animateToolGrip(tool: Tool, targetGrip: CFrame, duration: number)
    local startGrip = tool.Grip
    local elapsed = 0

    while elapsed < duration and tool.Parent do
        elapsed += RunService.Heartbeat:Wait()
        tool.Grip = startGrip:Lerp(targetGrip, math.clamp(elapsed / duration, 0, 1))
    end

    if tool.Parent then
        tool.Grip = targetGrip
    end
end

local function isBlocking(character: Model): boolean
    local blockingUntil = character:GetAttribute("BlockingUntil")

    return type(blockingUntil) == "number" and blockingUntil > os.clock()
end

local function applyDamage(attackerCharacter: Model, targetHumanoid: Humanoid?, damage: number, hitSoundId: string?)
    if not targetHumanoid or targetHumanoid.Health <= 0 then
        return false
    end

    local targetModel = targetHumanoid.Parent

    if not targetModel or not targetModel:IsA("Model") then
        return false
    end

    if targetModel:GetAttribute("BattleTeam") == attackerCharacter:GetAttribute("BattleTeam") then
        return false
    end

    local finalDamage = damage
    local blocked = isBlocking(targetModel)

    if blocked then
        finalDamage = math.max(3, math.floor(damage * BLOCK_DAMAGE_MULTIPLIER))
    end

    targetHumanoid:TakeDamage(finalDamage)

    if blocked then
        local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")

        if targetRoot and targetRoot:IsA("BasePart") then
            playOneShotSound(targetRoot, BLOCK_SOUND, 0.65, 1.08)

            local flash = Instance.new("Part")
            flash.Name = "BlockFlash"
            flash.Shape = Enum.PartType.Ball
            flash.Size = Vector3.new(3, 3, 3)
            flash.Material = Enum.Material.Neon
            flash.Color = Color3.fromRGB(222, 198, 126)
            flash.Transparency = 0.35
            flash.Anchored = true
            flash.CanCollide = false
            flash.CanTouch = false
            flash.CanQuery = false
            flash.CFrame = targetRoot.CFrame
            flash.Parent = Workspace
            Debris:AddItem(flash, 0.22)
        end
    elseif hitSoundId then
        local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")

        if targetRoot and targetRoot:IsA("BasePart") then
            playOneShotSound(targetRoot, hitSoundId, 0.55, 1)
        end
    end

    return true
end

local function setBlocking(player: Player)
    if player:GetAttribute("InBattle") ~= true then
        return
    end

    local now = os.clock()
    local lastBlock = blockCooldowns[player]

    if lastBlock and now - lastBlock < BLOCK_COOLDOWN_SECONDS then
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return
    end

    blockCooldowns[player] = now
    character:SetAttribute("BlockingUntil", now + BLOCK_WINDOW_SECONDS)
    playOneShotSound(root, BLOCK_SOUND, 0.5, 1.2)
end

local function createCosmeticPart(name: string, size: Vector3, color: Color3, material: Enum.Material, transparency: number?): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = material
    part.Transparency = transparency or 0
    part.Anchored = false
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth

    return part
end

local function attachPart(parent: Instance, part: Part, basePart: BasePart, offset: CFrame)
    part.CFrame = basePart.CFrame * offset
    part.Parent = parent

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = basePart
    weld.Part1 = part
    weld.Parent = part
end

local function clearSkinCosmetics(character: Model)
    local existing = character:FindFirstChild("BattleCosmetics")

    if existing then
        existing:Destroy()
    end
end

local function applySkinCosmetics(player: Player)
    local character = player.Character

    if not character then
        return
    end

    clearSkinCosmetics(character)

    local root = findFirstBodyPart(character, { "HumanoidRootPart" })
    local head = findFirstBodyPart(character, { "Head" })
    local torso = findFirstBodyPart(character, { "UpperTorso", "Torso", "LowerTorso" })
    local leftArm = findFirstBodyPart(character, { "LeftUpperArm", "Left Arm" })
    local rightArm = findFirstBodyPart(character, { "RightUpperArm", "Right Arm" })
    local leftLeg = findFirstBodyPart(character, { "LeftUpperLeg", "Left Leg" })
    local rightLeg = findFirstBodyPart(character, { "RightUpperLeg", "Right Leg" })

    if not root or not head or not torso then
        return
    end

    local skinId = player:GetAttribute("EquippedBattleSkin")

    if typeof(skinId) ~= "string" then
        skinId = "default"
    end

    local skin = ShopCatalog.SkinDefinitions[skinId] or ShopCatalog.SkinDefinitions.default
    local cosmetics = Instance.new("Folder")
    cosmetics.Name = "BattleCosmetics"
    cosmetics.Parent = character

    local cuirass = createCosmeticPart("Cuirass", Vector3.new(2.5, 2.6, 1.4), skin.PrimaryColor, Enum.Material.Metal, nil)
    attachPart(cosmetics, cuirass, torso, CFrame.new(0, 0.05, 0))

    local waistGuard = createCosmeticPart("WaistGuard", Vector3.new(2.7, 0.45, 1.45), skin.AccentColor, Enum.Material.Metal, nil)
    attachPart(cosmetics, waistGuard, torso, CFrame.new(0, 0.82, 0))

    local backCape = createCosmeticPart("BackCape", Vector3.new(2.8, 3.3, 0.2), skin.CapeColor, Enum.Material.Fabric, 0.05)
    attachPart(cosmetics, backCape, torso, CFrame.new(0, -0.18, 0.76))

    local helmetBand = createCosmeticPart("HelmetBand", Vector3.new(2.12, 0.34, 1.1), skin.SecondaryColor, Enum.Material.Metal, nil)
    attachPart(cosmetics, helmetBand, head, CFrame.new(0, 0.18, 0))

    local crest = createCosmeticPart("HelmetCrest", Vector3.new(0.32, 0.9, 1.2), skin.AccentColor, Enum.Material.Fabric, nil)
    attachPart(cosmetics, crest, head, CFrame.new(0, -0.48, 0))

    if leftArm then
        local leftShoulder = createCosmeticPart("LeftShoulder", Vector3.new(0.95, 0.62, 1.15), skin.PrimaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, leftShoulder, leftArm, CFrame.new(0, -0.52, 0))

        local leftBracer = createCosmeticPart("LeftBracer", Vector3.new(0.82, 1.05, 0.82), skin.SecondaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, leftBracer, leftArm, CFrame.new(0, 0.52, 0))

        local shieldPlate = createCosmeticPart("BattleShieldPlate", Vector3.new(0.26, 3.2, 2.6), skin.PrimaryColor, Enum.Material.WoodPlanks, nil)
        attachPart(cosmetics, shieldPlate, leftArm, CFrame.new(0.75, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)))

        local shieldRim = createCosmeticPart("BattleShieldRim", Vector3.new(0.32, 3.4, 2.8), skin.AccentColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, shieldRim, leftArm, CFrame.new(0.78, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)))

        local shieldBoss = createCosmeticPart("BattleShieldBoss", Vector3.new(0.5, 0.8, 0.8), Color3.fromRGB(192, 160, 90), Enum.Material.Metal, nil)
        attachPart(cosmetics, shieldBoss, leftArm, CFrame.new(0.92, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)))
    end

    if rightArm then
        local rightShoulder = createCosmeticPart("RightShoulder", Vector3.new(0.95, 0.62, 1.15), skin.PrimaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, rightShoulder, rightArm, CFrame.new(0, -0.52, 0))

        local rightBracer = createCosmeticPart("RightBracer", Vector3.new(0.82, 1.05, 0.82), skin.SecondaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, rightBracer, rightArm, CFrame.new(0, 0.52, 0))
    end

    if leftLeg then
        local leftGreave = createCosmeticPart("LeftGreave", Vector3.new(0.82, 1.18, 0.82), skin.SecondaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, leftGreave, leftLeg, CFrame.new(0, 0.3, 0))
    end

    if rightLeg then
        local rightGreave = createCosmeticPart("RightGreave", Vector3.new(0.82, 1.18, 0.82), skin.SecondaryColor, Enum.Material.Metal, nil)
        attachPart(cosmetics, rightGreave, rightLeg, CFrame.new(0, 0.3, 0))
    end

    if player:GetAttribute("HasFounderSupport") then
        local founderBand = createCosmeticPart("FounderBand", Vector3.new(0.24, 2.7, 1.18), Color3.fromRGB(208, 174, 92), Enum.Material.Metal, nil)
        attachPart(cosmetics, founderBand, torso, CFrame.new(1.05, 0, 0))
    end

    local aura = createCosmeticPart("AuraPlate", Vector3.new(2.8, 0.14, 2.8), skin.AccentColor, Enum.Material.Neon, 0.42)
    attachPart(cosmetics, aura, root, CFrame.new(0, -2.68, 0))

    local torchGlow = createCosmeticPart("BattleTorchGlow", Vector3.new(0.7, 0.7, 0.7), Color3.fromRGB(255, 187, 94), Enum.Material.Neon, 0.08)
    attachPart(cosmetics, torchGlow, root, CFrame.new(0, 1.45, -2.3))

    local torchLight = Instance.new("PointLight")
    torchLight.Name = "BattleTorchLight"
    torchLight.Color = Color3.fromRGB(255, 190, 116)
    torchLight.Brightness = 1.65
    torchLight.Range = 32
    torchLight.Shadows = true
    torchLight.Parent = torchGlow
end

local function createWeaponVisualPart(name: string, size: Vector3, color: Color3, material: Enum.Material): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = material
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth

    return part
end

local function weldToHandle(handle: BasePart, part: BasePart, offset: CFrame): Weld
    part.CFrame = handle.CFrame * offset
    part.Parent = handle.Parent

    local weld = Instance.new("Weld")
    weld.Part0 = handle
    weld.Part1 = part
    weld.C0 = offset
    weld.Parent = part

    return weld
end

local function createSwordTool(): Tool
    local tool = Instance.new("Tool")
    tool.Name = "Training Sword"
    tool.RequiresHandle = true
    tool.Grip = SWORD_IDLE_GRIP

    local handle = createWeaponVisualPart("Handle", Vector3.new(0.32, 2.25, 0.32), Color3.fromRGB(98, 66, 38), Enum.Material.Wood)
    handle.Parent = tool

    local grip = createWeaponVisualPart("Grip", Vector3.new(0.42, 1.55, 0.42), Color3.fromRGB(81, 52, 33), Enum.Material.Wood)
    local pommel = createWeaponVisualPart("Pommel", Vector3.new(0.5, 0.32, 0.5), Color3.fromRGB(177, 146, 78), Enum.Material.Metal)
    local guard = createWeaponVisualPart("Crossguard", Vector3.new(2.1, 0.24, 0.38), Color3.fromRGB(179, 149, 87), Enum.Material.Metal)
    local blade = createWeaponVisualPart("Blade", Vector3.new(0.24, 3.05, 0.36), Color3.fromRGB(216, 216, 216), Enum.Material.Metal)
    local tip = createWeaponVisualPart("BladeTip", Vector3.new(0.12, 0.52, 0.16), Color3.fromRGB(228, 228, 226), Enum.Material.Metal)
    local bladeTrail = attachTrail(blade, Color3.fromRGB(255, 235, 189), Color3.fromRGB(232, 215, 175), Vector3.new(0, -1.45, 0), Vector3.new(0, 1.45, 0))

    weldToHandle(handle, grip, CFrame.new(0, 0, 0))
    weldToHandle(handle, pommel, CFrame.new(0, -1.25, 0))
    weldToHandle(handle, guard, CFrame.new(0, 1.08, 0))
    weldToHandle(handle, blade, CFrame.new(0, 2.72, 0))
    weldToHandle(handle, tip, CFrame.new(0, 4.48, 0))

    local cooldown = false
    local swingToken = 0

    tool.Equipped:Connect(function()
        swingToken += 1
        tool.Grip = SWORD_IDLE_GRIP
        playOneShotSound(handle, SWORD_DRAW_SOUND, 0.45, 1)
    end)

    tool.Unequipped:Connect(function()
        swingToken += 1
        cooldown = false
        tool.Grip = SWORD_IDLE_GRIP
    end)

    tool.Activated:Connect(function()
        if cooldown then
            return
        end

        local character = tool.Parent

        if not character or not character:IsA("Model") then
            return
        end

        local humanoid = getCharacterHumanoid(character)
        local root = character:FindFirstChild("HumanoidRootPart")

        if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
            return
        end

        cooldown = true
        swingToken += 1
        local currentSwing = swingToken

        task.spawn(function()
            animateToolGrip(tool, SWORD_WINDUP_GRIP, 0.1)

            if currentSwing ~= swingToken then
                return
            end

            playOneShotSound(handle, SWORD_SWING_SOUND, 0.56, 1.02)
            bladeTrail.Enabled = true
            animateToolGrip(tool, SWORD_STRIKE_GRIP, 0.08)

            if currentSwing ~= swingToken then
                return
            end

            animateToolGrip(tool, SWORD_RECOVER_GRIP, 0.11)

            if currentSwing ~= swingToken then
                return
            end

            animateToolGrip(tool, SWORD_IDLE_GRIP, 0.13)
        end)

        task.delay(0.16, function()
            bladeTrail.Enabled = false
        end)

        task.delay(0.12, function()
            if currentSwing ~= swingToken then
                return
            end

            local hitCharacter = tool.Parent
            local hitRoot = hitCharacter and hitCharacter:FindFirstChild("HumanoidRootPart")

            if not hitCharacter or not hitCharacter:IsA("Model") or not hitRoot or not hitRoot:IsA("BasePart") then
                return
            end

            local direction = hitRoot.CFrame.LookVector * 11
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            raycastParams.FilterDescendantsInstances = { hitCharacter, tool }

            local result = Workspace:Raycast(hitRoot.Position, direction, raycastParams)
            local targetHumanoid = nil

            if result then
                local target = result.Instance:FindFirstAncestorOfClass("Model")

                if target then
                    targetHumanoid = getCharacterHumanoid(target)
                end
            end

            if not targetHumanoid then
                targetHumanoid = findSwordTarget(hitCharacter, SWORD_SWING_RANGE) or findEnemyHumanoid(hitCharacter, SWORD_SWING_RANGE)
            end

            applyDamage(hitCharacter, targetHumanoid, 32, SWORD_HIT_SOUND)
        end)

        task.delay(SWORD_SWING_COOLDOWN_SECONDS, function()
            cooldown = false
        end)
    end)

    return tool
end

local function createBowTool(): Tool
    local tool = Instance.new("Tool")
    tool.Name = "Bow"
    tool.RequiresHandle = true
    tool.Grip = BOW_IDLE_GRIP

    local handle = createWeaponVisualPart("Handle", Vector3.new(0.36, 3.2, 0.36), Color3.fromRGB(108, 74, 42), Enum.Material.Wood)
    handle.Parent = tool

    local upperLimb = createWeaponVisualPart("UpperLimb", Vector3.new(0.26, 3.4, 0.26), Color3.fromRGB(116, 82, 48), Enum.Material.Wood)
    local lowerLimb = createWeaponVisualPart("LowerLimb", Vector3.new(0.26, 3.4, 0.26), Color3.fromRGB(116, 82, 48), Enum.Material.Wood)
    local upperString = createWeaponVisualPart("UpperString", Vector3.new(0.08, 1.8, 0.08), Color3.fromRGB(228, 223, 207), Enum.Material.SmoothPlastic)
    local lowerString = createWeaponVisualPart("LowerString", Vector3.new(0.08, 1.8, 0.08), Color3.fromRGB(228, 223, 207), Enum.Material.SmoothPlastic)
    local displayArrow = createWeaponVisualPart("DisplayArrow", Vector3.new(0.18, 0.18, 2.8), Color3.fromRGB(124, 88, 48), Enum.Material.Wood)

    local upperLimbOffset = CFrame.new(0.56, -1.38, 0) * CFrame.Angles(0, 0, math.rad(26))
    local lowerLimbOffset = CFrame.new(0.56, 1.38, 0) * CFrame.Angles(0, 0, math.rad(-26))
    local upperStringIdleOffset = CFrame.new(1.0, -2.18, 0)
    local lowerStringIdleOffset = CFrame.new(1.0, 2.18, 0)
    local upperStringDrawOffset = CFrame.new(0.52, -2.18, 0)
    local lowerStringDrawOffset = CFrame.new(0.52, 2.18, 0)
    local displayArrowIdleOffset = CFrame.new(-0.32, 0, -0.7) * CFrame.Angles(math.rad(90), 0, 0)
    local displayArrowDrawOffset = CFrame.new(-0.98, 0, -0.7) * CFrame.Angles(math.rad(90), 0, 0)

    weldToHandle(handle, upperLimb, upperLimbOffset)
    weldToHandle(handle, lowerLimb, lowerLimbOffset)
    local upperStringWeld = weldToHandle(handle, upperString, upperStringIdleOffset)
    local lowerStringWeld = weldToHandle(handle, lowerString, lowerStringIdleOffset)
    local displayArrowWeld = weldToHandle(handle, displayArrow, displayArrowIdleOffset)

    local cooldown = false
    local drawing = false
    local drawStart = 0
    local currentDrawAlpha = 0
    local drawToken = 0

    local function setDrawVisual(drawAlpha: number)
        currentDrawAlpha = math.clamp(drawAlpha, 0, 1)
        tool.Grip = BOW_IDLE_GRIP:Lerp(BOW_DRAW_GRIP, currentDrawAlpha)
        upperStringWeld.C0 = upperStringIdleOffset:Lerp(upperStringDrawOffset, currentDrawAlpha)
        lowerStringWeld.C0 = lowerStringIdleOffset:Lerp(lowerStringDrawOffset, currentDrawAlpha)
        displayArrowWeld.C0 = displayArrowIdleOffset:Lerp(displayArrowDrawOffset, currentDrawAlpha)
    end

    local function easeDrawVisual(targetAlpha: number, duration: number)
        local startAlpha = currentDrawAlpha
        local elapsed = 0

        while elapsed < duration and tool.Parent do
            elapsed += RunService.Heartbeat:Wait()
            setDrawVisual(startAlpha + (targetAlpha - startAlpha) * math.clamp(elapsed / duration, 0, 1))
        end

        if tool.Parent then
            setDrawVisual(targetAlpha)
        end
    end

    tool.Equipped:Connect(function()
        drawToken += 1
        drawing = false
        displayArrow.Transparency = 0
        setDrawVisual(0)
    end)

    tool.Unequipped:Connect(function()
        drawToken += 1
        drawing = false
        cooldown = false
        displayArrow.Transparency = 0
        setDrawVisual(0)
    end)

    tool.Activated:Connect(function()
        if cooldown or drawing then
            return
        end

        local character = tool.Parent

        if not character or not character:IsA("Model") then
            return
        end

        local humanoid = getCharacterHumanoid(character)
        local root = character:FindFirstChild("HumanoidRootPart")

        if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
            return
        end

        drawing = true
        drawStart = os.clock()
        drawToken += 1
        local currentToken = drawToken
        playOneShotSound(handle, BOW_DRAW_SOUND, 0.35, 0.9)

        task.spawn(function()
            while drawing and drawToken == currentToken and tool.Parent == character do
                local alpha = math.clamp((os.clock() - drawStart) / BOW_DRAW_TIME_SECONDS, 0, 1)
                setDrawVisual(alpha)
                RunService.Heartbeat:Wait()
            end
        end)
    end)

    tool.Deactivated:Connect(function()
        if not drawing then
            return
        end

        local character = tool.Parent

        if not character or not character:IsA("Model") then
            drawing = false
            setDrawVisual(0)
            return
        end

        local humanoid = getCharacterHumanoid(character)
        local root = character:FindFirstChild("HumanoidRootPart")

        drawing = false

        if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
            setDrawVisual(0)
            return
        end

        local chargeAlpha = math.clamp((os.clock() - drawStart) / BOW_DRAW_TIME_SECONDS, 0, 1)

        if chargeAlpha < 0.08 then
            task.spawn(function()
                easeDrawVisual(0, 0.1)
            end)
            return
        end

        cooldown = true
        setDrawVisual(chargeAlpha)
        displayArrow.Transparency = 1
        playOneShotSound(handle, BOW_RELEASE_SOUND, 0.42 + chargeAlpha * 0.2, 1.08 + chargeAlpha * 0.14)

        local arrow = Instance.new("Part")
        arrow.Name = "BattleArrow"
        arrow.Size = Vector3.new(0.22, 0.22, 4.2)
        arrow.Color = Color3.fromRGB(113, 77, 44)
        arrow.Material = Enum.Material.Wood
        arrow.CanCollide = false
        arrow.CanTouch = true
        arrow.CanQuery = true
        local arrowSpawn = root.Position + root.CFrame.LookVector * 3.6 + Vector3.new(0, 1.5, 0)
        arrow.CFrame = CFrame.lookAt(arrowSpawn, arrowSpawn + root.CFrame.LookVector)
        arrow.Parent = Workspace
        arrow.AssemblyLinearVelocity = root.CFrame.LookVector * (132 + chargeAlpha * 94) + Vector3.new(0, 3 + chargeAlpha * 7, 0)

        local arrowTip = createWeaponVisualPart("ArrowTip", Vector3.new(0.28, 0.28, 0.52), Color3.fromRGB(191, 191, 191), Enum.Material.Metal)
        weldToHandle(arrow, arrowTip, CFrame.new(0, 0, -2.15))

        local featherA = createWeaponVisualPart("FeatherA", Vector3.new(0.12, 0.36, 0.44), Color3.fromRGB(224, 228, 233), Enum.Material.Fabric)
        local featherB = createWeaponVisualPart("FeatherB", Vector3.new(0.12, 0.36, 0.44), Color3.fromRGB(224, 228, 233), Enum.Material.Fabric)
        weldToHandle(arrow, featherA, CFrame.new(0.12, 0, 1.6))
        weldToHandle(arrow, featherB, CFrame.new(-0.12, 0, 1.6))

        local arrowTrail = attachTrail(arrow, Color3.fromRGB(227, 211, 170), Color3.fromRGB(255, 237, 198), Vector3.new(0, 0, -2.1), Vector3.new(0, 0, 2.1))
        arrowTrail.Lifetime = 0.14
        arrowTrail.Enabled = true

        local damaged = false
        local arrowAlignConnection

        arrow.Touched:Connect(function(hitPart)
            if damaged then
                return
            end

            local target = hitPart:FindFirstAncestorOfClass("Model")

            if target == character then
                return
            end

            local targetHumanoid = target and getCharacterHumanoid(target) or nil

            if targetHumanoid then
                local hitApplied = applyDamage(character, targetHumanoid, math.floor(18 + chargeAlpha * 24), BOW_HIT_SOUND)

                if hitApplied then
                    damaged = true

                    if arrowAlignConnection then
                        arrowAlignConnection:Disconnect()
                    end

                    arrow:Destroy()
                end

                return
            end

            damaged = true
            playOneShotSound(arrow, BOW_HIT_SOUND, 0.4, 0.96)

            if arrowAlignConnection then
                arrowAlignConnection:Disconnect()
            end

            arrow:Destroy()
        end)

        arrowAlignConnection = RunService.Heartbeat:Connect(function()
            if not arrow.Parent then
                if arrowAlignConnection then
                    arrowAlignConnection:Disconnect()
                end

                return
            end

            local velocity = arrow.AssemblyLinearVelocity

            if velocity.Magnitude > 0.2 then
                arrow.CFrame = CFrame.lookAt(arrow.Position, arrow.Position + velocity.Unit)
            end
        end)

        Debris:AddItem(arrow, 3.6 + chargeAlpha * 1.6)
        task.delay(4.8, function()
            if arrowAlignConnection then
                arrowAlignConnection:Disconnect()
            end
        end)

        task.spawn(function()
            easeDrawVisual(0, 0.16)
            displayArrow.Transparency = 0
        end)

        task.delay(BOW_SHOT_COOLDOWN_SECONDS, function()
            cooldown = false
        end)
    end)

    return tool
end

function BattleLoadout.ClearForPlayer(player: Player)
    local backpack = player:FindFirstChildOfClass("Backpack")

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Training Sword" or item.Name == "Bow") then
                item:Destroy()
            end
        end
    end

    local character = player.Character

    if character then
        clearSkinCosmetics(character)
        character:SetAttribute("BlockingUntil", nil)

        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Training Sword" or item.Name == "Bow") then
                item:Destroy()
            end
        end
    end
end

function BattleLoadout.ApplyCurrentSkin(player: Player)
    applySkinCosmetics(player)
end

function BattleLoadout.GiveToPlayer(player: Player)
    BattleLoadout.ClearForPlayer(player)

    local backpack = player:FindFirstChildOfClass("Backpack")

    if not backpack then
        return
    end

    createSwordTool().Parent = backpack
    createBowTool().Parent = backpack
    applySkinCosmetics(player)
end

requestBlock.OnServerEvent:Connect(function(player: Player)
    setBlocking(player)
end)

game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
    blockCooldowns[player] = nil
end)

return BattleLoadout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">BuildUtils</string>
          <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")

local BuildUtils = {}

function BuildUtils.CreateFolder(parent: Instance, name: string): Folder
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent

    return folder
end

function BuildUtils.CreatePart(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?,
    transparency: number?
): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Anchored = true
    part.CanCollide = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Size = size
    part.CFrame = cframe
    part.Color = color
    part.Material = material

    if shape then
        part.Shape = shape
    end

    if transparency then
        part.Transparency = transparency
    end

    part.Parent = parent

    return part
end

function BuildUtils.CreateTeleportAnchor(parent: Instance, name: string, position: Vector3): Part
    local anchor = BuildUtils.CreatePart(
        parent,
        name,
        Vector3.new(12, 1, 12),
        CFrame.new(position + Vector3.new(0, 2, 0)),
        Color3.fromRGB(255, 255, 255),
        Enum.Material.SmoothPlastic,
        nil,
        1
    )
    anchor.CanCollide = false

    return anchor
end

function BuildUtils.AddPointLight(parent: BasePart, color: Color3, brightness: number, range: number)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = brightness
    light.Range = range
    light.Parent = parent
end

function BuildUtils.AttachPrompt(
    parent: BasePart,
    actionText: string,
    objectText: string,
    attributes: { [string]: any }?
): ProximityPrompt
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = actionText
    prompt.ObjectText = objectText
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 12
    prompt.RequiresLineOfSight = false
    prompt.Parent = parent

    if attributes then
        for key, value in pairs(attributes) do
            prompt:SetAttribute(key, value)
        end
    end

    return prompt
end

local function createSignLabel(board: BasePart, title: string, subtitle: string, titleColor: Color3)
    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Face = Enum.NormalId.Front
    surfaceGui.CanvasSize = Vector2.new(760, 280)
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surfaceGui.PixelsPerStud = 60
    surfaceGui.Parent = board

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.fromOffset(26, 18)
    titleLabel.Size = UDim2.new(1, -52, 0, 110)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = title
    titleLabel.TextColor3 = titleColor
    titleLabel.TextScaled = true
    titleLabel.TextWrapped = true
    titleLabel.Parent = surfaceGui

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.fromOffset(26, 122)
    subtitleLabel.Size = UDim2.new(1, -52, 0, 110)
    subtitleLabel.Font = Enum.Font.Gotham
    subtitleLabel.Text = subtitle
    subtitleLabel.TextColor3 = Color3.fromRGB(228, 226, 221)
    subtitleLabel.TextScaled = true
    subtitleLabel.TextWrapped = true
    subtitleLabel.Parent = surfaceGui
end

function BuildUtils.CreateBoardSign(
    parent: Instance,
    name: string,
    position: Vector3,
    title: string,
    subtitle: string,
    accentColor: Color3,
    promptAttributes: { [string]: any }?
): BasePart
    local post = BuildUtils.CreatePart(
        parent,
        string.format("%s_Post", name),
        Vector3.new(2, 11, 2),
        CFrame.new(position + Vector3.new(0, 5.5, 0)),
        Color3.fromRGB(112, 79, 48),
        Enum.Material.WoodPlanks,
        nil,
        nil
    )

    local board = BuildUtils.CreatePart(
        parent,
        string.format("%s_Board", name),
        Vector3.new(18, 9, 1.2),
        CFrame.new(position + Vector3.new(0, 10.8, 0)),
        accentColor,
        Enum.Material.WoodPlanks,
        nil,
        nil
    )
    board.Orientation = Vector3.new(0, 180, 0)

    createSignLabel(board, title, subtitle, Color3.fromRGB(252, 249, 242))

    if promptAttributes then
        BuildUtils.AttachPrompt(board, promptAttributes.ActionText, promptAttributes.ObjectText, promptAttributes.Attributes)
    end

    return board
end

function BuildUtils.CreateWallSign(
    parent: Instance,
    name: string,
    position: Vector3,
    size: Vector3,
    title: string,
    subtitle: string,
    wallColor: Color3,
    promptAttributes: { [string]: any }?
): BasePart
    local wall = BuildUtils.CreatePart(
        parent,
        name,
        size,
        CFrame.new(position + Vector3.new(0, size.Y * 0.5, 0)),
        wallColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    createSignLabel(wall, title, subtitle, Color3.fromRGB(252, 249, 242))

    if promptAttributes then
        BuildUtils.AttachPrompt(wall, promptAttributes.ActionText, promptAttributes.ObjectText, promptAttributes.Attributes)
    end

    return wall
end

function BuildUtils.CreateBanner(parent: Instance, name: string, position: Vector3, clothColor: Color3)
    BuildUtils.CreatePart(parent, string.format("%s_Pole", name), Vector3.new(1, 16, 1), CFrame.new(position + Vector3.new(0, 8, 0)), Color3.fromRGB(111, 83, 53), Enum.Material.Wood, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Cloth", name), Vector3.new(7, 8, 0.6), CFrame.new(position + Vector3.new(3.6, 10.5, 0)), clothColor, Enum.Material.Fabric, nil, nil)
end

function BuildUtils.CreateLantern(parent: Instance, name: string, position: Vector3, accentColor: Color3)
    BuildUtils.CreatePart(parent, string.format("%s_Post", name), Vector3.new(1.4, 11, 1.4), CFrame.new(position + Vector3.new(0, 5.5, 0)), Color3.fromRGB(98, 73, 49), Enum.Material.WoodPlanks, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Arm", name), Vector3.new(5, 0.8, 0.8), CFrame.new(position + Vector3.new(1.8, 10.2, 0)), Color3.fromRGB(96, 78, 48), Enum.Material.WoodPlanks, nil, nil)

    local housing = BuildUtils.CreatePart(parent, string.format("%s_Housing", name), Vector3.new(2.5, 3.5, 2.5), CFrame.new(position + Vector3.new(3.8, 8.4, 0)), accentColor, Enum.Material.Metal, nil, nil)
    local glow = BuildUtils.CreatePart(parent, string.format("%s_Glow", name), Vector3.new(1.2, 1.8, 1.2), housing.CFrame, Color3.fromRGB(255, 223, 158), Enum.Material.Neon, nil, nil)
    BuildUtils.AddPointLight(glow, Color3.fromRGB(255, 224, 167), 1.5, 20)
end

function BuildUtils.CreatePalmTree(parent: Instance, name: string, position: Vector3)
    BuildUtils.CreatePart(parent, string.format("%s_Trunk", name), Vector3.new(3, 18, 3), CFrame.new(position + Vector3.new(0, 9, 0)), Color3.fromRGB(126, 87, 55), Enum.Material.Wood, nil, nil)

    for _, offset in ipairs({
        Vector3.new(0, 19, -5),
        Vector3.new(0, 19, 5),
        Vector3.new(5, 19, 0),
        Vector3.new(-5, 19, 0),
        Vector3.new(0, 21, 0),
    }) do
        BuildUtils.CreatePart(parent, string.format("%s_Leaf_%d_%d", name, offset.X, offset.Z), Vector3.new(18, 1.6, 6), CFrame.new(position + offset), Color3.fromRGB(71, 132, 73), Enum.Material.Grass, nil, nil)
    end
end

function BuildUtils.CreatePlanter(parent: Instance, name: string, position: Vector3, size: Vector3)
    BuildUtils.CreatePart(parent, string.format("%s_Border", name), size, CFrame.new(position + Vector3.new(0, 1.5, 0)), Color3.fromRGB(171, 153, 120), Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Green", name), Vector3.new(size.X - 6, 2, size.Z - 6), CFrame.new(position + Vector3.new(0, 2.6, 0)), Color3.fromRGB(116, 149, 99), Enum.Material.Grass, nil, nil)
end

function BuildUtils.CreateHouse(parent: Instance, name: string, position: Vector3, footprint: Vector3, roofColor: Color3)
    BuildUtils.CreatePart(parent, string.format("%s_Base", name), Vector3.new(footprint.X, 20, footprint.Z), CFrame.new(position + Vector3.new(0, 10, 0)), Color3.fromRGB(226, 219, 196), Enum.Material.Limestone, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Roof", name), Vector3.new(footprint.X + 4, 3, footprint.Z + 4), CFrame.new(position + Vector3.new(0, 21.5, 0)), roofColor, Enum.Material.Sandstone, nil, nil)
    BuildUtils.CreatePart(parent, string.format("%s_Door", name), Vector3.new(4, 9, 1), CFrame.new(position + Vector3.new(0, 4.5, footprint.Z * -0.5 - 0.5)), Color3.fromRGB(110, 82, 49), Enum.Material.Wood, nil, nil)
end

function BuildUtils.CreateWedge(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    transparency: number?
): WedgePart
    local wedge = Instance.new("WedgePart")
    wedge.Name = name
    wedge.Anchored = true
    wedge.CanCollide = true
    wedge.TopSurface = Enum.SurfaceType.Smooth
    wedge.BottomSurface = Enum.SurfaceType.Smooth
    wedge.Size = size
    wedge.CFrame = cframe
    wedge.Color = color
    wedge.Material = material

    if transparency then
        wedge.Transparency = transparency
    end

    wedge.Parent = parent

    return wedge
end

local function scaleColor(color: Color3, scale: number): Color3
    return Color3.fromRGB(
        math.clamp(math.floor(color.R * 255 * scale), 0, 255),
        math.clamp(math.floor(color.G * 255 * scale), 0, 255),
        math.clamp(math.floor(color.B * 255 * scale), 0, 255)
    )
end

local function fillTerrainBall(position: Vector3, radius: number, material: Enum.Material)
    pcall(function()
        Workspace.Terrain:FillBall(position, radius, material)
    end)
end

local function fillTerrainBlock(cframe: CFrame, size: Vector3, material: Enum.Material)
    pcall(function()
        Workspace.Terrain:FillBlock(cframe, size, material)
    end)
end

function BuildUtils.CreateMountain(
    parent: Instance,
    name: string,
    position: Vector3,
    baseWidth: number,
    height: number,
    depth: number,
    color: Color3,
    yawDegrees: number?
)
    local folder = BuildUtils.CreateFolder(parent, name)
    local yaw = math.rad(yawDegrees or 0)
    local baseCFrame = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
    folder:SetAttribute("TerrainMountain", true)
    folder:SetAttribute("ColorPreview", color)

    fillTerrainBlock(
        baseCFrame * CFrame.new(0, math.max(4, height * 0.08), 0),
        Vector3.new(baseWidth * 0.94, math.max(10, height * 0.16), depth * 0.82),
        Enum.Material.Rock
    )

    for index = -3, 3 do
        local alpha = index / 3
        local widthFalloff = 1 - math.abs(alpha) * 0.38
        local ridgeHeight = height * (0.46 + widthFalloff * 0.34)
        local radius = math.max(18, math.min(baseWidth, depth) * (0.28 + widthFalloff * 0.18))
        local lateral = alpha * baseWidth * 0.32
        local offsetZ = math.sin(index * 1.7) * depth * 0.08
        local centerPosition = (baseCFrame * CFrame.new(lateral, ridgeHeight * 0.48, offsetZ)).Position

        fillTerrainBall(centerPosition, radius, Enum.Material.Rock)
        fillTerrainBall(centerPosition + Vector3.new(0, radius * 0.32, 0), radius * 0.68, Enum.Material.Rock)

        if index % 2 == 0 then
            fillTerrainBall(
                (baseCFrame * CFrame.new(lateral * 0.9, ridgeHeight * 0.42, offsetZ + depth * 0.22)).Position,
                radius * 0.64,
                Enum.Material.Sandstone
            )
        end
    end

    for index = 1, 7 do
        local alpha = index / 8
        local x = (alpha - 0.5) * baseWidth * 0.92
        local y = height * (0.22 + alpha * 0.16)
        local z = ((index % 2 == 0) and -1 or 1) * depth * (0.28 + alpha * 0.08)
        local shoulderCFrame = baseCFrame
            * CFrame.new(x, y, z)
            * CFrame.Angles(0, math.rad((index % 2 == 0) and 14 or -18), math.rad((index % 3 - 1) * 5))

        fillTerrainBlock(
            shoulderCFrame,
            Vector3.new(baseWidth * (0.22 + alpha * 0.05), math.max(9, height * 0.08), depth * 0.08),
            index % 2 == 0 and Enum.Material.Rock or Enum.Material.Sandstone
        )
    end
end

function BuildUtils.CreateDune(parent: Instance, name: string, position: Vector3, size: Vector3, color: Color3)
    local folder = BuildUtils.CreateFolder(parent, name)
    folder:SetAttribute("TerrainDune", true)
    folder:SetAttribute("ColorPreview", color)

    fillTerrainBlock(
        CFrame.new(position + Vector3.new(0, math.max(4, size.Y * 0.1), 0)),
        Vector3.new(size.X * 0.88, math.max(8, size.Y * 0.22), size.Z * 0.78),
        Enum.Material.Sand
    )

    for index = -2, 2 do
        local alpha = index / 2
        local radius = math.max(14, math.min(size.X, size.Z) * (0.24 + (1 - math.abs(alpha)) * 0.1))
        local centerPosition = position
            + Vector3.new(alpha * size.X * 0.28, size.Y * (0.22 + (1 - math.abs(alpha)) * 0.18), math.sin(index * 1.3) * size.Z * 0.14)

        fillTerrainBall(centerPosition, radius, Enum.Material.Sand)
    end

    fillTerrainBlock(
        CFrame.new(position + Vector3.new(0, math.max(3, size.Y * 0.08), size.Z * -0.32)) * CFrame.Angles(0, math.rad(9), 0),
        Vector3.new(size.X * 0.72, math.max(5, size.Y * 0.12), size.Z * 0.16),
        Enum.Material.Sandstone
    )
end

function BuildUtils.CreateRockCluster(parent: Instance, name: string, position: Vector3)
    local folder = BuildUtils.CreateFolder(parent, name)
    folder:SetAttribute("TerrainRockCluster", true)

    fillTerrainBlock(
        CFrame.new(position + Vector3.new(4, 4, -2)) * CFrame.Angles(0, math.rad(-12), 0),
        Vector3.new(52, 8, 38),
        Enum.Material.Rock
    )

    for index, offset in ipairs({
        Vector3.new(-16, 12, -16),
        Vector3.new(8, 16, 12),
        Vector3.new(24, 10, -10),
        Vector3.new(-4, 8, 18),
    }) do
        fillTerrainBall(
            position + offset,
            index == 2 and 18 or 13,
            index == 3 and Enum.Material.Sandstone or Enum.Material.Rock
        )
    end
end

function BuildUtils.CreateVerticalCylinder(
    parent: Instance,
    name: string,
    height: number,
    radius: number,
    position: Vector3,
    color: Color3,
    material: Enum.Material,
    transparency: number?
): Part
    return BuildUtils.CreatePart(
        parent,
        name,
        Vector3.new(height, radius * 2, radius * 2),
        CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
        color,
        material,
        Enum.PartType.Cylinder,
        transparency
    )
end

function BuildUtils.CreateSphere(
    parent: Instance,
    name: string,
    diameter: number,
    position: Vector3,
    color: Color3,
    material: Enum.Material,
    transparency: number?
): Part
    return BuildUtils.CreatePart(
        parent,
        name,
        Vector3.new(diameter, diameter, diameter),
        CFrame.new(position),
        color,
        material,
        Enum.PartType.Ball,
        transparency
    )
end

function BuildUtils.CreateModernTower(
    parent: Instance,
    name: string,
    position: Vector3,
    footprint: Vector2,
    height: number,
    bodyColor: Color3,
    windowColor: Color3
)
    local podiumHeight = math.max(14, math.floor(height * 0.18))
    local shaftHeight = height

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Podium", name),
        Vector3.new(footprint.X + 16, podiumHeight, footprint.Y + 16),
        CFrame.new(position + Vector3.new(0, podiumHeight * 0.5, 0)),
        Color3.fromRGB(238, 237, 233),
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Shaft", name),
        Vector3.new(footprint.X, shaftHeight, footprint.Y),
        CFrame.new(position + Vector3.new(0, podiumHeight + shaftHeight * 0.5, 0)),
        bodyColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_GlassFront", name),
        Vector3.new(math.max(8, footprint.X * 0.42), math.max(16, shaftHeight - 18), 1.2),
        CFrame.new(position + Vector3.new(0, podiumHeight + shaftHeight * 0.5 + 2, footprint.Y * -0.5 - 0.7)),
        windowColor,
        Enum.Material.Glass,
        nil,
        0.2
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_GlassBack", name),
        Vector3.new(math.max(8, footprint.X * 0.42), math.max(16, shaftHeight - 18), 1.2),
        CFrame.new(position + Vector3.new(0, podiumHeight + shaftHeight * 0.5 + 2, footprint.Y * 0.5 + 0.7)),
        windowColor,
        Enum.Material.Glass,
        nil,
        0.2
    )

    local windowRows = math.clamp(math.floor(shaftHeight / 34), 4, 11)
    local windowRowSpacing = shaftHeight / (windowRows + 1)

    for row = 1, windowRows do
        local y = podiumHeight + row * windowRowSpacing

        BuildUtils.CreatePart(
            parent,
            string.format("%s_FloorLineFront_%d", name, row),
            Vector3.new(math.max(10, footprint.X - 8), 0.8, 1.35),
            CFrame.new(position + Vector3.new(0, y, footprint.Y * -0.5 - 1)),
            Color3.fromRGB(236, 229, 211),
            Enum.Material.Metal,
            nil,
            nil
        )

        BuildUtils.CreatePart(
            parent,
            string.format("%s_FloorLineBack_%d", name, row),
            Vector3.new(math.max(10, footprint.X - 8), 0.8, 1.35),
            CFrame.new(position + Vector3.new(0, y, footprint.Y * 0.5 + 1)),
            Color3.fromRGB(236, 229, 211),
            Enum.Material.Metal,
            nil,
            nil
        )

        BuildUtils.CreatePart(
            parent,
            string.format("%s_SideGlassWest_%d", name, row),
            Vector3.new(1.25, 6, math.max(10, footprint.Y * 0.42)),
            CFrame.new(position + Vector3.new(footprint.X * -0.5 - 0.8, y + 3, 0)),
            windowColor,
            Enum.Material.Glass,
            nil,
            0.24
        )

        BuildUtils.CreatePart(
            parent,
            string.format("%s_SideGlassEast_%d", name, row),
            Vector3.new(1.25, 6, math.max(10, footprint.Y * 0.42)),
            CFrame.new(position + Vector3.new(footprint.X * 0.5 + 0.8, y + 3, 0)),
            windowColor,
            Enum.Material.Glass,
            nil,
            0.24
        )
    end

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Crown", name),
        Vector3.new(footprint.X - 6, 8, footprint.Y - 6),
        CFrame.new(position + Vector3.new(0, podiumHeight + shaftHeight + 4, 0)),
        Color3.fromRGB(233, 231, 225),
        Enum.Material.Marble,
        nil,
        nil
    )
end

function BuildUtils.CreateMinaret(parent: Instance, name: string, position: Vector3, height: number, bodyColor: Color3, accentColor: Color3)
    local baseHeight = math.max(16, math.floor(height * 0.18))
    local lowerHeight = math.max(24, math.floor(height * 0.34))
    local upperHeight = math.max(20, math.floor(height * 0.24))
    local capHeight = math.max(10, math.floor(height * 0.12))

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Base", name),
        Vector3.new(14, baseHeight, 14),
        CFrame.new(position + Vector3.new(0, baseHeight * 0.5, 0)),
        bodyColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreateVerticalCylinder(
        parent,
        string.format("%s_Lower", name),
        lowerHeight,
        4,
        position + Vector3.new(0, baseHeight + lowerHeight * 0.5, 0),
        bodyColor,
        Enum.Material.Marble,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_BalconyLower", name),
        Vector3.new(12, 2, 12),
        CFrame.new(position + Vector3.new(0, baseHeight + lowerHeight + 1, 0)),
        accentColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreateVerticalCylinder(
        parent,
        string.format("%s_Upper", name),
        upperHeight,
        2.6,
        position + Vector3.new(0, baseHeight + lowerHeight + 2 + upperHeight * 0.5, 0),
        bodyColor,
        Enum.Material.Marble,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_BalconyUpper", name),
        Vector3.new(9, 2, 9),
        CFrame.new(position + Vector3.new(0, baseHeight + lowerHeight + upperHeight + 3, 0)),
        accentColor,
        Enum.Material.Marble,
        nil,
        nil
    )

    BuildUtils.CreateVerticalCylinder(
        parent,
        string.format("%s_Cap", name),
        capHeight,
        1.7,
        position + Vector3.new(0, baseHeight + lowerHeight + upperHeight + 3 + capHeight * 0.5 + 1, 0),
        bodyColor,
        Enum.Material.Marble,
        nil
    )

    BuildUtils.CreateSphere(
        parent,
        string.format("%s_Dome", name),
        4.8,
        position + Vector3.new(0, baseHeight + lowerHeight + upperHeight + capHeight + 7, 0),
        accentColor,
        Enum.Material.SmoothPlastic,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Spire", name),
        Vector3.new(1, 8, 1),
        CFrame.new(position + Vector3.new(0, baseHeight + lowerHeight + upperHeight + capHeight + 12, 0)),
        Color3.fromRGB(205, 176, 108),
        Enum.Material.Metal,
        nil,
        nil
    )
end

function BuildUtils.CreateCourtyardCanopy(parent: Instance, name: string, position: Vector3, canopyColor: Color3, poleColor: Color3)
    BuildUtils.CreateVerticalCylinder(
        parent,
        string.format("%s_Pole", name),
        16,
        0.7,
        position + Vector3.new(0, 8, 0),
        poleColor,
        Enum.Material.Metal,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Canopy", name),
        Vector3.new(22, 1, 22),
        CFrame.new(position + Vector3.new(0, 16.5, 0)),
        canopyColor,
        Enum.Material.Fabric,
        nil,
        nil
    )

    BuildUtils.CreatePart(
        parent,
        string.format("%s_Cap", name),
        Vector3.new(7, 1, 7),
        CFrame.new(position + Vector3.new(0, 17.3, 0)),
        Color3.fromRGB(243, 242, 238),
        Enum.Material.Marble,
        nil,
        nil
    )

    for index, offset in ipairs({
        Vector3.new(-8.5, 15.8, -8.5),
        Vector3.new(8.5, 15.8, -8.5),
        Vector3.new(-8.5, 15.8, 8.5),
        Vector3.new(8.5, 15.8, 8.5),
    }) do
        BuildUtils.CreateSphere(
            parent,
            string.format("%s_Tip_%d", name, index),
            2.2,
            position + offset,
            canopyColor,
            Enum.Material.SmoothPlastic,
            nil
        )
    end
end

return BuildUtils
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="30">
      <Properties>
        <string name="Name">ShopService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Debris = game:GetService("Debris")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShopCatalog = require(Shared.Data.ShopCatalog)
local BattleLoadout = require(script.Parent.Modules.BattleLoadout)

local shopFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Shop")
local requestShopState = shopFolder:WaitForChild("RequestShopState") :: RemoteEvent
local promptGamePassPurchase = shopFolder:WaitForChild("PromptGamePassPurchase") :: RemoteEvent
local promptDeveloperProductPurchase = shopFolder:WaitForChild("PromptDeveloperProductPurchase") :: RemoteEvent
local equipSkin = shopFolder:WaitForChild("EquipSkin") :: RemoteEvent
local useUltimate = shopFolder:WaitForChild("UseUltimate") :: RemoteEvent
local shopStateEvent = shopFolder:WaitForChild("ShopState") :: RemoteEvent
local purchaseFeedback = shopFolder:WaitForChild("PurchaseFeedback") :: RemoteEvent
local grantCurrency = shopFolder:FindFirstChild("GrantCurrency")

if not grantCurrency then
    local bindable = Instance.new("BindableEvent")
    bindable.Name = "GrantCurrency"
    bindable.Parent = shopFolder
    grantCurrency = bindable
end

local profileStore = DataStoreService:GetDataStore("PlayerMonetization_v1")
local receiptStore = DataStoreService:GetDataStore("ProcessedReceipts_v1")

local playerProfiles: { [Player]: { EquippedSkin: string, UltimateCharges: number, KnowledgeTokens: number, SupportPoints: number } } = {}
local playerPassOwnership: { [Player]: { [string]: boolean } } = {}
local ultimateCooldowns: { [Player]: number } = {}
local COMBATANT_TAG = "BattleCombatant"

local gamePassByKey = {}
local gamePassByProductId = {}
local developerProductByKey = {}
local developerProductByProductId = {}

for _, item in ipairs(ShopCatalog.GamePasses) do
    gamePassByKey[item.Key] = item

    if item.ProductId > 0 then
        gamePassByProductId[item.ProductId] = item
    end
end

for _, item in ipairs(ShopCatalog.DeveloperProducts) do
    developerProductByKey[item.Key] = item

    if item.ProductId > 0 then
        developerProductByProductId[item.ProductId] = item
    end
end

local function buildDefaultProfile()
    return {
        EquippedSkin = "default",
        UltimateCharges = 0,
        KnowledgeTokens = 0,
        SupportPoints = 0,
    }
end

local function cloneProfile(source)
    return {
        EquippedSkin = source.EquippedSkin,
        UltimateCharges = source.UltimateCharges,
        KnowledgeTokens = source.KnowledgeTokens,
        SupportPoints = source.SupportPoints,
    }
end

local function sendFeedback(player: Player, text: string, tone: string?)
    purchaseFeedback:FireClient(player, {
        Text = text,
        Tone = tone or "info",
    })
end

local function getOwnedSkins(ownedPasses: { [string]: boolean }): { [string]: boolean }
    local ownedSkins = {
        default = true,
    }

    for skinId, skinDefinition in pairs(ShopCatalog.SkinDefinitions) do
        if skinDefinition.UnlockType == "GamePass" and ownedPasses[skinDefinition.UnlockKey] then
            ownedSkins[skinId] = true
        end
    end

    return ownedSkins
end

local function sanitizeEquippedSkin(profile, ownedPasses: { [string]: boolean })
    local ownedSkins = getOwnedSkins(ownedPasses)

    if not ownedSkins[profile.EquippedSkin] then
        profile.EquippedSkin = "default"
    end
end

local function applyPlayerAttributes(player: Player)
    local profile = playerProfiles[player] or buildDefaultProfile()
    local ownedPasses = playerPassOwnership[player] or {}

    sanitizeEquippedSkin(profile, ownedPasses)
    playerProfiles[player] = profile

    player:SetAttribute("EquippedBattleSkin", profile.EquippedSkin)
    player:SetAttribute("UltimateCharges", profile.UltimateCharges)
    player:SetAttribute("KnowledgeTokens", profile.KnowledgeTokens)
    player:SetAttribute("SupportPoints", profile.SupportPoints)
    player:SetAttribute("HasFounderSupport", ownedPasses.founder_support == true)
end

local function saveProfile(player: Player)
    local profile = playerProfiles[player]

    if not profile then
        return
    end

    local profileCopy = cloneProfile(profile)

    task.spawn(function()
        local success, errorMessage = pcall(function()
            profileStore:SetAsync(string.format("player_%d", player.UserId), profileCopy)
        end)

        if not success then
            warn(string.format("[ShopService] Failed to save profile for %s: %s", player.Name, tostring(errorMessage)))
        end
    end)
end

local function refreshPassOwnership(player: Player)
    local ownedPasses = {}

    for _, item in ipairs(ShopCatalog.GamePasses) do
        local owned = false

        if item.ProductId > 0 then
            local success, result = pcall(function()
                return MarketplaceService:UserOwnsGamePassAsync(player.UserId, item.ProductId)
            end)

            if success then
                owned = result
            end
        end

        ownedPasses[item.Key] = owned
    end

    playerPassOwnership[player] = ownedPasses
    applyPlayerAttributes(player)
end

local function listOwnedKeys(lookup: { [string]: boolean }): { string }
    local results = {}

    for key, isOwned in pairs(lookup) do
        if isOwned then
            table.insert(results, key)
        end
    end

    table.sort(results)

    return results
end

local function sendShopState(player: Player, statusText: string?)
    local profile = playerProfiles[player] or buildDefaultProfile()
    local ownedPasses = playerPassOwnership[player] or {}
    local ownedSkins = getOwnedSkins(ownedPasses)

    shopStateEvent:FireClient(player, {
        OwnedPassKeys = listOwnedKeys(ownedPasses),
        OwnedSkinIds = listOwnedKeys(ownedSkins),
        EquippedSkinId = profile.EquippedSkin,
        UltimateCharges = profile.UltimateCharges,
        KnowledgeTokens = profile.KnowledgeTokens,
        SupportPoints = profile.SupportPoints,
        StatusText = statusText or "",
    })
end

local function loadProfile(player: Player)
    local profile = buildDefaultProfile()

    local success, storedProfile = pcall(function()
        return profileStore:GetAsync(string.format("player_%d", player.UserId))
    end)

    if success and type(storedProfile) == "table" then
        if type(storedProfile.EquippedSkin) == "string" then
            profile.EquippedSkin = storedProfile.EquippedSkin
        end

        if type(storedProfile.UltimateCharges) == "number" then
            profile.UltimateCharges = storedProfile.UltimateCharges
        end

        if type(storedProfile.KnowledgeTokens) == "number" then
            profile.KnowledgeTokens = storedProfile.KnowledgeTokens
        end

        if type(storedProfile.SupportPoints) == "number" then
            profile.SupportPoints = storedProfile.SupportPoints
        end
    elseif not success then
        warn(string.format("[ShopService] Failed to load profile for %s: %s", player.Name, tostring(storedProfile)))
    end

    playerProfiles[player] = profile
    refreshPassOwnership(player)
    sendShopState(player, "Shop ready.")
end

local function grantDeveloperProduct(player: Player, product)
    local profile = playerProfiles[player]

    if not profile then
        return false
    end

    if product.Grants then
        if product.Grants.UltimateCharges then
            profile.UltimateCharges += product.Grants.UltimateCharges
        end

        if product.Grants.KnowledgeTokens then
            profile.KnowledgeTokens += product.Grants.KnowledgeTokens
        end

        if product.Grants.SupportPoints then
            profile.SupportPoints += product.Grants.SupportPoints
        end
    end

    applyPlayerAttributes(player)
    saveProfile(player)
    sendShopState(player, string.format("%s granted.", product.DisplayName))
    sendFeedback(player, string.format("Purchase complete: %s", product.DisplayName), "success")

    return true
end

local function grantKnowledgeTokens(player: Player, amount: number, reason: string)
    local profile = playerProfiles[player]

    if not profile or amount <= 0 then
        return
    end

    profile.KnowledgeTokens += amount
    applyPlayerAttributes(player)
    saveProfile(player)
    sendShopState(player, string.format("%s: +%d %s", reason, amount, ShopCatalog.CurrencyName or "Knowledge Tokens"))
end

local function promptPass(player: Player, key: string)
    local item = gamePassByKey[key]

    if not item then
        sendFeedback(player, "That pass is not configured.", "warning")
        return
    end

    if item.ProductId <= 0 then
        sendFeedback(player, string.format("Create the %s pass in Creator Hub and paste the ProductId first.", item.DisplayName), "warning")
        return
    end

    MarketplaceService:PromptGamePassPurchase(player, item.ProductId)
end

local function promptProduct(player: Player, key: string)
    local item = developerProductByKey[key]

    if not item then
        sendFeedback(player, "That product is not configured.", "warning")
        return
    end

    if item.ProductId <= 0 then
        sendFeedback(player, string.format("Create the %s developer product in Creator Hub and paste the ProductId first.", item.DisplayName), "warning")
        return
    end

    MarketplaceService:PromptProductPurchase(player, item.ProductId)
end

local function tryEquipSkin(player: Player, skinId: string)
    local profile = playerProfiles[player]
    local ownedPasses = playerPassOwnership[player] or {}

    if not profile then
        return
    end

    local ownedSkins = getOwnedSkins(ownedPasses)

    if not ownedSkins[skinId] then
        sendFeedback(player, "You do not own that skin yet.", "warning")
        return
    end

    profile.EquippedSkin = skinId
    applyPlayerAttributes(player)
    saveProfile(player)
    BattleLoadout.ApplyCurrentSkin(player)
    sendShopState(player, string.format("Equipped %s.", ShopCatalog.SkinDefinitions[skinId].DisplayName))
    sendFeedback(player, string.format("Equipped %s.", ShopCatalog.SkinDefinitions[skinId].DisplayName), "success")
end

local function useUltimateCharge(player: Player)
    local profile = playerProfiles[player]

    if not profile then
        return
    end

    if player:GetAttribute("InBattle") ~= true then
        sendFeedback(player, "Ultimates can only be used during a battle round.", "warning")
        return
    end

    if profile.UltimateCharges <= 0 then
        sendFeedback(player, "No ultimate charges left. Buy more in the shop.", "warning")
        return
    end

    local now = os.clock()
    local lastUse = ultimateCooldowns[player]

    if lastUse and now - lastUse < 18 then
        sendFeedback(player, "Your ultimate is recharging.", "warning")
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local currentScenarioId = player:GetAttribute("CurrentScenarioId")
    local currentBattleTeam = player:GetAttribute("CurrentBattleTeam")

    if not character or not root or not root:IsA("BasePart") or typeof(currentScenarioId) ~= "string" or typeof(currentBattleTeam) ~= "string" then
        sendFeedback(player, "Your ultimate could not be activated right now.", "warning")
        return
    end

    profile.UltimateCharges -= 1
    ultimateCooldowns[player] = now
    applyPlayerAttributes(player)
    saveProfile(player)

    local pulse = Instance.new("Part")
    pulse.Name = "UltimatePulse"
    pulse.Shape = Enum.PartType.Ball
    pulse.Material = Enum.Material.Neon
    pulse.Color = Color3.fromRGB(230, 199, 121)
    pulse.Transparency = 0.35
    pulse.Anchored = true
    pulse.CanCollide = false
    pulse.CanTouch = false
    pulse.CanQuery = false
    pulse.Size = Vector3.new(2, 2, 2)
    pulse.CFrame = CFrame.new(root.Position)
    pulse.Parent = Workspace

    local tween = TweenService:Create(
        pulse,
        TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = Vector3.new(44, 44, 44),
            Transparency = 1,
        }
    )
    tween:Play()
    Debris:AddItem(pulse, 0.6)

    for _, targetModel in ipairs(CollectionService:GetTagged(COMBATANT_TAG)) do
        if targetModel:IsA("Model") and targetModel ~= character then
            local targetHumanoid = targetModel:FindFirstChildOfClass("Humanoid")
            local targetScenarioId = targetModel:GetAttribute("ScenarioId")
            local targetTeamId = targetModel:GetAttribute("BattleTeam")
            local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")

            if targetHumanoid and targetHumanoid.Health > 0 and targetScenarioId == currentScenarioId and targetTeamId ~= currentBattleTeam and targetRoot and targetRoot:IsA("BasePart") then
                local offset = targetRoot.Position - root.Position
                local distance = offset.Magnitude

                if distance <= 22 then
                    targetHumanoid:TakeDamage(30)

                    if distance > 0.1 then
                        targetRoot.AssemblyLinearVelocity += offset.Unit * 52
                    end
                end
            end
        end
    end

    sendShopState(player, "Ultimate activated.")
    sendFeedback(player, "Ultimate activated.", "success")
end

requestShopState.OnServerEvent:Connect(function(player: Player)
    if not playerProfiles[player] then
        loadProfile(player)
        return
    end

    sendShopState(player)
end)

promptGamePassPurchase.OnServerEvent:Connect(function(player: Player, key: string)
    if typeof(key) == "string" then
        promptPass(player, key)
    end
end)

promptDeveloperProductPurchase.OnServerEvent:Connect(function(player: Player, key: string)
    if typeof(key) == "string" then
        promptProduct(player, key)
    end
end)

equipSkin.OnServerEvent:Connect(function(player: Player, skinId: string)
    if typeof(skinId) == "string" then
        tryEquipSkin(player, skinId)
    end
end)

useUltimate.OnServerEvent:Connect(function(player: Player)
    useUltimateCharge(player)
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
    if not wasPurchased then
        return
    end

    local item = gamePassByProductId[gamePassId]

    if not item then
        return
    end

    refreshPassOwnership(player)
    sendShopState(player, string.format("Unlocked %s.", item.DisplayName))
    sendFeedback(player, string.format("Unlocked %s.", item.DisplayName), "success")
end)

MarketplaceService.ProcessReceipt = function(receiptInfo)
    local item = developerProductByProductId[receiptInfo.ProductId]

    if not item then
        warn(string.format("[ShopService] No receipt handler for product id %s", tostring(receiptInfo.ProductId)))
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)

    if not player then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    local receiptKey = string.format("receipt_%s", tostring(receiptInfo.PurchaseId))
    local alreadyProcessed = false

    local success, errorMessage = pcall(function()
        receiptStore:UpdateAsync(receiptKey, function(existing)
            if existing then
                alreadyProcessed = true
                return existing
            end

            return {
                ProductId = receiptInfo.ProductId,
                PlayerId = receiptInfo.PlayerId,
                ProcessedAt = os.time(),
            }
        end)
    end)

    if not success then
        warn(string.format("[ShopService] Failed to lock receipt %s: %s", tostring(receiptInfo.PurchaseId), tostring(errorMessage)))
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    if alreadyProcessed then
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end

    local granted = grantDeveloperProduct(player, item)

    if granted then
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end

    return Enum.ProductPurchaseDecision.NotProcessedYet
end

if grantCurrency and grantCurrency:IsA("BindableEvent") then
    grantCurrency.Event:Connect(function(player: Player, amount: number, reason: string?)
        grantKnowledgeTokens(player, amount, reason or "Reward")
    end)
end

Players.PlayerAdded:Connect(function(player)
    loadProfile(player)
end)

Players.PlayerRemoving:Connect(function(player)
    saveProfile(player)
    playerProfiles[player] = nil
    playerPassOwnership[player] = nil
    ultimateCooldowns[player] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(function()
        loadProfile(player)
    end)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="31">
      <Properties>
        <string name="Name">StoryService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Chat = game:GetService("Chat")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CompanionStories = require(Shared.Data.CompanionStories)
local TravelRoute = require(Shared.Data.TravelRoute)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local shopFolder = remotesFolder:WaitForChild("Shop")
local storyFolder = remotesFolder:WaitForChild("Story")
local showStoryDialogue = storyFolder:WaitForChild("ShowStoryDialogue") :: RemoteEvent
local updateStoryMission = storyFolder:WaitForChild("UpdateStoryMission") :: RemoteEvent
local clearStoryMission = storyFolder:WaitForChild("ClearStoryMission") :: RemoteEvent
local requestStartStory = storyFolder:WaitForChild("RequestStartStory") :: RemoteEvent

local STORY_WORLD_NAME = "GeneratedStories"
local LINE_DURATION_SECONDS = 2.4
local promptConnections = {}
local activeStories = {}
local storyById = {}

for _, story in ipairs(CompanionStories) do
    storyById[story.Id] = story
end

local function getGrantCurrencyBindable()
    local bindable = shopFolder:FindFirstChild("GrantCurrency")

    if bindable and bindable:IsA("BindableEvent") then
        return bindable
    end

    return nil
end

local function awardKnowledgeTokens(player: Player, amount: number, reason: string)
    if amount <= 0 then
        return
    end

    local bindable = getGrantCurrencyBindable()

    if bindable then
        bindable:Fire(player, amount, reason)
        return
    end

    local currentTokens = player:GetAttribute("KnowledgeTokens")

    if type(currentTokens) ~= "number" then
        currentTokens = 0
    end

    player:SetAttribute("KnowledgeTokens", currentTokens + amount)
end

local function getStoryWorld(): Folder?
    local folder = Workspace:FindFirstChild(STORY_WORLD_NAME)

    if folder and folder:IsA("Folder") then
        return folder
    end

    return nil
end

local function getStoryZone(storyId: string): Folder?
    local worldFolder = getStoryWorld()
    local zone = worldFolder and worldFolder:FindFirstChild(storyId)

    if zone and zone:IsA("Folder") then
        return zone
    end

    return nil
end

local function getAnchor(zone: Folder, anchorName: string): BasePart?
    local anchors = zone:FindFirstChild("Anchors")
    local anchor = anchors and anchors:FindFirstChild(anchorName)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function getHubAnchor(): BasePart?
    local hubFolder = Workspace:FindFirstChild(TravelRoute.WorldFolderName)
    local teleportFolder = hubFolder and hubFolder:FindFirstChild("TeleportPoints")
    local anchor = teleportFolder and teleportFolder:FindFirstChild(TravelRoute.StartDestinationId)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    return nil
end

local function getCharacter(player: Player): Model?
    if player.Character then
        return player.Character
    end

    local ok, character = pcall(function()
        return player.CharacterAdded:Wait()
    end)

    if ok then
        return character
    end

    return nil
end

local function getReadyCharacter(player: Player, timeoutSeconds: number): Model?
    local deadline = os.clock() + timeoutSeconds

    while os.clock() < deadline do
        local character = player.Character

        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local root = character:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
                return character
            end
        end

        task.wait(0.15)
    end

    return nil
end

local function teleportPlayerToAnchor(player: Player, anchor: BasePart)
    local character = getCharacter(player)

    if character then
        character:PivotTo(anchor.CFrame * CFrame.new(0, 4, 0))
    end
end

local function findNpcHead(zone: Folder, npcName: string): BasePart?
    local stations = zone:FindFirstChild("Stations")

    if not stations then
        return nil
    end

    for _, station in ipairs(stations:GetDescendants()) do
        if station:IsA("Model") and station.Name == npcName then
            local head = station:FindFirstChild("Head")

            if head and head:IsA("BasePart") then
                return head
            end
        end
    end

    return nil
end

local function speakDialogueBubble(zone: Folder, npcName: string, dialogueLines)
    local head = findNpcHead(zone, npcName)

    if not head then
        return
    end

    task.spawn(function()
        for _, line in ipairs(dialogueLines) do
            local text = line.Text or line

            if type(text) == "string" then
                Chat:Chat(head, text, Enum.ChatColor.White)
                task.wait(LINE_DURATION_SECONDS)
            end
        end
    end)
end

local function fireDialogue(player: Player, story, title: string, dialogueLines)
    showStoryDialogue:FireClient(player, {
        StoryName = story.DisplayName,
        Title = title,
        Lines = dialogueLines,
        AccentColor = story.AccentColor,
    })
end

local function getCurrentStep(state)
    return state.Story.ScenarioSteps[state.StepIndex]
end

local function updateMissionForPlayer(player: Player)
    local state = activeStories[player]

    if not state then
        clearStoryMission:FireClient(player)
        return
    end

    local step = getCurrentStep(state)

    if not step then
        clearStoryMission:FireClient(player)
        return
    end

    updateStoryMission:FireClient(player, {
        StoryName = state.Story.DisplayName,
        StepLabel = string.format("Step %d of %d", state.StepIndex, #state.Story.ScenarioSteps),
        Objective = step.Objective,
        LocationName = step.LocationName,
    })
end

local function clearStoryState(player: Player)
    activeStories[player] = nil
    player:SetAttribute("InStory", false)
    player:SetAttribute("CurrentStoryId", nil)
    player:SetAttribute("CurrentStoryStepIndex", nil)
    clearStoryMission:FireClient(player)
end

local function returnPlayerToHub(player: Player)
    local hubAnchor = getHubAnchor()

    if not hubAnchor then
        return
    end

    teleportPlayerToAnchor(player, hubAnchor)
end

local function completeStory(player: Player)
    local state = activeStories[player]

    if not state then
        return
    end

    fireDialogue(player, state.Story, state.Story.Completion.Title, state.Story.Completion.Lines)
    awardKnowledgeTokens(player, state.Story.RewardTokens or 0, string.format("%s story complete", state.Story.DisplayName))

    local returnDelay = math.max(5.5, #state.Story.Completion.Lines * LINE_DURATION_SECONDS + 0.7)

    task.delay(returnDelay, function()
        if activeStories[player] ~= state then
            return
        end

        clearStoryState(player)
        returnPlayerToHub(player)
    end)
end

local function triggerStoryStep(player: Player, storyId: string, stepIndex: number)
    local state = activeStories[player]

    if not state or state.Story.Id ~= storyId or state.StepIndex ~= stepIndex or state.StepLocked == true then
        return
    end

    local step = state.Story.ScenarioSteps[stepIndex]

    if not step then
        return
    end

    state.StepLocked = true

    speakDialogueBubble(state.Zone, step.NpcName, step.Dialogue)
    fireDialogue(player, state.Story, step.Title, step.Dialogue)

    local holdDuration = math.max(3.2, #step.Dialogue * LINE_DURATION_SECONDS + 0.7)

    task.delay(holdDuration, function()
        if activeStories[player] ~= state then
            return
        end

        if state.StepIndex ~= stepIndex then
            return
        end

        if stepIndex >= #state.Story.ScenarioSteps then
            state.StepLocked = false
            completeStory(player)
            return
        end

        state.StepIndex += 1
        state.StepLocked = false
        player:SetAttribute("CurrentStoryStepIndex", state.StepIndex)
        updateMissionForPlayer(player)
    end)
end

local function startStory(player: Player, storyId: string)
    local story = storyById[storyId]

    if not story then
        return
    end

    if player:GetAttribute("InBattle") == true then
        return
    end

    local zone = getStoryZone(storyId)
    local entryAnchor = zone and getAnchor(zone, "Entry")

    if not zone or not entryAnchor then
        return
    end

    local state = {
        Story = story,
        Zone = zone,
        StepIndex = 1,
    }

    activeStories[player] = state
    player:SetAttribute("InStory", true)
    player:SetAttribute("CurrentStoryId", story.Id)
    player:SetAttribute("CurrentStoryStepIndex", 1)

    teleportPlayerToAnchor(player, entryAnchor)
    fireDialogue(player, story, "Story Start", story.Introduction)
    updateMissionForPlayer(player)
end

local function exitStory(player: Player)
    if not activeStories[player] then
        return
    end

    clearStoryState(player)
    returnPlayerToHub(player)
end

requestStartStory.OnServerEvent:Connect(function(player: Player, storyId: string)
    if typeof(storyId) == "string" then
        startStory(player, storyId)
    end
end)

local function connectPrompt(prompt: ProximityPrompt)
    if promptConnections[prompt] then
        return
    end

    local action = prompt:GetAttribute("PromptAction")

    if action ~= "StartStory" and action ~= "StoryStep" and action ~= "ReturnToHub" then
        return
    end

    promptConnections[prompt] = prompt.Triggered:Connect(function(player: Player)
        if action == "StartStory" then
            local storyId = prompt:GetAttribute("StoryId")

            if typeof(storyId) == "string" then
                startStory(player, storyId)
            end
        elseif action == "StoryStep" then
            local storyId = prompt:GetAttribute("StoryId")
            local stepIndex = prompt:GetAttribute("StepIndex")

            if typeof(storyId) == "string" and type(stepIndex) == "number" then
                triggerStoryStep(player, storyId, stepIndex)
            end
        elseif action == "ReturnToHub" then
            exitStory(player)
        end
    end)
end

local function connectPromptsIn(instance: Instance)
    for _, descendant in ipairs(instance:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end

    instance.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then
            connectPrompt(descendant)
        end
    end)
end

task.spawn(function()
    local hubFolder = Workspace:WaitForChild(TravelRoute.WorldFolderName, 10)

    if hubFolder then
        connectPromptsIn(hubFolder)
    end
end)

task.spawn(function()
    local storyWorld = Workspace:WaitForChild(STORY_WORLD_NAME, 10)

    if storyWorld then
        connectPromptsIn(storyWorld)
    end
end)

local function handleCharacterAdded(player: Player, _character: Model)
    local state = activeStories[player]

    if not state then
        return
    end

    task.delay(0.4, function()
        if activeStories[player] ~= state then
            return
        end

        local anchor = getAnchor(state.Zone, string.format("Step_%d", state.StepIndex)) or getAnchor(state.Zone, "Entry")

        if anchor then
            teleportPlayerToAnchor(player, anchor)
        end
    end)
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(character)
        handleCharacterAdded(player, character)
    end)
end)

for _, player in ipairs(Players:GetPlayers()) do
    player.CharacterAdded:Connect(function(character)
        handleCharacterAdded(player, character)
    end)
end

Players.PlayerRemoving:Connect(function(player)
    activeStories[player] = nil
end)
]]></string>
